# --- secrets: never commit (share .env.example instead)
.env
.env.*
!.env.example

# --- OS / editor / Python noise
.DS_Store
**/.DS_Store
.idea/
.vscode/
__pycache__/
*.pyc
.venv/

# --- local backups and scratch
.backup/
*.bak
*.bak-*
*.orig

# --- other repos and share bundles (sent over Slack, not git)
others/
cwe-bench/
share/
*.zip

# --- pipeline runtime data: large, machine-specific, or regenerated
data/.cache/
data/logs/
data/*.sqlite3*
data/state.db
data/03_environments/
data/04_eval_runs/
data/knowledge/archive/
data/05_accepted_harbor/*.building/

# a task's repo snapshot has its own .git (needed by the image): git would store only a pointer. Share full tasks as zips.
data/05_accepted_harbor/*/environment/repo/
