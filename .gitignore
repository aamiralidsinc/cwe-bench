# Large / reproducible — regenerate by re-running the sourcer
sourcer/index/
*.sqlite
*.sqlite-journal
*.tsv.gz

# Secrets — never commit
.env
*.key
*.pem
*.p12

# Python / scratch
**/__pycache__/
*.pyc
.DS_Store

# Peer archives and their extracted repos (GBs; kept locally). Only the summary is tracked.
docs/peers/Junaid_Bhai/*
!docs/peers/Junaid_Bhai/results.md

# Packaged share archives (reproducible; too large for git, >100MB GitHub limit)
reports/*.tar.zst
reports/*.tar.gz
*.tar.zst

# Build scratch (bloat/binaries): agent working trees, experiment artifacts, repo clones
build/*/harden_work/
build/*/exp/
build/**/tree/
build/**/*.png
build/**/*.jpg
build/**/*.jpeg
build/**/*.gz
build/**/*.zip
build/**/*.whl
build/**/*.jar

# precision_validation (failed experiment): only its docs and code are tracked.
# GitHub Actions payloads/results (23 GB) and account/run id files stay local.
experiments/precision_validation/actions/
*.local.json

# Reserve-source bulk outputs (regenerable from the sourcer)
sourcer/reserve/index/
sourcer/reserve/out/*.jsonl

# trial.py's verdict state (set_verdict writes build/queue.json): run data, lives on the VM only
build/queue.json
pipelines/stacking/out/screener-ds/
