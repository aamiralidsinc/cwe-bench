#!/bin/bash
. "$HOME/cwe-bench/pipeline/docker-tuning.env" 2>/dev/null || true
# Gate one built task through nop/oracle/patches with per-stage retries (compose flakes under
# load return ok=None, not a real fail). Mark .sound on pass, .unsound otherwise.
s=$1
cd "$HOME/cwe-bench" || exit 1
sound=1
for st in nop oracle patches; do
  ok=None
  for a in 1 2 3 4; do
    python3 -I builder/gate.py "$s" --only "$st" >> "build/$s/recover.log" 2>&1
    ok=$(python3 -c "import json;print(json.load(open('build/$s/gate_report.partial.json'))['stages'].get('$st',{}).get('ok'))" 2>/dev/null || echo None)
    [ "$ok" = True ] && break
    [ "$ok" = False ] && break
    sleep 25
  done
  echo "  $s $st=$ok" >> "build/$s/recover.log"
  [ "$ok" = True ] || sound=0
done
if [ "$sound" = 1 ]; then rm -f "build/$s/.unsound"; touch "build/$s/.sound"; echo "$s SOUND"; else touch "build/$s/.unsound"; echo "$s unsound"; fi
