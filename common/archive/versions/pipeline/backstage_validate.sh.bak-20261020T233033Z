#!/bin/bash
# Wait for backstage-ds fairfix, then re-trial BOTH models. Writes the verdict to a log.
# Detached (setsid) so it survives ssh drops.
cd "$HOME/cwe-bench" || exit 1
S=backstage-ds
LOG=build/pipeline/backstage_validate.log
echo "=== validate $S start $(date -u +%FT%TZ) ===" >> "$LOG"
while [ "$(ps -eo cmd | grep -c "[r]un_fairfix.sh $S")" -gt 0 ]; do sleep 60; done
echo "fairfix done $(date -u +%T) exit=$(cat build/$S/fairfix-exit.txt 2>/dev/null)" >> "$LOG"
ts=$(date -u +%Y%m%dT%H%M%SZ)
for f in runs_deepseek.log runs_mimo.log trial_detail_deepseek.json trial_detail_mimo.json; do
  [ -f "build/$S/$f" ] && mv "build/$S/$f" "build/$S/$f.pre-fairfix-$ts"
done
rm -f "build/$S/.unsound"; touch "build/$S/.sound"
echo "re-trialing both models $(date -u +%T)" >> "$LOG"
nohup python3 build/trial.py "$S" --models deepseek --no-verdict >> "build/$S/trial_deepseek.out" 2>&1 &
p1=$!
nohup python3 build/trial.py "$S" --models mimo --no-verdict >> "build/$S/trial_mimo.out" 2>&1 &
p2=$!
wait $p1 $p2
D=$(grep -oE "reward=[0-9.]+" "build/$S/runs_deepseek.log" 2>/dev/null | sed s/reward=// | paste -sd, -)
M=$(grep -oE "reward=[0-9.]+" "build/$S/runs_mimo.log" 2>/dev/null | sed s/reward=// | paste -sd, -)
ds_solve=$(echo "$D" | grep -q "1.0" && echo yes || echo no)
mm_solve=$(echo "$M" | grep -q "1.0" && echo yes || echo no)
if [ "$ds_solve" = no ] && [ "$mm_solve" = no ]; then V="** REAL BOTH-MODELS BREAKER ** (both still fail after fairfix)"
elif [ "$ds_solve" = yes ] && [ "$mm_solve" = yes ]; then V="was UNFAIR (both solve after fairfix)"
else V="one-sided ($( [ $ds_solve = no ] && echo DeepSeek || echo MiMo )-only fail after fairfix)"; fi
echo "RE-TRIAL RESULT $(date -u +%T): DeepSeek[$D] MiMo[$M] => $V" >> "$LOG"
