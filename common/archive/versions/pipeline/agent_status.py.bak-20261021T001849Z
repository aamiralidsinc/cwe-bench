#!/usr/bin/env python3
"""agent_status.py <claude-output.json> <exit-code> : did a `claude -p --output-format json` run
finish cleanly? Prints `ok` or `error: <why>`; exit 0 / 1.

A run cut by a quota or session limit, an API error, the timeout (exit 124) or a crash produced
no substantive result, whatever files it left behind. Until 2026-10-20 several launchers used
such output anyway: backstage-ds wired a quota-cut agent's half patch in as a must-pass fix.
"""
import json
import re
import sys

# The provider's own cut-off messages only: a finished agent's summary may well talk about rate
# limits or errors (the tasks are about such code), so generic words must not match.
CUT = re.compile(r"^\s*(You've hit your|API Error: ?\d{3}|Credit balance is too low)|overloaded_error", re.I)


def status(path, rc):
    if rc == 124:
        return "error: agent timed out (exit 124)"
    try:
        data = json.loads(open(path).read())
    except FileNotFoundError:
        return f"error: no agent output {path} (exit {rc})"
    except (json.JSONDecodeError, OSError) as e:
        return f"error: unreadable agent output {path} ({type(e).__name__}, exit {rc})"
    if isinstance(data, list):        # stream form: the last result event decides
        data = next((e for e in reversed(data) if isinstance(e, dict) and e.get("type") == "result"), {})
    text = str(data.get("result") or "")
    if data.get("is_error"):
        return f"error: agent reported is_error ({text[:160]!r}, exit {rc})"
    if CUT.search(text[:2000]):
        return f"error: agent was cut off ({text[:160]!r})"
    if rc != 0:
        return f"error: agent exited {rc}"
    return "ok"


if __name__ == "__main__":
    if len(sys.argv) != 3:
        sys.exit("usage: agent_status.py <claude-output.json> <exit-code>")
    s = status(sys.argv[1], int(sys.argv[2]))
    print(s)
    sys.exit(0 if s == "ok" else 1)
