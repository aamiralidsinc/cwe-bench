# Raised Docker client/compose timeouts: a busy daemon returns "slow" not "failed",
# which kills the context-deadline-exceeded compose flakes under concurrency.
export COMPOSE_HTTP_TIMEOUT=300
export DOCKER_CLIENT_TIMEOUT=300
# No build happens at gate/trial time (prebuilt images); BuildKit only adds a
# colliding session under concurrency -> disable it to kill "only one connection allowed".
export DOCKER_BUILDKIT=0
export COMPOSE_DOCKER_CLI_BUILD=0
