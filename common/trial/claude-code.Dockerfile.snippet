# --- agent layer: append to a task's environment/Dockerfile (uid-1000 agent user) ----
# Pre-installs Claude Code for the unprivileged `agent` user so Harbor skips its own install
# step at trial start (that step otherwise apt-installs Node.js on every trial). The uid-1000
# `agent` user and an official `node` must already exist (see the boilerplate in the
# environment/Dockerfile template). Needs curl, bash and ca-certificates in the image.
USER agent
ENV HOME=/home/agent
RUN curl -fsSL https://downloads.claude.ai/claude-code-releases/bootstrap.sh | bash \
    && test -x /home/agent/.local/bin/claude
USER root
RUN ln -sf /home/agent/.local/bin/claude /usr/local/bin/claude \
    && su agent -c 'claude --version'
# --- node CPU count: a trial container has 2 CPUs, but node reports the host's (64 on the VM), so jest,
# vitest and any tool that sizes a worker pool from os.cpus() start one worker per host CPU and run out of
# memory. Every node process (the project's tools and Claude Code) sees at most 2 CPUs. Keeps a project's
# own NODE_OPTIONS.
RUN printf '%s\n' \
      "const os = require('os'); const n = Math.max(1, Math.min(2, os.cpus().length)); const cpus = os.cpus;" \
      "os.cpus = function () { return cpus.call(os).slice(0, n); };" \
      "if (os.availableParallelism) { os.availableParallelism = function () { return n; }; }" \
      > /etc/node-cpu-limit.js && chmod 644 /etc/node-cpu-limit.js
ENV NODE_OPTIONS="--require=/etc/node-cpu-limit.js ${NODE_OPTIONS}"
RUN node -e "process.exit(require('os').cpus().length <= 2 ? 0 : 1)" \
    && su agent -c 'claude --version'
# -----------------------------------------------------------------------------
