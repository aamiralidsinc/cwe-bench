#!/bin/bash
# Harden one fair-but-solved task (add fair complexity + re-gate). Needs Bash+Docker -> bypassPermissions.
set -uo pipefail
SLUG=$1
cd "$HOME/cwe-bench" || exit 1
mkdir -p "$HOME/.tb-graders/cwe/work/$SLUG"
bash pipeline/snapshot_experiment.sh "$SLUG"  # preserve prior version before in-place edit (provenance)
P=$(sed "s/{{SLUG}}/$SLUG/g" builder/HARDENING-PROMPT.md)
date -u +%FT%TZ > "build/$SLUG/harden_start.txt"
timeout "${HARDEN_TIMEOUT:-10800}" "$HOME/.local/bin/claude" -p "$P" --model "${MODEL:-claude-opus-5-5}" \
  --permission-mode bypassPermissions --add-dir "$HOME/cwe-bench" --add-dir "$HOME/.tb-graders/cwe/work" \
  --output-format json > "build/$SLUG/harden-run.json" 2> "build/$SLUG/harden-run.err"
echo $? > "build/$SLUG/harden-exit.txt"
echo "$SLUG harden: exit $(cat build/$SLUG/harden-exit.txt)"
