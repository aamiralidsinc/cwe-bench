#!/bin/bash
cd "$HOME/cwe-bench" || exit 1
. pipeline/docker-tuning.env 2>/dev/null || true
LOG=build/pipeline/harden_solved.log
SOLVED="langchain-ds prompty-ds mcp-atlassian-ds new-api-ds whistle-ds gogs-ds limesurvey-ds vitest-ds grav-ds compliance-trestle-ds ghost-ds"
# A round counts only when the hardening agent finished AND changed the task (run_harden.sh exit 0).
# Until 2026-10-20 this called `run_harden.sh` from the project root, where it does not exist
# (it is pipeline/run_harden.sh): every "round" ran no agent, re-gated the unchanged task and
# cleared .auto_trialed, so 22 tasks were re-trialed unchanged and burned their 3-round cap.
{
echo "=== harden 11 solved START $(date -u +%FT%TZ) C=4 staggered (round-capped at 3) ==="
printf '%s\n' $SOLVED | xargs -P4 -I{} bash -c '
  s="$1"; cd "$HOME/cwe-bench"; L=build/pipeline/harden_solved.log
  r=$(cat build/$s/.harden_rounds 2>/dev/null || echo 0); r=$((r+1))
  if [ "$r" -gt 3 ]; then touch build/$s/.terminal; echo "[$s] harden cap(3) reached -> terminal (dropped, stays solvable)" >> $L; exit 0; fi
  sleep $((RANDOM%30))
  ./drive.sh deepseek bash pipeline/run_harden.sh "$s" >> build/$s/harden.nohup 2>&1; hrc=$?
  if [ $hrc -ne 0 ]; then
    echo "[harden $s r$r $(date -u +%T)] NOT a round: $(cat build/$s/harden_status.txt 2>/dev/null) (round not counted; task left as is)" >> $L
    exit 0
  fi
  echo "$r" > build/$s/.harden_rounds
  bash pipeline/gate_one_ds.sh "$s" >> build/$s/harden.nohup 2>&1; grc=$?
  case $grc in
    0) rm -f build/$s/.auto_trialed; echo "[harden+gate $s r$r $(date -u +%T)] SOUND -> cleared .auto_trialed for re-trial" >> $L ;;
    1) echo "[harden+gate $s r$r] UNSOUND after harden (task failure: $(python3 -c "import json;d=json.load(open(\"build/$s/gate_verdict.json\"));print(d.get(\"stage\"))" 2>/dev/null))" >> $L ;;
    *) echo "[harden+gate $s r$r] GATE-ERROR after harden (infrastructure/gate, not a task verdict): re-gate it" >> $L ;;
  esac
' _ {}
echo "=== harden 11 DONE $(date -u +%FT%TZ) ==="; echo HARDEN11-DONE
} >> "$LOG" 2>&1
