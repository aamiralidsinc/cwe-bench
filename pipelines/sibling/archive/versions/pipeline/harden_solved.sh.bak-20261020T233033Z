#!/bin/bash
cd "$HOME/cwe-bench" || exit 1
. pipeline/docker-tuning.env 2>/dev/null || true
LOG=build/pipeline/harden_solved.log
SOLVED="langchain-ds prompty-ds mcp-atlassian-ds new-api-ds whistle-ds gogs-ds limesurvey-ds vitest-ds grav-ds compliance-trestle-ds ghost-ds"
{
echo "=== harden 11 solved START $(date -u +%FT%TZ) C=4 staggered (round-capped at 3) ==="
printf '%s\n' $SOLVED | xargs -P4 -I{} bash -c '
  s="$1"; cd "$HOME/cwe-bench"
  r=$(cat build/$s/.harden_rounds 2>/dev/null || echo 0); r=$((r+1))
  if [ "$r" -gt 3 ]; then touch build/$s/.terminal; echo "[$s] harden cap(3) reached -> terminal (dropped, stays solvable)" >> build/pipeline/harden_solved.log; exit 0; fi
  echo "$r" > build/$s/.harden_rounds
  sleep $((RANDOM%30))
  ./drive.sh deepseek bash run_harden.sh "$s" >> build/$s/harden.nohup 2>&1
  bash pipeline/gate_one_ds.sh "$s" >> build/$s/harden.nohup 2>&1
  if [ -f build/$s/.sound ]; then rm -f build/$s/.auto_trialed; echo "[harden+gate $s r$r $(date -u +%T)] SOUND -> cleared .auto_trialed for re-trial" >> build/pipeline/harden_solved.log
  else echo "[harden+gate $s r$r] UNSOUND after harden (will re-gate/record next tick)" >> build/pipeline/harden_solved.log; fi
' _ {}
echo "=== harden 11 DONE $(date -u +%FT%TZ) ==="; echo HARDEN11-DONE
} >> "$LOG" 2>&1
