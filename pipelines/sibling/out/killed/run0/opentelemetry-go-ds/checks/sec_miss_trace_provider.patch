+// redactedURL returns raw with the credential material removed: the password
+// part of the user-information and the whole query string.
+func redactedURL(raw string) string {
+	u, err := url.Parse(raw)
+	if err != nil {
+		return ""
+	}
+	if u.User != nil {
+		u.User = url.User(u.User.Username())
+	}
+	u.RawQuery = ""
+	u.Fragment = ""
+	return u.String()
+}
