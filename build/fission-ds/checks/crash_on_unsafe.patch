+
+// dangerousMergeCapabilities is the merge-layer mirror of the admission
+// denylist in pkg/apis/core/v1/podspec_safety.go. The webhook is the primary
+// defence; this covers stored objects and webhook-bypassed clusters.
+var dangerousMergeCapabilities = map[string]struct{}{
+	"SYS_ADMIN":       {},
+	"NET_ADMIN":       {},
+	"SYS_PTRACE":      {},
+	"SYS_MODULE":      {},
+	"DAC_READ_SEARCH": {},
+	"DAC_OVERRIDE":    {},
+	"ALL":             {},
+}
+
+func normalizedCapability(c apiv1.Capability) string {
+	name := strings.ToUpper(strings.TrimSpace(string(c)))
+	return strings.TrimPrefix(name, "CAP_")
+}
+
+// SanitizeContainerSecurityContext removes privilege-escalation settings from
+// a container. It deep-copies the security context first so a context shared
+// with an informer cache object is not modified.
+func SanitizeContainerSecurityContext(c *apiv1.Container) {
+	if c == nil || c.SecurityContext == nil {
+		return
+	}
+	sc := c.SecurityContext.DeepCopy()
+	if sc.Privileged != nil && *sc.Privileged {
+		sc.Privileged = new(false)
+	}
+	if sc.AllowPrivilegeEscalation != nil && *sc.AllowPrivilegeEscalation {
+		sc.AllowPrivilegeEscalation = new(false)
+	}
+	if sc.Capabilities != nil && len(sc.Capabilities.Add) > 0 {
+		kept := make([]apiv1.Capability, 0, len(sc.Capabilities.Add))
+		for _, capability := range sc.Capabilities.Add {
+			if _, bad := dangerousMergeCapabilities[normalizedCapability(capability)]; bad {
+				continue
+			}
+			kept = append(kept, capability)
+		}
+		sc.Capabilities.Add = kept
+	}
+	c.SecurityContext = sc
+}
+
+// withoutHostPathVolumes returns the volumes that are not hostPath mounts.
+func withoutHostPathVolumes(vols []apiv1.Volume) []apiv1.Volume {
+	if len(vols) == 0 {
+		return vols
+	}
+	out := make([]apiv1.Volume, 0, len(vols))
+	for _, v := range vols {
+		if v.HostPath != nil {
+			continue
+		}
+		out = append(out, v)
+	}
+	return out
+}
+
+// SanitizePodSpec removes the primitives that cross the container sandbox
+// boundary from a pod spec built out of tenant-supplied settings.
+func SanitizePodSpec(ps *apiv1.PodSpec) {
+	if ps == nil {
+		return
+	}
+	ps.HostNetwork = false
+	ps.HostPID = false
+	ps.HostIPC = false
+	ps.ServiceAccountName = ""
+	ps.DeprecatedServiceAccount = ""
+	ps.Volumes = withoutHostPathVolumes(ps.Volumes)
+	for i := range ps.Containers {
+		SanitizeContainerSecurityContext(&ps.Containers[i])
+	}
+	for i := range ps.InitContainers {
+		SanitizeContainerSecurityContext(&ps.InitContainers[i])
+	}
+}
