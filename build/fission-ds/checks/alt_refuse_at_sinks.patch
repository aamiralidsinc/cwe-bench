+package v1
+
+import (
+	"errors"
+	"fmt"
+	"strings"
+
+	apiv1 "k8s.io/api/core/v1"
+	"sigs.k8s.io/yaml"
+)
+
+// dangerousCapabilities lists Linux capabilities that effectively grant root
+// or break the container sandbox. Tenants that can write Environment or
+// Function objects must not be able to add these via securityContext.
+var dangerousCapabilities = map[string]struct{}{
+	"SYS_ADMIN":       {},
+	"NET_ADMIN":       {},
+	"SYS_PTRACE":      {},
+	"SYS_MODULE":      {},
+	"DAC_READ_SEARCH": {},
+	"DAC_OVERRIDE":    {},
+	"ALL":             {},
+}
+
+// capabilityName normalizes a capability spelling. Container runtimes
+// upper-case capability names and add the CAP_ prefix, so "cap_sys_admin",
+// "CAP_SYS_ADMIN" and "SYS_ADMIN" all take effect on a container.
+func capabilityName(c apiv1.Capability) string {
+	name := strings.ToUpper(strings.TrimSpace(string(c)))
+	return strings.TrimPrefix(name, "CAP_")
+}
+
+// ValidateContainerSafety rejects containers whose securityContext lets the
+// container escape the sandbox it runs in.
+func ValidateContainerSafety(fieldPath string, c *apiv1.Container) error {
+	if c == nil || c.SecurityContext == nil {
+		return nil
+	}
+	var errs error
+	sc := c.SecurityContext
+	if sc.Privileged != nil && *sc.Privileged {
+		errs = errors.Join(errs, fmt.Errorf("%s.securityContext.privileged is not allowed", fieldPath))
+	}
+	if sc.AllowPrivilegeEscalation != nil && *sc.AllowPrivilegeEscalation {
+		errs = errors.Join(errs, fmt.Errorf("%s.securityContext.allowPrivilegeEscalation is not allowed", fieldPath))
+	}
+	if sc.Capabilities != nil {
+		for _, capability := range sc.Capabilities.Add {
+			if _, bad := dangerousCapabilities[capabilityName(capability)]; bad {
+				errs = errors.Join(errs, fmt.Errorf("%s.securityContext.capabilities.add contains %q, which is not allowed", fieldPath, capability))
+			}
+		}
+	}
+	return errs
+}
+
+// ValidatePodSpecSafety rejects PodSpec fields that would let a low-privilege
+// tenant escalate to host or cluster level when the executor or buildermgr
+// schedules a pod from a user-supplied podspec.
+//
+// The fieldPath argument is used as a prefix in error messages so the caller
+// can identify which podspec failed.
+func ValidatePodSpecSafety(fieldPath string, ps *apiv1.PodSpec) error {
+	if ps == nil {
+		return nil
+	}
+	var errs error
+
+	if ps.HostNetwork {
+		errs = errors.Join(errs, fmt.Errorf("%s.hostNetwork is not allowed", fieldPath))
+	}
+	if ps.HostPID {
+		errs = errors.Join(errs, fmt.Errorf("%s.hostPID is not allowed", fieldPath))
+	}
+	if ps.HostIPC {
+		errs = errors.Join(errs, fmt.Errorf("%s.hostIPC is not allowed", fieldPath))
+	}
+	if ps.ServiceAccountName != "" {
+		errs = errors.Join(errs, fmt.Errorf("%s.serviceAccountName override is not allowed", fieldPath))
+	}
+	if ps.DeprecatedServiceAccount != "" {
+		errs = errors.Join(errs, fmt.Errorf("%s.serviceAccount override is not allowed", fieldPath))
+	}
+	for _, v := range ps.Volumes {
+		if v.HostPath != nil {
+			errs = errors.Join(errs, fmt.Errorf("%s.volumes[%s].hostPath is not allowed", fieldPath, v.Name))
+		}
+	}
+	for i := range ps.Containers {
+		errs = errors.Join(errs, ValidateContainerSafety(fmt.Sprintf("%s.containers[%s]", fieldPath, ps.Containers[i].Name), &ps.Containers[i]))
+	}
+	for i := range ps.InitContainers {
+		errs = errors.Join(errs, ValidateContainerSafety(fmt.Sprintf("%s.initContainers[%s]", fieldPath, ps.InitContainers[i].Name), &ps.InitContainers[i]))
+	}
+	return errs
+}
+
+// ValidatePodSpecPatchSafety checks a serialized pod spec patch for the same
+// forbidden primitives as a structured pod spec.
+func ValidatePodSpecPatchSafety(fieldPath string, patch string) error {
+	if strings.TrimSpace(patch) == "" {
+		return nil
+	}
+	raw, err := yaml.YAMLToJSON([]byte(patch))
+	if err != nil {
+		return fmt.Errorf("%s is not valid YAML or JSON: %v", fieldPath, err)
+	}
+	ps := &apiv1.PodSpec{}
+	if err := yaml.Unmarshal(raw, ps); err != nil {
+		return fmt.Errorf("%s is not a valid pod spec fragment: %v", fieldPath, err)
+	}
+	return ValidatePodSpecSafety(fieldPath, ps)
+}
