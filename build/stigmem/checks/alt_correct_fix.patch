+def _alt_host_is_loopback(node_url: str) -> bool:
+    from urllib.parse import urlparse
+
+    host = (urlparse(node_url).hostname or "").lower()
+    if host == "localhost":
+        return True
+    try:
+        return ipaddress.ip_address(host).is_loopback
+    except ValueError:
+        return False
+
+
+def _enforce_auth_not_disabled_remotely() -> None:
