diff -ruN a/src/helpers/NavigationHelper.php b/src/helpers/NavigationHelper.php
--- a/src/helpers/NavigationHelper.php	1970-01-01 00:00:00.000000000 +0000
+++ b/src/helpers/NavigationHelper.php	2026-10-26 06:08:47.489780922 +0000
@@ -0,0 +1,80 @@
+<?php
+/**
+ * @link https://craftcms.com/
+ * @copyright Copyright (c) Pixel & Tonic, Inc.
+ * @license https://craftcms.github.io/license/
+ */
+
+namespace craft\helpers;
+
+/**
+ * NavigationHelper prepares values that the product stores or hands to the browser as a
+ * navigation destination.
+ *
+ * A requested destination is never trusted as-is: the product removes template-tag braces and
+ * markup from destinations on the way out, and either of those removals can join a scheme back
+ * together (for example `java<script></script>script:` becomes `javascript:`). The value is
+ * therefore normalized the same way before its scheme is inspected, so the decision is made
+ * about the value the browser would actually receive.
+ *
+ * @author Pixel & Tonic, Inc. <support@pixelandtonic.com>
+ * @since 4.15.3
+ */
+final class NavigationHelper
+{
+    /**
+     * @var string[] The schemes a browser fetches instead of executing.
+     */
+    private const FETCHED_SCHEMES = ['http', 'https'];
+
+    /**
+     * Returns a destination that is safe to store, return, or navigate to.
+     *
+     * @param string $url The requested destination.
+     * @param string $fallback The destination to use if the requested one is executable.
+     * @return string
+     */
+    public static function sanitize(string $url, string $fallback = '/'): string
+    {
+        $url = self::normalize($url);
+        return self::isExecutable($url) ? $fallback : $url;
+    }
+
+    /**
+     * Returns the value the browser will actually receive, after the transformations the
+     * product applies to a destination on the way out.
+     *
+     * @param string $url
+     * @return string
+     */
+    public static function normalize(string $url): string
+    {
+        // Template-tag braces and markup are removed elsewhere in the request cycle before a
+        // destination reaches the browser, and doing so can assemble a scheme.
+        $url = str_replace(['{', '}'], '', strip_tags($url));
+
+        // Browsers drop tabs and newlines from a URL and ignore leading whitespace and
+        // control characters, so the scheme may not begin where it appears to.
+        $url = preg_replace('/[\t\r\n]+/', '', $url);
+        return (string)preg_replace('/^[\x00-\x20]+/', '', (string)$url);
+    }
+
+    /**
+     * Returns whether a browser would run the URL's scheme rather than fetch it.
+     *
+     * Relative, root-relative, and protocol-relative values have no scheme of their own, so
+     * they cannot execute code and are always safe.
+     *
+     * @param string $url A value that has already been through [[normalize()]].
+     * @return bool
+     */
+    public static function isExecutable(string $url): bool
+    {
+        if (!UrlHelper::isAbsoluteUrl($url)) {
+            return false;
+        }
+
+        $scheme = substr($url, 0, (int)strpos($url, ':'));
+        return !in_array(strtolower($scheme), self::FETCHED_SCHEMES, true);
+    }
+}
