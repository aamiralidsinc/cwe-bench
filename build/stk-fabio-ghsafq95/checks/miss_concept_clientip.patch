+// protectedGRPCMetadata replaces any client-supplied value for the headers
+// Fabio is configured to derive, so the backend only sees values Fabio
+// produced for this request.
+func protectedGRPCMetadata(ctx context.Context, md metadata.MD, cfg config.Proxy) metadata.MD {
+	for _, name := range []string{cfg.ClientIPHeader, cfg.TLSHeader, cfg.RequestID} {
+		if name != "" {
+			md.Delete(strings.ToLower(name))
+		}
+	}
+
+	if cfg.RequestID != "" {
+		md.Set(strings.ToLower(cfg.RequestID), uuid.NewUUID())
+	}
+
+	if cfg.TLSHeader != "" {
+		if p, ok := peer.FromContext(ctx); ok && p.AuthInfo != nil {
+			if _, ok := p.AuthInfo.(credentials.TLSInfo); ok {
+				md.Set(strings.ToLower(cfg.TLSHeader), cfg.TLSHeaderValue)
+			}
+		}
+	}
+
+	if cfg.ClientIPHeader != "" {
+		if host := grpcPeerHost(ctx); host != "" {
+			md.Set(strings.ToLower(cfg.ClientIPHeader), host)
+		}
+	}
+
+	return md
+}
+
+// grpcPeerHost returns the address of the peer that opened the connection.
+func grpcPeerHost(ctx context.Context) string {
+	p, ok := peer.FromContext(ctx)
+	if !ok || p.Addr == nil {
+		return ""
+	}
+	host, _, err := net.SplitHostPort(p.Addr.String())
+	if err != nil {
+		return p.Addr.String()
+	}
+	return host
+}
