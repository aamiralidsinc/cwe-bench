index 66966efd..bb7e2d32 100644
--- a/proxy/http_headers.go
+++ b/proxy/http_headers.go
@@ -5,11 +5,62 @@ import (
 	"errors"
 	"net"
 	"net/http"
+	"net/textproto"
 	"strings"
 
 	"github.com/fabiolb/fabio/config"
 )
 
+// protectHeaders are the headers Fabio derives for a request. They must
+// never be treated as hop-by-hop, even if the client lists them in the
+// Connection header, because the backend trusts the values Fabio sets.
+var protectHeaders = map[string]bool{
+	"Forwarded":          true,
+	"X-Forwarded-For":    true,
+	"X-Forwarded-Host":   true,
+	"X-Forwarded-Port":   true,
+	"X-Forwarded-Proto":  true,
+	"X-Forwarded-Prefix": true,
+	"X-Real-Ip":          true,
+}
+
+// protectedHeaderSet returns the set of headers Fabio derives for cfg,
+// including the operator-configured client IP, TLS and request id headers.
+func protectedHeaderSet(cfg config.Proxy) map[string]bool {
+	hdrs := make(map[string]bool, len(protectHeaders)+3)
+	for name := range protectHeaders {
+		hdrs[name] = true
+	}
+	for _, name := range []string{cfg.ClientIPHeader, cfg.TLSHeader, cfg.RequestID} {
+		if name != "" {
+			hdrs[textproto.CanonicalMIMEHeaderKey(name)] = true
+		}
+	}
+	return hdrs
+}
+
+// stripProtectedConnectionTokens removes the tokens that name headers Fabio
+// derives from the Connection header so that the reverse proxy does not
+// discard those headers. All other tokens are left in place.
+func stripProtectedConnectionTokens(r *http.Request, hdrs map[string]bool) {
+	var conHeaders []string
+	for _, s := range r.Header.Values("Connection") {
+		for _, p := range strings.Split(s, ",") {
+			p = strings.TrimSpace(p)
+			if p == "" {
+				continue
+			}
+			if !hdrs[textproto.CanonicalMIMEHeaderKey(p)] {
+				conHeaders = append(conHeaders, p)
+			}
+		}
+	}
+	r.Header.Del("Connection")
+	if len(conHeaders) > 0 {
+		r.Header.Set("Connection", strings.Join(conHeaders, ", "))
+	}
+}
