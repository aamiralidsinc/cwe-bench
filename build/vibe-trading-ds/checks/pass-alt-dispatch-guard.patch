 from typing import Any, Dict, List, Optional
 
 
+_FILE_ARGS = ("file_path", "journal_path", "factor_csv", "return_csv")
+_DIR_ARGS = ("run_dir", "output_dir")
+
+
+def _agent_dir():
+    from pathlib import Path
+    return Path(__file__).resolve().parents[2]
+
+
+def _roots(env_name, defaults):
+    import os
+    from pathlib import Path
+    roots = [d.resolve() for d in defaults]
+    for item in os.getenv(env_name, "").split(","):
+        item = item.strip()
+        if item:
+            roots.append(Path(item).expanduser().resolve())
+    return roots
+
+
+def _check_path_args(params):
+    """Return an error message when a path argument leaves the allowed areas."""
+    from pathlib import Path
+    agent = _agent_dir()
+    run_roots = _roots("", [agent / "runs"])
+    file_roots = _roots("VIBE_TRADING_ALLOWED_FILE_ROOTS", [agent / "uploads", agent / "runs"])
+    for key in _FILE_ARGS + _DIR_ARGS:
+        raw = params.get(key)
+        if raw is None or raw == "":
+            continue
+        text = str(raw)
+        if text.startswith(("//", "\\\\")):
+            return f"{key}: UNC paths are not allowed"
+        resolved = Path(text).expanduser().resolve()
+        allowed = run_roots if key in _DIR_ARGS else file_roots
+        if not any(resolved == r or resolved.is_relative_to(r) for r in allowed):
+            return f"{key} {text!r} is outside the allowed areas"
+    skill_file = params.get("file")
+    if skill_file:
+        text = str(skill_file)
+        if Path(text).is_absolute() or ".." in Path(text).parts:
+            return f"file {text!r} is outside the skill directory"
+    return None
+
+
