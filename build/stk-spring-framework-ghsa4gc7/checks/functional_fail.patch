+	private String toComparisonName(String field) {
+		StringBuilder result = new StringBuilder(field.length());
+		StringBuilder resolvedPath = new StringBuilder();
+		int i = 0;
+		while (i < field.length()) {
+			int start = i;
+			while (i < field.length() && field.charAt(i) != '.' && field.charAt(i) != '[') {
+				i++;
+			}
+			String name = field.substring(start, i);
+			result.append(name.toLowerCase(Locale.ROOT));
+			if (resolvedPath.length() > 0) {
+				resolvedPath.append('.');
+			}
+			resolvedPath.append(name);
+			while (i < field.length() && field.charAt(i) == '[') {
+				int end = field.indexOf(']', i);
+				if (end < 0) {
+					result.append(field, i, field.length());
+					resolvedPath.append(field, i, field.length());
+					i = field.length();
+					break;
+				}
+				String key = field.substring(i + 1, end);
+				result.append('[').append(toComparisonKey(resolvedPath.toString(), key)).append(']');
+				resolvedPath.append(field, i, end + 1);
+				i = end + 1;
+			}
+			if (i < field.length() && field.charAt(i) == '.') {
+				result.append('.');
+				i++;
+			}
+		}
+		return result.toString();
+	}
