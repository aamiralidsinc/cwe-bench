+	private String[] toComparisonNames(String[] fieldPatterns) {
+		String[] result = new String[fieldPatterns.length];
+		for (int i = 0; i < fieldPatterns.length; i++) {
+			result[i] = toComparisonName(fieldPatterns[i]);
+		}
+		return result;
+	}
