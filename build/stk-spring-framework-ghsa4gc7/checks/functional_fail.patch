+	private static int parseIndex(String key) {
+		if (key.isEmpty()) {
+			return -1;
+		}
+		int start = (key.charAt(0) == '+' || key.charAt(0) == '-') ? 1 : 0;
+		if (start == key.length()) {
+			return -1;
+		}
+		for (int i = start; i < key.length(); i++) {
+			char ch = key.charAt(i);
+			if (ch < '0' || ch > '9') {
