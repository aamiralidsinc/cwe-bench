+/**
+ * Provider configuration fields that hold addresses the server may contact
+ * (or send users to) on behalf of an OIDC provider.
+ */
+export const PROVIDER_ENDPOINT_FIELDS = [
+	"discoveryEndpoint",
+	"authorizationEndpoint",
+	"tokenEndpoint",
+	"userInfoEndpoint",
+	"jwksEndpoint",
+] as const;
+
+export type ProviderEndpointField = (typeof PROVIDER_ENDPOINT_FIELDS)[number];
+
+/**
+ * Returns true when the server is allowed to use `url` for a provider:
+ * it must be an absolute http(s) URL whose origin is trusted by the
+ * deployment's trusted origins configuration, or whose host is publicly
+ * routable. Loopback, private-network, link-local, cloud-metadata and other
+ * special-purpose hosts (in any spelling the URL parser accepts) are refused
+ * unless their origin is explicitly trusted.
+ */
+export function isPermittedProviderUrl(
+	url: string,
+	isTrustedOrigin: (url: string) => boolean,
+): boolean {
+	if (typeof url !== "string" || url.length === 0) {
+		return false;
+	}
+	let parsed: URL;
+	try {
+		parsed = new URL(url);
+	} catch {
+		return false;
+	}
+	if (parsed.protocol !== "http:" && parsed.protocol !== "https:") {
+		return false;
+	}
+	if (isTrustedOrigin(url)) {
+		return true;
+	}
+	return isPublicRoutableHost(parsed.hostname);
+}
+
+/**
