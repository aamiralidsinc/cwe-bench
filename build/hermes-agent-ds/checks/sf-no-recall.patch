+# Tools whose results carry attacker-controllable content.
+_UNTRUSTED_TOOL_NAMES = frozenset({
+    "web_extract",
+    "web_search",
+    "x_search",
+})
+
+_UNTRUSTED_TOOL_PREFIXES = (
+    "browser_",
+    "mcp_",
