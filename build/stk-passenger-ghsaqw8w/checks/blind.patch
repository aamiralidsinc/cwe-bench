+	# Creates and runs a small executable below 'dir'. The name of the probe
+	# used to be predictable, so another user could put an entry there and have
+	# it truncated, re-permissioned and executed. The probe is now created
+	# inside a fresh directory that only this process can enter, and the file
+	# itself is created exclusively, so nothing that already exists is opened.
+	# Returns whether the probe could be executed.
+	def self.executable_probe_works(dir)
+		result = false
+		PhusionPassenger::Utils.mktmpdir("passenger-exe-", dir) do |subdir|
+			filename = "#{subdir}/test-exe"
+			File.open(filename, File::WRONLY | File::CREAT | File::EXCL, 0700) do |f|
+				f.puts("#!/bin/sh")
+			end
+			File.chmod(0700, filename)
+			result = system(filename) ? true : false
+		end
+		return result
+	end
