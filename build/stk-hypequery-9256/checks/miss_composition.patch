diff --git a/packages/clickhouse/src/core/utils/identifiers.ts b/packages/clickhouse/src/core/utils/identifiers.ts
new file mode 100644
index 00000000..6410ff22
--- /dev/null
+++ b/packages/clickhouse/src/core/utils/identifiers.ts
@@ -0,0 +1,21 @@
+const IDENTIFIER = /^[A-Za-z_][A-Za-z0-9_]*(?:\.[A-Za-z_][A-Za-z0-9_]*)*$/;
+
+/**
+ * An identifier is written into SQL text, so it may only ever contain what an
+ * identifier can contain. Dotted, unquoted names are accepted because joined
+ * columns and schema-qualified names are written that way.
+ */
+export function assertSafeIdentifier(name: string, kind: string): void {
+  if (typeof name !== 'string' || !IDENTIFIER.test(name)) {
+    throw new Error(
+      `Invalid ${kind} "${String(name)}". Use an unquoted SQL identifier (letters, numbers, underscore; dots between parts).`
+    );
+  }
+}
+
+export function assertSafeCount(value: number, kind: string): number {
+  if (typeof value !== 'number' || !Number.isInteger(value) || value < 0) {
+    throw new Error(`Invalid ${kind} "${String(value)}". Use a non-negative whole number.`);
+  }
+  return value;
+}
