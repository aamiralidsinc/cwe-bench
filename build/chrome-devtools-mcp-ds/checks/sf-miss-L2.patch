diff --git a/src/utils/files.ts b/src/utils/files.ts
index 00083df..6eec841 100644
--- a/src/utils/files.ts
+++ b/src/utils/files.ts
@@ -22,3 +22,68 @@ export function ensureExtension(
   const ext = path.extname(filepath);
   return filepath.slice(0, filepath.length - ext.length) + extension;
 }
+
+const MAX_LINK_HOPS = 40;
+
+function isMissing(err: unknown): boolean {
+  return (
+    !!err &&
+    typeof err === 'object' &&
+    'code' in err &&
+    (err as {code?: string}).code === 'ENOENT'
+  );
+}
+
+/**
+ * Resolves every link along `absolutePath` and returns the location the
+ * filesystem would actually use. Unlike realpath(), this also resolves a link
+ * whose target does not exist yet: the write that follows must be checked
+ * against the location it would create, not against the link's own name.
+ */
+async function resolveCanonical(
+  absolutePath: string,
+  hops: number,
+): Promise<string> {
+  if (hops > MAX_LINK_HOPS) {
+    throw new Error(`Too many links while resolving ${absolutePath}`);
+  }
+
+  try {
+    return await fs.realpath(absolutePath);
+  } catch (err) {
+    if (!isMissing(err)) {
+      throw err;
+    }
+  }
+
+  // The final component does not exist (or is a link to something that does
+  // not exist). Inspect the component itself before falling back to its parent.
+  let stat;
+  try {
+    stat = await fs.lstat(absolutePath);
+  } catch (err) {
+    if (!isMissing(err)) {
+      throw err;
+    }
+    stat = undefined;
+  }
+
+  if (stat?.isSymbolicLink()) {
+    const target = await fs.readlink(absolutePath);
+    return await resolveCanonical(
+      path.resolve(path.dirname(absolutePath), target),
+      hops + 1,
+    );
+  }
+
+  const parent = path.dirname(absolutePath);
+  if (parent === absolutePath) {
+    throw new Error(`Cannot resolve path ${absolutePath}`);
+  }
+  const canonicalParent = await resolveCanonical(parent, hops + 1);
+  return path.join(canonicalParent, path.basename(absolutePath));
+}
+
+export async function resolveCanonicalPath(filePath: string): Promise<string> {
+  return await resolveCanonical(path.resolve(filePath), 0);
+}
