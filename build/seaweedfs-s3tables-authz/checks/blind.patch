+// authorizeTableWrite asks the S3 Tables layer whether the caller may perform
+// operation on the resources named by req, before any metadata file is
+// written. It returns an error response description when the caller is
+// refused (or the target does not exist), and nil when authorized.
+func (s *Server) authorizeTableWrite(ctx context.Context, operation string, req interface{}, identityName string, identity interface{}) *icebergRequestError {
+	err := s.filerClient.WithFilerClient(false, func(client filer_pb.SeaweedFilerClient) error {
+		mgrClient := s3tables.NewManagerClient(client)
+		return s.tablesManager.AuthorizeAs(ctx, mgrClient, operation, req, identityName, identity)
+	})
+	if err == nil {
+		return nil
+	}
+	var tableErr *s3tables.S3TablesError
+	if errors.As(err, &tableErr) {
+		switch tableErr.Type {
+		case s3tables.ErrCodeAccessDenied:
+			return &icebergRequestError{status: http.StatusForbidden, errType: "ForbiddenException", message: "Access denied"}
+		case s3tables.ErrCodeNoSuchNamespace:
+			return &icebergRequestError{status: http.StatusNotFound, errType: "NoSuchNamespaceException", message: "Namespace does not exist"}
+		case s3tables.ErrCodeNoSuchTable:
+			return &icebergRequestError{status: http.StatusNotFound, errType: "NoSuchTableException", message: "Table does not exist"}
+		case s3tables.ErrCodeNoSuchBucket:
+			return &icebergRequestError{status: http.StatusNotFound, errType: "NoSuchNamespaceException", message: "Catalog does not exist"}
+		}
+	}
+	glog.V(1).Infof("Iceberg: authorization check for %s failed: %v", operation, err)
+	return &icebergRequestError{status: http.StatusForbidden, errType: "ForbiddenException", message: "Access denied"}
+}
