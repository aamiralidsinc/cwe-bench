diff -ruN a/weed/s3api/s3tables/authz.go b/weed/s3api/s3tables/authz.go
--- a/weed/s3api/s3tables/authz.go	1970-01-01 00:00:00.000000000 +0000
+++ b/weed/s3api/s3tables/authz.go	2026-10-17 21:40:13.185307701 +0000
@@ -0,0 +1,251 @@
+package s3tables
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"strings"
+
+	"github.com/seaweedfs/seaweedfs/weed/s3api/s3_constants"
+)
+
+// Context keys used to describe how a request reached the handler. They are
+// unexported so only code in this package (and the explicit helpers below)
+// can set them; nothing a remote client sends can influence them.
+type trustedCallerKey struct{}
+type openAccessKey struct{}
+type authorizeOnlyKey struct{}
+
+type trustedCaller struct {
+	accountID string
+}
+
+// withTrustedCaller marks the request as coming from a trusted local tool
+// (weed shell, admin console, weed mini) acting for the named account.
+func withTrustedCaller(ctx context.Context, accountID string) context.Context {
+	return context.WithValue(ctx, trustedCallerKey{}, &trustedCaller{accountID: accountID})
+}
+
+// WithOpenAccess marks a request as served by a gateway that has no
+// identities configured. Such requests carry no credentials and get the
+// open-by-default fallback.
+func WithOpenAccess(ctx context.Context) context.Context {
+	return context.WithValue(ctx, openAccessKey{}, true)
+}
+
+func hasOpenAccess(r *http.Request) bool {
+	v, _ := r.Context().Value(openAccessKey{}).(bool)
+	return v
+}
+
+func withAuthorizeOnly(ctx context.Context) context.Context {
+	return context.WithValue(ctx, authorizeOnlyKey{}, true)
+}
+
+// isAuthorizeOnly reports whether the handler should stop right after a
+// successful authorization check without changing anything.
+func isAuthorizeOnly(r *http.Request) bool {
+	v, _ := r.Context().Value(authorizeOnlyKey{}).(bool)
+	return v
+}
+
+// caller describes who a request acts as, derived only from authentication.
+type caller struct {
+	principal     string
+	authenticated bool
+	trusted       bool
+	admin         bool
+	canOwn        bool
+	actions       []string
+	fallback      bool
+}
+
+// resolveCaller derives the caller from the authenticated identity in the
+// request context. Request headers are never consulted.
+func (h *S3TablesHandler) resolveCaller(r *http.Request) *caller {
+	if tc, ok := r.Context().Value(trustedCallerKey{}).(*trustedCaller); ok && tc != nil {
+		principal := normalizePrincipalID(tc.accountID)
+		if principal == "" {
+			principal = h.accountID
+		}
+		return &caller{
+			principal:     principal,
+			authenticated: true,
+			trusted:       true,
+			admin:         principal == s3_constants.AccountAdminId,
+			canOwn:        true,
+			fallback:      h.defaultAllow,
+		}
+	}
+
+	identity := s3_constants.GetIdentityFromContext(r)
+	identityName := s3_constants.GetIdentityNameFromContext(r)
+	if (identity == nil && identityName == "") ||
+		isAnonymousIdentity(r) ||
+		(identity == nil && identityName == s3_constants.AccountAnonymousId) {
+		// No valid credentials: never an owner or an administrator.
+		return &caller{
+			principal:     h.accountID,
+			authenticated: false,
+			actions:       withoutAdminActions(getIdentityActions(r)),
+			fallback:      h.defaultAllow || hasOpenAccess(r),
+		}
+	}
+
+	principal := h.getAccountID(r)
+	actions := getIdentityActions(r)
+	admin := false
+	for _, a := range actions {
+		if a == string(s3_constants.ACTION_ADMIN) {
+			admin = true
+			break
+		}
+	}
+	// The reserved admin/anonymous accounts can only be owned through
+	// administrative permissions, not by an identity that merely resolves to
+	// that account id (e.g. via its account, name or identity provider claims).
+	canOwn := principal != "" && (admin || !h.isReservedPrincipal(principal))
+	return &caller{
+		principal:     principal,
+		authenticated: true,
+		admin:         admin,
+		canOwn:        canOwn,
+		actions:       actions,
+		fallback:      false,
+	}
+}
+
+// isReservedPrincipal reports whether principal names one of the built-in
+// accounts (administrator, anonymous, or the handler's default account that
+// owns resources created by unauthenticated requests and local tools).
+func (h *S3TablesHandler) isReservedPrincipal(principal string) bool {
+	switch principal {
+	case s3_constants.AccountAdminId, s3_constants.AccountAnonymousId, DefaultAccountID, h.accountID:
+		return true
+	}
+	return false
+}
+
+func withoutAdminActions(actions []string) []string {
+	if len(actions) == 0 {
+		return nil
+	}
+	filtered := make([]string, 0, len(actions))
+	for _, a := range actions {
+		if a == string(s3_constants.ACTION_ADMIN) {
+			continue
+		}
+		filtered = append(filtered, a)
+	}
+	return filtered
+}
+
+// accessCheck is one resource policy evaluation used by checkAccessAny.
+type accessCheck struct {
+	owner     string
+	policy    string
+	arn       string
+	policyCtx *PolicyContext
+}
+
+// checkAccess decides whether the caller may perform operation on a resource
+// owned by owner and governed by resourcePolicy. The principal argument is
+// ignored; the caller is always derived from the authenticated request.
+func (h *S3TablesHandler) checkAccess(r *http.Request, operation, _ string, owner, resourcePolicy, resourceARN string, policyCtx *PolicyContext) bool {
+	return h.checkAccessAny(r, operation, accessCheck{owner: owner, policy: resourcePolicy, arn: resourceARN, policyCtx: policyCtx})
+}
+
+// checkAccessAny allows the operation if any of the checks allows it. For
+// callers without credentials an explicit Deny in any of the policies wins.
+func (h *S3TablesHandler) checkAccessAny(r *http.Request, operation string, checks ...accessCheck) bool {
+	c := h.resolveCaller(r)
+	if c.principal == "" {
+		return false
+	}
+	if !c.authenticated {
+		for _, chk := range checks {
+			if policyExplicitlyDenies(operation, c.principal, chk.policy, chk.arn, chk.policyCtx) {
+				return false
+			}
+		}
+	}
+	for _, chk := range checks {
+		if h.checkOne(r, c, operation, chk) {
+			return true
+		}
+	}
+	return false
+}
+
+func (h *S3TablesHandler) checkOne(r *http.Request, c *caller, operation string, chk accessCheck) bool {
+	if chk.owner == "" {
+		return false
+	}
+	if c.admin {
+		return true
+	}
+	if c.canOwn && c.principal == chk.owner {
+		return true
+	}
+	pctx := PolicyContext{}
+	if chk.policyCtx != nil {
+		pctx = *chk.policyCtx
+	}
+	pctx.IdentityActions = c.actions
+	pctx.DefaultAllow = c.fallback
+	if hasIdentityPermission(operation, &pctx) {
+		return true
+	}
+	if h.iamAllows(r, c, operation, chk.arn) {
+		return true
+	}
+	return evaluateResourcePolicy(operation, c.principal, chk.policy, chk.arn, &pctx)
+}
+
+// iamAllows consults the IAM authorizer for authenticated, non-local callers.
+func (h *S3TablesHandler) iamAllows(r *http.Request, c *caller, operation, resourceARN string) bool {
+	if !c.authenticated || c.trusted || resourceARN == "" {
+		return false
+	}
+	policyNames := getIdentityPolicyNames(r)
+	if !h.shouldUseIAM(r, c.actions, policyNames) {
+		return false
+	}
+	allowed, err := h.authorizeIAMAction(r, policyNames, operation, resourceARN)
+	return err == nil && allowed
+}
+
+// policyExplicitlyDenies reports whether a matching Deny statement exists.
+func policyExplicitlyDenies(operation, principal, resourcePolicy, resourceARN string, ctx *PolicyContext) bool {
+	if resourcePolicy == "" {
+		return false
+	}
+	fullAction := operation
+	if !strings.Contains(operation, ":") {
+		fullAction = "s3tables:" + operation
+	}
+	var policy PolicyDocument
+	if err := json.Unmarshal([]byte(resourcePolicy), &policy); err != nil {
+		// An unreadable policy cannot grant anything; treat it as denying.
+		return true
+	}
+	for _, stmt := range policy.Statement {
+		if stmt.Effect != "Deny" {
+			continue
+		}
+		if !matchesPrincipal(stmt.Principal, principal) {
+			continue
+		}
+		if !matchesAction(stmt.Action, fullAction) {
+			continue
+		}
+		if resourceARN != "" && !matchesResource(stmt.Resource, resourceARN) {
+			continue
+		}
+		if !matchesConditions(stmt.Condition, ctx) {
+			continue
+		}
+		return true
+	}
+	return false
+}
