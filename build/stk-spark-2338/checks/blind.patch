+// Characters that would otherwise be parsed as markup when a string is inserted into HTML.
+const HTML_ESCAPE_CHARS = {
+  '&': '&amp;',
+  '<': '&lt;',
+  '>': '&gt;',
+  '"': '&quot;',
+  "'": '&#39;'
+};
+
+// Render an arbitrary value as literal text. Non-strings are left alone so callers can pass
+// numbers or absent columns through unchanged.
+function toText(value) {
+  if (typeof value !== 'string') {
+    return value;
+  }
+  return value.replace(/[&<>"']/g, (ch) => HTML_ESCAPE_CHARS[ch]);
+}
