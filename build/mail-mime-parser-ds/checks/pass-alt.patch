diff --git a/src/Message/MimePart.php b/src/Message/MimePart.php
index 855200b..fa1d747 100644
--- a/src/Message/MimePart.php
+++ b/src/Message/MimePart.php
@@ -269,6 +269,11 @@ class MimePart extends MultiPart implements IMimePart
 
     public function setRawHeader(string $name, ?string $value, int $offset = 0) : static
     {
+        if ($value !== null) {
+            $value = \preg_replace('/\r\n(?![ \t])|\r(?!\n)|(?<!\r)\n/', ' ', $value) ?? '';
+            $value = \preg_replace('/[\x00-\x08\x0B\x0C\x0E-\x1F\x7F]+/', ' ', $value) ?? '';
+            $value = \rtrim($value, "\r\n");
+        }
         $this->headerContainer->set($name, $value, $offset);
         $this->notify();
         return $this;
