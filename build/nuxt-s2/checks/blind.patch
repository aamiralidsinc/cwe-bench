diff -ruN pristine/packages/nitro-server/src/runtime/plugins/route-rules-case.ts app/packages/nitro-server/src/runtime/plugins/route-rules-case.ts
--- a/packages/nitro-server/src/runtime/plugins/route-rules-case.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/packages/nitro-server/src/runtime/plugins/route-rules-case.ts	2026-10-26 00:18:29.692851147 +0000
@@ -0,0 +1,31 @@
+import { addRoute, createRouter, findAllRoutes } from 'rou3'
+import { defu } from 'defu'
+import { withoutBase } from 'ufo'
+import { defineNitroPlugin, useRuntimeConfig } from 'nitropack/runtime'
+// @ts-expect-error virtual file
+import { sensitive } from '#internal/route-rules-case'
+
+// Nitro's own route-rules table is built with verbatim keys and matched against the
+// request path as sent, so a rule configured for `/Admin` is invisible to `/ADMIN`.
+// Nuxt resolves routes case-insensitively unless `router.options.sensitive` is set,
+// so in that mode build the folded table once and answer `getRouteRules` for every
+// request from it. Consumers (redirect/proxy handlers, the renderer, modules) read
+// `event.context._nitro.routeRules`, which is what this hook seeds.
+export default defineNitroPlugin((nitroApp) => {
+  if (sensitive) { return }
+
+  const runtimeConfig = useRuntimeConfig()
+  const routeRules = runtimeConfig.nitro?.routeRules as Record<string, any> | undefined
+  if (!routeRules) { return }
+
+  const router = createRouter()
+  for (const route in routeRules) {
+    addRoute(router, undefined, route.toLowerCase(), routeRules[route])
+  }
+
+  nitroApp.hooks.hook('request', (event) => {
+    const path = withoutBase(event.path.split('?')[0] || '/', runtimeConfig.app.baseURL)
+    event.context._nitro ||= {}
+    event.context._nitro.routeRules = defu({}, ...findAllRoutes(router, undefined, path.toLowerCase()).map(r => r.data).reverse())
+  })
+})
