+/**
+ * Resolve a caller-supplied state name to a path inside the state directory.
+ * The target's deepest existing ancestor must realpath to the state directory
+ * itself, so neither a climbing name nor a link can leave it.
+ */
+async function resolveStateTarget(name) {
+    const fs = await import('fs');
+    const path = await import('path');
+    const os = await import('os');
+    const dir = path.resolve(process.env.CONSCIOUSNESS_EXPLORER_STATE_DIR ||
+        path.join(os.homedir(), '.consciousness-explorer', 'state'));
+    if (typeof name !== 'string' || name.length === 0 || Buffer.byteLength(name, 'utf8') > 255) {
+        throw new Error('unsafe state name');
+    }
+    if (name === '.' || name === '..' || name.startsWith('.') ||
+        name.includes('/') || name.includes('\\') || name.includes('\u0000')) {
+        throw new Error('unsafe state name');
+    }
+    fs.mkdirSync(dir, { recursive: true, mode: 0o700 });
+    const candidate = path.join(dir, name);
+    let probe = candidate;
+    while (!fs.existsSync(probe)) {
+        const parent = path.dirname(probe);
+        if (parent === probe) break;
+        probe = parent;
+    }
+    const realRoot = fs.realpathSync(dir);
+    const realProbe = fs.realpathSync(probe);
+    const rel = path.relative(realRoot, realProbe);
+    if (rel.startsWith('..') || path.isAbsolute(rel)) {
+        throw new Error('unsafe state name');
+    }
+    return candidate;
+}
