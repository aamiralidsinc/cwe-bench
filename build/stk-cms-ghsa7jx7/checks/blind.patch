     /**
+     * Recursively strips any `as X` and `on X` keys from a config array.
+     *
+     * Yii's [[\yii\base\Component::__set()]] interprets those key prefixes as requests to attach
+     * a behavior or an event handler, instantiating any class the value names. Config that comes
+     * from a request, project config, or any other source outside the application's own code must
+     * be passed through this method before it is handed to a component constructor or
+     * [[\Craft::configure()]].
+     *
+     * @param array $config
+     * @return array
+     * @since 4.16.17
+     */
+    public static function stripAttachKeys(array $config): array
+    {
+        $clean = [];
+        foreach ($config as $key => $value) {
+            if (is_string($key) && (str_starts_with($key, 'as ') || str_starts_with($key, 'on '))) {
+                continue;
+            }
+            $clean[$key] = is_array($value) ? static::stripAttachKeys($value) : $value;
+        }
+        return $clean;
+    }
+
