     /**
+     * Returns a fresh, cloned behavior to attach to a duplicated element.
+     *
+     * The duplication API is public, so a behavior spec may come from outside the application.
+     * An already-constructed behavior is safe to clone; a class name or config array would make
+     * Yii instantiate a caller-chosen class, so only the behaviors that Craft itself attaches
+     * while duplicating elements are accepted in config form.
+     *
+     * @param mixed $behavior
+     * @return Behavior
+     * @throws InvalidArgumentException if the behavior spec could instantiate a caller-chosen class
+     */
+    private function _requireDuplicateBehavior(mixed $behavior): Behavior
+    {
+        if ($behavior instanceof Behavior) {
+            return clone $behavior;
+        }
+
+        if (is_array($behavior)) {
+            // Don’t let the allowed behavior’s own config smuggle in another attachment.
+            $behavior = ComponentHelper::stripAttachKeys($behavior);
+            $class = $behavior['class'] ?? null;
+        } else {
+            $class = $behavior;
+        }
+
+        if (!in_array($class, [DraftBehavior::class, RevisionBehavior::class], true)) {
+            throw new InvalidArgumentException('Unsupported behavior configuration.');
+        }
+
+        $behavior = Craft::createObject($behavior);
+
+        if (!$behavior instanceof Behavior) {
+            throw new InvalidArgumentException('Unsupported behavior configuration.');
+        }
+
+        return clone $behavior;
+    }
