+    private function _duplicateBehavior(mixed $behavior): Behavior
+    {
+        if (is_string($behavior) || is_array($behavior)) {
+            $class = is_array($behavior) ? ($behavior['class'] ?? null) : $behavior;
+            if (!in_array($class, [DraftBehavior::class, RevisionBehavior::class], true)) {
