+     * Returns a cloned behavior instance for an element duplicate.
+     *
+     * @param mixed $behavior
+     * @return Behavior
+     * @throws InvalidArgumentException if the behavior config isn’t supported
+     */
+    private function _duplicateBehavior(mixed $behavior): Behavior
+    {
+        if (is_string($behavior) || is_array($behavior)) {
+            $class = is_array($behavior) ? ($behavior['class'] ?? null) : $behavior;
+            if (!in_array($class, [DraftBehavior::class, RevisionBehavior::class], true)) {
+                throw new InvalidArgumentException('Unsupported behavior configuration.');
+            }
+            $behavior = Craft::createObject($behavior);
+        }
+        if (!$behavior instanceof Behavior) {
+            throw new InvalidArgumentException('Invalid behavior configuration.');
+        }
+        return clone $behavior;
+    }
