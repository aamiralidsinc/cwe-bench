new file mode 100644
index 0000000..def2e86
--- /dev/null
+++ b/src/security/process-spawn.ts
@@ -0,0 +1,20 @@
+import {
+  spawn,
+  type SpawnOptions,
+  type ChildProcessWithoutNullStreams,
+} from "child_process";
+import { assertSafeArgv } from "./kubectl-flags.js";
+
+/**
+ * The spawn counterpart of execFileSyncSafe, for commands that stay alive
+ * (port forwarding) or stream their output. Tool modules import this as
+ * `spawn`, so the argv guard runs before every long-lived child is started.
+ */
+export function spawnSafe(
+  file: string,
+  args: string[],
+  options: SpawnOptions = {}
+): ChildProcessWithoutNullStreams {
+  assertSafeArgv(args);
+  return spawn(file, args, options) as ChildProcessWithoutNullStreams;
+}
