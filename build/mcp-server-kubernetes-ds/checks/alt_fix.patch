diff --git a/src/security/cluster-options.ts b/src/security/cluster-options.ts
new file mode 100644
index 0000000..79c1787
--- /dev/null
+++ b/src/security/cluster-options.ts
@@ -0,0 +1,126 @@
+import { McpError, ErrorCode } from "@modelcontextprotocol/sdk/types.js";
+import {
+  execFileSync,
+  spawn,
+  type ExecFileSyncOptionsWithStringEncoding,
+  type SpawnOptions,
+  type ChildProcessWithoutNullStreams,
+} from "child_process";
+
+// Options that select a target, install credentials, change what is trusted,
+// or act as another identity. They are refused wherever the option grammar of
+// the invoked tool would see them.
+const LONG_OPTIONS = new Set<string>([
+  "server",
+  "kubeconfig",
+  "cluster",
+  "user",
+  "tls-server-name",
+  "insecure-skip-tls-verify",
+  "certificate-authority",
+  "client-certificate",
+  "client-key",
+  "token",
+  "username",
+  "password",
+  "auth-provider",
+  "auth-provider-arg",
+  "exec-command",
+  "exec-arg",
+  "exec-api-version",
+  "exec-env",
+  "as",
+  "as-group",
+  "as-uid",
+  "kube-apiserver",
+  "kube-token",
+  "kube-ca-file",
+  "kube-as-user",
+  "kube-as-group",
+  "kube-tls-server-name",
+  "kube-insecure-skip-tls-verify",
+]);
+
+// Selecting an existing context is not a target redirect and every tool uses
+// it legitimately.
+const ALLOWED_LONG = new Set<string>(["context", "kube-context"]);
+
+const SHORT_DENIED = new Set<string>(["s"]);
+
+// Shorthands that swallow the remainder of the token as their value; the walk
+// of a shorthand cluster stops at the first of them.
+const SHORT_TAKES_VALUE = new Set<string>(["c", "k", "l", "L", "n", "o", "s", "v"]);
+
+function unsafeFlagsAllowed(): boolean {
+  return process.env.ALLOW_KUBECTL_UNSAFE_FLAGS === "true";
+}
+
+function fail(token: string): never {
+  throw new McpError(
+    ErrorCode.InvalidParams,
+    `Refusing to run a cluster command with "${token}": it would be read as ` +
+      `an option that changes the target, the credentials, what is trusted, ` +
+      `or the identity used. Set ALLOW_KUBECTL_UNSAFE_FLAGS=true to override.`
+  );
+}
+
+/** Every option name the invoked tool could read out of one argv token. */
+function optionsIn(token: string): string[] {
+  if (!token.startsWith("-") || token === "--") return [];
+
+  if (token.startsWith("--")) {
+    let name = token.slice(2);
+    const eq = name.indexOf("=");
+    if (eq !== -1) name = name.slice(0, eq);
+    return [name.toLowerCase().replace(/_/g, "-")];
+  }
+
+  const body = token.slice(1);
+  const out: string[] = [];
+  for (let i = 0; i < body.length; i++) {
+    const letter = body[i];
+    out.push("#" + letter);
+    if (body[i + 1] === "=") break;
+    if (SHORT_TAKES_VALUE.has(letter)) break;
+  }
+  return out;
+}
+
+/**
+ * Refuse a fully constructed argv whose tokens would be read as protected
+ * options. A bare "--" ends the option list: what a request asks to run in a
+ * workload starts there and is not part of this grammar.
+ */
+export function assertSafeArgv(args: readonly string[]): void {
+  if (unsafeFlagsAllowed()) return;
+
+  for (const token of args) {
+    if (typeof token !== "string") continue;
+    if (token === "--") break;
+    for (const option of optionsIn(token)) {
+      if (option.startsWith("#")) {
+        if (SHORT_DENIED.has(option.slice(1))) fail(token);
+      } else if (!ALLOWED_LONG.has(option) && LONG_OPTIONS.has(option)) {
+        fail(token);
+      }
+    }
+  }
+}
+
+export function execFileSyncSafe(
+  file: string,
+  args: string[],
+  options: ExecFileSyncOptionsWithStringEncoding
+): string {
+  assertSafeArgv(args);
+  return execFileSync(file, args, options) as string;
+}
+
+export function spawnSafe(
+  file: string,
+  args: string[],
+  options: SpawnOptions = {}
+): ChildProcessWithoutNullStreams {
+  assertSafeArgv(args);
+  return spawn(file, args, options) as ChildProcessWithoutNullStreams;
+}
