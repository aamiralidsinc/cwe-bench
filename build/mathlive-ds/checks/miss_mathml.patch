+/**
+ * Escape text that is emitted as the content of an HTML element.
+ * A box value is always interpolated between tags, never in an attribute,
+ * so escaping `&`, `<` and `>` keeps every character visible as text.
+ */
+function escapeText(s: string): string {
+  return s
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;');
+}
