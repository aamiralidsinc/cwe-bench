+    @staticmethod
+    def _destroy_content_tempfile(file_path):
+        """Overwrite a decrypted temporary file, then remove it.
+
+        Unlinking alone only drops one name for the data: anyone who opened or
+        linked the file still has the plaintext.  Overwrite the bytes through the
+        same inode first so every link sees destroyed content.
+        """
+        try:
+            with open(file_path, 'r+b') as f:
+                f.seek(0, os.SEEK_END)
+                remaining = f.tell()
+                f.seek(0)
+                block = b'\x00' * 4096
+                while remaining > 0:
+                    chunk = block[:min(remaining, len(block))]
+                    f.write(chunk)
+                    remaining -= len(chunk)
+                f.flush()
+                os.fsync(f.fileno())
+        except (IOError, OSError):
+            pass
+        try:
+            os.unlink(file_path)
+        except (IOError, OSError):
+            pass
+
