+
+
+/*!
+ * Reject server-side JavaScript operators in a populate match.
+ */
+
+function throwOnScript(match) {
+  if (match == null || typeof match !== 'object') {
+    return;
+  }
+  for (const key of Object.keys(match)) {
+    if (key === '$where') {
+      throw new MongooseError('Cannot use $where filter with populate() match');
+    }
+    if (key === '$function') {
+      throw new MongooseError('Cannot use $function filter with populate() match');
+    }
+    if (match[key] != null && typeof match[key] === 'object') {
+      throwOnScript(match[key]);
+    }
+  }
+}
