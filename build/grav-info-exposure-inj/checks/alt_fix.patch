diff --git a/system/src/Grav/Common/Twig/Sandbox/ContentValue.php b/system/src/Grav/Common/Twig/Sandbox/ContentValue.php
new file mode 100644
index 00000000..c4282949
--- /dev/null
+++ b/system/src/Grav/Common/Twig/Sandbox/ContentValue.php
@@ -0,0 +1,70 @@
+<?php
+
+/**
+ * @package    Grav\Common\Twig\Sandbox
+ *
+ * @copyright  Copyright (c) 2015 - 2026 Trilby Media, LLC. All rights reserved.
+ * @license    MIT License; see LICENSE file for details.
+ */
+
+namespace Grav\Common\Twig\Sandbox;
+
+use stdClass;
+
+/**
+ * Tracks whether editor-authored content is being rendered and redacts values
+ * that content hands to dump/serialize helpers, which read object state
+ * directly and so bypass the sandbox member checks.
+ */
+final class ContentValue
+{
+    /** @var int */
+    private static int $depth = 0;
+
+    public static function enter(): void
+    {
+        self::$depth++;
+    }
+
+    public static function leave(): void
+    {
+        self::$depth = max(0, self::$depth - 1);
+    }
+
+    public static function active(): bool
+    {
+        return self::$depth > 0;
+    }
+
+    /**
+     * Plain data (scalars, arrays, stdClass) passes through; the config facade
+     * becomes its redacted array; any other object becomes a placeholder.
+     */
+    public static function redact(mixed $value, int $level = 0): mixed
+    {
+        if ($level > 32) {
+            return null;
+        }
+        if (is_array($value)) {
+            foreach ($value as $key => $item) {
+                $value[$key] = self::redact($item, $level + 1);
+            }
+            return $value;
+        }
+        if (!is_object($value)) {
+            return $value;
+        }
+        if ($value instanceof SandboxConfig) {
+            return $value->toArray();
+        }
+        if ($value instanceof stdClass) {
+            $copy = new stdClass();
+            foreach (get_object_vars($value) as $key => $item) {
+                $copy->{$key} = self::redact($item, $level + 1);
+            }
+            return $copy;
+        }
+
+        return '[' . $value::class . ']';
+    }
+}
