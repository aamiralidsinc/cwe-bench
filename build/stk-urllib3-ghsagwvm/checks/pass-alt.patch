 log = logging.getLogger(__name__)
 
+CREDENTIAL_HEADERS = frozenset(['authorization', 'cookie'])
+
+
+def origin_of(url):
+    """The (scheme, host, port) a URL names, with the scheme's default port filled in."""
+    parts = parse_url(url)
+    if not parts.host:
+        return None
+    return get_host(url)
+
+
+def without_credentials(headers, source_url, target_url):
+    """Return *headers* without the credential names when the target leaves the origin."""
+    source = origin_of(source_url)
+    target = origin_of(target_url)
+    if source is None or target is None or source == target:
+        return headers
+    cleaned = dict(headers)
+    for name in list(cleaned):
+        if name.lower() in CREDENTIAL_HEADERS:
+            del cleaned[name]
+    return cleaned
+
