diff --git a/urllib3/util/redirect.py b/urllib3/util/redirect.py
new file mode 100644
index 00000000..8d747d2c
--- /dev/null
+++ b/urllib3/util/redirect.py
@@ -0,0 +1,65 @@
+from __future__ import absolute_import
+
+from ..packages.six.moves.urllib.parse import urljoin
+
+from .url import parse_url
+
+
+#: Request headers that carry the caller's credentials for one origin and
+#: therefore must not be replayed against another origin.
+DEFAULT_REMOVE_HEADERS_ON_REDIRECT = frozenset(['authorization', 'cookie'])
+
+#: Port implied by each scheme when the URL does not spell it out.
+DEFAULT_PORTS = {'http': 80, 'https': 443}
+
+
+def normalize_origin(scheme, host, port):
+    """Return a comparable ``(scheme, host, port)`` tuple for one origin.
+
+    The scheme and host are case-insensitive and an omitted port takes the
+    scheme's default, so ``HTTPS://Example.COM/`` and
+    ``https://example.com:443/`` name the same origin.
+    """
+    scheme = (scheme or 'http').lower()
+    if port is None:
+        port = DEFAULT_PORTS.get(scheme)
+    return (scheme, (host or '').lower(), port)
+
+
+def origin(url):
+    """Return the origin tuple of an absolute *url*, or ``None`` if it has no host."""
+    parts = parse_url(url)
+    if not parts.host:
+        return None
+    return normalize_origin(parts.scheme, parts.host, parts.port)
+
+
+def is_cross_origin(base_url, redirect_url, base_origin=None):
+    """Report whether *redirect_url* leaves the origin of *base_url*.
+
+    *redirect_url* is resolved against *base_url* first, so relative locations
+    stay on the same origin. When *base_url* is itself relative (a plain path
+    handed to a connection pool) *base_origin* supplies the origin it belongs
+    to.
+    """
+    resolved = urljoin(base_url, redirect_url)
+    source = origin(base_url) or base_origin
+    target = origin(resolved) or base_origin
+    return source != target
+
+
+def remove_credential_headers(headers, header_names=None):
+    """Drop the credential headers in *header_names* from *headers* in place.
+
+    Header names are matched case-insensitively. The caller must pass a dict it
+    owns: callers of the request methods often keep and reuse theirs.
+    """
+    if not headers:
+        return headers
+    if header_names is None:
+        header_names = DEFAULT_REMOVE_HEADERS_ON_REDIRECT
+    names = frozenset(name.lower() for name in header_names)
+    for name in list(headers.keys()):
+        if name.lower() in names:
+            headers.pop(name, None)
+    return headers
