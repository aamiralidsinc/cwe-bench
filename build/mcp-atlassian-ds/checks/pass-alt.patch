diff --git a/src/mcp_atlassian/utils/io.py b/src/mcp_atlassian/utils/io.py
index 4a6ae6b..59a738e 100644
--- a/src/mcp_atlassian/utils/io.py
+++ b/src/mcp_atlassian/utils/io.py
@@ -56,3 +56,20 @@ def validate_safe_path(
         )
 
     return resolved_path
+
+
+def confine_to_workspace(
+    path: "str | os.PathLike[str]",
+    base_dir: "str | os.PathLike[str] | None" = None,
+) -> Path:
+    """Return *path* resolved, requiring it to stay within *base_dir* (cwd).
+
+    Alternative implementation of the workspace confinement using real-path
+    normalisation and a separator-aware prefix comparison (so a sibling that
+    merely shares leading characters is not treated as contained).
+    """
+    base = os.path.realpath(os.getcwd() if base_dir is None else base_dir)
+    resolved = os.path.realpath(os.path.expanduser(os.fspath(path)))
+    if resolved != base and not resolved.startswith(base + os.sep):
+        raise ValueError(f"Path traversal detected: {path} resolves outside {base}")
+    return Path(resolved)
