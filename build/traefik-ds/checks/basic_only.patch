+// Package headeralias handles the header-name spellings that HTTP backends commonly read as one
+// name: letter case and the '_' versus '-' distinction (CGI, WSGI and PHP servers read both as
+// the same character). Whenever Traefik sets, replaces or removes a request header, the client
+// must not be able to supply the same header under an equivalent spelling.
+package headeralias
+
+import (
+	"net/http"
+	"regexp"
+	"strings"
+)
+
+// Normalize returns the name under which a backend reads a header name.
+func Normalize(name string) string {
+	return strings.ToLower(strings.ReplaceAll(name, "_", "-"))
+}
+
+// Spellings returns the forms of a header name against which an operator-configured pattern may
+// have been written: the received name, its dashed canonical form, its underscored canonical
+// form, and their lower-case variants.
+func Spellings(name string) []string {
+	dash := http.CanonicalHeaderKey(strings.ReplaceAll(name, "_", "-"))
+	underscore := strings.ReplaceAll(dash, "-", "_")
+
+	forms := []string{name, dash, underscore}
+	for _, form := range forms {
+		if lower := strings.ToLower(form); lower != form {
+			forms = append(forms, lower)
+		}
+	}
+
+	return forms
+}
+
+// MatchesPattern reports whether the pattern selects the header name, in any of the spellings a
+// backend could read as that name.
+func MatchesPattern(pattern *regexp.Regexp, name string) bool {
+	for _, form := range Spellings(name) {
+		if pattern.MatchString(form) {
+			return true
+		}
+	}
+
+	return false
+}
+
+// Delete removes from header every name which a backend could read as name.
+func Delete(header http.Header, name string) {
+	normalized := Normalize(name)
+	for key := range header {
+		if Normalize(key) == normalized {
+			delete(header, key)
+		}
+	}
+}
+
+// Set removes every spelling of name which a backend could read as that name, then sets it.
+func Set(header http.Header, name, value string) {
+	Delete(header, name)
+	header.Set(name, value)
+}
