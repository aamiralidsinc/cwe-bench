diff -ruN base/app/Helpers/SafeHttp.php control-variants/control_miss/app/Helpers/SafeHttp.php
--- a/app/Helpers/SafeHttp.php	1970-01-01 00:00:00.000000000 +0000
+++ b/app/Helpers/SafeHttp.php	2026-10-26 02:50:53.876533958 +0000
@@ -0,0 +1,57 @@
+<?php
+
+namespace App\Helpers;
+
+use App\Exceptions\UnsafeUrlException;
+use GuzzleHttp\Client;
+use GuzzleHttp\HandlerStack;
+use GuzzleHttp\Middleware;
+use Psr\Http\Message\RequestInterface;
+use Psr\Http\Message\ResponseInterface;
+use Psr\Http\Message\UriInterface;
+
+/**
+ * Defenses for outgoing HTTP requests: every request, and every redirect hop, must point at a
+ * public host. An attacker-controlled URL can pass an initial check and then redirect somewhere
+ * only the server can reach, so the decision is made again before each hop is requested.
+ */
+class SafeHttp
+{
+    /** @return array<string, mixed> */
+    public static function redirectOptions(int $max = 5): array
+    {
+        return [
+            'allow_redirects' => [
+                'max' => $max,
+                'on_redirect' => static function (
+                    RequestInterface $request,
+                    ResponseInterface $response,
+                    UriInterface $uri,
+                ): void {
+                    if (!Network::isSafeUrl((string) $uri)) {
+                        throw UnsafeUrlException::forUrl((string) $uri);
+                    }
+                },
+            ],
+        ];
+    }
+
+    public static function guzzleClient(int $timeoutInSeconds = 30): Client
+    {
+        $stack = HandlerStack::create();
+
+        $stack->push(Middleware::mapRequest(static function (RequestInterface $request): RequestInterface {
+            if (!Network::isSafeUrl((string) $request->getUri())) {
+                throw UnsafeUrlException::forUrl((string) $request->getUri());
+            }
+
+            return $request;
+        }));
+
+        return new Client([
+            'handler' => $stack,
+            'timeout' => $timeoutInSeconds,
+            ...self::redirectOptions(),
+        ]);
+    }
+}
