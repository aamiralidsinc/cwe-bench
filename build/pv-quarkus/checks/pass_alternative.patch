+package io.quarkus.vertx.http.runtime.security;
+
+import io.vertx.core.http.impl.HttpUtils;
+import io.vertx.core.net.impl.URIDecoder;
+
+/**
+ * Canonicalises request and rule paths so that both sides of a path-based decision are compared in
+ * the form the resource handlers resolve them to.
+ */
+public final class RequestPaths {
+
+    private static final int MAX_DECODE_ROUNDS = 10;
+
+    private RequestPaths() {
+    }
+
+    /**
+     * @param path a raw or partially decoded path
+     * @return the canonical path, or the input when it is {@code null} or empty
+     */
+    public static String canonical(String path) {
+        if (path == null || path.isEmpty()) {
+            return path;
+        }
+        String current = path;
+        for (int round = 0; round < MAX_DECODE_ROUNDS && current.indexOf('%') >= 0; round++) {
+            String decoded = URIDecoder.decodeURIComponent(current);
+            if (decoded == null || decoded.equals(current)) {
+                break;
+            }
+            current = decoded;
+        }
+        current = HttpSecurityUtils.pathWithoutMatrixParams(current);
+        if (current.indexOf('\0') >= 0) {
+            current = current.replace("\0", "");
+        }
+        if (current.indexOf('\\') >= 0) {
+            current = current.replace('\\', '/');
+        }
+        return HttpUtils.removeDots(current);
+    }
+}
