 from ...utils import get_nowtime
 
+#: Characters that change the structure of a Stata command line.  A value that
+#: carries one of them is data for the command the tool builds, never syntax.
+_DANGEROUS_TEXT = ('"', "\n", "\r", "\x00")
+
+
+def _reject_unsafe_text(value, field: str) -> None:
+    """Refuse a caller-supplied value that could break out of its command literal."""
+    text = str(value)
+    if not text:
+        raise ValueError(f"Invalid {field}: it must not be empty.")
+    if any(token in text for token in _DANGEROUS_TEXT) or any(
+        ord(character) < 32 or ord(character) == 127 for character in text
+    ):
+        raise ValueError(
+            f"Invalid {field}: it must not contain quotes, line breaks or control characters."
+        )
+
+
+def _validate_log_name(value) -> None:
+    text = str(value)
+    _reject_unsafe_text(text, "log_file_name")
+    if text in {".", ".."} or any(separator in text for separator in ("/", "\\")):
+        raise ValueError("Invalid log_file_name: it must be a file name inside the log directory.")
+    if any(part in {"", ".", ".."} for part in Path(text).parts):
+        raise ValueError("Invalid log_file_name: path traversal is not allowed.")
+
+
+def _validate_dofile_argument(value) -> None:
+    _reject_unsafe_text(value, "dofile_path")
+
 
