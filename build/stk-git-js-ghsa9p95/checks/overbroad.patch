diff -ruN a/simple-git/src/lib/plugins/block-unsafe-operations-plugin.ts overbroad/simple-git/src/lib/plugins/block-unsafe-operations-plugin.ts
--- a/simple-git/src/lib/plugins/block-unsafe-operations-plugin.ts	1970-01-01 00:00:00.000000000 +0000
+++ overbroad/simple-git/src/lib/plugins/block-unsafe-operations-plugin.ts	2026-10-26 02:20:05.206187382 +0000
@@ -0,0 +1,59 @@
+import type { SimpleGitPlugin } from './simple-git-plugin';
+
+import { GitPluginError } from '../errors/git-plugin-error';
+import type { SimpleGitPluginConfig } from '../types';
+
+const protocolPermission = /^\s*protocol(?:\.allow|\.[a-z0-9_-]+\.allow)\s*=/i;
+
+function isConfigSwitch(arg: string) {
+   return arg.trim() === '-c' || arg.trim() === '--config';
+}
+
+function isInlineConfigSwitch(arg: string) {
+   return /^\s*(?:-c|--config)\s*=/.test(arg);
+}
+
+function configuredValue(arg: string, next: string) {
+   const trimmed = arg.trim();
+
+   if (isConfigSwitch(trimmed)) {
+      return next;
+   }
+
+   if (isInlineConfigSwitch(trimmed)) {
+      return trimmed.slice(trimmed.indexOf('=') + 1);
+   }
+
+   if (/^-c\S/.test(trimmed)) {
+      return trimmed.slice(2);
+   }
+
+   return '';
+}
+
+export function blockUnsafeOperationsPlugin({
+   allowUnsafeProtocolOverride = false,
+}: SimpleGitPluginConfig['unsafe'] = {}): SimpleGitPlugin<'spawn.args'> {
+   return {
+      type: 'spawn.args',
+      action(args) {
+         args.forEach((current, index) => {
+            if (/ext::/.test(current)) {
+               throw new GitPluginError(undefined, 'unsafe', 'transport helper syntax is not permitted');
+            }
+
+            const value = configuredValue(current, index + 1 < args.length ? args[index + 1] : '');
+
+            if (value && protocolPermission.test(value) && !allowUnsafeProtocolOverride) {
+               throw new GitPluginError(
+                  undefined,
+                  'unsafe',
+                  'Configuring protocol permissions is not permitted without enabling allowUnsafeProtocolOverride',
+               );
+            }
+         });
+
+         return args;
+      },
+   };
+}
diff -ruN a/simple-git/src/lib/plugins/block-unsafe-pack-plugin.ts overbroad/simple-git/src/lib/plugins/block-unsafe-pack-plugin.ts
--- a/simple-git/src/lib/plugins/block-unsafe-pack-plugin.ts	1970-01-01 00:00:00.000000000 +0000
+++ overbroad/simple-git/src/lib/plugins/block-unsafe-pack-plugin.ts	2026-10-26 02:16:52.182363722 +0000
@@ -0,0 +1,30 @@
+import type { SimpleGitPlugin } from './simple-git-plugin';
+
+import { GitPluginError } from '../errors/git-plugin-error';
+
+function namesProgram(arg: string) {
+   return /^\s*--(?:upload|receive)-pack(?:=|$)/.test(arg);
+}
+
+function isCloneUploadShorthand(arg: string, method: string) {
+   return method === 'clone' && /^\s*-u(?:\s|$|=)/.test(arg);
+}
+
+export function blockUnsafePackPlugin(): SimpleGitPlugin<'spawn.args'> {
+   return {
+      type: 'spawn.args',
+      action(args, context) {
+         args.forEach((current) => {
+            if (namesProgram(current) || isCloneUploadShorthand(current, context.method)) {
+               throw new GitPluginError(
+                  undefined,
+                  'unsafe',
+                  'Use of a pack program option is not permitted',
+               );
+            }
+         });
+
+         return args;
+      },
+   };
+}
diff -ruN a/simple-git/src/lib/plugins/block-unsafe-remotes-plugin.ts overbroad/simple-git/src/lib/plugins/block-unsafe-remotes-plugin.ts
--- a/simple-git/src/lib/plugins/block-unsafe-remotes-plugin.ts	1970-01-01 00:00:00.000000000 +0000
+++ overbroad/simple-git/src/lib/plugins/block-unsafe-remotes-plugin.ts	2026-10-26 02:17:02.870353958 +0000
@@ -0,0 +1,37 @@
+import type { SimpleGitPlugin } from './simple-git-plugin';
+
+import { GitPluginError } from '../errors/git-plugin-error';
+import type { SimpleGitPluginConfig } from '../types';
+
+const helperAddress = /^\s*[a-z][a-z0-9+.-]*::/i;
+
+function isStoredAddress(args: string[], index: number) {
+   if (args[index] !== 'remote' || args[index + 1] !== 'add') {
+      return false;
+   }
+
+   return args.slice(index + 2).some((value) => helperAddress.test(value));
+}
+
+export function blockUnsafeRemotesPlugin({
+   allowUnsafeProtocolOverride = false,
+}: SimpleGitPluginConfig['unsafe'] = {}): SimpleGitPlugin<'spawn.args'> {
+   return {
+      type: 'spawn.args',
+      action(args) {
+         if (!allowUnsafeProtocolOverride) {
+            args.forEach((_current, index) => {
+               if (isStoredAddress(args, index)) {
+                  throw new GitPluginError(
+                     undefined,
+                     'unsafe',
+                     'Storing a transport helper address is not permitted without enabling allowUnsafeProtocolOverride',
+                  );
+               }
+            });
+         }
+
+         return args;
+      },
+   };
+}
