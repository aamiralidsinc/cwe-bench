diff -ruN a/simple-git/src/lib/plugins/guard-plugin.ts alt/simple-git/src/lib/plugins/guard-plugin.ts
--- a/simple-git/src/lib/plugins/guard-plugin.ts	1970-01-01 00:00:00.000000000 +0000
+++ alt/simple-git/src/lib/plugins/guard-plugin.ts	2026-10-26 02:20:12.662180571 +0000
@@ -0,0 +1,59 @@
+import type { SimpleGitPlugin } from './simple-git-plugin';
+
+import { GitPluginError } from '../errors/git-plugin-error';
+import type { SimpleGitPluginConfig } from '../types';
+
+const protocolPermission = /^\s*protocol(?:\.allow|\.[a-z0-9_-]+\.allow)\s*=/i;
+const helperAddress = /^\s*[a-z][a-z0-9+.-]*::/i;
+
+function configValue(arg: string, next: string) {
+   const trimmed = arg.trim();
+
+   if (trimmed === '-c' || trimmed === '--config') {
+      return next;
+   }
+
+   if (/^(?:-c|--config)\s*=/.test(trimmed)) {
+      return trimmed.slice(trimmed.indexOf('=') + 1);
+   }
+
+   if (/^-c\S/.test(trimmed)) {
+      return trimmed.slice(2);
+   }
+
+   return '';
+}
+
+function guard(args: string[], method: string, unsafe: SimpleGitPluginConfig['unsafe']) {
+   const allowed = !!(unsafe && unsafe.allowUnsafeProtocolOverride);
+
+   args.forEach((current, index) => {
+      if (/^\s*--(?:upload|receive)-pack(?:=|$)/.test(current) ||
+          (method === 'clone' && /^\s*-u(?:\s|$|=)/.test(current))) {
+         throw new GitPluginError(undefined, 'unsafe', 'pack program option is not permitted');
+      }
+
+      const value = configValue(current, index + 1 < args.length ? args[index + 1] : '');
+      if (!allowed && value && protocolPermission.test(value)) {
+         throw new GitPluginError(undefined, 'unsafe', 'protocol permission change is not permitted');
+      }
+   });
+
+   if (!allowed) {
+      const add = args.findIndex((value, index) =>
+         value === 'remote' && args[index + 1] === 'add');
+      if (add >= 0 && args.slice(add + 2).some((value) => helperAddress.test(value))) {
+         throw new GitPluginError(undefined, 'unsafe', 'storing a transport helper address is not permitted');
+      }
+   }
+}
+
+export function guardPlugin(unsafe: SimpleGitPluginConfig['unsafe']): SimpleGitPlugin<'spawn.args'> {
+   return {
+      type: 'spawn.args',
+      action(args, context) {
+         guard(args, context.method, unsafe);
+         return args;
+      },
+   };
+}
