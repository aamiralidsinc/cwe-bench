diff -ruN a/nltk/_pathguard.py b/nltk/_pathguard.py
--- a/nltk/_pathguard.py	1970-01-01 00:00:00.000000000 +0000
+++ b/nltk/_pathguard.py	2026-10-25 23:34:24.591255924 +0000
@@ -0,0 +1,69 @@
+# Natural Language Toolkit: containment helpers for resolved file names
+#
+# Copyright (C) 2001-2023 NLTK Project
+# URL: <https://www.nltk.org/>
+# For license information, see LICENSE.TXT
+#
+"""
+Keep a name that is joined onto a directory inside that directory.
+
+Both the data search path and the downloader take names that do not come from
+the caller -- an index entry, a resource name, a corpus file id -- and resolve
+them against a directory that *does* come from the caller.  These helpers apply
+one rule to every such join: after ``..`` segments and symbolic links are
+resolved, the result must lie at or below the root.  Any other result is
+reported as an ``EscapeError`` instead of being used.
+"""
+
+import os
+
+
+class EscapeError(ValueError):
+    """A name resolved to a location outside the root it was joined onto."""
+
+
+def _resolved(path):
+    return os.path.realpath(os.path.abspath(path))
+
+
+def is_inside(root, candidate):
+    """
+    Return True when ``candidate`` lies at or below ``root``.
+
+    Both arguments are made absolute and their symbolic links are resolved
+    first, so a link inside the root cannot be used to reach a file outside it.
+    """
+    root = _resolved(root)
+    candidate = _resolved(candidate)
+    try:
+        return os.path.commonpath([root, candidate]) == root
+    except ValueError:
+        # Different drives (Windows): no common location at all.
+        return False
+
+
+def join_inside(root, name, what="path"):
+    """
+    Join ``name`` onto ``root``, returning the resolved path.
+
+    :raise EscapeError: if ``name`` is absolute, holds a NUL byte, or the
+        joined path lies outside ``root``.
+    """
+    name = os.fspath(name)
+    if "\x00" in name:
+        raise EscapeError(f"{what} contains a NUL byte")
+    root = os.path.abspath(os.fspath(root))
+    joined = os.path.abspath(os.path.join(root, name))
+    if not is_inside(root, joined):
+        raise EscapeError(f"{what} {name!r} resolves outside {root!r}")
+    return joined
+
+
+def check_archive_members(zip_file, root, what="archive"):
+    """
+    Refuse an archive whose members would land outside ``root`` when unpacked.
+
+    :raise EscapeError: on the first member name that escapes ``root``.
+    """
+    for member in zip_file.infolist():
+        join_inside(root, member.filename, what=f"{what} member")
