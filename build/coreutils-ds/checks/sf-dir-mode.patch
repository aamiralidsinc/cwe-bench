+/// Find the deepest existing real directory ancestor of `path`.
+///
+/// Returns that ancestor and the components that still have to be created.
+/// `symlink_metadata` is used so an existing symbolic link is reported as a
+/// component to create rather than being followed.
+fn find_existing_ancestor(path: &Path) -> io::Result<(PathBuf, Vec<OsString>)> {
+    let mut current = path.to_path_buf();
+    let mut components: Vec<OsString> = Vec::new();
+
+    loop {
+        match fs::symlink_metadata(&current) {
+            Ok(meta) => {
+                if meta.is_dir() && !meta.file_type().is_symlink() {
+                    components.reverse();
+                    return Ok((current, components));
+                }
+                if let Some(file_name) = current.file_name() {
+                    components.push(file_name.to_os_string());
+                }
+            }
+            Err(e) if e.kind() == io::ErrorKind::NotFound => {
+                if let Some(file_name) = current.file_name() {
+                    components.push(file_name.to_os_string());
+                }
+            }
+            Err(e) => return Err(e),
+        }
+
+        match current.parent() {
+            Some(parent) if !parent.as_os_str().is_empty() => current = parent.to_path_buf(),
+            _ => {
+                let root = if path.is_absolute() {
+                    PathBuf::from("/")
+                } else {
+                    PathBuf::from(".")
+                };
+                components.reverse();
+                return Ok((root, components));
+            }
+        }
+    }
