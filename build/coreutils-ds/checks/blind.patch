+///
+/// Components that already exist are traversed as they are, so an existing
+/// directory reached through a symbolic link keeps working. Every component
+/// this function creates is created relative to an open descriptor of its
+/// parent and then reopened without following symbolic links, so a symbolic
+/// link standing where a missing directory has to be created makes the call
+/// fail instead of redirecting the creation to the link's target.
 pub fn create_dir_all_absolute(path: &Path) -> IOResult<()> {
