+
+/// Create all missing components of `path` without letting a symbolic link
+/// redirect a component that has to be created.
+///
+/// See [`create_dir_all_absolute`].
+#[cfg(all(unix, not(target_os = "redox")))]
+pub fn create_dir_all_nofollow(path: &Path) -> IOResult<()> {
+    use crate::features::safe_traversal::DirFd;
+
+    if path.as_os_str().is_empty() {
+        return Ok(());
+    }
+
+    let mut current = if path.is_absolute() {
+        DirFd::open(Path::new("/"))?
+    } else {
+        DirFd::open(Path::new("."))?
+    };
+
+    let comps: Vec<Component> = path.components().collect();
+    let last_normal = comps
+        .iter()
+        .rposition(|c| matches!(c, Component::Normal(_)));
+
+    // Set once we descend into a directory by following a symbolic link. A new
+    // directory must never be created inside such a directory, and a symbolic
+    // link must never stand where the final directory component is needed, so
+    // nothing is ever created, placed or redirected at a link's target.
+    let mut followed_link = false;
+
+    for (idx, component) in comps.iter().enumerate() {
+        let name = match component {
+            Component::RootDir | Component::CurDir | Component::Prefix(_) => continue,
+            Component::ParentDir => {
+                current = current.open_subdir(OsStr::new(".."))?;
+                followed_link = false;
+                continue;
+            }
+            Component::Normal(name) => *name,
+        };
+        let is_last = Some(idx) == last_normal;
+
+        match current.stat_at(name, false) {
+            Ok(st) => {
+                let is_symlink =
+                    (st.st_mode as libc::mode_t & libc::S_IFMT) == libc::S_IFLNK;
+                if is_symlink {
+                    // A symbolic link stands at a component we need as a
+                    // directory. If it is the final component the work (a
+                    // created directory, or the destination placed by the
+                    // caller) would happen at the link's target: refuse.
+                    // Otherwise it only leads to an already-existing location
+                    // deeper in the tree, so follow it but remember we did.
+                    if is_last {
+                        return Err(Error::from_raw_os_error(libc::ELOOP));
+                    }
+                    current = current.open_subdir(name)?;
+                    followed_link = true;
+                } else {
+                    // An existing real entry: open it without following a link
+                    // (a regular file here fails with ENOTDIR, as before).
+                    current = current.open_subdir_nofollow(name)?;
+                    followed_link = false;
+                }
+            }
+            Err(e) if e.kind() == ErrorKind::NotFound => {
+                // The component is missing and must be created. Refuse when its
+                // parent was reached by following a symbolic link.
+                if followed_link {
+                    return Err(Error::from_raw_os_error(libc::ELOOP));
+                }
+                let created = current.mkdir_at(name, 0o777);
+                match current.open_subdir_nofollow(name) {
+                    Ok(dir) => current = dir,
+                    Err(e) => return Err(created.err().unwrap_or(e)),
+                }
+                followed_link = false;
+            }
+            Err(e) => return Err(e),
+        }
+    }
+
+    Ok(())
+}
+
+/// Create all missing components of `path`.
+#[cfg(not(all(unix, not(target_os = "redox"))))]
+pub fn create_dir_all_nofollow(path: &Path) -> IOResult<()> {
+    fs::create_dir_all(path)
 }
 
