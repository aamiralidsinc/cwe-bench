+func DisallowPublicRequests(next echo.HandlerFunc) echo.HandlerFunc {
+	return func(ctx shared.Context) error {
+		if shared.IsPublicRequest(ctx) {
+			slog.Warn("access denied for public request")
+			return echo.NewHTTPError(404, "could not find resource")
+		}
+		return next(ctx)
+	}
+}
+
+func DisallowPublicChanges(next echo.HandlerFunc) echo.HandlerFunc {
+	return func(ctx shared.Context) error {
+		if shared.IsPublicRequest(ctx) && ctx.Request().Method != "GET" && ctx.Request().Method != "HEAD" {
+			slog.Warn("access denied for public change request")
+			return echo.NewHTTPError(404, "could not find resource")
+		}
+		return next(ctx)
+	}
+}
