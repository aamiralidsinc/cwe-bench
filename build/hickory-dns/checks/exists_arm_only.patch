diff --git a/crates/resolver/src/caching_client.rs b/crates/resolver/src/caching_client.rs
index 7c82359..60817e0 100644
--- a/crates/resolver/src/caching_client.rs
+++ b/crates/resolver/src/caching_client.rs
@@ -249,7 +249,19 @@ where
                 Ok(lookup) => client.cname(lookup, query),
                 Err(e) => client.cache(query, Err(e)),
             },
-            Ok(Records::Exists { message }) => client.cache(query, Ok(message)),
+            Ok(Records::Exists { message }) => {
+                // Refuse an answer whose records failed DNSSEC validation.
+                #[cfg(feature = "__dnssec")]
+                if is_dnssec
+                    && message
+                        .answers
+                        .iter()
+                        .any(|r| r.proof == crate::proto::dnssec::Proof::Bogus)
+                {
+                    return Err(NetError::Msg("DNSSEC validation failed: bogus answer".into()));
+                }
+                client.cache(query, Ok(message))
+            }
             Err(e) => client.cache(query, Err(e)),
         };
 
