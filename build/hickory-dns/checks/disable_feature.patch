diff --git a/crates/net/src/error.rs b/crates/net/src/error.rs
index a02a79083..1237de264 100644
--- a/crates/net/src/error.rs
+++ b/crates/net/src/error.rs
@@ -391,6 +391,9 @@ pub enum DnsError {
         /// DNSSEC proof of the record
         proof: Proof,
     },
+    /// DNSSEC validation failure
+    #[error("DNSSEC validation failed")]
+    DnssecBogus,
 }
 
 impl DnsError {
@@ -504,6 +507,7 @@ impl DnsError {
             Self::NoRecordsFound(_) => "dns_no_records",
             #[cfg(feature = "__dnssec")]
