diff --git a/crates/resolver/src/caching_client.rs b/crates/resolver/src/caching_client.rs
index 7c8235977..34c48cbc5 100644
--- a/crates/resolver/src/caching_client.rs
+++ b/crates/resolver/src/caching_client.rs
@@ -259,6 +259,23 @@ where
             .cache_miss_duration
             .record(request_start.elapsed());
 
+        // Reject any answer that is not fully DNSSEC-Secure.
+        #[cfg(feature = "__dnssec")]
+        let result = match result {
+            Ok(lookup) => {
+                use crate::proto::dnssec::DnssecSummary;
+                if !matches!(
+                    DnssecSummary::from_records(lookup.answers().iter()),
+                    DnssecSummary::Secure
+                ) {
+                    Err(NetError::Dns(DnsError::DnssecBogus))
+                } else {
+                    Ok(lookup)
+                }
+            }
+            Err(e) => Err(e),
+        };
+
         result
     }
 
