diff -ruN a/bbot/modules/apkpure.py b/bbot/modules/apkpure.py
--- a/bbot/modules/apkpure.py	2026-10-26 12:14:27.853868055 +0000
+++ b/bbot/modules/apkpure.py	2026-10-26 12:24:54.069274350 +0000
@@ -46,6 +46,13 @@
 
     async def download_apk(self, app_id):
         path = None
+        # app_id becomes a path component; refuse anything that could leave the output folder
+        if not app_id or app_id in (".", "..") or "/" in app_id or "\\" in app_id or ".." in app_id:
+            self.warning(f"Unsafe app_id, skipping: {app_id!r}")
+            return path
+        if Path(app_id).name != app_id:
+            self.warning(f"Unsafe app_id, skipping: {app_id!r}")
+            return path
         url = f"https://d.apkpure.com/b/XAPK/{app_id}?version=latest"
         self.helpers.mkdir(self.output_dir / app_id)
         response = await self.helpers.request(url, allow_redirects=True)
diff -ruN a/bbot/modules/postman_download.py b/bbot/modules/postman_download.py
--- a/bbot/modules/postman_download.py	2026-10-26 12:14:27.865868044 +0000
+++ b/bbot/modules/postman_download.py	2026-10-26 12:24:54.957273519 +0000
@@ -55,12 +55,24 @@
                     context=f"{{module}} downloaded postman workspace at {repo_url} to {{event.type}}: {workspace_path}",
                 )
 
+    @staticmethod
+    def _safe_name(name):
+        if not name or name in (".", "..") or "/" in name or "\\" in name:
+            return False
+        return Path(name).name == name
+
     def save_workspace(self, workspace, environments, collections):
         zip_path = None
         # Create a folder for the workspace
         name = workspace["name"]
         id = workspace["id"]
+        if not self._safe_name(name):
+            self.warning(f"Unsafe workspace name, skipping: {name!r}")
+            return None
         folder = self.output_dir / name
+        if not folder.resolve().is_relative_to(self.output_dir.resolve()):
+            self.warning(f"Unsafe workspace name, skipping: {name!r}")
+            return None
         self.helpers.mkdir(folder)
         zip_path = folder / f"{id}.zip"
 
