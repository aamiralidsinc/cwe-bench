+// supersededTokenGroupPrincipal reports whether a group principal persisted on a token
+// has been superseded by the user's live identity for the same provider. Membership must
+// come from the provider's current data, not from a copy stored when the token was issued.
+// Without the User we cannot confirm an identity for the provider, so the legacy
+// behaviour is kept rather than dropping a possibly legitimate group.
+func (m *userManager) supersededTokenGroupPrincipal(principal v3.Principal, userID string) bool {
+	providerName := principal.Provider
+	if providerName == "" || m.userCache == nil {
+		return false
+	}
+	user, err := m.userCache.Get(userID)
+	if err != nil || user == nil {
+		return false
+	}
+	prefix := providerName + "_user://"
+	if providerName == "local" {
+		prefix = "local://"
+	}
+	for _, id := range user.PrincipalIDs {
+		if strings.HasPrefix(id, prefix) {
+			return true
+		}
+	}
+	return false
+}
