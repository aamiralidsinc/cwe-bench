+// supersededTokenGroupPrincipal reports whether a group principal persisted on a token
+// has been superseded by the user's live identity for the same provider. For a provider
+// whose memberships can be refreshed, current membership is authoritative; a copy made
+// when the token was issued must not grant access. Unrefreshable providers keep the
+// legacy fallback because the stored attribute is their only record of membership.
+func supersededTokenGroupPrincipal(principal apiv3.Principal, authUser *apiv3.User) bool {
+	providerName := principal.Provider
+	if providerName == "" || authUser == nil || providers.UnrefreshableProviders[providerName] {
+		return false
+	}
+	return providerrefresh.GetPrincipalIDForProvider(providerName, authUser) != ""
+}
