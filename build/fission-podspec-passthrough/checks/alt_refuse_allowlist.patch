@@ -748,3 +764,64 @@ func (ml *MessageQueueTriggerList) Validate() error {
 	}
 	return errs
 }
+
+// allowedAddedCapabilities is the container runtime's default capability
+// set (minus DAC_OVERRIDE and NET_RAW): a tenant may re-add these after
+// dropping ALL, and nothing else.
+var allowedAddedCapabilities = map[string]bool{
+	"AUDIT_WRITE": true, "CHOWN": true, "FOWNER": true, "FSETID": true, "KILL": true, "MKNOD": true,
+	"NET_BIND_SERVICE": true, "SETFCAP": true, "SETGID": true, "SETPCAP": true, "SETUID": true, "SYS_CHROOT": true,
+}
+
+// ContainerPrivilegeProblems lists the settings of a tenant-supplied
+// container that would give it more than an ordinary unprivileged container.
+func ContainerPrivilegeProblems(c *apiv1.Container) []string {
+	if c == nil || c.SecurityContext == nil {
+		return nil
+	}
+	var out []string
+	sc := c.SecurityContext
+	if sc.Privileged != nil && *sc.Privileged {
+		out = append(out, c.Name+": privileged")
+	}
+	if sc.AllowPrivilegeEscalation != nil && *sc.AllowPrivilegeEscalation {
+		out = append(out, c.Name+": allowPrivilegeEscalation")
+	}
+	if sc.Capabilities != nil {
+		for _, cp := range sc.Capabilities.Add {
+			n := strings.TrimPrefix(strings.ToUpper(string(cp)), "CAP_")
+			if !allowedAddedCapabilities[n] {
+				out = append(out, c.Name+": capability "+n)
+			}
+		}
+	}
+	return out
+}
+
+// PodSpecPrivilegeProblems lists the pod-level and container-level settings
+// of a tenant-supplied pod spec that would reach the node or another
+// identity.
+func PodSpecPrivilegeProblems(ps *apiv1.PodSpec) []string {
+	if ps == nil {
+		return nil
+	}
+	var out []string
+	if ps.HostNetwork || ps.HostPID || ps.HostIPC {
+		out = append(out, "host namespaces")
+	}
+	if ps.ServiceAccountName != "" || ps.DeprecatedServiceAccount != "" {
+		out = append(out, "service account")
+	}
+	for _, v := range ps.Volumes {
+		if v.HostPath != nil {
+			out = append(out, "hostPath volume "+v.Name)
+		}
+	}
+	for i := range ps.Containers {
+		out = append(out, ContainerPrivilegeProblems(&ps.Containers[i])...)
+	}
+	for i := range ps.InitContainers {
+		out = append(out, ContainerPrivilegeProblems(&ps.InitContainers[i])...)
+	}
+	return out
+}
