@@ -293,6 +293,17 @@ func (spec FunctionSpec) Validate() error {
 		errs = errors.Join(errs, spec.InvokeStrategy.Validate())
 	}
 
+	if spec.PodSpec != nil && (spec.PodSpec.SecurityContext != nil || len(spec.PodSpec.Volumes) > 0 || len(spec.PodSpec.Containers) > 1 ||
+		spec.PodSpec.HostNetwork || spec.PodSpec.HostPID || spec.PodSpec.HostIPC || spec.PodSpec.ServiceAccountName != "" || spec.PodSpec.DeprecatedServiceAccount != "" || spec.PodSpec.NodeSelector != nil) {
+		errs = errors.Join(errs, errors.New("pod customisation is not allowed"))
