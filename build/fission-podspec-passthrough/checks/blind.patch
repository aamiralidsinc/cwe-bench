+
+// Tenant-supplied pod customisation (Environment.Spec.Runtime/Builder
+// PodSpec and Container, Function.Spec.PodSpec) is merged into pods the
+// Fission controllers create with the platform's service accounts. The
+// helpers below define which settings a tenant may never apply to those
+// pods: host namespaces, privileged / escalating containers, non-default
+// Linux capabilities, host filesystem mounts, host ports and a
+// tenant-chosen service account.
+//
+// ValidatePodSpecSecurity / ValidateContainerSecurity are used at admission
+// time. SanitizePodSpec / SanitizeContainer are the controller-side
+// defence for objects that were stored without passing admission; they
+// return a deep copy with every forbidden setting removed.
+
+// defaultCapabilities is the container runtime's default capability set.
+// Adding one of these is a no-op security-wise and stays allowed.
+var defaultCapabilities = map[string]struct{}{
+	"AUDIT_WRITE":      {},
+	"CHOWN":            {},
+	"DAC_OVERRIDE":     {},
+	"FOWNER":           {},
+	"FSETID":           {},
+	"KILL":             {},
+	"MKNOD":            {},
+	"NET_BIND_SERVICE": {},
+	"NET_RAW":          {},
+	"SETFCAP":          {},
+	"SETGID":           {},
+	"SETPCAP":          {},
+	"SETUID":           {},
+	"SYS_CHROOT":       {},
+}
+
+func isAllowedCapability(c apiv1.Capability) bool {
+	name := strings.ToUpper(strings.TrimSpace(string(c)))
+	name = strings.TrimPrefix(name, "CAP_")
+	_, ok := defaultCapabilities[name]
+	return ok
+}
+
+func forbiddenErr(field string, value any, reason string) error {
+	return MakeValidationErr(ErrorInvalidValue, field, value, reason)
+}
+
+// ValidatePodSpecSecurity rejects tenant-supplied pod spec settings that
+// would grant node- or cluster-level privileges to the resulting pod.
+func ValidatePodSpecSecurity(field string, ps *apiv1.PodSpec) error {
+	if ps == nil {
+		return nil
+	}
+	var errs error
+
+	if ps.HostNetwork {
+		errs = errors.Join(errs, forbiddenErr(field+".hostNetwork", true, "sharing the host network namespace is not allowed"))
+	}
+	if ps.HostPID {
+		errs = errors.Join(errs, forbiddenErr(field+".hostPID", true, "sharing the host PID namespace is not allowed"))
+	}
+	if ps.HostIPC {
+		errs = errors.Join(errs, forbiddenErr(field+".hostIPC", true, "sharing the host IPC namespace is not allowed"))
+	}
+	if ps.ServiceAccountName != "" {
+		errs = errors.Join(errs, forbiddenErr(field+".serviceAccountName", ps.ServiceAccountName, "selecting a service account is not allowed"))
+	}
+	if ps.DeprecatedServiceAccount != "" {
+		errs = errors.Join(errs, forbiddenErr(field+".serviceAccount", ps.DeprecatedServiceAccount, "selecting a service account is not allowed"))
+	}
+	if sc := ps.SecurityContext; sc != nil {
+		if sc.WindowsOptions != nil && sc.WindowsOptions.HostProcess != nil && *sc.WindowsOptions.HostProcess {
+			errs = errors.Join(errs, forbiddenErr(field+".securityContext.windowsOptions.hostProcess", true, "host process pods are not allowed"))
+		}
+	}
+	for i, v := range ps.Volumes {
+		if v.HostPath != nil {
+			errs = errors.Join(errs, forbiddenErr(fmt.Sprintf("%s.volumes[%d].hostPath", field, i), v.HostPath.Path, "host path volumes are not allowed"))
+		}
+	}
+	for i := range ps.Containers {
+		errs = errors.Join(errs, ValidateContainerSecurity(fmt.Sprintf("%s.containers[%d]", field, i), &ps.Containers[i]))
+	}
+	for i := range ps.InitContainers {
+		errs = errors.Join(errs, ValidateContainerSecurity(fmt.Sprintf("%s.initContainers[%d]", field, i), &ps.InitContainers[i]))
+	}
+	for i := range ps.EphemeralContainers {
+		c := apiv1.Container(ps.EphemeralContainers[i].EphemeralContainerCommon)
+		errs = errors.Join(errs, ValidateContainerSecurity(fmt.Sprintf("%s.ephemeralContainers[%d]", field, i), &c))
+	}
+	return errs
+}
+
+// ValidateContainerSecurity rejects tenant-supplied container settings that
+// would grant node-level privileges.
+func ValidateContainerSecurity(field string, c *apiv1.Container) error {
+	if c == nil {
+		return nil
+	}
+	var errs error
+	for i, p := range c.Ports {
+		if p.HostPort != 0 {
+			errs = errors.Join(errs, forbiddenErr(fmt.Sprintf("%s.ports[%d].hostPort", field, i), p.HostPort, "host ports are not allowed"))
+		}
+	}
+	sc := c.SecurityContext
+	if sc == nil {
+		return errs
+	}
+	if sc.Privileged != nil && *sc.Privileged {
+		errs = errors.Join(errs, forbiddenErr(field+".securityContext.privileged", true, "privileged containers are not allowed"))
+	}
+	if sc.AllowPrivilegeEscalation != nil && *sc.AllowPrivilegeEscalation {
+		errs = errors.Join(errs, forbiddenErr(field+".securityContext.allowPrivilegeEscalation", true, "privilege escalation is not allowed"))
+	}
+	if sc.Capabilities != nil {
+		for _, capability := range sc.Capabilities.Add {
+			if !isAllowedCapability(capability) {
+				errs = errors.Join(errs, forbiddenErr(field+".securityContext.capabilities.add", capability, "adding this capability is not allowed"))
+			}
+		}
+	}
+	if sc.ProcMount != nil && *sc.ProcMount == apiv1.UnmaskedProcMount {
+		errs = errors.Join(errs, forbiddenErr(field+".securityContext.procMount", *sc.ProcMount, "unmasked proc mount is not allowed"))
+	}
+	if sc.WindowsOptions != nil && sc.WindowsOptions.HostProcess != nil && *sc.WindowsOptions.HostProcess {
+		errs = errors.Join(errs, forbiddenErr(field+".securityContext.windowsOptions.hostProcess", true, "host process containers are not allowed"))
+	}
+	return errs
+}
+
+// SanitizePodSpec returns a deep copy of a tenant-supplied pod spec with
+// every setting rejected by ValidatePodSpecSecurity removed. Volume mounts
+// and devices referring to dropped host path volumes are removed as well.
+func SanitizePodSpec(ps *apiv1.PodSpec) *apiv1.PodSpec {
+	if ps == nil {
+		return nil
+	}
+	out := ps.DeepCopy()
+
+	out.HostNetwork = false
+	out.HostPID = false
+	out.HostIPC = false
+	out.ServiceAccountName = ""
+	out.DeprecatedServiceAccount = ""
+	if sc := out.SecurityContext; sc != nil && sc.WindowsOptions != nil && sc.WindowsOptions.HostProcess != nil {
+		sc.WindowsOptions.HostProcess = new(false)
+	}
+
+	dropped := make(map[string]struct{})
+	vols := out.Volumes[:0]
+	for _, v := range out.Volumes {
+		if v.HostPath != nil {
+			dropped[v.Name] = struct{}{}
+			continue
+		}
+		vols = append(vols, v)
+	}
+	out.Volumes = vols
+	if len(out.Volumes) == 0 {
+		out.Volumes = nil
+	}
+
+	for i := range out.Containers {
+		sanitizeContainerInPlace(&out.Containers[i], dropped)
+	}
+	for i := range out.InitContainers {
+		sanitizeContainerInPlace(&out.InitContainers[i], dropped)
+	}
+	for i := range out.EphemeralContainers {
+		c := apiv1.Container(out.EphemeralContainers[i].EphemeralContainerCommon)
+		sanitizeContainerInPlace(&c, dropped)
+		out.EphemeralContainers[i].EphemeralContainerCommon = apiv1.EphemeralContainerCommon(c)
+	}
+	return out
+}
+
+// SanitizeContainer returns a deep copy of a tenant-supplied container with
+// every setting rejected by ValidateContainerSecurity removed. Mounts named
+// in droppedVolumes (host path volumes removed by SanitizePodSpec) are
+// removed too.
+func SanitizeContainer(c *apiv1.Container, droppedVolumes map[string]struct{}) *apiv1.Container {
+	if c == nil {
+		return nil
+	}
+	out := c.DeepCopy()
+	sanitizeContainerInPlace(out, droppedVolumes)
+	return out
+}
+
+// HostPathVolumeNames returns the names of host path volumes in ps.
+func HostPathVolumeNames(ps *apiv1.PodSpec) map[string]struct{} {
+	names := make(map[string]struct{})
+	if ps == nil {
+		return names
+	}
+	for _, v := range ps.Volumes {
+		if v.HostPath != nil {
+			names[v.Name] = struct{}{}
+		}
+	}
+	return names
+}
+
+func sanitizeContainerInPlace(c *apiv1.Container, droppedVolumes map[string]struct{}) {
+	for i := range c.Ports {
+		c.Ports[i].HostPort = 0
+		c.Ports[i].HostIP = ""
+	}
+	if len(droppedVolumes) > 0 {
+		mounts := c.VolumeMounts[:0]
+		for _, m := range c.VolumeMounts {
+			if _, ok := droppedVolumes[m.Name]; ok {
+				continue
+			}
+			mounts = append(mounts, m)
+		}
+		c.VolumeMounts = mounts
+		if len(c.VolumeMounts) == 0 {
+			c.VolumeMounts = nil
+		}
+		devices := c.VolumeDevices[:0]
+		for _, d := range c.VolumeDevices {
+			if _, ok := droppedVolumes[d.Name]; ok {
+				continue
+			}
+			devices = append(devices, d)
+		}
+		c.VolumeDevices = devices
+		if len(c.VolumeDevices) == 0 {
+			c.VolumeDevices = nil
+		}
+	}
+	sc := c.SecurityContext
+	if sc == nil {
+		return
+	}
+	if sc.Privileged != nil && *sc.Privileged {
+		sc.Privileged = new(false)
+	}
+	if sc.AllowPrivilegeEscalation != nil && *sc.AllowPrivilegeEscalation {
+		sc.AllowPrivilegeEscalation = new(false)
+	}
+	if sc.Capabilities != nil && len(sc.Capabilities.Add) > 0 {
+		var add []apiv1.Capability
+		for _, capability := range sc.Capabilities.Add {
+			if isAllowedCapability(capability) {
+				add = append(add, capability)
+			}
+		}
+		sc.Capabilities.Add = add
+	}
+	if sc.ProcMount != nil && *sc.ProcMount == apiv1.UnmaskedProcMount {
+		sc.ProcMount = nil
+	}
+	if sc.WindowsOptions != nil && sc.WindowsOptions.HostProcess != nil && *sc.WindowsOptions.HostProcess {
+		sc.WindowsOptions.HostProcess = new(false)
+	}
+}
