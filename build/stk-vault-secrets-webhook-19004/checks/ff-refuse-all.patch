+// SameAddress reports whether two addresses denote the same endpoint, ignoring
+// case, a trailing slash and surrounding whitespace. An empty address never
+// matches: it is not a usable Vault endpoint.
+func SameAddress(a, b string) bool {
+	if strings.TrimSpace(a) == "" || strings.TrimSpace(b) == "" {
+		return false
+	}
+
+	return normalizeAddr(a) == normalizeAddr(b)
+}
