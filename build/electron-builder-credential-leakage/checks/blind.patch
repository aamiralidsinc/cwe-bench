+/**
+ * Removes every credential (credential headers in any spelling, basic auth, client certificates/keys) from the request options.
+ * Returns the names of the removed items.
+ */
+export function stripCredentials(options: RequestOptions): Array<string> {
+  const stripped: Array<string> = []
+  const headers = options.headers as RequestHeaders | undefined
+  if (headers != null) {
+    for (const name of Object.keys(headers)) {
+      if (isCredentialHeader(name, headers[name])) {
+        delete headers[name]
+        stripped.push(name)
+      }
+    }
+  }
+
+  const anyOptions = options as any
+  for (const name of ["auth", "username", "password", "key", "cert", "pfx", "passphrase"]) {
+    if (anyOptions[name] != null) {
+      delete anyOptions[name]
+      stripped.push(name)
+    }
+  }
+  return stripped
+}
