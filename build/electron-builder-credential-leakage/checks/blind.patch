+/**
+ * Returns true if the header (by name or by value) can carry credentials and must not be forwarded to another origin.
+ */
+export function isCredentialHeader(name: string, value?: any): boolean {
+  const lowerCaseName = name.toLowerCase()
+  if (lowerCaseName === "host" || SENSITIVE_HEADER_NAME_PATTERN.test(lowerCaseName)) {
+    return true
+  }
+  const values = Array.isArray(value) ? value : [value]
+  return values.some(it => typeof it === "string" && SENSITIVE_HEADER_VALUE_PATTERN.test(it))
+}
