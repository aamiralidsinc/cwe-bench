+  /**
+   * Creates a request that follows redirects itself (instead of letting Electron net follow them with the original headers),
+   * so that credentials are stripped on cross-origin redirects.
+   */
+  createRequestFollowingRedirects(
+    requestOptions: RequestOptions,
+    callback: (response: any) => void,
+    reject: (error: Error) => void,
+    onRedirect: ((redirectOptions: RequestOptions) => void) | null = null,
+    redirectCount = 0
+  ): any {
+    const options: RequestOptions = { ...requestOptions }
+    ;(options as any).redirect = "manual"
+    const request = this.httpExecutor.createRequest(options, callback)
+    request.on("redirect", (statusCode: number, method: string, redirectUrl: string) => {
+      // no way to modify request options, abort old and make a new one
+      request.abort()
+
+      if (redirectCount >= MAX_REDIRECTS) {
+        reject(new Error(`Too many redirects (> ${MAX_REDIRECTS})`))
