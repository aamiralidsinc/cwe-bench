+const SENSITIVE_HEADER_NAME_PATTERN = /auth|token|cookie|secret|passw|passphrase|key|credential|session|signature|jwt|csrf|xsrf|private|bearer/i
+const SENSITIVE_HEADER_VALUE_PATTERN = /^\s*(basic|bearer|token|digest|negotiate|ntlm|hoba|mutual|vapid|scram-sha-1|scram-sha-256|aws4-hmac-sha256)\s/i
