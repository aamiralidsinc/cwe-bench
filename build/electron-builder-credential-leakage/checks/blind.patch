+/**
+ * Removes credentials (userinfo and sensitive query parameter values) from an URL so that it can be safely used in error messages and logs.
+ */
+export function redactUrlForLog(url: string): string {
+  let result = url.replace(/^([a-z][a-z0-9+.-]*:\/\/)[^/?#@]*@/i, "$1<stripped>@")
+  const queryIndex = result.indexOf("?")
+  if (queryIndex < 0) {
+    return result
+  }
+  const hashIndex = result.indexOf("#", queryIndex)
+  const query = result.substring(queryIndex + 1, hashIndex < 0 ? undefined : hashIndex)
+  const redactedQuery = query
+    .split("&")
+    .map(part => {
+      const eqIndex = part.indexOf("=")
+      if (eqIndex < 0) {
+        return part
+      }
+      let name = part.substring(0, eqIndex)
+      try {
+        name = decodeURIComponent(name)
+      } catch {
+        // ignore
+      }
+      return SENSITIVE_QUERY_PARAM_PATTERN.test(name) ? `${part.substring(0, eqIndex)}=<stripped>` : part
+    })
+    .join("&")
+  result = result.substring(0, queryIndex + 1) + redactedQuery + (hashIndex < 0 ? "" : result.substring(hashIndex))
+  return result
+}
