+      this.logger.info(`Redirect to ${removeQuery(redirectUrl)}`)
+      const redirectOptions = HttpExecutor.prepareRedirectUrlOptions(redirectUrl, options)
+      if (onRedirect != null) {
+        onRedirect(redirectOptions)
+      }
+      const redirectRequest = this.createRequestFollowingRedirects(redirectOptions, callback, reject, onRedirect, redirectCount + 1)
+      this.httpExecutor.addErrorAndTimeoutHandlers(redirectRequest, reject)
+      redirectRequest.end()
+    })
+    return request
+  }
