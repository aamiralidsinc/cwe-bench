+  /**
+   * Is the specified path a location inside the repository into which Silverpeas stores the files
+   * of the components? The comparison is done on the canonical paths so that symbolic links or
+   * relative navigation cannot make a foreign location look like a stored one.
+   * @param path an absolute path.
+   * @return true if the path is located inside the upload repository, false otherwise.
+   */
+  private static boolean isInUploadRepository(final String path) {
+    if (path == null) {
+      return false;
+    }
+    try {
+      Path repository =
+          new File(FileRepositoryManager.getUploadPath()).getCanonicalFile().toPath();
+      Path file = new File(path).getCanonicalFile().toPath();
+      return file.startsWith(repository);
+    } catch (IOException e) {
+      return false;
+    }
+  }
