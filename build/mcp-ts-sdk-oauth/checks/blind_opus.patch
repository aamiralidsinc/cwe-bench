 /**
+ * The authorization-server identity a request built from `authorizationServerUrl` /
+ * `metadata` is addressed to. Mirrors the identity {@linkcode auth} stamps stored
+ * credentials with: the (RFC 8414 §3.3-validated) `metadata.issuer` whose endpoints
+ * the request uses, or the authorization-server URL itself when no metadata is in hand.
+ */
+function requestIssuer(authorizationServerUrl: string | URL, metadata: AuthorizationServerMetadata | undefined): string {
+    return metadata?.issuer ?? String(authorizationServerUrl);
+}
