+        if ($quote === null && ($char === '"' || $char === "'")) {
+            $quote = $char;
+            $clean .= $char;
+            continue;
+        }
+        if ($quote !== null && $char === $quote) {
+            $quote = null;
+            $clean .= $char;
+            continue;
+        }
+        if ($quote === null) {
+            if ($char === '>') {
+                break; // the caller appends its own log redirect
