+            continue;
+        }
+        $clean .= $char;
+    }
+    if ($quote !== null) {
+        _error_log("Sanitization failed: unbalanced quotes");
+        return '';
+    }
+    $command = $clean;
+
+    // Refuse to forward a command that still carries quoting: strip the quote characters so
