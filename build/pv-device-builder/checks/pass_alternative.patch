+def _resolve_pair(args: argparse.Namespace) -> tuple[str, str, bool]:
+    """Resolve the pair through flags, the current names, then the old pair."""
+    username = args.username or os.getenv("ESPHOME_USERNAME") or ""
+    password = args.password or os.getenv("ESPHOME_PASSWORD") or ""
+    legacy = False
+    if not username and not password and os.getenv("PASSWORD"):
+        username = os.getenv("USERNAME", "")
+        password = os.getenv("PASSWORD", "")
+        legacy = bool(username and password)
+    return username, password, legacy
