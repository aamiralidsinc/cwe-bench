 // ClusterNameRegex is the regex for validating cluster names (a-z0-9)
 const ClusterNameRegex = "^[a-z0-9]+$"
+
+// SafeClusterName reports whether name can be used as a single cluster
+// identifier. Names are kept to what Ceph accepts and may not reuse the base
+// names of the files the local cluster keeps for itself.
+func SafeClusterName(name string) error {
+	if len(name) == 0 || len(name) > 63 {
+		return fmt.Errorf("cluster names must be 1 to 63 characters")
+	}
+
+	for i := 0; i < len(name); i++ {
+		c := name[i]
+		if (c < 'a' || c > 'z') && (c < '0' || c > '9') {
+			return fmt.Errorf("cluster names can only have [a-z] or [0-9] characters")
+		}
+	}
+
+	switch name {
+	case "ceph", "ganesha", "radosgw":
+		return fmt.Errorf("cluster name %q is reserved", name)
+	}
+
+	return nil
+}
