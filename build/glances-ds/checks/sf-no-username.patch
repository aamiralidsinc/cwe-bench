-# Key name patterns redacted in any section
+# Key name patterns redacted in any section.
+# A login name is a credential too. The `user` pattern only matches a standalone
+# `user` or a name ending in `_user`, so the CPU/load `user_careful`,
+# `user_warning`... thresholds stay visible.
 _SECURE_SENSITIVE_KEY_RE = re.compile(
     r"password|token|secret|api_key|apikey|ssl_keyfile",
     re.IGNORECASE,
 )
 
+# Credentials embedded in an URL value (scheme://user:password@host)
+_SECURE_URL_CREDENTIALS_RE = re.compile(r"(?<=://)[^/?#@\s]+@")
+
+
+def secure_option(key, value):
+    """Return the sanitised value of a configuration option or a command line argument.
+
+    A sensitive key is fully redacted, otherwise only the credentials embedded in
+    an URL value are redacted. Non string values (boolean flags, ports, refresh
+    rates...) can not carry a credential and are returned as is.
+    """
+    if not isinstance(value, str):
+        return value
+    if _SECURE_SENSITIVE_KEY_RE.search(key):
+        return "********"
+    return _SECURE_URL_CREDENTIALS_RE.sub("********@", value)
+
+
+def secure_value(value):
+    """Return a copy of a value with URL credentials redacted, at any depth.
+
+    Values are reproduced as they are (numbers, booleans, None...), lists and
+    dictionaries are walked so a credential nested inside a structure is removed.
+    """
+    if isinstance(value, str):
+        return _SECURE_URL_CREDENTIALS_RE.sub("********@", value)
+    if isinstance(value, list):
+        return [secure_value(item) for item in value]
+    if isinstance(value, dict):
+        return {key: secure_value(item) for key, item in value.items()}
+    if isinstance(value, tuple):
+        return tuple(secure_value(item) for item in value)
+    return value
+
+
+def secure_mapping(values):
+    """Return a copy of a name/value mapping with credentials removed.
+
+    A sensitive name is fully redacted whatever the value type (some mappings store
+    the configuration as lists). Other values keep their type; URLs lose their
+    user information.
+    """
+    return {
+        key: "********"
+        if isinstance(key, str) and _SECURE_SENSITIVE_KEY_RE.search(key)
+        else secure_value(value)
+        for key, value in values.items()
+    }
+
 
