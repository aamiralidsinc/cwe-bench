+/**
+ * Path confinement helpers for snapshot file I/O.
+ * @module path-confinement
+ */
+
+import * as fs from 'node:fs';
+import * as path from 'node:path';
+
+/** True when `target` is `root` itself or lies below it. */
+export function isWithin(root: string, target: string): boolean {
+  const rel = path.relative(root, target);
+  return (
+    rel === '' ||
+    (rel !== '..' && !rel.startsWith(`..${path.sep}`) && !path.isAbsolute(rel))
+  );
+}
+
+/**
+ * Resolve the nearest existing ancestor so that links along the way are
+ * followed even when the final entry does not exist yet.
+ */
+function realPathLoose(target: string): string {
+  let probe = path.resolve(target);
+  const tail: string[] = [];
+  while (!fs.existsSync(probe)) {
+    const parent = path.dirname(probe);
+    if (parent === probe) break;
+    tail.unshift(path.basename(probe));
+    probe = parent;
+  }
+  try {
+    probe = fs.realpathSync(probe);
+  } catch {
+    return path.resolve(target);
+  }
+  return tail.length > 0 ? path.join(probe, ...tail) : probe;
+}
+
+/**
+ * Return `candidate` resolved against `root` when the result, after links are
+ * followed, stays inside `root`; otherwise return null.
+ */
+export function confineToRoot(root: string, candidate: string): string | null {
+  const absRoot = path.resolve(root);
+  const absTarget = path.resolve(absRoot, candidate);
+  if (!isWithin(absRoot, absTarget)) return null;
+  if (!isWithin(realPathLoose(absRoot), realPathLoose(absTarget))) return null;
+  return absTarget;
+}
