+function staysInside(root: string, target: string): boolean {
+  const rel = path.relative(root, target);
+  return rel === '' || (rel !== '..' && !rel.startsWith(`..${path.sep}`) && !path.isAbsolute(rel));
+}
+
+function realTarget(target: string): string {
+  const parts: string[] = [];
+  let current = path.resolve(target);
+  while (!fs.existsSync(current)) {
+    const parent = path.dirname(current);
+    if (parent === current) break;
+    parts.unshift(path.basename(current));
+    current = parent;
+  }
+  const real = fs.realpathSync(current);
+  return parts.length > 0 ? path.join(real, ...parts) : real;
+}
+
+function confine(root: string, candidate: string): string | null {
+  const absRoot = path.resolve(root);
+  const absTarget = path.resolve(absRoot, candidate);
+  if (!staysInside(absRoot, absTarget)) return null;
+  return staysInside(realTarget(absRoot), realTarget(absTarget)) ? absTarget : null;
+}
