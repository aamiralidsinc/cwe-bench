--- a/src/main/java/org/jenkinsci/plugins/github_branch_source/EndpointChoices.java	1970-01-01 00:00:00.000000000 +0000
+++ b/src/main/java/org/jenkinsci/plugins/github_branch_source/EndpointChoices.java	2026-10-26 05:38:38.739410716 +0000
@@ -0,0 +1,54 @@
+package org.jenkinsci.plugins.github_branch_source;
+
+import edu.umd.cs.findbugs.annotations.CheckForNull;
+import hudson.model.Item;
+import hudson.util.ListBoxModel;
+import jenkins.model.Jenkins;
+
+/**
+ * Supplies the GitHub endpoint choices for the plugin's descriptor form fills.
+ *
+ * <p>Registered GitHub Enterprise servers are internal infrastructure details. A form fill may
+ * name them only for a caller who administers the controller, when the fill is made outside any
+ * item, or for a caller who may configure the item the fill is made for. Every other caller gets a
+ * choice list without any registered server in it.
+ */
+final class EndpointChoices {
+
+    private EndpointChoices() {}
+
+    /**
+     * Returns whether the caller of a form fill may see the registered GitHub Enterprise servers.
+     *
+     * @param context the item the fill is made for, or {@code null} when it is made outside any
+     *     item
+     * @return {@code true} if the registered servers may be listed for this caller
+     */
+    static boolean mayListRegisteredServers(@CheckForNull Item context) {
+        return context == null
+                ? Jenkins.get().hasPermission(Jenkins.MANAGE)
+                : context.hasPermission(Item.CONFIGURE);
+    }
+
+    /**
+     * Builds the endpoint choice list for a form fill.
+     *
+     * @param context the item the fill is made for, or {@code null} when it is made outside any
+     *     item
+     * @return the choices, empty when the caller may not see the registered servers
+     */
+    static ListBoxModel forContext(@CheckForNull Item context) {
+        ListBoxModel items = new ListBoxModel();
+        if (!mayListRegisteredServers(context)) {
+            return items;
+        }
+        items.add("GitHub", "");
+        for (Endpoint endpoint : GitHubConfiguration.get().getEndpoints()) {
+            String name = endpoint.getName();
+            items.add(
+                    name == null ? endpoint.getApiUri() : name + " (" + endpoint.getApiUri() + ")",
+                    endpoint.getApiUri());
+        }
+        return items;
+    }
+}
