diff -ruN /home/mara/.tb-graders/cwe/work/flowise-cross-tenant-inj/base/packages/server/src/utils/workspaceCredential.ts /home/mara/.tb-graders/cwe/work/flowise-cross-tenant-inj/variant-run/blind/packages/server/src/utils/workspaceCredential.ts
--- a/packages/server/src/utils/workspaceCredential.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/packages/server/src/utils/workspaceCredential.ts	2026-10-20 02:48:25.258862330 +0000
@@ -0,0 +1,146 @@
+import { StatusCodes } from 'http-status-codes'
+import { DataSource } from 'typeorm'
+import { Credential } from '../database/entities/Credential'
+import { WorkspaceShared } from '../enterprise/database/entities/EnterpriseEntities'
+import { InternalFlowiseError } from '../errors/internalFlowiseError'
+import { getRunningExpressApp } from './getRunningExpressApp'
+
+/**
+ * Raised when a request references a credential the caller's workspace is not entitled to.
+ * Services should let it propagate as-is so the caller receives a client error.
+ */
+export class CredentialAccessError extends InternalFlowiseError {
+    constructor(credentialId?: string) {
+        super(StatusCodes.NOT_FOUND, `Credential ${credentialId} not found`)
+    }
+}
+
+/**
+ * Returns true when the credential belongs to the given workspace, or has been
+ * explicitly shared into it by its owning workspace.
+ */
+export const isCredentialAccessibleByWorkspace = async (
+    credential: Pick<Credential, 'id' | 'workspaceId'>,
+    workspaceId: string | undefined,
+    dataSource?: DataSource
+): Promise<boolean> => {
+    if (!credential || !workspaceId) return false
+    if (credential.workspaceId && credential.workspaceId === workspaceId) return true
+    const appDataSource = dataSource ?? getRunningExpressApp().AppDataSource
+    const shared = await appDataSource.getRepository(WorkspaceShared).count({
+        where: {
+            workspaceId: workspaceId,
+            sharedItemId: credential.id,
+            itemType: 'credential'
+        }
+    })
+    return shared > 0
+}
+
+/**
+ * Load a credential referenced by a request, only if the caller's workspace owns it
+ * or it has been shared into the caller's workspace. Returns null otherwise.
+ */
+export const findWorkspaceCredential = async (
+    credentialId: string | undefined,
+    workspaceId: string | undefined,
+    dataSource?: DataSource
+): Promise<Credential | null> => {
+    if (!credentialId || typeof credentialId !== 'string' || !workspaceId) return null
+    const appDataSource = dataSource ?? getRunningExpressApp().AppDataSource
+    const credential = await appDataSource.getRepository(Credential).findOneBy({ id: credentialId })
+    if (!credential) return null
+    if (!(await isCredentialAccessibleByWorkspace(credential, workspaceId, appDataSource))) return null
+    return credential
+}
+
+/**
+ * Throws a client error unless the credential exists and is accessible to the workspace.
+ */
+export const assertWorkspaceCredentialAccess = async (
+    credentialId: string | undefined,
+    workspaceId: string | undefined,
+    dataSource?: DataSource
+): Promise<Credential> => {
+    const credential = await findWorkspaceCredential(credentialId, workspaceId, dataSource)
+    if (!credential) {
+        throw new CredentialAccessError(credentialId)
+    }
+    return credential
+}
+
+/**
+ * Collect the credential references carried by a node-data-like object coming from a request
+ * (the `credential` field, and the `FLOWISE_CREDENTIAL_ID` input).
+ */
+export const getNodeDataCredentialIds = (nodeData: any): string[] => {
+    const ids: string[] = []
+    if (!nodeData || typeof nodeData !== 'object') return ids
+    if (nodeData.credential) ids.push(nodeData.credential)
+    const inputs = nodeData.inputs
+    if (inputs && typeof inputs === 'object' && inputs['FLOWISE_CREDENTIAL_ID']) ids.push(inputs['FLOWISE_CREDENTIAL_ID'])
+    return ids
+}
+
+/**
+ * Throws a client error if any credential referenced by the node data is not accessible to the workspace.
+ */
+export const assertNodeDataCredentialsAccess = async (nodeData: any, workspaceId: string | undefined, dataSource?: DataSource) => {
+    for (const credentialId of getNodeDataCredentialIds(nodeData)) {
+        await assertWorkspaceCredentialAccess(credentialId, workspaceId, dataSource)
+    }
+}
+
+/**
+ * Defense in depth for node execution: when the executing workspace is known (options.workspaceId),
+ * refuse to initialize a node whose referenced credential is neither owned by nor shared into it.
+ */
+export const assertNodeCredentialsForOptions = async (nodeData: any, options: { workspaceId?: string; appDataSource?: DataSource }) => {
+    if (!options?.workspaceId) return
+    await assertNodeDataCredentialsAccess(nodeData, options.workspaceId, options.appDataSource)
+}
+
+const CREDENTIAL_REFERENCE_KEYS = ['credential', 'credentialId', 'FLOWISE_CREDENTIAL_ID']
+
+/**
+ * Collect every credential reference found anywhere in a request payload (including
+ * JSON-encoded string fields, as sent by multipart/form-data API calls).
+ */
+export const collectCredentialReferences = (payload: any, found: Set<string> = new Set(), depth = 0): Set<string> => {
+    if (payload === null || payload === undefined || depth > 20) return found
+    if (typeof payload === 'string') {
+        const trimmed = payload.trim()
+        if ((trimmed.startsWith('{') && trimmed.endsWith('}')) || (trimmed.startsWith('[') && trimmed.endsWith(']'))) {
+            try {
+                collectCredentialReferences(JSON.parse(trimmed), found, depth + 1)
+            } catch {
+                // not JSON, ignore
+            }
+        }
+        return found
+    }
+    if (Array.isArray(payload)) {
+        for (const item of payload) collectCredentialReferences(item, found, depth + 1)
+        return found
+    }
+    if (typeof payload === 'object') {
+        for (const [key, value] of Object.entries(payload)) {
+            if (CREDENTIAL_REFERENCE_KEYS.includes(key) && value) {
+                if (typeof value === 'string') found.add(value)
+                else found.add(JSON.stringify(value))
+            } else {
+                collectCredentialReferences(value, found, depth + 1)
+            }
+        }
+    }
+    return found
+}
+
+/**
+ * Throws a client error if any credential referenced anywhere in the payload is not accessible to the workspace.
+ */
+export const assertPayloadCredentialsAccess = async (payload: any, workspaceId: string | undefined, dataSource?: DataSource) => {
+    for (const credentialId of collectCredentialReferences(payload)) {
+        await assertWorkspaceCredentialAccess(credentialId, workspaceId, dataSource)
+    }
+}
