 def allowed_mcp_tools() -> set[str] | None:
-    """Whitelist of MCP (deferred) tool names, ``None`` = unrestricted."""
+    """Whitelist of MCP (deferred) tool names.
+
+    ``None`` means unrestricted and is reserved for administrators. A
+    non-admin account that was not explicitly granted MCP tool names gets an
+    empty whitelist, so a turn can neither list nor load deployment-wide MCP
+    host tools.
+    """
     grant = _current_grant()
     if grant is None:
         return None
     value = grant.get("mcp_tools")
     if value is None:
-        return None
+        return set()
     return {str(name) for name in value}
 
 
