diff --git a/src/joserfc/_keys.py b/src/joserfc/_keys.py
index cdd313a..29a0d6c 100644
--- a/src/joserfc/_keys.py
+++ b/src/joserfc/_keys.py
@@ -173,7 +173,10 @@ class KeySet:
         for data in value["keys"]:
             if isinstance(data, (str, bytes)):
                 # a rotation list may also carry the raw secret values directly
-                keys.append(OctKey(to_bytes(data), data, parameters))
+                raw_secret = to_bytes(data)
+                if not raw_secret:
+                    raise ValueError("secret must not be empty")
+                keys.append(OctKey(raw_secret, data, parameters))
             else:
                 keys.append(cls.registry_cls.import_key(data, parameters=parameters))
 
diff --git a/src/joserfc/_rfc7518/oct_key.py b/src/joserfc/_rfc7518/oct_key.py
index 658590f..6c7f0a2 100644
--- a/src/joserfc/_rfc7518/oct_key.py
+++ b/src/joserfc/_rfc7518/oct_key.py
@@ -58,6 +58,8 @@ class OctKey(SymmetricKey):
         password: Any = None,
     ) -> "OctKey":
         key: OctKey = super(OctKey, cls).import_key(value, parameters, password)
+        if not key.raw_value:
+            raise ValueError("oct key material must not be empty")
         if len(key.raw_value) < 14:
             # https://csrc.nist.gov/publications/detail/sp/800-131a/rev-2/final
             warnings.warn("Key size should be >= 112 bits", SecurityWarning)
@@ -84,6 +86,9 @@ class OctKey(SymmetricKey):
         if key_size is None:
             key_size = 256
 
+        if key_size == 0:
+            raise ValueError("Invalid bit size for oct key")
+
         if key_size % 8 != 0:
             raise ValueError("Invalid bit size for oct key")
 
