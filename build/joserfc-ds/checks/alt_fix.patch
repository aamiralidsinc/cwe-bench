@@ -294,6 +294,22 @@ class BaseKey(t.Generic[NativePrivateKey, NativePublicKey], metaclass=ABCMeta):
 
 
 class SymmetricKey(BaseKey[bytes, bytes], metaclass=ABCMeta):
+    def __init__(
+        self,
+        raw_value: bytes,
+        original_value: t.Any,
+        parameters: KeyParameters | None = None,
+    ):
+        if not raw_value:
+            raise ValueError("symmetric key material must not be empty")
+        super().__init__(raw_value, original_value, parameters)
+
+    def get_op_key(self, operation: str) -> bytes:
+        op_key: bytes = super().get_op_key(operation)
+        if not op_key:
+            raise ValueError("symmetric key material must not be empty")
+        return op_key
+
     @property
     def raw_value(self) -> bytes:
         """The raw key in bytes."""
