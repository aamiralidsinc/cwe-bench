+/// Number of elements held by a tensor of the given shape.
+///
+/// `None` when the product of the dimensions does not fit a `usize`. A shape like that can not
+/// describe a tensor that exists in memory, whatever its datum type, so callers must refuse it
+/// instead of letting the product wrap around.
+pub fn checked_shape_product(shape: &[usize]) -> Option<usize> {
+    shape.iter().try_fold(1usize, |acc, &dim| acc.checked_mul(dim))
+}
+
+/// Byte size of a tensor with the given shape and datum type.
+///
+/// `None` when the element count or the consequent byte count overflows a `usize`. Skipping this
+/// check lets a declared shape wrap back to a small (or zero) allocation that the tensor then
+/// claims to fill.
+pub fn checked_shape_byte_len(shape: &[usize], dt: DatumType) -> Option<usize> {
+    checked_shape_product(shape)?.checked_mul(dt.size_of())
+}
