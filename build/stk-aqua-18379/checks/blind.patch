+// handleLink creates a link entry. The link target is checked before the link is
+// created: a symlink target is interpreted the way the operating system will
+// interpret it, relative to the directory that holds the link, while a hard link
+// target is a name relative to the install directory. A link that would point
+// outside the install directory is refused, because a later entry could otherwise
+// be written through it. Targets that do not exist yet are still accepted, as
+// packages legitimately ship dangling relative links.
+func (h *handler) handleLink(linkPath, linkTarget string, symlink bool) error {
+	target := h.normalizePath(linkTarget)
+	if symlink {
+		pointedAt := target
+		if !filepath.IsAbs(pointedAt) {
+			pointedAt = filepath.Join(filepath.Dir(linkPath), pointedAt)
+		}
+		if !confined(h.dest, pointedAt) {
+			return fmt.Errorf("%w: symlink %q -> %q", errOutsideDest, linkPath, linkTarget)
+		}
+		if err := os.Symlink(linkTarget, linkPath); err != nil {
+			slogerr.WithError(h.logger, err).Warn("create a symlink", "link_target", linkTarget, "link_dest", linkPath)
+		}
+		return nil
+	}
+	targetPath := filepath.Join(h.dest, target)
+	if !confined(h.dest, targetPath) {
+		return fmt.Errorf("%w: hard link %q -> %q", errOutsideDest, linkPath, linkTarget)
+	}
+	if err := os.Link(targetPath, linkPath); err != nil {
+		slogerr.WithError(h.logger, err).Warn("create a hard link", "link_target", linkTarget, "link_dest", linkPath)
+	}
+	return nil
+}
 
