+var errOutsideDest = errors.New("an archive entry points outside the install directory")
+
+// confined reports whether p stays within root once both are cleaned, so that a
+// directory whose name merely shares root's prefix (root-sibling) does not count
+// as being inside root.
+func confined(root, p string) bool {
+	rel, err := filepath.Rel(filepath.Clean(root), filepath.Clean(p))
+	if err != nil {
+		return false
+	}
+	if rel == "." {
+		return true
+	}
+	return rel != ".." && !strings.HasPrefix(rel, ".."+string(filepath.Separator))
+}
