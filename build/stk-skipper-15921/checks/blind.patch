+// readBodyPrefix reads at most limit leading bytes of body for the policy and
+// returns them together with a reader that still yields the complete body.
+//
+// Reading one byte beyond the limit is what tells a body that fills the prefix
+// exactly from one that continues past it: the policy sees the first limit
+// bytes, cut is false only when they are the whole body, and the extra byte
+// plus the rest of the body are handed back to the chain untouched.
+func readBodyPrefix(body io.ReadCloser, limit int) (prefix []byte, cut bool, rest io.ReadCloser) {
+	buf := make([]byte, limit+1)
+	n, _ := io.ReadFull(body, buf)
+
+	prefix = buf[:n]
+	if n > limit {
+		prefix = prefix[:limit]
+		cut = true
+	}
+
+	rest = io.NopCloser(io.MultiReader(bytes.NewReader(buf[:n]), body))
+	return
+}
