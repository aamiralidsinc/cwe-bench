@@ -0,0 +1,109 @@
+package openpolicyagent
+
+import (
+	"io"
+	"net/http"
+)
+
+// BodyExtraction is the outcome of reading a request body for an external
+// policy decision. The policy is shown Sample only, which may be just a leading
+// part of the client's body; Whole reports whether Sample is the entire body.
+// Reader always yields the complete body, so the rest of the filter chain and
+// the upstream still see every byte.
+type BodyExtraction struct {
+	Reader  io.ReadCloser
+	Sample  []byte
+	Whole   bool
+	Release func()
+}
+
+// ExtractRequestBody reads a request body for policy evaluation, bounded by the
+// configured maximum request body size, and reports whether the bytes returned
+// in Sample are the whole body or only a prefix of it. A caller that evaluates
+// the sample in a policy must pass Whole on, otherwise a body that was cut at
+// the maximum can be mistaken for a complete one.
+func (opa *OpenPolicyAgentInstance) ExtractRequestBody(req *http.Request) (BodyExtraction, error) {
+	if req.Body == nil || opa.EnvoyPluginConfig().SkipRequestBodyParse {
+		return BodyExtraction{Reader: req.Body, Whole: true, Release: func() {}}, nil
+	}
+
+	// A negative ContentLength means the length is unknown: Transfer-Encoding:
+	// chunked on HTTP/1.1, or no content-length header in HTTP/2 framing. Only
+	// the policy's maximum bounds the read then. Any other value is the length
+	// the framing promises, so it bounds the read too and OPA is not shown
+	// bytes the client never claimed to send.
+	expectedSize := req.ContentLength
+	if expectedSize < 0 {
+		expectedSize = opa.maxBodyBytes
+	}
+
+	wrapper := newBufferedBodyReader(req.Body, opa.maxBodyBytes, opa.bodyReadBufferSize)
+
+	requestedBodyBytes := bodyUpperBound(expectedSize, opa.maxBodyBytes)
+	if !opa.registry.maxMemoryBodyParsingSem.TryAcquire(requestedBodyBytes) {
+		return BodyExtraction{Reader: req.Body, Release: func() {}}, ErrTotalBodyBytesExceeded
+	}
+
+	sample, whole, err := wrapper.readCappedBody(expectedSize)
+	return BodyExtraction{
+		Reader:  wrapper,
+		Sample:  sample,
+		Whole:   whole,
+		Release: func() { opa.registry.maxMemoryBodyParsingSem.Release(requestedBodyBytes) },
+	}, err
+}
+
+// readCappedBody fills the reader's buffer from the client's body, reading no
+// further than the policy's maximum, and then decides whether the buffered
+// bytes are the whole body.
+//
+// The cap alone cannot answer that: a body of exactly the maximum fills the
+// buffer just like a larger one. When the cap is reached without seeing
+// end-of-stream, one further read settles it. Whatever that read yields stays
+// in the buffer, so Read returns it to the rest of the chain and the upstream
+// still receives the complete body.
+func (m *bufferedBodyReader) readCappedBody(expectedSize int64) ([]byte, bool, error) {
+	var atEnd bool
+
+	for int64(m.bodyBuffer.Len()) < m.maxBufferSize && int64(m.bodyBuffer.Len()) < expectedSize {
+		n, err := m.input.Read(m.readBuffer)
+		if n > 0 {
+			m.bodyBuffer.Write(m.readBuffer[:n])
+		}
+		if err == io.EOF {
+			atEnd = true
+			break
+		}
+		if err != nil {
+			return m.bodyBuffer.Bytes(), false, err
+		}
+	}
+
+	cut := false
+
+	if !atEnd && int64(m.bodyBuffer.Len()) >= m.maxBufferSize {
+		// The buffer is full at the cap but end-of-stream was not observed.
+		n, err := m.input.Read(m.readBuffer)
+		if n > 0 {
+			m.bodyBuffer.Write(m.readBuffer[:n])
+			cut = true
+		}
+		if err != nil && err != io.EOF {
+			return m.bodyBuffer.Bytes(), false, err
+		}
+		if n == 0 && err == nil {
+			// No progress and no end-of-stream: the body cannot be shown to
+			// be complete, so the policy must not be told that it is.
+			cut = true
+		}
+	}
+
+	sample := m.bodyBuffer.Bytes()
+	// The last read may overshoot the cap by up to one read-buffer length.
+	if int64(len(sample)) > m.maxBufferSize {
+		sample = sample[:m.maxBufferSize]
+		cut = true
+	}
+
+	return sample, !cut, nil
+}
