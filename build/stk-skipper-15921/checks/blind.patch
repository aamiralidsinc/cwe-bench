--- /dev/null
+++ b/filters/openpolicyagent/internal/envoy/bodycompleteness.go	2026-10-26 05:07:10.409140903 +0000
@@ -0,0 +1,33 @@
+package envoy
+
+import (
+	ext_authz_v3 "github.com/envoyproxy/go-control-plane/envoy/service/auth/v3"
+)
+
+// BodyCompletenessHeader carries the body-completeness value on an ext_authz
+// CheckRequest. The OPA Envoy plugin reads it from the request headers and
+// turns it into input.truncated_body, which is the only way a policy can tell a
+// body that was cut at the proxy's maximum from a complete one. Envoy uses the
+// same header name for the same purpose.
+const BodyCompletenessHeader = "x-envoy-auth-partial-body"
+
+// SetBodyCompleteness records on an already-built CheckRequest whether the body
+// it carries is the whole request body. It must be applied after the client's
+// headers have been copied, so the value describes what the proxy actually read
+// and a client cannot assert it.
+func SetBodyCompleteness(ereq *ext_authz_v3.CheckRequest, wholeBody bool) {
+	httpRequest := ereq.GetAttributes().GetRequest().GetHttp()
+	if httpRequest == nil {
+		return
+	}
+
+	if httpRequest.Headers == nil {
+		httpRequest.Headers = make(map[string]string, 1)
+	}
+
+	if wholeBody {
+		httpRequest.Headers[BodyCompletenessHeader] = "false"
+	} else {
+		httpRequest.Headers[BodyCompletenessHeader] = "true"
+	}
+}
