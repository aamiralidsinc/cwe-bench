--- a/internal/storage/contain.go	1970-01-01 00:00:00.000000000 +0000
+++ b/internal/storage/contain.go	2026-10-18 20:11:40.639686260 +0000
@@ -0,0 +1,83 @@
+package storage
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+// ContainedName reports whether name stays inside root once joined, without
+// using the shared path helper. Parent segments, absolute names and names that
+// leave through a symbolic link are rejected.
+func ContainedName(root, name string) (string, error) {
+	if strings.TrimSpace(name) == "" {
+		return "", fmt.Errorf("name is required")
+	}
+	if strings.IndexByte(name, 0) >= 0 {
+		return "", fmt.Errorf("name contains a NUL byte")
+	}
+	norm := strings.ReplaceAll(name, `\`, "/")
+	if !filepath.IsLocal(norm) {
+		return "", fmt.Errorf("name %q is not local", name)
+	}
+	rootAbs, err := filepath.Abs(root)
+	if err != nil {
+		return "", err
+	}
+	rootAbs = filepath.Clean(rootAbs)
+	candidate := filepath.Join(rootAbs, filepath.FromSlash(norm))
+	rel, err := filepath.Rel(rootAbs, candidate)
+	if err != nil || rel == ".." || strings.HasPrefix(rel, ".."+string(filepath.Separator)) {
+		return "", fmt.Errorf("name %q escapes its root", name)
+	}
+	probe := candidate
+	for {
+		if _, err := os.Lstat(probe); err == nil {
+			break
+		} else if !os.IsNotExist(err) {
+			return "", err
+		}
+		parent := filepath.Dir(probe)
+		if parent == probe {
+			return "", fmt.Errorf("name %q has no existing ancestor", name)
+		}
+		probe = parent
+	}
+	rootProbe := rootAbs
+	for {
+		if _, err := os.Lstat(rootProbe); err == nil {
+			break
+		} else if !os.IsNotExist(err) {
+			return "", err
+		}
+		parent := filepath.Dir(rootProbe)
+		if parent == rootProbe {
+			break
+		}
+		rootProbe = parent
+	}
+	resolvedRoot, err := filepath.EvalSymlinks(rootProbe)
+	if err != nil {
+		return "", err
+	}
+	rootTail, err := filepath.Rel(rootProbe, rootAbs)
+	if err != nil {
+		return "", err
+	}
+	resolvedRoot = filepath.Join(resolvedRoot, rootTail)
+	resolvedProbe, err := filepath.EvalSymlinks(probe)
+	if err != nil {
+		return "", err
+	}
+	rel2, err := filepath.Rel(probe, candidate)
+	if err != nil {
+		return "", err
+	}
+	resolved := filepath.Join(resolvedProbe, rel2)
+	rel3, err := filepath.Rel(resolvedRoot, resolved)
+	if err != nil || rel3 == ".." || strings.HasPrefix(rel3, ".."+string(filepath.Separator)) {
+		return "", fmt.Errorf("name %q escapes its root through a link", name)
+	}
+	return candidate, nil
+}
