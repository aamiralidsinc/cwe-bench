+// reservedMetadataNames are the entries of the git directory that are not
+// reference storage. A name that lands on one of them would let a caller
+// overwrite, read or remove repository metadata instead of a reference, so the
+// storage refuses it. The comparison is case-insensitive because a name can be
+// authored on one filesystem and opened on another that folds case.
+var reservedMetadataNames = []string{
+	configPath, configWorktreePath, indexPath, shallowPath, modulePath,
+	objectsPath, branchesPath, hooksPath, infoPath, remotesPath, logsPath,
+	worktreesPath, alternatesPath, packedRefsPath,
+	"commondir", "gitdir", "description",
+	"COMMIT_EDITMSG", "MERGE_MSG", "MERGE_MODE", "SQUASH_MSG", "TAG_EDITMSG",
+}
+
+// isReservedMetadataName reports whether a leading path component names an
+// entry of the git directory that does not hold references.
+func isReservedMetadataName(component string) bool {
+	for _, reserved := range reservedMetadataNames {
+		if strings.EqualFold(component, reserved) {
+			return true
+		}
+	}
+	return false
+}
+
+// validReferenceName rejects reference names that cannot safely be turned into
+// a path under the .git directory. A loose reference (and its reflog) is
+// stored verbatim at ".git/<name>", so a crafted name could otherwise climb out
+// of its reference sub-tree or land on unrelated repository metadata such as
+// .git/config, .git/hooks or .git/objects.
+//
+// Path traversal is refused component by component, including the disguises a
+// case-insensitive or Unicode-normalising filesystem would fold back to a dot.
+// A name whose first component is a metadata entry of the git directory is
+// refused as well, whatever its remaining components are.
+func validReferenceName(name plumbing.ReferenceName) error {
+	s := string(name)
+	if s == "" {
+		return fmt.Errorf("%w: empty name", ErrReferenceNameEscape)
+	}
+
+	for i := 0; i < len(s); i++ {
+		if s[i] < 0x20 || s[i] == 0x7f {
+			return fmt.Errorf("%w: %q", ErrReferenceNameEscape, s)
+		}
+	}
+
+	if filepath.VolumeName(s) != "" {
+		return fmt.Errorf("%w: %q", ErrReferenceNameEscape, s)
+	}
+
+	parts := strings.FieldsFunc(s, func(r rune) bool { return r == '/' || r == '\\' })
+	if len(parts) == 0 {
+		return fmt.Errorf("%w: %q", ErrReferenceNameEscape, s)
+	}
+	for _, part := range parts {
+		// IsNTFSDot/IsHFSDot with a "." needle match ".." and its disguises
+		// but not a bare ".", so reject that component explicitly too.
+		if part == "." || pathutil.IsHFSDot(part, ".") || pathutil.IsNTFSDot(part, ".", "") {
+			return fmt.Errorf("%w: %q", ErrReferenceNameEscape, s)
+		}
+	}
+
+	if isReservedMetadataName(parts[0]) {
+		return fmt.Errorf("%w: %q names repository metadata", ErrReferenceNameEscape, s)
+	}
+
+	return nil
+}
