+// authored on one filesystem and opened on another that folds case.
+var reservedMetadataNames = []string{
+	configPath, configWorktreePath, indexPath, shallowPath, modulePath,
+	objectsPath, branchesPath, hooksPath, infoPath, remotesPath, logsPath,
+	worktreesPath, alternatesPath, packedRefsPath,
+	"commondir", "gitdir", "description",
+	"COMMIT_EDITMSG", "MERGE_MSG", "MERGE_MODE", "SQUASH_MSG", "TAG_EDITMSG",
+}
+
+// isReservedMetadataName reports whether a leading path component names an
+// entry of the git directory that does not hold references.
+func isReservedMetadataName(component string) bool {
+	for _, reserved := range reservedMetadataNames {
+		if strings.EqualFold(component, reserved) {
+			return true
+		}
+	}
+	return false
