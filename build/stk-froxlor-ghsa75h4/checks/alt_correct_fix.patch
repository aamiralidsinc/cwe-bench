diff --git a/lib/Froxlor/FileDir.php b/lib/Froxlor/FileDir.php
index 41250b1d..4ce652bc 100644
--- a/lib/Froxlor/FileDir.php
+++ b/lib/Froxlor/FileDir.php
@@ -130,6 +130,45 @@ class FileDir
 		throw new Exception("Cannot validate directory in " . __FUNCTION__ . " which is very dangerous.");
 	}
 
+	/**
+	 * Resolve a path to the place it actually leads to: links are followed and a part that does
+	 * not exist yet is appended to the deepest ancestor that does.
+	 */
+	public static function resolvedLocation(string $path): string
+	{
+		$p = preg_replace('#/+#', '/', $path);
+		$suffix = [];
+		$guard = 0;
+		while (++$guard < 256) {
+			if (is_link($p)) {
+				$target = readlink($p);
+				if ($target === false) {
+					break;
+				}
+				$p = preg_replace('#/+#', '/', (substr($target, 0, 1) === '/') ? $target : dirname($p) . '/' . $target);
+				continue;
+			}
+			if ($p === '/' || file_exists($p)) {
+				break;
+			}
+			array_unshift($suffix, basename($p));
+			$p = dirname($p);
+		}
+		$real = realpath($p);
+		$base = rtrim(($real === false) ? $p : $real, '/');
+		return ($suffix === [] ? $base : $base . '/' . implode('/', $suffix));
+	}
+
+	/**
+	 * Whether $path leads to $home or to something below it.
+	 */
+	public static function leadsWithin(string $path, string $home): bool
+	{
+		$home = rtrim(self::makeCorrectDir($home), '/');
+		$resolved = self::resolvedLocation($path);
+		return $resolved === $home || substr($resolved, 0, strlen($home) + 1) === $home . '/';
+	}
+
