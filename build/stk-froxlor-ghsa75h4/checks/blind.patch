+namespace Froxlor;
+
+use Exception;
+
+/**
+ * Keeps paths that are built from customer supplied values inside the directory they belong to.
+ *
+ * The comparison is not made on the text of the path: every component that already exists is
+ * followed the way the operating system follows it, symbolic links included (and a link may
+ * point to another link). Components that do not exist yet cannot be links, so they are kept
+ * below the deepest component that does exist. Afterwards the fully resolved path is compared
+ * to the fully resolved base directory. A link inside the base directory may therefore point
+ * to another location inside it, but never outside of it.
+ */
+class PathGuard
+{
+	/**
+	 * Upper bound for link resolutions in a single path, so a link loop cannot spin forever.
+	 */
+	private const MAX_LINK_HOPS = 40;
+
+	/**
+	 * Resolve a path to the location it really leads to.
+	 *
+	 * @param string $path path to resolve
+	 *
+	 * @return string absolute path without trailing slash (except for the root itself)
+	 * @throws Exception when a link cannot be followed
+	 */
+	public static function resolve(string $path): string
+	{
+		clearstatcache(true);
+
+		// a NUL byte cannot be part of a filesystem name; do not let it truncate the check
+		$path = str_replace("\0", '', $path);
+		if ($path === '') {
+			return '/';
+		}
+
+		$parts = explode('/', $path);
+		$count = count($parts);
+		$position = 0;
+		$resolved = '';
+		$hops = 0;
+
+		while ($position < $count) {
+			$part = $parts[$position];
+			$position++;
+
+			if ($part === '' || $part === '.') {
+				continue;
+			}
+			if ($part === '..') {
+				$resolved = self::parentOf($resolved);
+				continue;
+			}
+
+			$candidate = $resolved . '/' . $part;
+			if (is_link($candidate)) {
+				if (++$hops > self::MAX_LINK_HOPS) {
+					throw new Exception("Too many symbolic links in path");
+				}
+				$target = @readlink($candidate);
+				if ($target === false || $target === '') {
+					throw new Exception("Cannot read symbolic link in path");
+				}
+				if (substr($target, 0, 1) === '/') {
+					// absolute target: continue from the filesystem root
+					$resolved = '';
+				}
+				// replay the target in front of the components that are still pending
+				$parts = array_merge(explode('/', $target), array_slice($parts, $position));
+				$count = count($parts);
+				$position = 0;
+				continue;
+			}
+			$resolved .= '/' . $part;
+		}
+
+		return $resolved === '' ? '/' : $resolved;
+	}
+
+	/**
+	 * Whether $path leads to $base or to something below it.
+	 *
+	 * A path that cannot be resolved (a link loop, an unreadable link) is never considered
+	 * to be within: refusing is the safe answer.
+	 *
+	 * @param string $path the path to test
+	 * @param string $base the directory the path has to stay in
+	 *
+	 * @return bool
+	 */
+	public static function isWithin(string $path, string $base): bool
+	{
+		try {
+			$base = rtrim(self::resolve($base), '/');
+			if ($base === '') {
+				// the filesystem root contains everything
+				return true;
+			}
+			$path = self::resolve($path);
+		} catch (Exception $e) {
+			return false;
+		}
+
+		return $path === $base || strpos($path, $base . '/') === 0;
+	}
+
+	/**
+	 * @param string $path
+	 *
+	 * @return string the parent of a resolved path ('' is the root)
+	 */
+	private static function parentOf(string $path): string
+	{
+		$slash = strrpos($path, '/');
+		if ($slash === false || $slash === 0) {
+			return '';
+		}
+		return substr($path, 0, $slash);
+	}
+}
