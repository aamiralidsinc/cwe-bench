+
+    /**
+     * Returns an SQL expression that compares a stored value exactly, character
+     * for character. MySQL/MariaDB compare character columns by collation, which
+     * can ignore case, accents or trailing spaces; the column charset can also
+     * differ between installations. Converting to a common character set and then
+     * to a binary string compares the characters themselves.
+     *
+     * @param string $db_type The type of database (e.g., "mysql", "sqlite", etc.)
+     * @param string $column The column reference to compare
+     * @return string The SQL expression
+     */
+    public static function exactIdentityColumn(string $db_type, string $column): string
+    {
+        return match ($db_type) {
+            'mysql', 'mysqli' => "CAST(CONVERT($column USING utf8mb4) AS BINARY)",
+            default => $column,
+        };
+    }
+
+    /**
+     * Returns the matching SQL expression for the parameter side of an exact
+     * identity comparison (see exactIdentityColumn()).
+     *
+     * @param string $db_type The type of database (e.g., "mysql", "sqlite", etc.)
+     * @return string The SQL expression, with one parameter placeholder
+     */
+    public static function exactIdentityValue(string $db_type): string
+    {
+        return match ($db_type) {
+            'mysql', 'mysqli' => 'CAST(CONVERT(? USING utf8mb4) AS BINARY)',
+            default => '?',
+        };
+    }
 }
