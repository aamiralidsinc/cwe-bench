diff -ruN a/agent/src/tools/path_utils.py b/agent/src/tools/path_utils.py
--- a/agent/src/tools/path_utils.py	2026-10-17 17:45:37.763307163 +0000
+++ b/agent/src/tools/path_utils.py	2026-10-17 17:47:26.835228566 +0000
@@ -16,7 +16,10 @@
 
 from __future__ import annotations
 
+import os
+import sys
 from pathlib import Path
+from typing import Any
 
 
 def _rejects_unc(p: str) -> None:
@@ -79,3 +82,136 @@
     raise ValueError(
         f"Path {p!r} is outside the user home directory and project directory"
     )
+
+
+# ---------------------------------------------------------------------------
+# Application file areas
+# ---------------------------------------------------------------------------
+#
+# Agent tools may only touch files inside these areas:
+#
+# * run storage — every run's workspace (read/write; the only place a tool
+#   may be told to work in or write into);
+# * the upload area — where ``POST /upload`` stores files (read-only);
+# * the bundled skill documentation (read-only);
+# * directories listed in ``VIBE_TRADING_ALLOWED_FILE_ROOTS`` (read-only).
+#
+# Every check resolves the candidate (following symlinks, collapsing ``..``)
+# and compares path components, so ``/runs_evil`` is not inside ``/runs``.
+
+
+AGENT_DIR = Path(__file__).resolve().parents[2]
+RUNS_DIR = AGENT_DIR / "runs"
+SWARM_RUNS_DIR = AGENT_DIR / ".swarm" / "runs"
+UPLOADS_DIR = AGENT_DIR / "uploads"
+SKILLS_DIR = Path(__file__).resolve().parents[1] / "skills"
+ALLOWED_ROOTS_ENV = "VIBE_TRADING_ALLOWED_FILE_ROOTS"
+
+
+def _module_attr_paths(attr: str, modules: tuple[str, ...]) -> list[Path]:
+    """Collect ``attr`` from already-imported modules (honours runtime overrides)."""
+    out: list[Path] = []
+    for name in modules:
+        mod = sys.modules.get(name)
+        value = getattr(mod, attr, None) if mod is not None else None
+        if value:
+            out.append(Path(value))
+    return out
+
+
+def _resolve_roots(paths: list[Path]) -> list[Path]:
+    roots: list[Path] = []
+    for p in paths:
+        try:
+            r = Path(p).expanduser().resolve()
+        except (OSError, RuntimeError):
+            continue
+        if r not in roots:
+            roots.append(r)
+    return roots
+
+
+def run_storage_roots() -> list[Path]:
+    """Directories that hold run workspaces."""
+    paths = [RUNS_DIR, SWARM_RUNS_DIR]
+    paths += _module_attr_paths("RUNS_DIR", ("src.agent.loop", "api_server", "cli"))
+    return _resolve_roots(paths)
+
+
+def upload_roots() -> list[Path]:
+    """Directories where uploaded files live."""
+    paths = [UPLOADS_DIR]
+    paths += _module_attr_paths("UPLOADS_DIR", ("api_server", "cli"))
+    return _resolve_roots(paths)
+
+
+def configured_roots() -> list[Path]:
+    """Operator-configured read roots from ``VIBE_TRADING_ALLOWED_FILE_ROOTS``."""
+    raw = os.environ.get(ALLOWED_ROOTS_ENV, "")
+    entries = [e.strip() for e in raw.split(",")]
+    return _resolve_roots([Path(e) for e in entries if e])
+
+
+def readable_roots() -> list[Path]:
+    """All areas a tool may read from."""
+    return _resolve_roots(
+        upload_roots() + run_storage_roots() + [SKILLS_DIR] + configured_roots()
+    )
+
+
+def _inside(path: Path, roots: list[Path]) -> bool:
+    return any(path == r or path.is_relative_to(r) for r in roots)
+
+
+def _candidates(p: str, base: str | Path | None) -> list[Path]:
+    """Resolve ``p`` (``~`` expanded); relative paths try ``base`` then CWD."""
+    raw = Path(p).expanduser()
+    if raw.is_absolute():
+        return [raw.resolve()]
+    out: list[Path] = []
+    if base:
+        out.append((Path(base).expanduser() / raw).resolve())
+    out.append((Path.cwd() / raw).resolve())
+    return out
+
+
+def _check(p: Any, roots: list[Path], base: str | Path | None, what: str) -> Path:
+    if not isinstance(p, (str, os.PathLike)) or not str(p).strip():
+        raise ValueError(f"Invalid {what} path: {p!r}")
+    p = str(p).strip()
+    if "\x00" in p:
+        raise ValueError(f"Invalid {what} path: {p!r}")
+    _rejects_unc(p)
+    candidates = _candidates(p, base)
+    allowed = [c for c in candidates if _inside(c, roots)]
+    for c in allowed:
+        if c.exists():
+            return c
+    if allowed:
+        return allowed[0]
+    raise ValueError(f"Path {p!r} is outside the allowed {what} areas")
+
+
+def safe_read_path(p: Any, base: str | Path | None = None) -> Path:
+    """Validate a path a tool wants to read.
+
+    Accepts files in the upload area, run storage, bundled skills and the
+    operator-configured roots. Relative paths are tried against ``base``
+    (typically the current run dir) and then the CWD.
+
+    Raises:
+        ValueError: If the resolved path lies outside every readable area.
+    """
+    return _check(p, readable_roots(), base, "file")
+
+
+def safe_run_path(p: Any, base: str | Path | None = None) -> Path:
+    """Validate a directory/file a tool will work in or write to.
+
+    Must resolve inside run storage. Relative paths are tried against
+    ``base`` (typically the current run dir) and then the CWD.
+
+    Raises:
+        ValueError: If the resolved path lies outside run storage.
+    """
+    return _check(p, run_storage_roots(), base, "run storage")
