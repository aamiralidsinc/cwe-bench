+    @staticmethod
+    def _destroy_tempfile(file_path):
+        """Overwrite a temporary file, then remove it, so its contents are not recoverable."""
+        try:
+            if os.path.isfile(file_path):
+                with open(file_path, 'r+b') as f:
+                    f.seek(0, os.SEEK_END)
+                    length = f.tell()
+                    f.seek(0)
+                    f.write(b'\x00' * length)
+                    f.flush()
+                    os.fsync(f.fileno())
+                os.unlink(file_path)
+        except OSError:
+            try:
+                os.unlink(file_path)
+            except OSError:
+                pass
