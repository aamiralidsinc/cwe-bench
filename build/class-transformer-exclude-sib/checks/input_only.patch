@@ -96,6 +96,23 @@ export class MetadataStorage {
   }
 
   getStrategy(target: Function): 'excludeAll' | 'exposeAll' | 'none' {
+    const strategy = this.getOwnStrategy(target);
+    if (strategy === 'excludeAll') return strategy;
+
+    // a class excluded as a whole (@Exclude() on the class) stays excluded in its subclasses
+    return strategy;
+  }
+
+  getInheritedStrategy(target: Function): 'excludeAll' | 'exposeAll' | 'none' {
+    const strategy = this.getStrategy(target);
+    if (strategy === 'excludeAll') return strategy;
+    for (const ancestor of this.getAncestors(target)) {
+      if (this.getOwnStrategy(ancestor) === 'excludeAll') return 'excludeAll';
+    }
+    return strategy;
+  }
+
+  private getOwnStrategy(target: Function): 'excludeAll' | 'exposeAll' | 'none' {
     const excludeMap = this._excludeMetadatas.get(target);
     const exclude = excludeMap && excludeMap.get(undefined);
     const exposeMap = this._exposeMetadatas.get(target);
