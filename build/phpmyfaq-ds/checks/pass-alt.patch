     /**
+     * Returns whether the given record may be shown to an ordinary visitor right now.
+     */
+    public function isPubliclyVisible(int $faqId): bool
+    {
+        $now = date(format: 'YmdHis');
+        $query = sprintf(
+            "SELECT fd.id FROM %sfaqdata fd WHERE fd.id = %d AND fd.lang = '%s'"
+            . " AND fd.active = 'yes' AND fd.date_start <= '%s' AND fd.date_end >= '%s'",
+            Database::getTablePrefix(),
+            $faqId,
+            $this->getEscapedCurrentLanguage(),
+            $now,
+            $now,
+        );
+
+        $result = $this->configuration->getDb()->query($query);
+
+        return false !== $result && $this->configuration->getDb()->numRows($result) > 0;
+    }
