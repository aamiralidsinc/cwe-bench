+namespace TYPO3\CMS\Form\Hooks;
+
+use Symfony\Component\DependencyInjection\Attribute\Autoconfigure;
+use TYPO3\CMS\Core\DataHandling\DataHandler;
+use TYPO3\CMS\Core\SysLog\Action\Database as SystemLogDatabaseAction;
+use TYPO3\CMS\Core\SysLog\Error as SystemLogErrorClassification;
+use TYPO3\CMS\Form\Storage\Security\FormDefinitionPersistenceScope;
+
+/**
+ * Denies record-layer access to form_definition unless the form repository is
+ * currently driving the record layer itself, after it validated and
+ * authorised the definition.
+ *
+ * @internal
+ */
+#[Autoconfigure(public: true)]
+final readonly class FormDefinitionDataHandlerHook
+{
+    public function __construct(
+        private FormDefinitionPersistenceScope $persistenceScope,
+    ) {}
+
+    public function processDatamap_preProcessFieldArray(
+        ?array &$incomingFieldArray,
+        string $table,
+        string|int $id,
+        DataHandler $dataHandler,
+    ): void {
+        if ($table !== 'form_definition' || $this->persistenceScope->isActive()) {
+            return;
+        }
+        $incomingFieldArray = null;
+        $dataHandler->log(
+            $table,
+            0,
+            SystemLogDatabaseAction::INSERT,
+            null,
+            SystemLogErrorClassification::USER_ERROR,
+            'Persisting form definition "%s" via DataHandler is denied',
+            null,
+            [$id],
+        );
+    }
+
+    public function processCmdmap(
+        string $command,
+        string $table,
+        int|string $id,
+        mixed $value,
+        bool &$commandIsProcessed,
+        DataHandler $dataHandler,
+    ): void {
+        if ($table !== 'form_definition' || $this->persistenceScope->isActive()) {
+            return;
+        }
+        $commandIsProcessed = true;
+        $dataHandler->log(
+            $table,
+            (int)$id,
+            SystemLogDatabaseAction::DELETE,
+            null,
+            SystemLogErrorClassification::USER_ERROR,
+            'Command "%s" on form definition "%s" via DataHandler is denied',
+            null,
+            [$command, $id],
+        );
+    }
+
+    /**
+     * @param array<string, mixed> $recordToDelete
+     */
+    public function processCmdmap_deleteAction(
+        string $table,
+        int $id,
+        array $recordToDelete,
+        bool &$recordWasDeleted,
+        DataHandler $dataHandler,
+    ): void {
+        if ($table !== 'form_definition' || $this->persistenceScope->isActive()) {
+            return;
+        }
+        $recordWasDeleted = true;
+        $dataHandler->log(
+            $table,
+            $id,
+            SystemLogDatabaseAction::DELETE,
+            null,
+            SystemLogErrorClassification::USER_ERROR,
+            'Deleting form definition "%s" via DataHandler is denied',
+            null,
+            [$id],
+        );
+    }
+}
