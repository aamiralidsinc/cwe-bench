+<?php
+
+declare(strict_types=1);
+
+/*
+ * This file is part of the TYPO3 CMS project.
+ *
+ * It is free software; you can redistribute it and/or modify it under
+ * the terms of the GNU General Public License, either version 2
+ * of the License, or any later version.
+ *
+ * For the full copyright and license information, please read the
+ * LICENSE.txt file that was distributed with this source code.
+ *
+ * The TYPO3 project - inspiring people to share!
+ */
+
+namespace TYPO3\CMS\Form\Storage\Security;
+
+/**
+ * Marks the short window in which the form repository itself drives the core
+ * record layer. Only form definitions written inside this scope come from the
+ * framework's validated persistence path.
+ *
+ * @internal
+ */
+final class FormDefinitionPersistenceScope
+{
+    private int $depth = 0;
+
+    public function enter(): void
+    {
+        $this->depth++;
+    }
+
+    public function leave(): void
+    {
+        if ($this->depth > 0) {
+            $this->depth--;
+        }
+    }
+
+    public function isActive(): bool
+    {
+        return $this->depth > 0;
+    }
+}
