+// AuthorizeProjectWrite decides whether the caller may perform the given action on a project
+func (ap *Platform) AuthorizeProjectWrite(ctx context.Context,
+	projectName string,
+	action opaclient.Action,
+	permissionOptions *opaclient.PermissionOptions,
+	authSession auth.Session) error {
+	if projectName == "" {
+		return nuclio.NewErrBadRequest("Project name cannot be empty")
+	}
+	options := *permissionOptions
+	if len(options.MemberIds) == 0 {
+		options.MemberIds = opa.GetUserAndGroupIdsFromAuthSession(authSession)
+	}
+	options.RaiseForbidden = true
+	if _, err := ap.QueryOPAProjectPermissions(ctx, projectName, action, &options); err != nil {
+		return errors.Wrap(err, "Failed to authorize project write")
+	}
+	return nil
+}
+
