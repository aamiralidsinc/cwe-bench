+// resolve returns the location of a plugin inside the plugin directory. The
+// name must be a plain relative path, and any symbolic link on the way to it
+// must stay inside the plugin directory.
+func (m *Manager) resolve(name string) (string, error) {
+	if strings.Contains(name, "../") {
+		return "", xerrors.Errorf("invalid plugin name %q", name)
+	}
+	return filepath.Join(m.pluginRoot, name), nil
+}
+
+// withinDir reports whether path stays inside dir once symbolic links that
+// already exist are resolved. Components that do not exist yet are allowed.
+func withinDir(dir, path string) error {
+	realDir, err := filepath.EvalSymlinks(dir)
+	if err != nil {
+		if errors.Is(err, fs.ErrNotExist) {
+			return nil
+		}
+		return xerrors.Errorf("failed to resolve %q: %w", dir, err)
+	}
+
+	existing, rest := path, []string(nil)
+	for {
+		_, err := os.Lstat(existing)
+		if err == nil {
+			break
+		}
+		if !errors.Is(err, fs.ErrNotExist) {
+			return xerrors.Errorf("failed to inspect %q: %w", existing, err)
+		}
+		parent := filepath.Dir(existing)
+		if parent == existing {
+			break
+		}
+		rest = append([]string{filepath.Base(existing)}, rest...)
+		existing = parent
+	}
+
+	realExisting, err := filepath.EvalSymlinks(existing)
+	if err != nil {
+		return xerrors.Errorf("failed to resolve %q: %w", existing, err)
+	}
+	resolved := filepath.Join(append([]string{realExisting}, rest...)...)
+	if resolved != realDir && !strings.HasPrefix(resolved, realDir+string(filepath.Separator)) {
+		return xerrors.Errorf("%q is outside the plugin directory", path)
+	}
+	return nil
+}
+
