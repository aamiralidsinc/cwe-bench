+// SPDX-License-Identifier: MIT
+// SPDX-FileCopyrightText: © 2015 LabStack LLC and Echo contributors
+
+// Package pathutil holds internal helpers for safely handling request and file paths.
+package pathutil
+
+import "net/http"
+
+// HasEncodedPathSeparator reports whether s contains a percent-encoded path separator,
+// case-insensitively: %2F/%2f (forward slash) or %5C/%5c (backslash). Backslash is included as
+// defense-in-depth against Windows-style separators even though fs.FS only uses forward slashes.
+func HasEncodedPathSeparator(s string) bool {
+	for i := 0; i+2 < len(s); i++ {
+		if s[i] != '%' {
+			continue
+		}
+		switch {
+		case s[i+1] == '2' && (s[i+2] == 'f' || s[i+2] == 'F'):
+			return true
+		case s[i+1] == '5' && (s[i+2] == 'c' || s[i+2] == 'C'):
+			return true
+		}
+	}
+	return false
+}
+
+// RequestHasEncodedPathSeparator reports whether the request's escaped path contains a
+// percent-encoded path separator. The router matches on this escaped form by default, so a
+// separator encoded here was not a segment boundary during routing and must not become one when
+// a file location is resolved from the request.
+func RequestHasEncodedPathSeparator(r *http.Request) bool {
+	if r == nil || r.URL == nil {
+		return false
+	}
+	return HasEncodedPathSeparator(r.URL.RawPath)
+}
