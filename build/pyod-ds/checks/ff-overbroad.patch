+    def load(cls, path, *, trusted=False):
         """Load the model from the specified path.
 
+        A pickled detector can execute code while it is being
+        deserialized, so the caller must pass ``trusted=True`` to
+        acknowledge that the file came from a trusted source.
+
         Parameters
         ----------
         path : str
             The path to load the model.
+        trusted : bool, default False
+            The caller's acknowledgement that the file came from a
+            trusted source. When False, the file is not opened.
 
         Returns
         -------
         model : BaseDeepLearningDetector
             The loaded model.
         """
+        if trusted is not True:
+            raise ValueError(
+                f"{cls.__name__}.load(): refusing to deserialize a "
+                "pickled detector whose source the caller has not "
+                "vouched for. Pass trusted=True only for files from a "
+                "trusted source.")
         with open(path, 'rb') as file:
             detector = pickle.load(file)
         return detector
