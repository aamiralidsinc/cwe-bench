+def open_vouched(path: Any, trusted: Any, api: str) -> Any:
+    """Return ``path`` for reading, or refuse before it is opened.
+
+    Every deserializing surface funnels through here, so the decision
+    is taken before any file is touched and there is one place to
+    audit.
+    """
+    if trusted is not True:
+        raise PermissionError(
+            f"{api}: the source of this artifact has not been vouched "
+            "for; pass trusted=True only for a trusted source.")
+    return path
+
