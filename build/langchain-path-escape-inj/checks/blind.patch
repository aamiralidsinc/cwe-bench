     """Virtual file system for memory tools."""
 
 
+def _has_parent_segment(path: str) -> bool:
+    """Return `True` if any path segment is exactly `..`.
+
+    Names that merely contain dots (e.g. `v1..2.txt`) are not traversal.
+    """
+    return any(segment == ".." for segment in path.replace("\\", "/").split("/"))
+
+
+def _is_within_prefix(path: str, prefix: str) -> bool:
+    """Return `True` if `path` is `prefix` itself or a genuine descendant of it.
+
+    A sibling that merely shares leading characters (e.g. `/memories_evil` for
+    the prefix `/memories`) is not within the prefix.
+    """
+    base = prefix.rstrip("/")
+    if not base:
+        # Prefix is the root, everything (absolute) is inside it
+        return path.startswith("/")
+    return path == base or path.startswith(base + "/")
+
+
