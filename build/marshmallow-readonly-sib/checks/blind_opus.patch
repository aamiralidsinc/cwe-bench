+def _unbound_field_copy(field: Field, memo: dict[int, Field] | None = None) -> Field:
+    """Return a copy of ``field`` (and of any fields it contains) that is not
+    bound to a schema and holds no cached nested schema, so that it can be
+    bound to another schema without affecting the original.
+    """
+    if memo is None:
+        memo = {}
+    if id(field) in memo:
+        return memo[id(field)]
+    new = copy.copy(field)
+    memo[id(field)] = new
+    new.parent = None
+    new.name = None
+    new.root = None
+    if isinstance(new, Nested):
+        new._schema = None
+    for attr, value in list(vars(new).items()):
+        if attr in ("parent", "root"):
+            continue
+        if isinstance(value, Field):
+            setattr(new, attr, _unbound_field_copy(value, memo))
+        elif isinstance(value, (list, tuple)) and any(
+            isinstance(each, Field) for each in value
+        ):
+            setattr(
+                new,
+                attr,
+                type(value)(
+                    _unbound_field_copy(each, memo) if isinstance(each, Field) else each
+                    for each in value
+                ),
+            )
+    return new
+
+
 class Raw(Field[typing.Any]):
     """Field that applies no formatting."""
 
