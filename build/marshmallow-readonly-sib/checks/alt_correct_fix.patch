+                load_only = self._nested_normalized_option("load_only")
+                dump_only = self._nested_normalized_option("dump_only")
+                restricted = {}
+                for flag, names in (("load_only", load_only), ("dump_only", dump_only)):
+                    for name in names:
+                        head = name.split(".", 1)[0]
+                        original_field = self._schema.declared_fields.get(head)
+                        if original_field is None:
+                            continue
+                        new_field = restricted.get(head) or _detached(original_field)
+                        if head == name:
+                            setattr(new_field, flag, True)
+                        restricted[head] = new_field
+                if restricted:
+                    self._schema.declared_fields = {
+                        **self._schema.declared_fields,
