@@ -477,6 +477,21 @@
     """Field that applies no formatting."""
 
 
+def _detached(field: Field) -> Field:
+    """Copy ``field`` and every field it holds, forgetting where they were bound."""
+    clone = copy.copy(field)
+    for attr, value in list(vars(clone).items()):
+        if attr in ("parent", "root"):
+            setattr(clone, attr, None)
+        elif attr == "_schema":
+            setattr(clone, attr, None)
+        elif isinstance(value, Field):
+            setattr(clone, attr, _detached(value))
+        elif isinstance(value, list) and value and all(isinstance(v, Field) for v in value):
+            setattr(clone, attr, [_detached(v) for v in value])
+    return clone
+
+
 class Nested(Field):
     """Allows you to nest a :class:`Schema <marshmallow.Schema>`
     inside a field.
