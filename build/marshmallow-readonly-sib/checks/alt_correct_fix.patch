+                    }
+                    # deeper names are read from this schema by the nested fields
+                    self._schema.load_only = set_class(self._schema.load_only) | set_class(
+                        n for n in load_only if "." in n
+                    )
+                    self._schema.dump_only = set_class(self._schema.dump_only) | set_class(
+                        n for n in dump_only if "." in n
