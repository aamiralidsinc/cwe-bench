     """Field that applies no formatting."""
 
 
+def _unbound_copy(field: Field) -> Field:
+    """Return a copy of a field, and of the fields it contains, that is not
+    bound to any schema, so that it can be bound to another one."""
+    new = copy.copy(field)
+    new.parent = None
+    new.root = None
+    if isinstance(new, Nested):
+        new._schema = None
+    if isinstance(new, List):
+        new.inner = _unbound_copy(new.inner)
+    if isinstance(new, Tuple):
+        new.tuple_fields = [_unbound_copy(f) for f in new.tuple_fields]
+    if isinstance(new, Mapping):
+        if new.key_field is not None:
+            new.key_field = _unbound_copy(new.key_field)
+        if new.value_field is not None:
+            new.value_field = _unbound_copy(new.value_field)
+    return new
+
+
 class Nested(Field):
     """Allows you to nest a :class:`Schema <marshmallow.Schema>`
     inside a field.
