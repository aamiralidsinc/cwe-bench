+def _validate_output_extension(ext):
+    """Refuse an extension that the desktop treats as a launcher/shortcut when it is about to
+    become a file's own suffix."""
+    if ext is None:
+        return
+    value = str(ext).rstrip(' .')
+    if value.rpartition('.')[2].lower() in LINK_TEMPLATES:
+        raise _UnsafeExtensionError(ext)
+    if any(ch in value for ch in ('/', '\\', '\0')):
+        raise _UnsafeExtensionError(ext)
+
