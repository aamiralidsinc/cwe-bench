+def _partial_pipeline_external_resume_fields(partial: PartialMixin) -> tuple[str, ...]:
+    fields = partial.data.get(PARTIAL_PIPELINE_EXTERNAL_RESUME_FIELDS) or ()
+    return tuple(field for field in fields if isinstance(field, str) and field)
+
+
+def _partial_pipeline_external_resume_allowed(
+    partial: PartialMixin, request_data: dict[str, Any]
+) -> bool:
+    """A stored flow may be completed elsewhere only when that flow itself
+    recorded the request fields that carry its out-of-band proof, and every
+    one of them is present in the current request."""
+    fields = _partial_pipeline_external_resume_fields(partial)
+    if not fields:
+        return False
+    return all(request_data.get(field) not in (None, "") for field in fields)
+
+
+def _approve_partial_pipeline_resume(strategy: BaseStrategy, token: str) -> None:
+    approved = getattr(strategy, "_partial_pipeline_resume_approved", None)
+    if approved is None:
+        approved = set()
+        setattr(strategy, "_partial_pipeline_resume_approved", approved)
+    approved.add(token)
+
+
+def partial_pipeline_resume_owned(strategy: BaseStrategy, partial: PartialMixin) -> bool:
+    """True when this request may continue the stored flow: the flow was
+    started by this session, or its completion was explicitly approved for
+    this request after checking the flow's recorded out-of-band proof."""
+    session_token = strategy.session_get(PARTIAL_TOKEN_SESSION_NAME, None)
+    if session_token and session_token == partial.token:
+        return True
+    approved = getattr(strategy, "_partial_pipeline_resume_approved", None) or set()
+    return partial.token in approved
+
+
+def consume_partial_pipeline_resume(strategy: BaseStrategy, partial: PartialMixin) -> None:
+    approved = getattr(strategy, "_partial_pipeline_resume_approved", None)
+    if approved is not None:
+        approved.discard(partial.token)
+
