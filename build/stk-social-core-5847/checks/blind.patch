+def _recorded_external_resume_fields(partial: PartialMixin) -> tuple[str, ...]:
+    recorded = partial.data.get(PARTIAL_PIPELINE_EXTERNAL_RESUME_FIELDS)
+    if not isinstance(recorded, (list, tuple)):
+        return ()
+    return tuple(field for field in recorded if isinstance(field, str) and field)
+
+
+def partial_pipeline_resume_allowed(
+    strategy: BaseStrategy,
+    partial: PartialMixin,
+    request_data: dict[str, Any] | None = None,
+) -> bool:
+    """Whether the current request may continue the given stored flow.
+
+    A session may always continue the flow whose token it recorded. Any other
+    flow may be continued only when the flow itself was stored with an
+    out-of-band completion and the request carries every recorded proof field;
+    a field is never trusted just because the request happened to supply it.
+    """
+    session_token = strategy.session_get(PARTIAL_TOKEN_SESSION_NAME, None)
+    if session_token and session_token == partial.token:
+        return True
+
+    proof_fields = _recorded_external_resume_fields(partial)
+    if not proof_fields:
+        return False
+
+    if request_data is None:
+        request_data = strategy.request_data()
+    return all(request_data.get(field) not in (None, "") for field in proof_fields)
+
