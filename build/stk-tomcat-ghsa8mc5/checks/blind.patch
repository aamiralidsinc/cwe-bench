@@ -715,6 +715,35 @@
 
 
     /**
+     * Check whether two host names resolve to the same TLS configuration.
+     * <p>
+     * The comparison follows the virtual host mapper: host names are case-insensitive, wildcard TLS host
+     * configurations are honoured and a missing host name (the client sent no SNI extension, or the request carried no
+     * host) resolves to the default configuration.
+     *
+     * @param connectionHostName the host name the client named during the TLS handshake, may be {@code null}
+     * @param servedHostName     the host name the request will be served under, may be {@code null}
+     *
+     * @return {@code true} if both names resolve to the same TLS configuration, or if this endpoint has TLS disabled
+     */
+    public boolean isSameTlsHostConfig(String connectionHostName, String servedHostName) {
+        if (!isSSLEnabled()) {
+            return true;
+        }
+        return getSSLHostConfig(toLowercaseHostName(connectionHostName)) ==
+                getSSLHostConfig(toLowercaseHostName(servedHostName));
+    }
+
+
+    private static String toLowercaseHostName(String hostName) {
+        if (hostName == null) {
+            return null;
+        }
+        return hostName.toLowerCase(Locale.ENGLISH);
+    }
+
+
+    /**
      * Has the user requested that send file be used where possible?
      */
     private boolean useSendfile = true;
