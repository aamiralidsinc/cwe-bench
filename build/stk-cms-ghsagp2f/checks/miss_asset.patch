     /**
+     * Returns the control panel’s resource base URL, derived from the site’s
+     * configuration rather than the incoming request.
+     */
+    private function resourceJsBaseUrl(): string
+    {
+        $generalConfig = Craft::$app->getConfig()->getGeneral();
+        $baseUrl = (string)$generalConfig->resourceBaseUrl;
+
+        if (str_starts_with($baseUrl, '@')) {
+            try {
+                $siteBaseUrl = rtrim((string)Craft::$app->getSites()->getPrimarySite()->getBaseUrl(), '/');
+            } catch (Throwable) {
+                $siteBaseUrl = '';
+            }
+            if ($siteBaseUrl !== '') {
+                $baseUrl = (string)preg_replace('/^@web(?=\/|$)/', $siteBaseUrl, $baseUrl);
+            }
+            if (str_starts_with($baseUrl, '@')) {
+                $resolved = Craft::getAlias($baseUrl, false);
+                if (is_string($resolved)) {
+                    $baseUrl = $resolved;
+                }
+            }
+        }
+
+        return rtrim($baseUrl, '/');
+    }
+
+    /**
+     * Returns whether the given URL belongs to the control panel’s resource origin.
+     */
+    private function isResourceJsUrl(string $url, string $baseUrl): bool
+    {
+        $urlParts = parse_url($url);
+        $baseParts = parse_url($baseUrl);
+
+        if (!is_array($urlParts) || !is_array($baseParts) || empty($urlParts['host']) || empty($baseParts['host'])) {
+            return false;
+        }
+
+        $scheme = strtolower($urlParts['scheme'] ?? '');
+        if ($scheme !== strtolower($baseParts['scheme'] ?? '')) {
+            return false;
+        }
+
+        if (strtolower($urlParts['host']) !== strtolower($baseParts['host'])) {
+            return false;
+        }
+
+        $defaultPort = $scheme === 'https' ? 443 : 80;
+        if ((int)($urlParts['port'] ?? $defaultPort) !== (int)($baseParts['port'] ?? $defaultPort)) {
+            return false;
+        }
+
+        $basePath = rtrim($baseParts['path'] ?? '/', '/');
+        $urlPath = $urlParts['path'] ?? '/';
+
+        return $urlPath === $basePath || str_starts_with($urlPath, $basePath . '/');
+    }
