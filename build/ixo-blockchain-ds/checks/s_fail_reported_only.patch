index 0000000..44e7859
--- /dev/null
+++ b/x/bonds/keeper/auth.go
@@ -0,0 +1,51 @@
+package keeper
+
+import (
+	errorsmod "cosmossdk.io/errors"
+	sdk "github.com/cosmos/cosmos-sdk/types"
+	sdkerrors "github.com/cosmos/cosmos-sdk/types/errors"
+
+	iidtypes "github.com/ixofoundation/ixo-blockchain/v7/x/iid/types"
+)
+
+// verifyDidSignerAuthentication checks inside the keeper that signer is an
+// account the DID document authorises to act for did. The IID ante performs
+// this check for top-level transactions only; handlers reached through any
+// other dispatch path must re-establish it themselves.
+func (k Keeper) verifyDidSignerAuthentication(ctx sdk.Context, did, signer string) error {
+	doc, found := k.iidKeeper.GetDidDocument(ctx, []byte(did))
+	if !found {
+		return errorsmod.Wrapf(iidtypes.ErrDidDocumentNotFound, "did document %s not found", did)
+	}
+	if !doc.HasRelationship(iidtypes.NewBlockchainAccountID(signer), iidtypes.Authentication, iidtypes.AssertionMethod) {
+		return errorsmod.Wrapf(iidtypes.ErrUnauthorized,
+			"signer %s is not authorized to act on behalf of did %s", signer, did)
+	}
+	return nil
+}
+
+// resolveDidSignerAccount resolves the account a DID fragment names and
+// requires it to be the signer's own account, so that coins are only ever
+// moved from an account belonging to the party that authorized the request.
+func (k Keeper) resolveDidSignerAccount(ctx sdk.Context, fragment iidtypes.DIDFragment, signer string) (sdk.AccAddress, error) {
+	if err := k.verifyDidSignerAuthentication(ctx, fragment.Did(), signer); err != nil {
+		return nil, err
+	}
+	doc, found := k.iidKeeper.GetDidDocument(ctx, []byte(fragment.Did()))
+	if !found {
+		return nil, errorsmod.Wrapf(iidtypes.ErrDidDocumentNotFound, "did document %s not found", fragment.Did())
+	}
+	resolved, err := doc.GetVerificationMethodBlockchainAddress(fragment.String())
+	if err != nil {
+		return nil, errorsmod.Wrap(err, "Address not found in iid doc")
+	}
+	signerAddr, err := sdk.AccAddressFromBech32(signer)
+	if err != nil {
+		return nil, errorsmod.Wrapf(sdkerrors.ErrInvalidAddress, "invalid signer address (%s)", err)
+	}
+	if !resolved.Equals(signerAddr) {
+		return nil, errorsmod.Wrapf(iidtypes.ErrUnauthorized,
+			"signer %s does not control account %s", signer, resolved.String())
+	}
+	return resolved, nil
+}
