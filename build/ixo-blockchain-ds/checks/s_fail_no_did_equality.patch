new file mode 100644
index 0000000..7fbc077
--- /dev/null
+++ b/x/entity/keeper/auth.go
@@ -0,0 +1,29 @@
+package keeper
+
+import (
+	errorsmod "cosmossdk.io/errors"
+	sdk "github.com/cosmos/cosmos-sdk/types"
+
+	iidtypes "github.com/ixofoundation/ixo-blockchain/v7/x/iid/types"
+)
+
+// VerifyDidSignerAuthentication re-establishes, inside the keeper, the
+// signer→DID binding that the IID ante decorator performs at transaction
+// level: the signer must be an account the DID document authorises to act for
+// the DID.
+//
+// Every entity handler that authorises an action "as" a DID must call it,
+// because the IID ante decorator does not run on messages dispatched through
+// other paths (contract execution, delegated execution, or a direct module
+// call).
+func (k Keeper) VerifyDidSignerAuthentication(ctx sdk.Context, did, signerAddr string) error {
+	doc, found := k.IidKeeper.GetDidDocument(ctx, []byte(did))
+	if !found {
+		return errorsmod.Wrapf(iidtypes.ErrDidDocumentNotFound, "did document %s not found", did)
+	}
+	if !doc.HasRelationship(iidtypes.NewBlockchainAccountID(signerAddr), iidtypes.Authentication, iidtypes.AssertionMethod) {
+		return errorsmod.Wrapf(iidtypes.ErrUnauthorized,
+			"signer %s is not authorized to act on behalf of did %s", signerAddr, did)
+	}
+	return nil
+}
