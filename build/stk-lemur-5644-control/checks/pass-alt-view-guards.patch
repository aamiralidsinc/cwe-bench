+def _validate_plugin_options(options):
+    """Reject any acme_url entry that is outside the configured allowlist."""
+    from lemur.plugins.lemur_acme.plugin import _validate_acme_url
+
+    if not options:
+        return
+    try:
+        entries = json.loads(options)
+    except (TypeError, ValueError):
+        return
+    if not isinstance(entries, list):
+        return
+    for entry in entries:
+        if isinstance(entry, dict) and entry.get("name") == "acme_url":
+            _validate_acme_url(entry.get("value") or "")
+
+
