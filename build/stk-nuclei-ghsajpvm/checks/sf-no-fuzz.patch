 // Replace replaces placeholders in template with values on the fly.
+//
+// Substitution happens in a single pass over the input template: an inserted
+// value is emitted as data and is never scanned again for placeholders. Both
+// marker forms are understood during that same pass.
 func Replace(template string, values map[string]interface{}) string {
 	valuesMap := make(map[string]interface{}, len(values))
 	for k, v := range values {
 		valuesMap[k] = types.ToString(v)
 	}
-	replaced := fasttemplate.ExecuteStringStd(template, marker.ParenthesisOpen, marker.ParenthesisClose, valuesMap)
-	final := fasttemplate.ExecuteStringStd(replaced, marker.General, marker.General, valuesMap)
-	return final
+	return replaceSinglePass(template, marker.ParenthesisOpen, marker.ParenthesisClose, marker.General, valuesMap)
+}
+
+// replaceSinglePass scans the template once from left to right and substitutes
+// both marker forms as it goes. When a marker's key is unknown the opening
+// marker is emitted literally and scanning continues after it, so a marker of
+// the other form nested inside an unknown one is still substituted.
+func replaceSinglePass(template, open, close, general string, values map[string]interface{}) string {
+	if template == "" || len(values) == 0 {
+		return template
+	}
+	var builder strings.Builder
+	builder.Grow(len(template))
+
+	for index := 0; index < len(template); {
+		rest := template[index:]
+		openIndex := strings.Index(rest, open)
+		generalIndex := strings.Index(rest, general)
+
+		switch {
+		case openIndex < 0 && generalIndex < 0:
+			builder.WriteString(rest)
+			index = len(template)
+		case openIndex >= 0 && (generalIndex < 0 || openIndex <= generalIndex):
+			builder.WriteString(rest[:openIndex])
+			index += openIndex
+			keyStart := index + len(open)
+			keyEnd := strings.Index(template[keyStart:], close)
+			if keyEnd < 0 {
+				builder.WriteString(open)
+				index += len(open)
+				continue
+			}
+			keyEnd += keyStart
+			if value, ok := values[template[keyStart:keyEnd]]; ok {
+				builder.WriteString(types.ToString(value))
+				index = keyEnd + len(close)
+			} else {
+				builder.WriteString(open)
+				index += len(open)
+			}
+		default:
+			builder.WriteString(rest[:generalIndex])
+			index += generalIndex
+			keyStart := index + len(general)
+			keyEnd := strings.Index(template[keyStart:], general)
+			if keyEnd < 0 {
+				builder.WriteString(general)
+				index += len(general)
+				continue
+			}
+			keyEnd += keyStart
+			if value, ok := values[template[keyStart:keyEnd]]; ok {
+				builder.WriteString(types.ToString(value))
+				index = keyEnd + len(general)
+			} else {
+				builder.WriteString(general)
+				index += len(general)
+			}
+		}
+	}
+	return builder.String()
 }
 
