+export function resolveFeishuFamilyAccount(params: {
+  api: Pick<OpenClawPluginApi, "config">;
+  executeParams?: AccountAwareParams;
+  defaultAccountId?: string;
+  family: FeishuToolFamily;
+  label: string;
+}): ResolvedFeishuAccount {
+  const cfg = params.api.config;
+  if (!cfg) {
+    throw new Error("Feishu config unavailable");
+  }
+  const refuses = (account: ResolvedFeishuAccount): boolean =>
+    !resolveToolsConfig(account.config.tools)[params.family];
+  const disabled = (accountId: string) =>
+    new Error(`Feishu ${params.label} tools are disabled for account "${accountId}"`);
+
+  const explicitAccountId = normalizeOptionalString(params.executeParams?.accountId);
+  if (explicitAccountId) {
+    const account = resolveFeishuRuntimeAccount({ cfg, accountId: explicitAccountId });
+    if (refuses(account)) {
+      throw disabled(account.accountId);
+    }
+    return account;
+  }
+
+  const contextualAccountId = normalizeOptionalString(params.defaultAccountId);
+  if (contextualAccountId && listFeishuAccountIds(cfg).includes(contextualAccountId)) {
+    const contextual = resolveFeishuAccount({ cfg, accountId: contextualAccountId });
+    if (contextual.enabled) {
+      const account = resolveFeishuRuntimeAccount({ cfg, accountId: contextualAccountId });
+      if (refuses(account)) {
+        throw disabled(account.accountId);
+      }
+      return account;
+    }
+  }
+
+  const configuredDefaultAccountId = normalizeOptionalString(
+    (cfg.channels?.feishu as { defaultAccount?: unknown } | undefined)?.defaultAccount,
+  );
+  if (configuredDefaultAccountId) {
+    const account = resolveFeishuRuntimeAccount({ cfg, accountId: configuredDefaultAccountId });
+    if (refuses(account)) {
+      throw disabled(account.accountId);
+    }
+    return account;
+  }
+
+  for (const accountId of listFeishuAccountIds(cfg)) {
+    const candidate = resolveFeishuAccount({ cfg, accountId });
+    if (candidate.enabled && candidate.configured && !refuses(candidate)) {
+      return resolveFeishuRuntimeAccount({ cfg, accountId });
+    }
+  }
+
+  throw new Error(`Feishu ${params.label} tools are not enabled for any account`);
+}
+
+export function createFeishuFamilyClient(params: {
+  api: Pick<OpenClawPluginApi, "config">;
+  executeParams?: AccountAwareParams;
+  defaultAccountId?: string;
+  family: FeishuToolFamily;
+  label: string;
+}): Lark.Client {
+  return createFeishuClient(resolveFeishuFamilyAccount(params));
 }
 
 export function createFeishuToolClient(params: {
