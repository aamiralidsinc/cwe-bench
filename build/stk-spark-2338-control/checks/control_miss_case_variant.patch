+/* Render a value as literal text: markup characters must never take effect. */
+function escapeHtml(text) {
+  if (typeof text !== 'string') return text;
+  return text
+    .replace(/&/g, "&amp;")
+    .replace(/</g, "&lt;")
+    .replace(/>/g, "&gt;")
+    .replace(/"/g, "&quot;")
+    .replace(/'/g, "&#039;");
+}
+function abbreviateEscapedSummary(content, limit) {
+  if (content && content.length > limit) {
+    const span = "<span onclick=\"this.parentNode.querySelector('.stacktrace-details').classList.toggle('collapsed')\" class=\"expand-details\">+details</span>";
+    const pre = '<pre>' + content + '</pre>';
+    const div = '<div class="stacktrace-details collapsed">' + pre + '</div>';
+    return escapeHtml(content.substring(0, limit)) + '...' + span + div;
+  }
+  return escapeHtml(content);
+}
