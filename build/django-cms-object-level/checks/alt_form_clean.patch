+    def check_copy_and_target(self, data):
+        """Copy sources need view (hidden ones: change, on their own site);
+        existing pages need change on their own site. Subclasses overriding
+        clean() call this too."""
+        source, page = data.get("source"), data.get("cms_page")
+        if source and not self.user_may_copy(source):
+            self.add_error("source", _("You may not copy content from this page."))
+            return False
+        if page and (page.site_id != self._site.pk or not user_can_change_page(self._user, page, site=page.site)):
+            self.add_error("cms_page", _("You may not add a translation to this page."))
+            return False
+        return True
+
+    def user_may_copy(self, source):
+        if self.fields["source"].widget.is_hidden and not source.is_page_type:
+            return user_can_change_page(self._user, source, site=source.site)
+        return user_can_view_page(self._user, source, site=source.site)
