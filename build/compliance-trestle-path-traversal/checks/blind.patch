     return True
 
 
+def is_path_within_root(path: pathlib.Path, root: pathlib.Path, allow_root: bool = False) -> bool:
+    """Determine whether a path, once fully resolved (symlinks and '..' expanded), lies within root.
+
+    args:
+        path: the candidate path, absolute or relative to the current working directory.
+        root: the directory that must contain the path.
+        allow_root: whether the path may be the root directory itself.
+
+    Returns:
+        Whether the resolved path is inside the resolved root.
+    """
+    root_resolved = pathlib.Path(root).resolve()
+    path_resolved = pathlib.Path(path).resolve()
+    try:
+        relative = path_resolved.relative_to(root_resolved)
+    except ValueError:
+        return False
+    return allow_root or relative != pathlib.Path('.')
+
+
+def ensure_path_within_root(path: pathlib.Path, root: pathlib.Path, allow_root: bool = False) -> pathlib.Path:
+    """Raise TrestleError unless the resolved path is within root.
+
+    This must be called before anything is created, modified or deleted at a location derived from a user given name.
+    """
+    if not is_path_within_root(path, root, allow_root):
+        raise TrestleError(f'Path {path} resolves to a location outside of {root}, which is not allowed.')
+    return pathlib.Path(path)
+
+
