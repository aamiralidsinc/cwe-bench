diff --git a/trestle/common/file_utils.py b/trestle/common/file_utils.py
index 1e19944e..3ecf02f6 100644
--- a/trestle/common/file_utils.py
+++ b/trestle/common/file_utils.py
@@ -92,6 +92,14 @@ def is_local_and_visible(file_path: pathlib.Path) -> bool:
     return not (is_hidden(file_path) or is_symlink(file_path))
 
 
+def ensure_within_workspace(trestle_root: pathlib.Path, target: pathlib.Path) -> None:
+    """Raise TrestleError unless target (after resolving links and '..') lies inside trestle_root."""
+    root = os.path.realpath(str(trestle_root))
+    real = os.path.realpath(str(target))
+    if os.path.commonpath([root, real]) != root:
+        raise TrestleError(f'{target} is outside the trestle workspace {trestle_root}')
+
+
 def is_directory_name_allowed(name: str) -> bool:
     """Determine whether a directory name, which is a 'non-core-OSCAL activity/directory is allowed.
 
@@ -105,6 +113,13 @@ def is_directory_name_allowed(name: str) -> bool:
     # Task must not self-interfere with a project
     pathed_name = pathlib.Path(name)
 
+    # Task must stay inside the workspace: relative, and never stepping up a level
+    if os.path.isabs(str(name)) or str(name).startswith(('/', '\\')) or '..' in pathlib.PurePosixPath(
+        str(name).replace('\\', '/')
+    ).parts:
+        logger.warning('Task name must be a relative path inside the workspace')
+        return False
+
     root_path = pathed_name.parts[0]
     if root_path in const.MODEL_TYPE_TO_MODEL_DIR.values():
         logger.warning('Task name is the same as an OSCAL schema name.')
