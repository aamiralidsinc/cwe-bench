+/** A binding is network-reachable when it names a host that is not the local machine. */
+function isApiExposed(api: { host?: string, middlewareMode?: boolean } | undefined): boolean {
+  if (!api || api.middlewareMode) {
+    return false
+  }
+  const host = api.host
+  return !!host && host !== 'localhost' && host !== '127.0.0.1'
+}
+
+function assertWriteAllowed(ctx: Vitest): void {
+  if (isApiExposed(ctx.config.api)) {
+    throw new Error(
+      'Cannot modify files or start test runs because the server is exposed to the network. Bind the API to the local machine to allow writes.',
+    )
+  }
+}
