+/** A binding is network-reachable when it names a host that is not the local machine. */
+export function isApiExposed(api: { host?: string, middlewareMode?: boolean } | undefined): boolean {
+  if (!api || api.middlewareMode) {
+    return false
+  }
+  const host = api.host
+  return !!host && host !== 'localhost' && host !== '127.0.0.1'
+}
+
+/**
+ * File writes and deletes are refused while any API that fronts this project is
+ * reachable from the network. The browser API inherits the runner's binding, so
+ * the runner's own API is part of the check.
+ */
+export function assertWriteAllowed(project: TestProject): void {
+  const bindings = [
+    project.vitest.config.api,
+    project.config.api,
+    project.vitest.config.browser.api,
+    project.config.browser.api,
+  ]
+  if (bindings.some(isApiExposed)) {
+    throw new Error(
+      'Cannot modify files because the server is exposed to the network. Bind the API to the local machine to allow writes.',
+    )
+  }
+}
