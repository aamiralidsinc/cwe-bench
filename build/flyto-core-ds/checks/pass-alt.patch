diff -ruN '--exclude=__pycache__' '--exclude=*.pyc' a/src/core/sandbox_confine.py b/src/core/sandbox_confine.py
--- a/src/core/sandbox_confine.py	1970-01-01 00:00:00.000000000 +0000
+++ b/src/core/sandbox_confine.py	2026-10-21 23:48:52.679967995 +0000
@@ -0,0 +1,25 @@
+# Copyright 2026 Flyto2. Licensed under Apache-2.0. See LICENSE.
+
+"""Confinement helper for module input/output locations.
+
+Independent implementation of the sandbox rule: resolve both the operator
+sandbox and the requested location with pathlib and require the resolved
+location to be the sandbox or one of its descendants.
+"""
+import os
+from pathlib import Path
+
+from .utils import PathTraversalError, get_safe_path_config
+
+
+def confine_path(path: str) -> str:
+    """Return the resolved path, or raise when it leaves the sandbox."""
+    config = get_safe_path_config()
+    base = Path(os.path.expanduser(str(config['base_dir']))).resolve()
+    target = Path(os.path.expanduser(str(path))).resolve()
+    if target == base or base in target.parents:
+        return str(target)
+    raise PathTraversalError(
+        f"Path escapes sandbox directory: {path} "
+        f"(resolves to {target}, outside {base})"
+    )
