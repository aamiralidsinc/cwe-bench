+func svgLocalName(name string) string {
+	name = strings.ToLower(strings.TrimSpace(name))
+	if idx := strings.LastIndex(name, ":"); 0 <= idx {
+		name = name[idx+1:]
+	}
+	return name
+}
+
+func isActiveSVGElement(name string) bool {
+	switch svgLocalName(name) {
+	case "script", "iframe", "object", "embed", "foreignobject":
+		return true
+	}
+	return false
+}
+
+func isActiveSVGAttr(attr *html.Attribute) bool {
+	if nil == attr {
+		return true
+	}
+	key := strings.ToLower(strings.TrimSpace(attr.Key))
+	if strings.HasPrefix(key, "on") {
+		return true
+	}
+	val := strings.ToLower(strings.TrimSpace(attr.Val))
+	val = strings.TrimLeft(val, "\x00\x09\x0a\x0c\x0d\x20")
+	switch svgLocalName(key) {
+	case "href", "src", "action", "formaction", "poster":
+		return isActiveSVGURL(val)
+	case "style":
+		return strings.Contains(val, "expression(") || strings.Contains(val, "javascript:") || strings.Contains(val, "vbscript:")
+	}
+	return false
+}
+
+func isActiveSVGURL(val string) bool {
+	switch {
+	case strings.HasPrefix(val, "javascript:"),
+		strings.HasPrefix(val, "vbscript:"),
+		strings.HasPrefix(val, "livescript:"),
+		strings.HasPrefix(val, "mocha:"):
+		return true
+	case strings.HasPrefix(val, "data:"):
+		return !isSafeSVGDataImage(val)
+	}
+	return false
+}
+
+// HasActiveSVGContent 报告 SVG 中是否含有可执行内容
+func HasActiveSVGContent(svgInput string) bool {
+	doc, err := html.Parse(strings.NewReader(svgInput))
+	if err != nil {
+		return true
+	}
+	active := false
+	var walk func(*html.Node)
+	walk = func(n *html.Node) {
+		for c := n.FirstChild; c != nil; c = c.NextSibling {
+			if c.Type == html.ElementNode {
+				if isActiveSVGElement(c.Data) {
+					active = true
+					return
+				}
+				for _, attr := range c.Attr {
+					if isActiveSVGAttr(attr) {
+						active = true
+						return
+					}
+				}
+			}
+			walk(c)
+			if active {
+				return
+			}
+		}
+	}
+	walk(doc)
+	return active
+}
+
+func isSafeSVGDataImage(val string) bool {
+	if !strings.HasPrefix(val, "data:") {
+		return false
+	}
+	mediaType := val[len("data:"):]
+	if idx := strings.IndexAny(mediaType, ";,"); 0 <= idx {
+		mediaType = mediaType[:idx]
+	}
+	switch strings.TrimSpace(mediaType) {
+	case "image/png", "image/jpeg", "image/jpg", "image/gif", "image/webp":
+		return true
+	}
+	return false
+}
