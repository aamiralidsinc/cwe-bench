--- /dev/null
+++ b/kernel/server/svg_middleware.go
@@ -0,0 +1,83 @@
+package server
+
+import (
+	"bytes"
+	"net/http"
+	"strings"
+
+	"github.com/gin-gonic/gin"
+	"github.com/siyuan-note/siyuan/kernel/model"
+	"github.com/siyuan-note/siyuan/kernel/util"
+)
+
+// sanitizeSVGMiddleware sanitises every SVG document that leaves the kernel.
+func sanitizeSVGMiddleware() gin.HandlerFunc {
+	return func(c *gin.Context) {
+		if nil != model.Conf && nil != model.Conf.Editor && model.Conf.Editor.AllowSVGScript {
+			c.Next()
+			return
+		}
+		writer := &svgSanitizingWriter{ResponseWriter: c.Writer, status: http.StatusOK}
+		c.Writer = writer
+		c.Next()
+		writer.finish()
+		c.Writer = writer.ResponseWriter
+	}
+}
+
+type svgSanitizingWriter struct {
+	gin.ResponseWriter
+	status  int
+	started bool
+	body    bytes.Buffer
+}
+
+func (w *svgSanitizingWriter) WriteHeader(code int) {
+	if 0 < code && w.status != code {
+		if w.started {
+			return
+		}
+		w.status = code
+	}
+}
+
+func (w *svgSanitizingWriter) WriteHeaderNow() {
+	if !w.started {
+		w.started = true
+		w.status = http.StatusOK
+	}
+}
+
+func (w *svgSanitizingWriter) Write(data []byte) (int, error) {
+	w.WriteHeaderNow()
+	return w.body.Write(data)
+}
+
+func (w *svgSanitizingWriter) WriteString(s string) (int, error) {
+	return w.Write([]byte(s))
+}
+
+func (w *svgSanitizingWriter) Status() int {
+	if w.started {
+		return w.status
+	}
+	return w.ResponseWriter.Status()
+}
+
+func (w *svgSanitizingWriter) Written() bool { return w.started }
+
+func (w *svgSanitizingWriter) Size() int { return w.body.Len() }
+
+func (w *svgSanitizingWriter) Flush() { w.WriteHeaderNow() }
+
+func (w *svgSanitizingWriter) finish() {
+	data := w.body.Bytes()
+	if strings.Contains(strings.ToLower(w.Header().Get("Content-Type")), "image/svg+xml") {
+		data = []byte(util.SanitizeSVG(string(data)))
+		w.Header().Del("Content-Length")
+	}
+	w.ResponseWriter.WriteHeader(w.status)
+	if 0 < len(data) {
+		_, _ = w.ResponseWriter.Write(data)
+	}
+}
