 }
 
+var safeSVGElements = map[string]bool{
+	"svg": true, "g": true, "defs": true, "symbol": true, "use": true, "switch": true,
+	"path": true, "rect": true, "circle": true, "ellipse": true, "line": true,
+	"polyline": true, "polygon": true, "text": true, "tspan": true, "textpath": true,
+	"image": true, "a": true, "style": true, "title": true, "desc": true, "metadata": true,
+	"lineargradient": true, "radialgradient": true, "stop": true, "pattern": true,
+	"clippath": true, "mask": true, "filter": true, "fegaussianblur": true,
+	"feblend": true, "fecolormatrix": true, "fecomposite": true, "fedropshadow": true,
+	"feoffset": true, "femerge": true, "femergenode": true, "marker": true,
+	"view": true, "animate": true, "animatetransform": true, "animatemotion": true,
+	"set": true, "mpath": true,
+}
+
+func svgElementName(name string) string {
+	name = strings.ToLower(strings.TrimSpace(name))
+	if idx := strings.LastIndex(name, ":"); 0 <= idx {
+		name = name[idx+1:]
+	}
+	return name
+}
+
+func safeSVGURL(value string) bool {
+	switch {
+	case strings.HasPrefix(value, "javascript:"), strings.HasPrefix(value, "vbscript:"),
+		strings.HasPrefix(value, "livescript:"), strings.HasPrefix(value, "mocha:"):
+		return false
+	case strings.HasPrefix(value, "data:"):
+		mediaType := value[len("data:"):]
+		if idx := strings.IndexAny(mediaType, ";,"); 0 <= idx {
+			mediaType = mediaType[:idx]
+		}
+		switch strings.TrimSpace(mediaType) {
+		case "image/png", "image/jpeg", "image/jpg", "image/gif", "image/webp":
+			return true
+		}
+		return false
+	}
+	return true
+}
+
+func safeSVGAttribute(attr *html.Attribute) bool {
+	if nil == attr {
+		return false
+	}
+	key := strings.ToLower(strings.TrimSpace(attr.Key))
+	if strings.HasPrefix(key, "on") {
+		return false
+	}
+	value := strings.ToLower(strings.TrimSpace(attr.Val))
+	value = strings.TrimLeft(value, "\x00\x09\x0a\x0c\x0d\x20")
+	switch svgElementName(key) {
+	case "href", "src", "action", "formaction", "poster":
+		return safeSVGURL(value)
+	case "style":
+		return !strings.Contains(value, "expression(") && !strings.Contains(value, "javascript:") && !strings.Contains(value, "vbscript:")
+	}
+	return true
+}
+
+func findSVGElement(n *html.Node) *html.Node {
+	if n.Type == html.ElementNode && "svg" == svgElementName(n.Data) {
+		return n
+	}
+	for c := n.FirstChild; c != nil; c = c.NextSibling {
+		if found := findSVGElement(c); nil != found {
+			return found
+		}
+	}
+	return nil
+}
+
+// SanitizeSVG 只保留已知安全的 SVG 元素和属性
+func SanitizeSVG(svgInput string) string {
+	doc, err := html.Parse(strings.NewReader(svgInput))
+	if err != nil {
+		logging.LogWarnf("parse svg failed: %v", err)
+		return svgInput
+	}
+	root := findSVGElement(doc)
+	if nil == root {
+		return svgInput
+	}
+	var walk func(*html.Node)
+	walk = func(n *html.Node) {
+		if 0 < len(n.Attr) {
+			filtered := n.Attr[:0]
+			for _, attr := range n.Attr {
+				if safeSVGAttribute(attr) {
+					filtered = append(filtered, attr)
+				}
+			}
+			n.Attr = filtered
+		}
+		for c := n.FirstChild; c != nil; {
+			next := c.NextSibling
+			if c.Type == html.ElementNode && !safeSVGElements[svgElementName(c.Data)] {
+				n.RemoveChild(c)
+				c = next
+				continue
+			}
+			walk(c)
+			c = next
+		}
+	}
+	walk(root)
+	var buf bytes.Buffer
+	if err = html.Render(&buf, doc); err != nil {
+		logging.LogWarnf("render svg failed: %v", err)
+		return svgInput
+	}
+	return extractSVG(buf.String())
+}
+
 func extractSVG(fullHTML string) string {
 	start := strings.Index(fullHTML, "<svg")
 	end := strings.LastIndex(fullHTML, "</svg>")
