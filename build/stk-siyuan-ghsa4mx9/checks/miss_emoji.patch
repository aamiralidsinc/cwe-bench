+// serveFileOrSanitizedSVG 返回文件内容，SVG 图片在未开启脚本时先清理可执行内容
+func serveFileOrSanitizedSVG(context *gin.Context, absPath string) {
+	if strings.HasSuffix(strings.ToLower(absPath), ".svg") {
+		data, err := os.ReadFile(absPath)
+		if err == nil {
+			if !model.Conf.Editor.AllowSVGScript {
+				data = []byte(util.SanitizeSVG(string(data)))
+			}
+			context.Data(http.StatusOK, "image/svg+xml", data)
+			return
+		}
+	}
+	http.ServeFile(context.Writer, context.Request, absPath)
+}
