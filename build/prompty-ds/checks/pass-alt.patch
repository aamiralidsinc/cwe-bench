+++ b/runtime/python/prompty/prompty/core/paths.py
@@ -0,0 +1,21 @@
+"""Path containment helpers for author-controlled references."""
+
+from __future__ import annotations
+
+import os
+from pathlib import Path
+
+__all__ = ["resolve_under"]
+
+
+def resolve_under(base_dir: str | Path, reference: str) -> Path:
+    """Resolve *reference* below *base_dir*, refusing anything that escapes."""
+    root = os.path.realpath(os.fspath(base_dir))
+    target = os.path.realpath(os.path.join(root, reference))
+    try:
+        inside = os.path.commonpath([root, target]) == root
+    except ValueError:
+        inside = False
+    if not inside:
+        raise ValueError(f"Reference '{reference}' resolves outside the prompt directory '{root}'")
+    return Path(target)
