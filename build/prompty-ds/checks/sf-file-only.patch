+/**
+ * Resolve `reference` under `baseDir`, rejecting anything that escapes it.
+ *
+ * `baseDir` is the directory that contains the prompt document. The reference
+ * is canonicalized (links followed) before the containment check, so upward
+ * traversal, absolute paths and links that point elsewhere on the host are
+ * all rejected before any file is opened.
+ */
+export function containPath(baseDir: string, reference: string): string {
+  const root = realpathSync(resolve(baseDir));
+  const target = realpathSync(resolve(root, reference));
+  const rel = relative(root, target);
+  if (rel === "") {
+    return target;
+  }
+  if (rel === ".." || rel.startsWith(".." + sep) || isAbsolute(rel)) {
+    throw new Error(
+      `Reference '${reference}' resolves outside the prompt directory '${root}'`,
+    );
+  }
+  return target;
+}
+
