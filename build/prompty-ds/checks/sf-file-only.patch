+class _DocumentFileSystemLoader(FileSystemLoader):
+    """Load template fragments only from the document's own directory.
+
+    A fragment name is canonicalized before it is read, so a link inside the
+    directory that points elsewhere on the host is refused instead of opened.
+    """
+
+    def get_source(self, environment, template):
+        root = Path(self.searchpath[0]).resolve()
+        if not (root / template).resolve().is_relative_to(root):
+            raise TemplateNotFound(template)
+        return super().get_source(environment, template)
+
