diff --git a/runtime/typescript/packages/core/src/core/paths.ts b/runtime/typescript/packages/core/src/core/paths.ts
new file mode 100644
index 0000000..0155f92
--- /dev/null
+++ b/runtime/typescript/packages/core/src/core/paths.ts
@@ -0,0 +1,25 @@
+/**
+ * Confinement for author-named filesystem references.
+ *
+ * @module
+ */
+
+import { realpathSync } from "node:fs";
+import { relative, resolve, isAbsolute, sep } from "node:path";
+
+/**
+ * Resolve `reference` under `baseDir`, refusing anything that escapes it.
+ *
+ * The resolved target is canonicalized (links followed) first, so upward
+ * spellings, absolute paths and links that lead elsewhere are all rejected.
+ */
+export function confinePath(baseDir: string, reference: string): string {
+  const root = realpathSync(resolve(baseDir));
+  const target = realpathSync(resolve(root, reference));
+  const rel = relative(root, target);
+  if (rel === "") return target;
+  if (rel === ".." || rel.startsWith(".." + sep) || isAbsolute(rel)) {
+    throw new Error(`Reference '${reference}' resolves outside the prompt directory '${root}'`);
+  }
+  return target;
+}
