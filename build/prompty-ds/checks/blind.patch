@@ -0,0 +1,25 @@
+"""Filesystem confinement for references written in a prompt document."""
+
+from __future__ import annotations
+
+import os
+from pathlib import Path
+
+__all__ = ["confine"]
+
+
+def confine(base_dir: str | Path, reference: str) -> Path:
+    """Resolve *reference* under *base_dir*, refusing anything that escapes.
+
+    The reference is canonicalized before the check, so a link is judged by
+    the location it leads to rather than by how it is spelled.
+    """
+    base = os.path.realpath(os.fspath(base_dir))
+    target = os.path.realpath(os.path.join(base, os.fspath(reference)))
+    try:
+        inside = os.path.commonpath([base, target]) == base
+    except ValueError:  # different drives / no common prefix
+        inside = False
+    if not inside:
+        raise PermissionError(f"Reference '{reference}' resolves outside the prompt directory '{base}'")
+    return Path(target)
