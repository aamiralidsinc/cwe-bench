+// catalogErrorStatus classifies a failed table-storage operation for a REST
+// caller. The storage request API already decided whether the caller was
+// refused or the resource is missing; the catalog must report that decision as
+// a client error instead of turning every failure into a server failure.
+func catalogErrorStatus(err error) (int, string) {
+	var tableErr *s3tables.S3TablesError
+	if errors.As(err, &tableErr) {
+		switch tableErr.Type {
+		case s3tables.ErrCodeAccessDenied:
+			return http.StatusForbidden, "ForbiddenException"
+		case s3tables.ErrCodeNoSuchBucket, s3tables.ErrCodeNoSuchNamespace, s3tables.ErrCodeNoSuchTable:
+			return http.StatusNotFound, "NotFoundException"
+		case s3tables.ErrCodeBucketAlreadyExists, s3tables.ErrCodeNamespaceAlreadyExists, s3tables.ErrCodeTableAlreadyExists:
+			return http.StatusConflict, "AlreadyExistsException"
+		}
+	}
+	return http.StatusInternalServerError, "InternalServerError"
+}
+
+// writeCatalogError reports a failed operation to a REST caller.
+func writeCatalogError(w http.ResponseWriter, err error) {
+	status, errType := catalogErrorStatus(err)
+	writeError(w, status, errType, err.Error())
+}
