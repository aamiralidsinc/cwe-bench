+// openDefault reports whether the zero-config fallback may decide for this
+// request: only for local tools, or for callers that resolve to no principal of
+// their own (no credentials) or to the anonymous identity.
+func (h *S3TablesHandler) openDefault(r *http.Request) bool {
+	if h.localTool {
+		return true
+	}
+	if !h.defaultAllow {
+		return false
+	}
+	p := h.getAccountID(r)
+	return p == h.accountID || p == s3_constants.AccountAnonymousId || isAnonymousIdentity(r)
+}
