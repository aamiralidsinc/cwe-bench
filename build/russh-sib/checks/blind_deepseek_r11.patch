+            kex: Cow::Owned(vec![kex::NONE]),
+            ..Preferred::DEFAULT
+        };
+        assert!(matches!(
+            Server::read_kex(&buf, &pref, None, None, &KexCause::Initial),
+            Err(Error::InsecureAlgorithm)
+        ));
+        assert!(matches!(
+            Client::read_kex(&buf, &pref, None, None, &KexCause::Initial),
+            Err(Error::InsecureAlgorithm)
+        ));
+    }
+
