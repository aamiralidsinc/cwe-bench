+    def _routes(self) -> list[tuple[WebhookEventType, str]]:
+        """List every distinct ``(event_type, local_path)`` the application registered.
+
+        :return: Registered routes in registration order.
+        """
+        routes: list[tuple[WebhookEventType, str]] = []
+        for event_type, handlers in self._handlers.items():
+            seen: set[str] = set()
+            for _, _, local_path in handlers:
+                if local_path not in seen:
+                    seen.add(local_path)
+                    routes.append((event_type, local_path))
+        return routes
+
+    def _endpoint(self, local_path: str) -> str:
+        """Build the absolute callback URL for a registered local path.
+
+        :param local_path: Route the application serves (default or custom).
+        :return: Endpoint TONAPI calls for this route.
+        """
+        if not self._origin:
+            return local_path
+        return f"{self._origin}/{local_path.lstrip('/')}"
+
+    async def _sync_subscriptions(
+        self,
+        webhook: t.Any,
+        event_type: WebhookEventType,
+        *,
+        removing: bool,
+    ) -> None:
+        """Apply (or drop) the dispatcher's subscriptions on one webhook.
+
+        :param webhook: Bound webhook object for one route.
+        :param event_type: Event type the route serves.
+        :param removing: ``True`` to unsubscribe, ``False`` to subscribe.
+        """
+        if event_type is WebhookEventType.ACCOUNT_TX:
+            if not self._accounts:
+                return
+            accounts = list(self._accounts)
+            if removing:
+                await webhook.unsubscribe(accounts)
+            else:
+                # Sync instead of blind-subscribe so a reused webhook is exact.
+                await webhook.sync_accounts(accounts)
+            return
+
+        if event_type is WebhookEventType.OPCODE_MSG:
+            if not self._opcodes:
+                return
+            for opcode in self._opcodes:
+                if removing:
+                    await webhook.unsubscribe_opcode_msg(opcode)
+                else:
+                    await webhook.subscribe_opcode_msg(opcode)
+            return
+
+        if event_type is WebhookEventType.MEMPOOL_MSG:
+            method = webhook.unsubscribe_mempool_msg if removing else webhook.subscribe_mempool_msg
+        elif event_type is WebhookEventType.NEW_CONTRACTS:
+            method = webhook.unsubscribe_new_contracts if removing else webhook.subscribe_new_contracts
+        else:
+            return
+        await method()
