@@ -50,6 +50,12 @@ class Xlsx extends BaseReader
 {
     const INITIAL_FILE = '_rels/.rels';
 
+    private const LENGTH_MULTIPLIER = [
+        'G' => 1024 * 1024 * 1024,
+        'M' => 1024 * 1024,
+        'K' => 1024,
+    ];
+
     /**
      * ReferenceHelper instance.
      */
@@ -412,21 +418,45 @@ class Xlsx extends BaseReader
         // Sadly, some 3rd party xlsx generators don't use consistent case for filenaming
         //    so we need to load case-insensitively from the zip file
 
-        $contents = $archive->getFromName($fileName, 0, ZipArchive::FL_NOCASE);
+        $contents = $this->getZipEntry($archive, $fileName);
 
         // Apache POI fixes
         if ($contents === false) {
-            $contents = $archive->getFromName(substr($fileName, 1), 0, ZipArchive::FL_NOCASE);
+            $contents = $this->getZipEntry($archive, substr($fileName, 1));
         }
 
         // Has the file been saved with Windoze directory separators rather than unix?
         if ($contents === false) {
-            $contents = $archive->getFromName(str_replace('/', '\\', $fileName), 0, ZipArchive::FL_NOCASE);
+            $contents = $this->getZipEntry($archive, str_replace('/', '\\', $fileName));
         }
 
         return ($contents === false) ? '' : $contents;
     }
 
+    private static function decompressionLimit(): int
+    {
+        $limit = ini_get('memory_limit') ?: '128M';
+        $limit = trim(str_replace('-1', '128M', $limit));
+        $unit = strtoupper(substr($limit, -1));
+        $limit = (int) $limit;
+        $limit *= self::LENGTH_MULTIPLIER[$unit] ?? 1;
+
+        return intdiv($limit, 4);
+    }
+
+    private function getZipEntry(ZipArchive $archive, string $fileName): string|false
+    {
+        $stat = $archive->statName($fileName, ZipArchive::FL_NOCASE);
+        if ($stat === false) {
+            return false;
+        }
+        if (($stat['size'] ?? 0) > self::decompressionLimit()) {
+            throw new Exception('Archive entry exceeds the configured decompression limit');
+        }
+
+        return $archive->getFromName($fileName, 0, ZipArchive::FL_NOCASE);
+    }
