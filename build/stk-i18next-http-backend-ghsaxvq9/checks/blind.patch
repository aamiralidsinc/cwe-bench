--- a/lib/guard.js	1970-01-01 00:00:00.000000000 +0000
+++ b/lib/guard.js	2026-10-26 05:15:07.464711489 +0000
@@ -0,0 +1,60 @@
+// A caller-supplied value may only fill one path token of the request URL.
+//
+// The language and the namespace reach this backend from outside the
+// application: a visitor picks a language, and i18next hands it (and the
+// namespaces derived from it) to read/readMulti/create. A value that contains
+// URL structure — a scheme delimiter, a path separator, a query or fragment
+// introducer, an authority boundary, an escape sequence or a control
+// character — can move the request to a destination the application never
+// configured, whichever placeholder it fills.
+//
+// So values are checked while they are still values, before a request is
+// built, rather than by inspecting the finished URL: that keeps the rule the
+// same for a string location, a function location and a promise location, for
+// both transports, and for the create/addPath write path. `+` separates the
+// languages (and namespaces) that i18next asks for in one round trip, so a
+// value may hold one or more `+`-joined tokens; each token is checked.
+
+const MAX_TOKEN_LENGTH = 96
+
+// Allowed token characters are ASCII letters, digits, `-`, `_` and `.`.
+// Everything else is refused: `:` (scheme), `/` and `\` (path), `?` and `#`
+// (query/fragment), `@` (authority), `%` (escaped separators), whitespace and
+// control characters.
+function isTokenChar (code) {
+  if (code >= 0x30 && code <= 0x39) return true // 0-9
+  if (code >= 0x41 && code <= 0x5A) return true // A-Z
+  if (code >= 0x61 && code <= 0x7A) return true // a-z
+  return code === 0x2D || code === 0x2E || code === 0x5F // - . _
+}
+
+function isSafeToken (token) {
+  if (token.length === 0 || token.length > MAX_TOKEN_LENGTH) return false
+  // `.` and `..` are directory segments; `..` anywhere is traversal.
+  if (token === '.' || token.indexOf('..') !== -1) return false
+  for (let i = 0; i < token.length; i += 1) {
+    if (!isTokenChar(token.charCodeAt(i))) return false
+  }
+  return true
+}
+
+// True when `value` can be substituted into a location without changing the
+// destination. Numbers are accepted (they were interpolated as text before);
+// anything else that is not a string is refused.
+export function isSafeRequestValue (value) {
+  let text = value
+  if (typeof value === 'number' && Number.isFinite(value)) text = String(value)
+  if (typeof text !== 'string') return false
+  const tokens = text.split('+')
+  for (let i = 0; i < tokens.length; i += 1) {
+    if (!isSafeToken(tokens[i])) return false
+  }
+  return true
+}
+
+// The values themselves never appear in the refusal message: it is reported to
+// the application (and may be logged) and the whole point is that they are not
+// trustworthy.
+export function unsafeRequestValues () {
+  return new Error('i18next-http-backend: refusing to request a location built from an unsafe lng or ns value')
+}
