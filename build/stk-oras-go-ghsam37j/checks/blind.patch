+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+// maxSymlinkDepth bounds the number of symbolic links followed while
+// resolving a single path, mirroring the usual kernel limit.
+const maxSymlinkDepth = 255
+
+// pathComponents splits an absolute or relative slash-separated path into its
+// non-empty components. It deliberately does not clean the path: "." and ".."
+// are kept in order so they can be applied while walking the real filesystem.
+func pathComponents(path string) []string {
+	parts := strings.Split(filepath.ToSlash(path), "/")
+	comps := make([]string, 0, len(parts))
+	for _, p := range parts {
+		if p != "" {
+			comps = append(comps, p)
+		}
+	}
+	return comps
+}
+
+// joinRaw joins a directory and a (possibly unclean) relative name without
+// cleaning the result. Cleaning here would cancel a ".." against a preceding
+// symbolic link name on paper only, which is exactly the mismatch between the
+// path that gets validated and the path the kernel resolves.
+func joinRaw(dir, name string) string {
+	if name == "" {
+		return dir
+	}
+	if strings.HasSuffix(dir, string(filepath.Separator)) {
+		return dir + name
+	}
+	return dir + string(filepath.Separator) + name
+}
+
+// resolvePathLinks returns the path that the kernel would resolve for path,
+// following every symbolic link component. Components that do not exist are
+// appended literally: a write that needs them fails with a "not exist" error
+// anyway, and they cannot redirect the resolution elsewhere. The result is
+// absolute.
+func resolvePathLinks(path string) (string, error) {
+	// NB: filepath.Abs (and filepath.Join) call Clean, and cleaning would
+	// cancel a ".." against a preceding symbolic link name on paper only.
+	// Prefix the working directory by hand so the components reach the walk
+	// in their original order.
+	if !filepath.IsAbs(path) {
+		wd, err := os.Getwd()
+		if err != nil {
+			return "", err
+		}
+		path = joinRaw(wd, path)
+	}
+	pending := pathComponents(path)
+	resolved := string(filepath.Separator)
+	followed := 0
+	for len(pending) > 0 {
+		comp := pending[0]
+		pending = pending[1:]
+		switch comp {
+		case ".", "":
+			continue
+		case "..":
+			resolved = filepath.Dir(resolved)
+			continue
+		}
+
+		next := filepath.Join(resolved, comp)
+		info, err := os.Lstat(next)
+		if err != nil {
+			if os.IsNotExist(err) {
+				// Nothing exists from here on. Resolve the remainder
+				// lexically; any operation through it fails with a
+				// "not exist" error before touching anything.
+				rest := make([]string, 0, len(pending)+1)
+				rest = append(rest, comp)
+				rest = append(rest, pending...)
+				return filepath.Join(resolved, filepath.Join(rest...)), nil
+			}
+			return "", err
+		}
+		if info.Mode()&os.ModeSymlink == 0 {
+			resolved = next
+			continue
+		}
+
+		followed++
+		if followed > maxSymlinkDepth {
+			return "", fmt.Errorf("too many levels of symbolic links resolving %q", path)
+		}
+		target, err := os.Readlink(next)
+		if err != nil {
+			return "", err
+		}
+		if filepath.IsAbs(target) {
+			resolved = string(filepath.Separator)
+		}
+		// A relative link target is relative to the directory holding the
+		// link, which is still `resolved`; prepend it to the pending work.
+		pending = append(pathComponents(target), pending...)
+	}
+	return resolved, nil
+}
+
+// checkContained reports whether target resolves to a location inside base
+// once every symbolic link along the way has been followed. On an escape it
+// returns ErrPathTraversalDisallowed.
+func checkContained(base, target string) error {
+	realBase, err := resolvePathLinks(base)
+	if err != nil {
+		return err
+	}
+	realTarget, err := resolvePathLinks(target)
+	if err != nil {
+		return err
+	}
+	rel, err := filepath.Rel(realBase, realTarget)
+	if err != nil {
+		return ErrPathTraversalDisallowed
+	}
+	rel = filepath.ToSlash(rel)
+	if rel == ".." || strings.HasPrefix(rel, "../") {
+		return ErrPathTraversalDisallowed
+	}
+	return nil
+}
+
+// linkTargetLocation returns the path a symbolic link placed at linkPath with
+// the given archive linkname points to, relative names being anchored at the
+// link's own directory, without cleaning the result.
+func linkTargetLocation(linkPath, linkname string) string {
+	if filepath.IsAbs(linkname) {
+		return linkname
+	}
+	return joinRaw(filepath.Dir(linkPath), linkname)
+}
