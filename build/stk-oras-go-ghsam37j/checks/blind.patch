+// hardLinkPath validates a hard-link member's target and returns the path that
+// os.Link should receive. A relative linkname is anchored at the link's own
+// directory, not at the process working directory, so the file that is linked
+// is the one the containment checks inspected.
+func hardLinkPath(baseAbs, baseRel, link, target string) (string, error) {
+	path := linkTargetLocation(link, target)
+	// Reuse the member-name checks for the lexical and per-directory part.
+	if _, err := resolveRelToBase(baseAbs, baseRel, path); err != nil {
+		return "", err
+	}
+	// Then verify where the kernel would actually take that path.
+	if err := checkContained(baseAbs, path); err != nil {
+		return "", err
+	}
+	return path, nil
+}
