+// ensureHardLinkPath validates a hard link target and returns the path os.Link
+// should use. A relative linkname is resolved against the link's directory, so
+// the linked path is the one the containment check validated rather than a
+// path relative to the process working directory.
+func ensureHardLinkPath(baseAbs, baseRel, link, target string) (string, error) {
+	path := target
+	if !filepath.IsAbs(target) {
+		path = filepath.Join(filepath.Dir(link), target)
+	}
+	if _, err := resolveRelToBase(baseAbs, baseRel, path); err != nil {
+		return "", err
+	}
+	return path, nil
+}
