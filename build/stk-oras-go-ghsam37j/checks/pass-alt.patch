@@ -686,3 +689,19 @@ func (s *Store) setClosed() {
 func ensureDir(path string) error {
 	return os.MkdirAll(path, 0777)
 }
+
+// checkSymlinkComponents rejects a write whose path crosses a symbolic link below base.
+func checkSymlinkComponents(base, target string) error {
+	rel, err := filepath.Rel(base, target)
+	if err != nil {
+		return ErrPathTraversalDisallowed
+	}
+	dir := filepath.Dir(rel)
+	for dir != "." {
+		if info, err := os.Lstat(filepath.Join(base, dir)); err == nil && info.Mode()&os.ModeSymlink != 0 {
+			return ErrPathTraversalDisallowed
+		}
+		dir = filepath.Dir(dir)
+	}
+	return nil
+}
