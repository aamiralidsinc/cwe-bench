+    /**
+     * Verifies that the current user is allowed to build every project this
+     * trigger names. Names are resolved with full privileges so that a project
+     * the user cannot see is still checked, and the permission itself is then
+     * checked as the current user.
+     */
+    public static void checkDownstreamPermissions(BuildTrigger trigger, AbstractProject owner) {
+        List<AbstractProject> children;
+        SecurityContext orig = ACL.impersonate(ACL.SYSTEM);
+        try {
+            children = trigger.getChildProjects(owner);
+        } finally {
+            SecurityContextHolder.setContext(orig);
+        }
+        for (AbstractProject downstream : children)
+            downstream.checkPermission(Item.BUILD);
+    }
