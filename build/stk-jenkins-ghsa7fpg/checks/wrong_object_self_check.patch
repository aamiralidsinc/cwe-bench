+     * using the trigger stored on the given project.
+     */
+    public static void checkDownstreamPermissions(AbstractProject owner) {
+        BuildTrigger trigger = (BuildTrigger) owner.getPublishersList().get(BuildTrigger.class);
+        if (trigger != null)
+            checkDownstreamPermissions(trigger, owner);
+    }
