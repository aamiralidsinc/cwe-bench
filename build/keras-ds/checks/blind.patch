diff -ruN a/keras/src/saving/h5_safety.py b/keras/src/saving/h5_safety.py
--- a/keras/src/saving/h5_safety.py	1970-01-01 00:00:00.000000000 +0000
+++ b/keras/src/saving/h5_safety.py	2026-10-20 22:46:29.461662435 +0000
@@ -0,0 +1,169 @@
+"""Safety checks for HDF5 files holding model or weight data.
+
+An HDF5 file can express indirection to data that is not stored in the file
+itself:
+
+* external links (``h5py.ExternalLink``) make an entry resolve to an object
+  kept in a different file, resolved relative to the file holding the link;
+* datasets can declare *external storage*, so that their raw bytes live in a
+  different file;
+* virtual datasets (VDS) read their values from one or more other files.
+
+A model or weights artifact obtained from a third party must never be allowed
+to pull in data from outside the artifact. These helpers reject each of the
+constructs above before any value is dereferenced or read.
+"""
+
+try:
+    import h5py
+except ImportError:
+    h5py = None
+
+
+class H5ArtifactError(ValueError):
+    """Raised when an H5 artifact references data outside of itself.
+
+    Subclasses `ValueError` so that it is reported to callers as a regular
+    client-side error, while still being distinguishable from recoverable
+    weight-loading errors (`skip_mismatch` must never hide it).
+    """
+
+
+def validate_h5_dataset(dataset, path=None):
+    """Rejects datasets whose values are read from outside the file.
+
+    Args:
+        dataset: An `h5py.Dataset` instance.
+        path: Optional human-readable location of the dataset, used in the
+            error message.
+
+    Returns:
+        The dataset, unchanged, when it only holds data of its own file.
+    """
+    if dataset.external:
+        raise H5ArtifactError(
+            "Not allowed: H5 file Dataset with external links: "
+            f"{dataset.external}"
+        )
+    if getattr(dataset, "is_virtual", False):
+        try:
+            sources = [
+                (source.file_name, source.dset_name)
+                for source in dataset.virtual_sources()
+            ]
+        except Exception:
+            sources = []
+        location = f" at '{path}'" if path else ""
+        raise H5ArtifactError(
+            "Not allowed: H5 file Dataset with virtual sources pointing to "
+            f"other files: {sources}{location}"
+        )
+    return dataset
+
+
+def _validate_link(link, path):
+    """Rejects link objects that are not plain hard links."""
+    if isinstance(link, h5py.ExternalLink):
+        raise H5ArtifactError(
+            "Not allowed: H5 file entry is a link to another file: "
+            f"'{path}' -> '{link.filename}':{link.path}"
+        )
+    if isinstance(link, h5py.SoftLink):
+        raise H5ArtifactError(
+            "Not allowed: H5 file entry is a soft link, which may resolve "
+            f"outside of the file: '{path}' -> {link.path}"
+        )
+
+
+def _resolve_path(group, path):
+    """Resolves an HDF5 path while checking every link on the way.
+
+    Unlike `h5py.Group.get`, this walks the path one component at a time so
+    that an external link in the middle of a path cannot be silently followed.
+    """
+    if path.startswith("/"):
+        current = group.file["/"]
+        components = path.split("/")
+    else:
+        current = group
+        components = path.split("/")
+    for component in components:
+        if component in ("", "."):
+            continue
+        if component == "..":
+            raise H5ArtifactError(
+                "Not allowed: H5 file path contains a parent reference: "
+                f"{path}"
+            )
+        if not isinstance(current, h5py.Group):
+            raise KeyError(path)
+        link = current.get(component, getlink=True)
+        if link is None:
+            raise KeyError(path)
+        _validate_link(link, component)
+        current = current[component]
+    return current
+
+
+def get_validated_entry(group, name):
+    """Returns `group[name]` after checking every link on the path.
+
+    Args:
+        group: An `h5py.Group` (or `h5py.File`) instance.
+        name: The name or HDF5 path of the entry to resolve.
+
+    Returns:
+        The resolved object (group or dataset). Datasets are additionally
+        checked for external storage and virtual sources.
+    """
+    if h5py is None:
+        raise ImportError("h5py must be installed to load H5 files.")
+    if isinstance(name, bytes):
+        name = name.decode("utf8")
+    name = str(name)
+    value = _resolve_path(group, name)
+    if isinstance(value, h5py.Dataset):
+        validate_h5_dataset(value, path=name)
+    return value
+
+
+def validate_h5_artifact(h5_obj):
+    """Rejects any entry of an HDF5 file that reaches outside of it.
+
+    The whole object tree is inspected (only link metadata and dataset layout
+    are read; no dataset values are loaded), so that an out-of-bounds entry is
+    refused no matter where it sits in the artifact: a single value, a group,
+    the top-level container or optimizer state.
+
+    Args:
+        h5_obj: An `h5py.File`, `h5py.Group` or `h5py.Dataset`.
+    """
+    if h5py is None or h5_obj is None:
+        return
+    if isinstance(h5_obj, h5py.Dataset):
+        validate_h5_dataset(h5_obj)
+        return
+    if not isinstance(h5_obj, h5py.Group):
+        return
+
+    seen = set()
+    stack = [(h5_obj, "")]
+    while stack:
+        group, prefix = stack.pop()
+        # Hard links may form cycles (a group linked inside itself); visit
+        # every group only once so that the walk always terminates.
+        seen.add(group.id)
+        for key in list(group.keys()):
+            path = f"{prefix}/{key}" if prefix else key
+            link = group.get(key, getlink=True)
+            if link is None:
+                # Broken / dangling link: nothing can be read through it.
+                continue
+            _validate_link(link, path)
+            child = group[key]
+            if isinstance(child, h5py.Group):
+                if child.id in seen:
+                    continue
+                stack.append((child, path))
+            elif isinstance(child, h5py.Dataset):
+                validate_h5_dataset(child, path=path)
