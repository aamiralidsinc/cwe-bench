+def _validate_h5_artifact(node, depth=0):
+    """Reject any link, external value or virtual value in an artifact."""
+    if depth > 100:
+        raise ValueError("Invalid H5 file: nesting too deep")
+    for name in node.keys():
+        link_type = node.get(name, default=None, getclass=True, getlink=True)
+        if link_type in (h5py.ExternalLink, h5py.SoftLink):
+            raise ValueError(f"Not allowed: H5 file with {link_type.__name__}")
+        obj = node[name]
+        if isinstance(obj, h5py.Group):
+            _validate_h5_artifact(obj, depth + 1)
+        elif isinstance(obj, h5py.Dataset):
+            if obj.external:
+                raise ValueError(
+                    "Not allowed: H5 file with external Dataset: "
+                    f"{obj.external}"
+                )
+            if obj.is_virtual:
+                raise ValueError("Not allowed: H5 file with virtual Dataset")
+
