+    /**
+     * Frames signed with a server-side token are trusted; everything else is client supplied.
+     */
+    private function isTrustedSocketSender($msgObj) {
+        if (!empty($msgObj->isCommandLineInterface)) {
+            return true;
+        }
+        return ($msgObj->sentFrom ?? '') === 'php';
+    }
+
+    /**
+     * Drop executable fields from every carrier in an outgoing payload.
+     */
+    private function removeExecutableFields(&$data) {
+        if (is_object($data)) {
+            $data = object_to_array($data);
+        }
+        if (!is_array($data)) {
+            return;
+        }
+        if (array_key_exists('autoEvalCodeOnHTML', $data)) {
+            unset($data['autoEvalCodeOnHTML']);
+        }
+        foreach ($data as &$value) {
+            if (is_array($value) || is_object($value)) {
+                $this->removeExecutableFields($value);
+            }
+        }
+        unset($value);
+    }
+
+    private function enforceSenderIdentity(&$data, $msgObj)
+    {
+        if (is_object($data)) {
+            $data = object_to_array($data);
+        }
+        if (!is_array($data)) {
+            return;
+        }
+        if (array_key_exists('from_users_id', $data)) {
+            $data['from_users_id'] = $msgObj->from_users_id;
+        }
+        if (array_key_exists('from_identification', $data)) {
+            $data['from_identification'] = strip_tags((string)($msgObj->user_name ?? ''));
+        }
+        foreach ($data as &$value) {
+            if (is_array($value) || is_object($value)) {
+                $this->enforceSenderIdentity($value, $msgObj);
+            }
+        }
+        unset($value);
+    }
+
+    private function isPlainFunctionName($value) {
+        return is_string($value) && preg_match('/^[a-zA-Z_][a-zA-Z0-9_]*$/', $value) === 1;
+    }
