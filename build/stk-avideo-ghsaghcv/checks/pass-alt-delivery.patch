+            $data['from_users_id'] = $this->frameSender->from_users_id;
+        }
+        if (array_key_exists('from_identification', $data)) {
+            $data['from_identification'] = strip_tags((string)($this->frameSender->user_name ?? ''));
+        }
+        foreach ($data as &$value) {
+            if (is_array($value) || is_object($value)) {
+                $this->scrubClientFrame($value);
+            }
+        }
+        unset($value);
