index 1e19944..aef1926 100644
--- a/trestle/common/file_utils.py
+++ b/trestle/common/file_utils.py
@@ -92,6 +92,22 @@ def is_local_and_visible(file_path: pathlib.Path) -> bool:
     return not (is_hidden(file_path) or is_symlink(file_path))
 
 
+def require_within_workspace(path: pathlib.Path, trestle_root: pathlib.Path) -> pathlib.Path:
+    """Return path unchanged, raising if it resolves outside the trestle workspace."""
+    root = os.path.realpath(str(trestle_root))
+    candidate = pathlib.Path(path)
+    if not candidate.is_absolute():
+        candidate = pathlib.Path(trestle_root) / candidate
+    target = os.path.realpath(str(candidate))
+    try:
+        inside = os.path.commonpath([root, target]) == root
+    except ValueError:
+        inside = False
+    if not inside:
+        raise TrestleError(f'Path {path} is outside the trestle workspace {trestle_root}')
+    return pathlib.Path(target)
+
+
 def is_directory_name_allowed(name: str) -> bool:
     """Determine whether a directory name, which is a 'non-core-OSCAL activity/directory is allowed.
 
@@ -105,6 +121,17 @@ def is_directory_name_allowed(name: str) -> bool:
     # Task must not self-interfere with a project
     pathed_name = pathlib.Path(name)
 
+    # Defense-in-depth: reject absolute paths
+    # Check both is_absolute() and if the name starts with '/' to handle Unix-style paths on Windows.
+    if pathed_name.is_absolute() or name.startswith('/'):
+        logger.warning('Task name must not be an absolute path')
+        return False
+
+    # Defense-in-depth: reject any path containing ".." components
+    if '..' in pathed_name.parts:
+        logger.warning('Task name must not contain ".." path traversal sequences')
+        return False
+
     root_path = pathed_name.parts[0]
     if root_path in const.MODEL_TYPE_TO_MODEL_DIR.values():
         logger.warning('Task name is the same as an OSCAL schema name.')
