     return not (is_hidden(file_path) or is_symlink(file_path))
 
 
+def path_is_within_workspace(candidate: pathlib.Path, trestle_root: pathlib.Path) -> bool:
+    """Return True only when candidate resolves to a location inside trestle_root."""
+    root = pathlib.Path(trestle_root).resolve()
+    target = pathlib.Path(candidate)
+    if not target.is_absolute():
+        target = root / target
+    try:
+        target.resolve().relative_to(root)
+    except ValueError:
+        return False
+    return True
+
