+
+function resolveSymlinks(path: string, depth = 0): string {
+  if (depth > 32) {
+    throw new Error(`Access denied to "${path}". Too many symbolic links.`)
+  }
+  const absolute = resolve(path)
+  const parts: string[] = []
+  let current = absolute
+  while (true) {
+    const parent = dirname(current)
+    if (parent === current) {
+      break
+    }
+    parts.unshift(basename(current))
+    current = parent
+  }
+  for (let index = 0; index < parts.length; index++) {
+    const next = resolve(current, parts[index])
+    let stat: fs.Stats
+    try {
+      stat = fs.lstatSync(next)
+    }
+    catch {
+      return resolve(next, ...parts.slice(index + 1))
+    }
+    if (stat.isSymbolicLink()) {
+      const target = fs.readlinkSync(next)
+      return resolveSymlinks(
+        resolve(dirname(next), target, ...parts.slice(index + 1)),
+        depth + 1,
+      )
+    }
+    current = next
+  }
+  return current
+}
+
+function assertInsideProjectRoot(path: string, project: TestProject) {
+  const root = slash(resolveSymlinks(project.config.root))
+  const target = slash(resolveSymlinks(path))
+  if (target !== root && !target.startsWith(`${root}/`)) {
+    throw new Error(
+      `Access denied to "${path}". The path is outside of the project root.`,
     )
   }
 }
