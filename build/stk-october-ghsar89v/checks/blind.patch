diff -ruN pristine/modules/system/twig/SafeModePolicy.php app/modules/system/twig/SafeModePolicy.php
--- a/modules/system/twig/SafeModePolicy.php	1970-01-01 00:00:00.000000000 +0000
+++ b/modules/system/twig/SafeModePolicy.php	2026-10-26 05:18:09.988541079 +0000
@@ -0,0 +1,135 @@
+<?php namespace System\Twig;
+
+use Config;
+use Twig\Markup;
+use Twig\Template;
+use Twig\Sandbox\SecurityPolicyInterface;
+use Twig\Sandbox\SecurityNotAllowedMethodError;
+
+/**
+ * With the CMS safe mode enabled a template author may change markup and expressions,
+ * but must not be able to run PHP. The objects a template can reach (pages, layouts,
+ * the controller, the storage layer behind them) all implement October's extension,
+ * event and datasource APIs, and each of those APIs can turn a template expression
+ * into a PHP call:
+ *
+ * - addDynamicMethod()/addDynamicProperty() register an arbitrary callable that the
+ *   template then invokes (the extension mechanism);
+ * - extendClassWith() instantiates an arbitrary class against the object;
+ * - bindEvent()/bindEventOnce() register an arbitrary callable that fireEvent() invokes;
+ * - insert()/update()/delete()/write() persist template-supplied content (including a
+ *   PHP code section) straight through the datasource, bypassing the save-time guard.
+ *
+ * Those method names are therefore not callable from a template while safe mode is on.
+ * Every other method and every property keeps working exactly as before; the policy
+ * does not restrict tags, filters, functions or properties.
+ *
+ * @package october\system
+ */
+final class SafeModePolicy implements SecurityPolicyInterface
+{
+    /**
+     * @var array Method names (lower case) that a template may never call while safe mode is on.
+     */
+    protected static $blockedMethods = [
+        'adddynamicmethod' => true,
+        'adddynamicproperty' => true,
+        'extendclasswith' => true,
+        'bindevent' => true,
+        'bindeventonce' => true,
+        'unbindevent' => true,
+        'insert' => true,
+        'update' => true,
+        'delete' => true,
+        'forcedelete' => true,
+        'write' => true,
+    ];
+
+    /**
+     * @var array Method name prefixes (lower case) that are never callable from a template.
+     */
+    protected static $blockedPrefixes = [
+        'adddynamic',
+        'bindevent',
+        'unbindevent',
+    ];
+
+    /**
+     * {@inheritdoc}
+     */
+    public function checkSecurity($tags, $filters, $functions)
+    {
+    }
+
+    /**
+     * {@inheritdoc}
+     */
+    public function checkPropertyAllowed($obj, $property)
+    {
+    }
+
+    /**
+     * {@inheritdoc}
+     */
+    public function checkMethodAllowed($obj, $method)
+    {
+        if (!self::safeModeEnabled()) {
+            return;
+        }
+
+        /*
+         * Template and markup objects are internals of the rendering engine itself.
+         */
+        if ($obj instanceof Template || $obj instanceof Markup) {
+            return;
+        }
+
+        if (!self::isBlockedMethod($method)) {
+            return;
+        }
+
+        $class = get_class($obj);
+        throw new SecurityNotAllowedMethodError(
+            sprintf('Calling "%s" on a "%s" object is not allowed in CMS safe mode.', $method, $class),
+            $class,
+            $method
+        );
+    }
+
+    /**
+     * @param string $method
+     * @return bool
+     */
+    protected static function isBlockedMethod($method)
+    {
+        $method = strtolower((string) $method);
+
+        if (isset(self::$blockedMethods[$method])) {
+            return true;
+        }
+
+        foreach (self::$blockedPrefixes as $prefix) {
+            if (strpos($method, $prefix) === 0) {
+                return true;
+            }
+        }
+
+        return false;
+    }
+
+    /**
+     * Mirrors Cms\Helpers\Cms::safeModeEnabled() without making the system module
+     * depend on the cms module.
+     *
+     * @return bool
+     */
+    protected static function safeModeEnabled()
+    {
+        $safeMode = Config::get('cms.enableSafeMode', null);
+        if ($safeMode === null) {
+            $safeMode = !Config::get('app.debug', false);
+        }
+
+        return (bool) $safeMode;
+    }
+}
