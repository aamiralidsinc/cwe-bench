+    /**
+     * Guard for helpers that dump or serialize PHP state: they bypass the Twig
+     * sandbox member gate (print_r/vardump reflect private and protected state,
+     * json_encode/yaml_encode/string serialize it) so they must refuse objects
+     * themselves. Two tiers, applied recursively to arrays:
+     *  - $reflective: only a plain stdClass (pure page-header data) may pass.
+     *  - otherwise: the object's class must be allow-listed by the active policy.
+     * No-op outside sandboxed editor content, so trusted templates are
+     * unaffected.
+     *
+     * @param Environment $env
+     * @param mixed $var
+     * @param string $filter
+     * @param bool $reflective
+     * @return void
+     */
+    protected function assertSandboxDumpSafe(Environment $env, mixed $var, string $filter, bool $reflective): void
+    {
+        $sandbox = $this->contentSandbox($env);
+        if ($sandbox === null) {
+            return;
+        }
+
+        $policy = $sandbox->getSecurityPolicy();
+        $this->scanSandboxDump($policy instanceof GravSecurityPolicy ? $policy : null, $var, $filter, $reflective);
+    }
+
+    /**
+     * @param GravSecurityPolicy|null $policy
+     * @param mixed $var
+     * @param string $filter
+     * @param bool $reflective
+     * @param int $depth
+     * @return void
+     */
+    private function scanSandboxDump(?GravSecurityPolicy $policy, mixed $var, string $filter, bool $reflective, int $depth = 0): void
+    {
+        if ($depth > 16) {
+            throw new SecurityNotAllowedFilterError(
+                sprintf('Filter "%s" is not allowed on deeply nested data inside sandboxed content.', $filter),
+                $filter
+            );
+        }
+
+        if (is_array($var)) {
+            return;
+        }
+
+        if (!is_object($var)) {
+            return;
+        }
+
+        $allowed = $reflective
+            ? $var instanceof \stdClass
+            : ($policy !== null && $policy->isClassAllowed($var));
+
+        if (!$allowed) {
+            throw new SecurityNotAllowedFilterError(
+                sprintf('Filter "%s" is not allowed on a "%s" object inside sandboxed content.', $filter, $var::class),
+                $filter
+            );
+        }
+    }
