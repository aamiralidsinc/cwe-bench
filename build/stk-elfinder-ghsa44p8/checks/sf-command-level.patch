diff --git a/php/elFinderVolumeLocalFileSystem.class.php b/php/elFinderVolumeLocalFileSystem.class.php
index 3809c8373..035bc5752 100644
--- a/php/elFinderVolumeLocalFileSystem.class.php
+++ b/php/elFinderVolumeLocalFileSystem.class.php
@@ -419,11 +419,39 @@ class elFinderVolumeLocalFileSystem extends elFinderVolumeDriver {
 		$real_path   = $this->getFullPath($path,   $cwd);
 		$real_parent = $this->getFullPath($parent, $cwd);
 		if ($real_path && $real_parent) {
+			$real_path   = $this->normalizeLexicalPath($real_path);
+			$real_parent = $this->normalizeLexicalPath($real_parent);
 			return $real_path === $real_parent || strpos($real_path, rtrim($real_parent, DIRECTORY_SEPARATOR).DIRECTORY_SEPARATOR) === 0;
 		}
 		return false;
 	}
 	
+	/**
+	 * Collapse `.` and `..` segments of a path without touching the file system
+	 *
+	 * @param  string  $path  file path
+	 * @return string
+	 **/
+	protected function normalizeLexicalPath($path) {
+		$absolute = ($path !== '' && $path[0] === DIRECTORY_SEPARATOR);
+		$result = array();
+		foreach (explode(DIRECTORY_SEPARATOR, $path) as $part) {
+			if ($part === '' || $part === '.') {
+				continue;
+			}
+			if ($part === '..') {
+				if (!empty($result) && end($result) !== '..') {
+					array_pop($result);
+				} else if (!$absolute) {
+					$result[] = '..';
+				}
+			} else {
+				$result[] = $part;
+			}
+		}
+		return ($absolute? DIRECTORY_SEPARATOR : '') . join(DIRECTORY_SEPARATOR, $result);
+	}
