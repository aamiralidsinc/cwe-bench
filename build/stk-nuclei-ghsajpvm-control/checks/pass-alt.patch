 // Replace replaces placeholders in template with values on the fly.
+//
+// Only placeholders whose key exists in values are matched, and the scan runs
+// over the original template in one pass: an inserted value is exactly the
+// substitute and is never inspected for further placeholders.
 func Replace(template string, values map[string]interface{}) string {
-	valuesMap := make(map[string]interface{}, len(values))
-	for k, v := range values {
-		valuesMap[k] = types.ToString(v)
+	if template == "" || len(values) == 0 {
+		return template
+	}
+
+	keys := make([]string, 0, len(values))
+	for key := range values {
+		if key == "" {
+			continue
+		}
+		keys = append(keys, regexp.QuoteMeta(key))
 	}
-	replaced := fasttemplate.ExecuteStringStd(template, marker.ParenthesisOpen, marker.ParenthesisClose, valuesMap)
-	final := fasttemplate.ExecuteStringStd(replaced, marker.General, marker.General, valuesMap)
-	return final
+	if len(keys) == 0 {
+		return template
+	}
+	sort.Slice(keys, func(i, j int) bool { return len(keys[i]) > len(keys[j]) })
+	alternatives := strings.Join(keys, "|")
+	pattern := regexp.MustCompile(
+		regexp.QuoteMeta(marker.ParenthesisOpen) + "(" + alternatives + ")" + regexp.QuoteMeta(marker.ParenthesisClose) +
+			"|" + regexp.QuoteMeta(marker.General) + "(" + alternatives + ")" + regexp.QuoteMeta(marker.General),
+	)
+
+	return pattern.ReplaceAllStringFunc(template, func(match string) string {
+		var inner string
+		if strings.HasPrefix(match, marker.ParenthesisOpen) {
+			inner = strings.TrimSuffix(strings.TrimPrefix(match, marker.ParenthesisOpen), marker.ParenthesisClose)
+		} else {
+			inner = strings.TrimSuffix(strings.TrimPrefix(match, marker.General), marker.General)
+		}
+		if value, ok := values[inner]; ok {
+			return types.ToString(value)
+		}
+		return match
+	})
 }
 
