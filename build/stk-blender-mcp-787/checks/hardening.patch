+
+def _safe_temp_name(value, fallback):
+    """Return a plain file-name component for a caller-supplied identifier."""
+    name = os.path.basename(value or "")
+    if name in ("", ".", "..") or "\x00" in name:
+        return fallback
+    return name
+
+
+def _confined_join(base, name):
+    """Return a path under base for a relative name, or None when it would escape."""
+    if not name or "\x00" in name or os.path.isabs(name):
+        return None
+    base_abs = os.path.abspath(base)
+    target = os.path.abspath(os.path.join(base_abs, os.path.normpath(name)))
+    if target != base_abs and not target.startswith(base_abs + os.sep):
+        return None
+    if ".." in name.replace("\\", "/").split("/"):
+        return None
+    return target
+
 
