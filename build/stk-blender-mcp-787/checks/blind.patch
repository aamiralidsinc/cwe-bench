 REQ_HEADERS = requests.utils.default_headers()
 REQ_HEADERS.update({"User-Agent": "blender-mcp"})
 
+
+def _confined_path(base_dir, name, what="path"):
+    """Resolve ``name`` inside ``base_dir``, or raise ``ValueError``.
+
+    Asset services and callers supply these names, so nothing about them is trusted:
+    an absolute path, a ``..`` component or any other form whose normalized location
+    is not strictly below ``base_dir`` is refused before a directory, a file or an
+    extraction target is created.
+    """
+    if not isinstance(name, str) or not name:
+        raise ValueError(f"empty {what}")
+    normalized = os.path.normpath(name)
+    if os.path.isabs(name) or os.path.isabs(normalized):
+        raise ValueError(f"{what} is an absolute path: {name!r}")
+    base = os.path.abspath(base_dir)
+    target = os.path.abspath(os.path.join(base, normalized))
+    try:
+        inside_base = os.path.commonpath([base, target]) == base
+    except ValueError:
+        inside_base = False
+    if not inside_base or target == base:
+        raise ValueError(f"{what} escapes the asset's temporary folder: {name!r}")
+    return target
+
+
+def _name_fragment(value, fallback="asset"):
+    """Reduce an untrusted identifier to characters that cannot form a path component.
+
+    Used wherever an identifier becomes part of a file name (``tempfile`` prefixes,
+    archive names), so a separator or an absolute form cannot decide the directory
+    the file is created in.
+    """
+    fragment = re.sub(r"[^A-Za-z0-9._-]", "_", str(value if value is not None else ""))
+    fragment = fragment.lstrip(".")
+    return fragment or fallback
+
+
+def _extract_zip_within(zip_ref, base_dir):
+    """Extract ``zip_ref`` into ``base_dir`` after checking every member name."""
+    for member in zip_ref.infolist():
+        _confined_path(base_dir, member.filename, what="archive member")
+    zip_ref.extractall(base_dir)
+
