+			http.MethodPost,
+			http.MethodPut,
+			http.MethodPatch,
+			http.MethodDelete,
+			http.MethodOptions,
+			http.MethodHead,
+		},
+		// AllowedHeaders: nil reflects the client's Access-Control-Request-Headers,
+		// which is the equivalent of "*" under credentialed CORS.
+		AllowedHeaders:   nil,
+		ExposedHeaders:   nil,
+		AllowCredentials: true,
+		MaxAge:           "",
+	})
+}
