+// isDashboardOrigin accepts only the origins the local dashboard is served
+// from: <subdomain>.dashboard.local.nhost.run (one DNS label) or
+// local.dashboard.nhost.run, over http or https, on any port.
+func isDashboardOrigin(origin string) bool {
+	u, err := url.Parse(origin)
+	if err != nil || (u.Scheme != "http" && u.Scheme != "https") {
+		return false
+	}
+
+	if u.User != nil || u.Path != "" || u.RawQuery != "" || u.Fragment != "" {
+		return false
+	}
+
+	if p := u.Port(); p != "" {
+		if _, err := strconv.ParseUint(p, 10, 16); err != nil {
+			return false
+		}
+	}
+
+	host := u.Hostname()
+	if host == "local.dashboard.nhost.run" {
+		return true
+	}
+
+	sub, ok := strings.CutSuffix(host, ".dashboard.local.nhost.run")
+
+	return ok && sub != "" && !strings.ContainsAny(sub, "./")
+}
+
+func dashboardCORS() gin.HandlerFunc {
+	return cors.New(cors.Options{ //nolint:exhaustruct
+		AllowOriginFunc: isDashboardOrigin,
+		AllowedMethods: []string{
+			http.MethodGet, http.MethodPost, http.MethodPut, http.MethodPatch,
+			http.MethodDelete, http.MethodHead,
+		},
+		AllowedHeaders:   []string{"*"},
+		AllowCredentials: true,
+	})
+}
