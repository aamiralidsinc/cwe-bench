 func (l *Local) UpdateSecrets(_ context.Context, _, newApp *graph.App, _ logrus.FieldLogger) error {
+	stored := map[string]string{}
+	if b, err := os.ReadFile(l.secrets); err == nil {
+		var current model.Secrets
+		if err := env.Unmarshal(b, &current); err != nil {
+			return fmt.Errorf("failed to parse secrets file: %w", err)
+		}
+
+		for _, s := range current {
+			stored[s.Name] = s.Value
+		}
+	} else if !errors.Is(err, os.ErrNotExist) {
+		return fmt.Errorf("failed to read secrets file: %w", err)
+	}
+
 	m := make(map[string]string)
 	for _, v := range newApp.Secrets {
+		if v.Value == maskedSecret {
+			if old, ok := stored[v.Name]; ok {
+				m[v.Name] = old
+			}
+
+			continue
+		}
+
 		m[v.Name] = v.Value
 	}
 
