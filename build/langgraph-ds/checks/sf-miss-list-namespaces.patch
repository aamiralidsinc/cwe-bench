+def _validate_scope_labels(path: tuple[str, ...]) -> None:
+    """Reject a scope path whose labels cannot name a stored namespace.
+
+    A namespace label is a non-empty string without a period, so a scope that
+    contains any other label cannot describe a stored namespace. Rejecting it
+    keeps a malformed scope from being reinterpreted as a different path.
+    """
+    for label in path:
+        if not isinstance(label, str) or not label or "." in label:
+            raise InvalidNamespaceError(
+                f"Invalid namespace scope label '{label}' in {path}. Namespace labels"
+                " must be non-empty strings that do not contain periods ('.')."
+            )
+
+
 def _validate_namespace(namespace: tuple[str, ...]) -> None:
     if not namespace:
         raise InvalidNamespaceError("Namespace cannot be empty.")
