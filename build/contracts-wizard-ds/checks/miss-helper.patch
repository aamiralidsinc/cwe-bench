 import type { ContractBuilder } from './contract';
+import { OptionsError } from './error';
 
 export const TAG_SECURITY_CONTACT = `@custom:security-contact`;
 
@@ -11,14 +12,33 @@ export type Info = {
   license?: string;
 };
 
+// Values placed in header comments cannot carry a line break, since a comment has no escape
+// syntax and the break would start a new source line.
+function hasLineTerminator(value: string): boolean {
+  for (const ch of value) {
+    const code = ch.codePointAt(0)!;
+    if (code === 0x0a || code === 0x0d || code === 0x0b || code === 0x2028 || code === 0x2029) {
+      return true;
+    }
+  }
+  return false;
+}
+
+function singleLine(field: keyof Info, value: string): string {
+  if (hasLineTerminator(value)) {
+    throw new OptionsError({ [field]: 'Line breaks are not allowed' });
+  }
+  return value;
+}
+
 export function setInfo(c: ContractBuilder, info: Info) {
   const { securityContact, license } = info;
 
   if (securityContact) {
-    c.addNatspecTag(TAG_SECURITY_CONTACT, securityContact);
+    c.addNatspecTag(TAG_SECURITY_CONTACT, singleLine('securityContact', securityContact));
   }
 
   if (license) {
-    c.license = license;
+    c.license = singleLine('license', license);
   }
 }
