+    c.license = singleLine(license);
   }
 }
diff --git a/packages/core/solidity/src/utils/sanitize.ts b/packages/core/solidity/src/utils/sanitize.ts
index 7830cc5..c0a77d8 100644
--- a/packages/core/solidity/src/utils/sanitize.ts
+++ b/packages/core/solidity/src/utils/sanitize.ts
@@ -1,6 +1,15 @@
+// Alternative design: every value is emitted as a unicode literal, with the characters the
+// grammar excludes escaped. ASCII text is therefore also carried by a unicode literal.
 export function stringifyUnicodeSafe(str: string): string {
-  // eslint-disable-next-line no-control-regex
-  const containsUnicode = /[^\x00-\x7F]/.test(str);
-
-  return containsUnicode ? `unicode"${str.replace(/"/g, '\\"')}"` : JSON.stringify(str);
+  let body = '';
+  for (const ch of str) {
+    const code = ch.codePointAt(0)!;
+    if (ch === '\\') body += '\\\\';
+    else if (ch === '"') body += '\\"';
+    else if (code === 0x0a) body += '\\n';
+    else if (code === 0x0d) body += '\\r';
+    else if (code === 0x0b) body += '\\x0b';
+    else body += ch;
+  }
+  return `unicode"${body}"`;
 }
