+// Alternative design: fold a line break into a space so the value stays on one comment line.
+function singleLine(value: string): string {
+  let out = '';
+  for (const ch of value) {
+    const code = ch.codePointAt(0)!;
+    out += code === 0x0a || code === 0x0d || code === 0x0b || code === 0x2028 || code === 0x2029 ? ' ' : ch;
+  }
+  return out;
+}
+
