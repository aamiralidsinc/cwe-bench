+    private static boolean isInsideTemplateRoot(String name) {
+        int level = 0;
+        int start = 0;
+        int len = name.length();
+        for (int i = 0; i <= len; i++) {
+            if (i == len || name.charAt(i) == '/' || name.charAt(i) == '\\') {
+                int partLen = i - start;
+                if (partLen == 2 && name.charAt(start) == '.' && name.charAt(start + 1) == '.') {
+                    level--;
+                    if (level < 0) {
+                        return false;
+                    }
+                } else if (partLen > 0 && !(partLen == 1 && name.charAt(start) == '.')) {
+                    level++;
+                }
+                start = i + 1;
+            }
+        }
+        return true;
+    }
