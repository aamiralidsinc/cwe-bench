+            appendPartToLocaleInfix(infix, locale.getCountry(), 1);
+        }
+        if (hasVariant && (hasLang || hasCountry)) {
+            appendPartToLocaleInfix(infix, locale.getVariant(), 2);
+        }
+        if (hasScript && (hasLang || hasCountry)) {
+            appendPartToLocaleInfix(infix, locale.getScript(), 3);
+        }
