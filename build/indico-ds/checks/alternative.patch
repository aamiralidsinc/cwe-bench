+class WebURL:
+    def __call__(self, form, field):
+        if not field.data:
+            return
+        try:
+            scheme = urlsplit(field.data).scheme.lower()
+        except ValueError:
+            scheme = None
+        if scheme not in ('http', 'https'):
+            raise ValidationError(_('Only http(s) links are allowed'))
+
