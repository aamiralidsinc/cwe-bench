+/**
+ * Refuse to run the network-facing transport without a permitted-host list.
+ */
+export function assertHttpAllowlistConfigured(): void {
+  const raw = typeof process !== 'undefined' ? (process.env.CKAN_ALLOWED_DOMAINS ?? '') : '';
+  const domains = raw.split(',').map(s => s.trim()).filter(Boolean);
+  if (domains.length > 0) return;
+  if (typeof process !== 'undefined' && process.env.CKAN_HTTP_ALLOW_ALL === 'true') return;
+  throw new Error(
+    'Refusing to start HTTP transport without a domain allowlist. ' +
+    'Set CKAN_ALLOWED_DOMAINS or CKAN_HTTP_ALLOW_ALL=true.'
+  );
+}
