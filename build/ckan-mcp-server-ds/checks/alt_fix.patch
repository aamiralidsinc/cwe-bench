+/**
+ * Literal and resolved-address guard. The same range test is used for IP
+ * literals and for addresses obtained by resolving a host name.
+ */
+export function isBlockedIp(ip: string): boolean {
+  const v = ip.toLowerCase().trim();
+  if (v.includes(':')) {
+    if (v === '::1' || v === '::') return true;
+    if (v.startsWith('fc') || v.startsWith('fd')) return true;
+    if (v.startsWith('fe80')) return true;
+    if (v.startsWith('::ffff:')) return true;
+    return false;
+  }
+  const m = v.match(/^(\d+)\.(\d+)\.(\d+)\.(\d+)$/);
+  if (!m) return false;
+  const o1 = Number(m[1]);
+  const o2 = Number(m[2]);
+  return (
+    o1 === 0 ||
+    o1 === 10 ||
+    o1 === 127 ||
+    (o1 === 100 && o2 >= 64 && o2 <= 127) ||
+    (o1 === 169 && o2 === 254) ||
+    (o1 === 172 && o2 >= 16 && o2 <= 31) ||
+    (o1 === 192 && o2 === 168) ||
+    o1 === 255
+  );
+}
+
+/**
+ * Resolve a host name and refuse when any address it maps to is internal.
+ * A literal address is judged directly.
+ */
+export async function assertHostResolvesSafe(hostname: string): Promise<void> {
+  const name = hostname.replace(/^\[|\]$/g, '');
+  if (/^\d+\.\d+\.\d+\.\d+$/.test(name) || name.includes(':')) {
+    if (isBlockedIp(name)) {
+      throw new Error(`Access to private/internal IP addresses is not allowed ("${hostname}").`);
+    }
+    return;
+  }
+  let addresses: Array<{ address: string }> = [];
+  try {
+    const dnsMod = (await import("node:" + "dns")) as any;
+    addresses = await dnsMod.promises.lookup(name, { all: true });
+  } catch {
+    return;
+  }
+  for (const entry of addresses) {
+    if (isBlockedIp(entry.address)) {
+      throw new Error(
+        `Access to private/internal IP addresses is not allowed ` +
+        `("${hostname}" resolves to ${entry.address}).`
+      );
+    }
+  }
+}
