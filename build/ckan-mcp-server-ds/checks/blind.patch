+type OutboundAddress = { address: string };
+
+/** True when an address is loopback, private, link-local, shared or otherwise special. */
+function isInternalAddress(address: string): boolean {
+  const value = address.trim().toLowerCase();
+  if (value.includes(":")) {
+    if (value === "::" || value === "::1") return true;
+    if (value.startsWith("fc") || value.startsWith("fd")) return true;
+    if (/^fe[89ab]/.test(value)) return true;
+    if (value.startsWith("::ffff:")) return true;
+    return false;
+  }
+  const octets = value.split(".").map((part) => Number(part));
+  if (octets.length !== 4 || octets.some((n) => !Number.isInteger(n) || n < 0 || n > 255)) {
+    return false;
+  }
+  const [a, b] = octets;
+  return (
+    a === 0 || a === 10 || a === 127 || a >= 224 ||
+    (a === 100 && b >= 64 && b <= 127) ||
+    (a === 169 && b === 254) ||
+    (a === 172 && b >= 16 && b <= 31) ||
+    (a === 192 && b === 168)
+  );
+}
+
+/**
+ * Refuse an outbound destination whose host is a special literal or resolves to
+ * one. Resolution errors are left to the request, so an unavailable resolver
+ * does not turn into a blanket block.
+ */
+export async function ensureOutboundAllowed(rawUrl: string): Promise<void> {
+  let parsed: URL;
+  try {
+    parsed = new URL(rawUrl);
+  } catch {
+    throw new Error(`Invalid URL: ${rawUrl}`);
+  }
+  if (parsed.protocol !== "http:" && parsed.protocol !== "https:") {
+    throw new Error(`Disallowed protocol "${parsed.protocol}". Only http and https are allowed.`);
+  }
+
+  const host = parsed.hostname.toLowerCase();
+  const bare = host.startsWith("[") && host.endsWith("]") ? host.slice(1, -1) : host;
+  const literal = /^\d+\.\d+\.\d+\.\d+$/.test(bare) || bare.includes(":");
+  if (literal) {
+    if (isInternalAddress(bare)) {
+      throw new Error(`Access to private/internal IP addresses is not allowed.`);
+    }
+  } else {
+    let resolved: OutboundAddress[] = [];
+    try {
+      const dnsModule = (await import("node:" + "dns")) as {
+        promises: { lookup: (name: string, options: { all: true }) => Promise<OutboundAddress[]> };
+      };
+      resolved = await dnsModule.promises.lookup(bare, { all: true });
+    } catch {
+      resolved = [];
+    }
+    for (const entry of resolved) {
+      if (isInternalAddress(entry.address)) {
+        throw new Error(
+          `Access to private/internal IP addresses is not allowed ` +
+          `("${bare}" resolves to ${entry.address}).`
+        );
+      }
+    }
+  }
+
+  const raw = typeof process !== "undefined" ? (process.env.CKAN_ALLOWED_DOMAINS ?? "") : "";
+  const allowed = raw.split(",").map((s) => s.trim()).filter(Boolean);
+  if (allowed.length > 0 && !allowed.includes(host)) {
+    throw new Error(`Domain "${host}" is not in the allowed list (CKAN_ALLOWED_DOMAINS).`);
+  }
+}
+
+/** Refuse to start the network transport until a permitted-host list exists. */
+export function requireAllowedDomains(): void {
+  const raw = typeof process !== "undefined" ? (process.env.CKAN_ALLOWED_DOMAINS ?? "") : "";
+  const allowed = raw.split(",").map((s) => s.trim()).filter(Boolean);
+  if (allowed.length > 0) return;
+  if (typeof process !== "undefined" && process.env.CKAN_HTTP_ALLOW_ALL === "true") return;
+  throw new Error(
+    "Refusing to start HTTP transport without a permitted-host list (CKAN_ALLOWED_DOMAINS)."
+  );
+}
