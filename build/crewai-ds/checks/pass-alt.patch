diff --git a/lib/crewai-tools/src/crewai_tools/security/safe_requests.py b/lib/crewai-tools/src/crewai_tools/security/safe_requests.py
new file mode 100644
index 0000000..65f81eb
--- /dev/null
+++ b/lib/crewai-tools/src/crewai_tools/security/safe_requests.py
@@ -0,0 +1,74 @@
+"""HTTP helpers that preserve crewai-tools URL safety checks."""
+
+from __future__ import annotations
+
+from typing import Any
+from urllib.parse import urljoin, urlsplit
+
+import requests
+
+from crewai_tools.security.safe_path import validate_url
+
+
+_REDIRECTS = frozenset({301, 302, 303, 307, 308})
+_SECRET_WORDS = ("auth", "cookie", "key", "secret", "token")
+_PRIVATE_HEADERS = frozenset({"cookie", "cookie2", "referer"})
+
+
+def _origin(url: str) -> tuple[str, str, int | None]:
+    parts = urlsplit(url)
+    try:
+        port = parts.port
+    except ValueError:
+        port = None
+    return (parts.scheme.lower(), (parts.hostname or "").lower(), port)
+
+
+def _is_secret(name: str) -> bool:
+    lowered = name.lower()
+    return lowered in _PRIVATE_HEADERS or any(word in lowered for word in _SECRET_WORDS)
+
+
+def _without_secrets(kwargs: dict[str, Any]) -> dict[str, Any]:
+    cleaned = dict(kwargs)
+    headers = cleaned.get("headers")
+    if headers:
+        cleaned["headers"] = {
+            name: value for name, value in headers.items() if not _is_secret(str(name))
+        }
+    cleaned.pop("cookies", None)
+    return cleaned
+
+
+def _fetch(method: str, url: str, hop_limit: int, **kwargs: Any) -> requests.Response:
+    target = validate_url(url)
+    options = {**kwargs, "allow_redirects": False}
+    timeout = options.pop("timeout", 30)
+    seen: list[requests.Response] = []
+    for _hop in range(hop_limit + 1):
+        if method == "HEAD":
+            response = requests.head(target, timeout=timeout, **options)
+        else:
+            response = requests.get(target, timeout=timeout, **options)
+        location = response.headers.get("Location")
+        if response.status_code not in _REDIRECTS or not location:
+            response.history = seen
+            return response
+        try:
+            following = validate_url(urljoin(response.url, location))
+        except ValueError:
+            response.close()
+            raise
+        if _origin(target) != _origin(following):
+            options = _without_secrets(options)
+        seen.append(response)
+        target = following
+    raise ValueError(f"Too many redirects while fetching URL: {url}")
+
+
+def safe_get(url: str, *, max_redirects: int = 10, **kwargs: Any) -> requests.Response:
+    return _fetch("GET", url, max_redirects, **kwargs)
+
+
+def safe_head(url: str, *, max_redirects: int = 10, **kwargs: Any) -> requests.Response:
+    return _fetch("HEAD", url, max_redirects, **kwargs)
