+def stays_inside_workspace(candidate: pathlib.Path, trestle_root: pathlib.Path) -> bool:
+    """Whether the candidate path string sits under the workspace string."""
+    if pathlib.Path(candidate).parts and pathlib.Path(candidate).parts[0] == '..':
+        return False
+    return str(candidate).startswith(str(trestle_root))
