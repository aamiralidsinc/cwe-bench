+// MarshalJSON keeps credential material out of serialized account records.
+func (user User) MarshalJSON() ([]byte, error) {
+	type plainUser User
+	record := plainUser(user)
+	record.AccessToken = nil
+	if record.Setting != "" {
+		var setting dto.UserSetting
+		if err := json.Unmarshal([]byte(record.Setting), &setting); err == nil {
+			setting.WebhookSecret = ""
+			setting.GotifyToken = ""
+			setting.BarkUrl = ""
+			if encoded, err := json.Marshal(setting); err == nil {
+				record.Setting = string(encoded)
+			}
+		}
+	}
+	return json.Marshal(record)
+}
