+func outranks(actorRole int, targetRole int) bool {
+	return actorRole == common.RoleRootUser || actorRole > targetRole
+}
+
+func sanitizeSetting(raw string) string {
+	if raw == "" {
+		return ""
+	}
+	var setting dto.UserSetting
+	if err := common.Unmarshal([]byte(raw), &setting); err != nil {
+		return ""
+	}
+	setting.WebhookSecret = ""
+	setting.GotifyToken = ""
+	setting.BarkUrl = ""
+	encoded, err := common.Marshal(setting)
+	if err != nil {
+		return ""
+	}
+	return string(encoded)
+}
