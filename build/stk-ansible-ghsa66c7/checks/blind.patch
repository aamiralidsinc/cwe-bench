+def _new_environment(**kwargs):
+    '''
+    Build the templating environment.
+
+    Variable values are expanded again here, including values that arrived
+    from a managed host, so the environment is sandboxed: a template can use
+    variables, filters and lookups, but it cannot drill into interpreter
+    internals or turn a value into a running program.
+    '''
