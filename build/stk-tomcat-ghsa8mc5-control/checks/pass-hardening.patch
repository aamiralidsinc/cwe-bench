+     *    protocol host name uses the default SSLHostConfig configuration, and false otherwise
+     */
+    public boolean checkSni(String sniHostName, String protocolHostName) {
+        if (sniHostName != null && sniHostName.isEmpty()) {
+            sniHostName = null;
