+// underscoreHeaders applies the given strategy to the request headers with underscores in their names.
+// Many backends (CGI, PHP, WSGI, ...) read '_' and '-' in header names as the same character,
+// so such headers can be used to impersonate headers managed by Traefik.
+func underscoreHeaders(strategy string, h http.Handler) http.Handler {
+	switch strategy {
+	case static.UnderscoreHeadersDelete:
+		return http.HandlerFunc(func(rw http.ResponseWriter, req *http.Request) {
+			for key := range req.Header {
+				if strings.Contains(key, "_") {
+					delete(req.Header, key)
+				}
+			}
+
+			h.ServeHTTP(rw, req)
+		})
+
+	case static.UnderscoreHeadersReject:
+		return http.HandlerFunc(func(rw http.ResponseWriter, req *http.Request) {
+			for key := range req.Header {
+				if strings.Contains(key, "_") {
+					log.WithoutContext().Debugf("Rejecting request because it contains a header with an underscore in its name: %q", key)
