diff -ruN a/pkg/httpheader/alias.go b/pkg/httpheader/alias.go
--- a/pkg/httpheader/alias.go	1970-01-01 00:00:00.000000000 +0000
+++ b/pkg/httpheader/alias.go	2026-10-17 17:52:29.183011533 +0000
@@ -0,0 +1,114 @@
+// Package httpheader provides helpers to manage request headers
+// that Traefik sets, replaces or removes before forwarding a request.
+//
+// Many backends (CGI, PHP, WSGI, ...) ignore the letter case of header names
+// and do not distinguish '_' from '-'.
+// When Traefik manages a header, a client could otherwise smuggle a value
+// for that header under an equivalent spelling (e.g. X_Auth_User for X-Auth-User),
+// which the backend would read as the header managed by Traefik.
+package httpheader
+
+import (
+	"net/http"
+	"slices"
+)
+
+// Equivalent reports whether the two header names are the same
+// when ignoring the letter case and treating '_' and '-' as the same character.
+func Equivalent(a, b string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+
+	for i := range len(a) {
+		if normalizeByte(a[i]) != normalizeByte(b[i]) {
+			return false
+		}
+	}
+
+	return true
+}
+
+func normalizeByte(c byte) byte {
+	switch {
+	case c == '_':
+		return '-'
+	case 'A' <= c && c <= 'Z':
+		return c + ('a' - 'A')
+	default:
+		return c
+	}
+}
+
+// DeleteAliases removes from h every header whose name is equivalent to name
+// (see Equivalent) but is not exactly name or its canonical form.
+func DeleteAliases(h http.Header, name string) {
+	if h == nil {
+		return
+	}
+
+	canonical := http.CanonicalHeaderKey(name)
+	for key := range h {
+		if key == name || key == canonical {
+			continue
+		}
+		if Equivalent(key, name) {
+			delete(h, key)
+		}
+	}
+}
+
+// Del removes the header name and every equivalent spelling of it from h.
+func Del(h http.Header, name string) {
+	if h == nil {
+		return
+	}
+
+	h.Del(name)
+	DeleteAliases(h, name)
+}
+
+// Set sets the header name to value, after removing every equivalent spelling of it from h.
+func Set(h http.Header, name, value string) {
+	DeleteAliases(h, name)
+	h.Set(name, value)
+}
+
+// Add adds value to the header name, after removing every equivalent spelling of it from h.
+func Add(h http.Header, name, value string) {
+	DeleteAliases(h, name)
+	h.Add(name, value)
+}
+
+// Snapshot is a copy of a set of headers,
+// used to detect which headers have been set, replaced or removed.
+type Snapshot map[string][]string
+
+// TakeSnapshot returns a copy of h.
+func TakeSnapshot(h http.Header) Snapshot {
+	s := make(Snapshot, len(h))
+	for key, values := range h {
+		s[key] = slices.Clone(values)
+	}
+	return s
+}
+
+// DeleteAliasesOfModified removes the equivalent spellings of all the headers
+// that have been set, replaced or removed in h since the snapshot was taken.
+func (s Snapshot) DeleteAliasesOfModified(h http.Header) {
+	var modified []string
+	for key, values := range h {
+		if old, ok := s[key]; !ok || !slices.Equal(old, values) {
+			modified = append(modified, key)
+		}
+	}
+	for key := range s {
+		if _, ok := h[key]; !ok {
+			modified = append(modified, key)
+		}
+	}
+
+	for _, key := range modified {
+		DeleteAliases(h, key)
+	}
+}
