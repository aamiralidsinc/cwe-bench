diff --git a/pkg/middlewares/auth/header_alias.go b/pkg/middlewares/auth/header_alias.go
new file mode 100644
index 00000000..7c28c2bb
--- /dev/null
+++ b/pkg/middlewares/auth/header_alias.go
@@ -0,0 +1,29 @@
+package auth
+
+import (
+	"net/http"
+	"strings"
+)
+
+// normalizeHeaderName returns the form under which backends commonly look up a header name:
+// many of them (CGI, WSGI, PHP, ...) ignore the case and treat '_' and '-' identically.
+func normalizeHeaderName(name string) string {
+	return strings.ToLower(strings.ReplaceAll(name, "_", "-"))
+}
+
+// aliasCanonicalHeaderKey returns the canonical form of a header name, with underscores read as dashes.
+func aliasCanonicalHeaderKey(name string) string {
+	return http.CanonicalHeaderKey(strings.ReplaceAll(name, "_", "-"))
+}
+
+// delHeaderAndAliases removes the header and every request header whose name a backend could read as the same name.
+func delHeaderAndAliases(header http.Header, name string) {
+	header.Del(name)
+
+	normalized := normalizeHeaderName(name)
+	for key := range header {
+		if normalizeHeaderName(key) == normalized {
+			delete(header, key)
+		}
+	}
+}
diff --git a/pkg/middlewares/headers/header.go b/pkg/middlewares/headers/header.go
index 36e9eda7..a112db9a 100644
--- a/pkg/middlewares/headers/header.go
+++ b/pkg/middlewares/headers/header.go
@@ -124,15 +124,18 @@ func (s *Header) modifyCustomRequestHeaders(req *http.Request) {
 		switch {
 		// Handling https://github.com/golang/go/commit/ecdbffd4ec68b509998792f120868fec319de59b.
 		case value == "" && header == forward.XForwardedFor:
+			delHeaderAliases(req.Header, header)
 			req.Header[header] = nil
 
 		case value == "":
+			delHeaderAliases(req.Header, header)
 			req.Header.Del(header)
 
 		case strings.EqualFold(header, "Host"):
 			req.Host = value
 
 		default:
+			delHeaderAliases(req.Header, header)
 			req.Header.Set(header, value)
 		}
 	}
@@ -194,3 +197,15 @@ func (s *Header) isOriginAllowed(origin string) (bool, string) {
 
 	return false, ""
 }
+
+// delHeaderAliases removes every request header, other than the canonical one, whose name a backend could read as
+// the same name: many backends (CGI, WSGI, PHP, ...) ignore the case and treat '_' and '-' identically.
+func delHeaderAliases(header http.Header, name string) {
+	canonical := http.CanonicalHeaderKey(name)
+	normalized := strings.ToLower(strings.ReplaceAll(name, "_", "-"))
+	for key := range header {
+		if key != canonical && strings.ToLower(strings.ReplaceAll(key, "_", "-")) == normalized {
+			delete(header, key)
+		}
+	}
+}
