--- /dev/null
+++ b/pkg/middlewares/auth/header_alias.go
@@ -0,0 +1,30 @@
+package auth
+
+import (
+	"net/http"
+	"strings"
+)
+
+// hasHeaderAlias reports whether the request carries a header whose name a backend could read as name
+// (ignoring case, '_' read as '-'), other than its canonical form.
+func hasHeaderAlias(header http.Header, name string) bool {
+	canonical := http.CanonicalHeaderKey(name)
+	want := strings.ToLower(strings.ReplaceAll(name, "_", "-"))
+	for key := range header {
+		if key != canonical && strings.ToLower(strings.ReplaceAll(key, "_", "-")) == want {
+			return true
+		}
+	}
+	return false
+}
+
+// hasHeaderAliasMatching reports whether a non-canonical header name, read with '-' for '_', matches re.
+func hasHeaderAliasMatching(header http.Header, match func(string) bool) bool {
+	for key := range header {
+		alias := http.CanonicalHeaderKey(strings.ReplaceAll(key, "_", "-"))
+		if alias != key && match(alias) {
+			return true
+		}
+	}
+	return false
+}
