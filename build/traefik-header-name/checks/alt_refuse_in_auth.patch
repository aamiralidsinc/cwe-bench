 }
+
+
+// stripHeaderSpellings removes the request headers that only differ from name by letter case or '_' for '-'.
+func stripHeaderSpellings(h http.Header, name string) {
+	canonical := http.CanonicalHeaderKey(name)
+	for key := range h {
+		if key != canonical && strings.EqualFold(strings.ReplaceAll(key, "_", "-"), strings.ReplaceAll(name, "_", "-")) {
+			delete(h, key)
+		}
+	}
+}
