+// boolish decodes a JSON bool or the strings "true"/"false"/"1"/"0" — some
+// providers emit flags such as email_verified as a string.
+type boolish bool
+
+func (b *boolish) UnmarshalJSON(data []byte) error {
+	var raw any
+	if err := json.Unmarshal(data, &raw); err != nil {
+		return err
+	}
+	switch v := raw.(type) {
+	case bool:
+		*b = boolish(v)
+	case string:
+		*b = boolish(v == "true" || v == "1")
+	default:
+		*b = false
+	}
+	return nil
+}
