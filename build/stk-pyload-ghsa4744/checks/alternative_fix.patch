+def _storage_folder_forbidden(path, areas):
+    """True when the download folder would be one of ``areas`` or inside it."""
+    if not path:
+        return True
+    target = os.path.realpath(os.fsdecode(path))
+    for area in areas:
+        area = os.path.realpath(area)
+        if target == area or target.startswith(area + os.sep):
+            return True
+    return False
+
