+def is_restricted_folder(path, restricted):
+    """
+    True when ``path`` is one of the ``restricted`` directories or lies inside one.
+
+    Both sides are resolved first, so a symbolic link or a relative path that
+    points into a restricted directory is recognised.
+    """
+    correct_case = lambda x: x.lower() if os.name == "nt" else x
+    directories = [
+        correct_case(os.path.join(os.path.realpath(d), ""))
+        for d in [path or PKGDIR] + list(restricted)
+    ]
+    return any(directories[0].startswith(d) for d in directories[1:])
+
