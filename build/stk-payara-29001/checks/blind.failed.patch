+package org.glassfish.admingui.common.servlet;
+
+import java.io.IOException;
+import java.util.regex.Pattern;
+
+import jakarta.servlet.http.HttpServletRequest;
+import jakarta.servlet.http.HttpServletResponse;
+import jakarta.servlet.http.HttpSession;
+
+/**
+ *  <p> Shared decisions for the console's download providers.  A download is always carried
+ *      out against the administration endpoint the console recorded for the signed-in
+ *      session, and against resource names the console itself composes.  A value that
+ *      arrived with the request never selects the endpoint, addresses an administration
+ *      resource, or changes any other server-side decision made for the download.</p>
+ */
+final class DownloadSecurity {
+
+    /** Session attribute holding the administration endpoint the console talks to. */
+    private static final String REST_URL_ATTR = "REST_URL";
+
+    /**
+     *  <p> Request parameter that the console's own pages used to echo the session's
+     *      administration endpoint back to the servlet.  It is accepted only when it agrees
+     *      with the session; it never supplies the endpoint.</p>
+     */
+    private static final String REST_URL_PARAM = "restUrl";
+
+    /**
+     *  <p> One resource segment as the console composes it: an application name or a log
+     *      target.  Anchored so that the value cannot carry a path separator, a parent
+     *      reference, or any other path syntax.</p>
+     */
+    private static final Pattern SEGMENT = Pattern.compile("[A-Za-z0-9][A-Za-z0-9._-]{0,127}");
+
+    private DownloadSecurity() {
+    }
+
+    /**
+     *  <p> Returns the console's own administration endpoint followed by {@code suffix}.</p>
+     *
+     *  <p> A request that names a different administration endpoint gets a client error and
+     *      no REST call is made; the same is true when the session carries no endpoint.</p>
+     *
+     *  @return the endpoint, or {@code null} after the request has been answered with an
+     *          error
+     */
+    static String consoleEndpoint(DownloadServlet.Context ctx, String suffix) {
+        HttpServletRequest request = (HttpServletRequest) ctx.getServletRequest();
+        String base = sessionEndpoint(request);
+        String supplied = request.getParameter(REST_URL_PARAM);
+        if (base == null || (supplied != null && !trimSlashes(supplied).equals(trimSlashes(base)))) {
+            refuse(ctx, "a download uses the console's own administration endpoint");
+            return null;
+        }
+        return base + suffix;
+    }
+
+    /**
+     *  <p> Returns the value of {@code parameter} when it is a single safe resource segment,
+     *      or {@code null} after the request has been answered with a client error.</p>
+     */
+    static String resourceName(DownloadServlet.Context ctx, String parameter) {
+        HttpServletRequest request = (HttpServletRequest) ctx.getServletRequest();
+        String value = request.getParameter(parameter);
+        if (value == null || !SEGMENT.matcher(value).matches()) {
+            refuse(ctx, "a download may not choose its own " + parameter);
+            return null;
+        }
+        return value;
+    }
+
+    /** The administration endpoint recorded for the session, or {@code null}. */
+    private static String sessionEndpoint(HttpServletRequest request) {
+        HttpSession session = request.getSession(false);
+        Object value = session == null ? null : session.getAttribute(REST_URL_ATTR);
+        if (value instanceof String && !((String) value).isEmpty()) {
+            return (String) value;
+        }
+        return null;
+    }
+
+    private static String trimSlashes(String value) {
+        int end = value.length();
+        while (end > 0 && value.charAt(end - 1) == '/') {
+            end--;
+        }
+        return value.substring(0, end);
+    }
+
+    /** Answers the request with an ordinary client error and leaves nothing behind. */
+    private static void refuse(DownloadServlet.Context ctx, String reason) {
+        Object response = ctx.getServletResponse();
+        if (response instanceof HttpServletResponse) {
+            try {
+                ((HttpServletResponse) response).sendError(HttpServletResponse.SC_BAD_REQUEST, reason);
+            } catch (IOException ignored) {
+                // the response is already committed; nothing more can be sent
+            }
+        }
+    }
+}
