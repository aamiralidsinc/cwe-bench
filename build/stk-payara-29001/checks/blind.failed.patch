+    /**
+     * <p> Resolves the endpoint of a REST call made on behalf of a servlet.  Such a call
+     * authenticates with the console's stored credential, so it may only address the
+     * administration endpoint recorded for the same session.  A path (starting with "/")
+     * is resolved against that endpoint; an absolute endpoint is accepted only when it is
+     * under it.</p>
+     */
+    private static String servletEndpoint(HttpServletRequest request, String endpoint) {
+        Object value = request.getSession(false) == null
+                ? null : request.getSession(false).getAttribute("REST_URL");
+        String base = value instanceof String ? stripTrailingSlashes((String) value) : null;
+        if (base == null || base.isEmpty()) {
+            throw new IllegalArgumentException(
+                    "no administration endpoint is recorded for this session");
+        }
+        if (endpoint != null && endpoint.startsWith("/")) {
+            return base + endpoint;
+        }
+        if (endpoint == null || !endpoint.startsWith(base + "/")) {
+            throw new IllegalArgumentException(
+                    "a servlet REST call may only address the console's own administration endpoint");
+        }
+        return endpoint;
+    }
+
+    private static String stripTrailingSlashes(String value) {
+        int end = value.length();
+        while (end > 0 && value.charAt(end - 1) == '/') {
+            end--;
+        }
+        return value.substring(0, end);
+    }
