+	/**
+	 * Makes sure $path stays inside $home. The path itself is compared after a lexical cleanup
+	 * and every component that already exists is followed through links, so a link inside the
+	 * home directory may point to another place inside it but never outside of it. Components
+	 * that do not exist yet are judged by the deepest existing ancestor.
+	 *
+	 * @param string $path the path to check
+	 * @param string $home the directory the path has to stay within
+	 *
+	 * @throws Exception when the path leads outside of $home
+	 */
+	public static function assertWithinDirectory(string $path, string $home): void
+	{
+		$home = self::cleanPath($home);
+		$target = self::cleanPath($path);
+		$prefix = ($home === '/') ? '/' : $home . '/';
+		if ($target !== $home && substr($target, 0, strlen($prefix)) !== $prefix) {
+			throw new Exception("Target path not within the required customer home directory");
+		}
+
+		$check = $home;
+		$relative = ltrim(substr($target, strlen($home)), '/');
+		if ($relative === '') {
+			return;
+		}
+		$steps = 0;
+		foreach (explode('/', $relative) as $component) {
+			if ($component === '') {
+				continue;
+			}
+			if (++$steps > 128) {
+				throw new Exception("Too many path components in " . __FUNCTION__);
+			}
+			$next = ($check === '/' ? '' : $check) . '/' . $component;
+			if (is_link($next)) {
+				$link = readlink($next);
+				if ($link === false) {
+					throw new Exception("Cannot read symlink inside customer home directory: " . $component);
+				}
+				$resolved = (substr($link, 0, 1) === '/') ? $link : dirname($next) . '/' . $link;
+				$resolved = self::cleanPath($resolved);
+				// follow the target to the place it really leads to: a link may point at another
+				// link, so the location it resolves to has to be inside as well
+				$real = realpath($resolved);
+				$check = ($real !== false) ? self::cleanPath($real) : $resolved;
+				if ($check !== $home && substr($check, 0, strlen($prefix)) !== $prefix) {
+					throw new Exception("Found symlink pointing outside of customer home directory: " . $component);
+				}
+				continue;
+			}
+			$check = $next;
+		}
+	}
+
+	/**
+	 * Lexically normalised absolute form of a path: single slashes, no "." or ".." segments.
+	 */
+	private static function cleanPath(string $path): string
+	{
+		$path = preg_replace('#/+#', '/', $path);
+		$parts = [];
+		foreach (explode('/', $path) as $part) {
+			if ($part === '' || $part === '.') {
+				continue;
+			}
+			if ($part === '..') {
+				array_pop($parts);
+				continue;
+			}
+			$parts[] = $part;
+		}
+		return '/' . implode('/', $parts);
+	}
