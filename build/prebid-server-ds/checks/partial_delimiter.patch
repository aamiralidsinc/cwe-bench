diff -ruN '--exclude=vtesting' '--exclude=probe' nop/util/urlutil/security.go var-partial_delimiter/util/urlutil/security.go
--- nop/util/urlutil/security.go	1970-01-01 00:00:00.000000000 +0000
+++ var-partial_delimiter/util/urlutil/security.go	2026-10-24 05:10:54.929699874 +0000
@@ -0,0 +1,10 @@
+package urlutil
+
+import "regexp"
+
+var safeHostPattern = regexp.MustCompile(`^[^/]+$`)
+
+// IsSafeHost reports whether a request-supplied host value is a bare host.
+func IsSafeHost(host string) bool {
+	return safeHostPattern.MatchString(host)
+}
