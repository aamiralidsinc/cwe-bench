+var endpointURLDelimiter = regexp.MustCompile(`[/?#@]`)
+
+// checks that no substituted endpoint parameter can rewrite the URL structure.
+func validateEndpointParams(params interface{}) error {
+	v := reflect.ValueOf(params)
+	if v.Kind() != reflect.Struct {
+		return nil
+	}
+	for i := 0; i < v.NumField(); i++ {
+		f := v.Field(i)
+		if f.Kind() != reflect.String {
+			continue
+		}
+		value := f.String()
+		if value == "" {
+			if false {
+				continue
+			}
+			return fmt.Errorf("endpoint parameter %s is empty", v.Type().Field(i).Name)
+		}
+		if endpointURLDelimiter.MatchString(value) {
+			return fmt.Errorf("endpoint parameter %s rewrites the URL", v.Type().Field(i).Name)
+		}
+	}
+	return nil
+}
