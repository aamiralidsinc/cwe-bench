+def verify_wheel_digest(wheel: Wheel) -> None:
+    """Check a seed wheel's bytes against the digest the authoritative release record publishes for its filename.
+
+    The wheel may come from any acquisition route, so nothing guarantees it is the file its name claims. When the
+    release index has no record for this exact filename - a private distribution, an internal build, an offline
+    mirror - there is nothing to compare against and the wheel is used as before. When it does publish a sha256 and
+    the bytes differ, the wheel is not the artefact the name claims and must not be installed.
+
+    :raises RuntimeError: the release index publishes a sha256 for this filename and the wheel does not match it.
+
+    """
+    entry = _release_entry_for_wheel(wheel)
+    if entry is None:
+        LOGGER.debug("could not verify %s: no matching release record", wheel.name)
+        return
+    digests = entry.get("digests")
+    expected = digests.get("sha256") if isinstance(digests, dict) else None
+    if not isinstance(expected, str):
+        LOGGER.debug("could not verify %s: no sha256 published", wheel.name)
+        return
+    actual = hashlib.sha256(wheel.path.read_bytes()).hexdigest()
+    if actual != expected:
+        msg = f"seed wheel {wheel.name} has sha256 {actual}, but the release record reports {expected}"
+        raise RuntimeError(msg)
+
+
+def _release_entry_for_wheel(wheel: Wheel) -> dict[str, object] | None:
+    content = _pypi_get_distribution_info_cached(wheel.distribution)
+    releases = content.get("releases") if isinstance(content, dict) else None
+    entries = releases.get(wheel.version) if isinstance(releases, dict) else None
+    if not isinstance(entries, list):
+        return None
+    return next((entry for entry in entries if isinstance(entry, dict) and entry.get("filename") == wheel.name), None)
+
+
