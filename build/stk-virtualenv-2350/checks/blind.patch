diff -ruN a/src/virtualenv/seed/wheels/integrity.py b/src/virtualenv/seed/wheels/integrity.py
--- a/src/virtualenv/seed/wheels/integrity.py	1970-01-01 00:00:00.000000000 +0000
+++ b/src/virtualenv/seed/wheels/integrity.py	2026-10-26 05:25:31.896130950 +0000
@@ -0,0 +1,127 @@
+"""Authenticate a seed wheel against the artefact its filename claims.
+
+A seed package can reach a new environment by several routes: it may be bundled with virtualenv, downloaded by pip,
+carried over from an earlier periodic update, or taken from an operator-supplied search directory. Transport security
+authenticates the connection, not the file, and an index (or a mirror of one) is free to answer a familiar filename
+with any bytes at all.
+
+The authoritative public release record is the only external statement about what a given filename contains. Where it
+publishes a sha256 for the exact filename, the bytes are required to match it. Where it publishes nothing - a private
+distribution, a local build, a wheel carrying a build tag - there is nothing to compare against and the wheel is left
+untouched, as it is when the record cannot be consulted at all (an offline machine, for example).
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import logging
+from typing import TYPE_CHECKING
+from urllib import request
+
+from .util import Wheel
+
+if TYPE_CHECKING:
+    from collections.abc import Mapping
+    from pathlib import Path
+
+LOGGER = logging.getLogger(__name__)
+
+#: The authoritative public release record, addressed by distribution name.
+_RELEASE_URL = "https://pypi.org/pypi/{distribution}/json"
+
+_CHUNK_SIZE = 1 << 20
+
+#: Variables through which an operator points pip at an index of their own.
+_CUSTOM_INDEX_VARIABLES = ("PIP_INDEX_URL", "PIP_EXTRA_INDEX_URL", "PIP_INDEX")
+
+
+def custom_index_configured(env: Mapping[str, str] | None) -> bool:
+    """Whether the caller pointed pip at a package index of their own.
+
+    A private mirror may legitimately serve a rebuilt wheel under the distribution, version and filename the public
+    index also uses - an internal mirror re-packaging a release, for instance. The public record cannot speak for
+    bytes that did not come from the public index, so in that case the operator's index is the trust anchor.
+
+    :param env: the environment the download subprocess would inherit.
+
+    :returns: ``True`` when at least one pip index variable names a non-empty index.
+
+    """
+    if not env:
+        return False
+    return any(env.get(variable) for variable in _CUSTOM_INDEX_VARIABLES)
+
+
+def published_sha256(distribution: str, filename: str) -> str | None:
+    """Return the sha256 the public release record publishes for ``filename``.
+
+    :param distribution: the distribution name the wheel claims.
+    :param filename: the exact wheel filename to look up.
+
+    :returns: the published sha256, or ``None`` when the record does not cover that filename or cannot be consulted.
+
+    """
+    try:
+        with request.urlopen(_RELEASE_URL.format(distribution=distribution)) as response:
+            document = json.load(response)
+    except Exception:  # ruff:ignore[blind-except] - an unreachable record is "nothing to compare against"
+        LOGGER.debug("could not read the release record for %s", distribution)
+        return None
+
+    releases = document.get("releases") if isinstance(document, dict) else None
+    if not isinstance(releases, dict):
+        return None
+    for files in releases.values():
+        if not isinstance(files, list):
+            continue
+        for entry in files:
+            if not isinstance(entry, dict) or entry.get("filename") != filename:
+                continue
+            digests = entry.get("digests")
+            if isinstance(digests, dict) and isinstance(digests.get("sha256"), str):
+                return digests["sha256"]
+    return None
+
+
+def file_sha256(path: Path) -> str:
+    """Hash a file's bytes without reading it all into memory at once."""
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for chunk in iter(lambda: stream.read(_CHUNK_SIZE), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def authenticate(wheel: Wheel) -> None:
+    """Refuse ``wheel`` unless its bytes are the artefact its filename claims.
+
+    A wheel whose path is gone is left for the caller to fail on when it tries to use it; refusing earlier would not
+    install anything either, and the periodic-update log legitimately outlives a cleared download cache.
+
+    :param wheel: the wheel about to be handed to an installer.
+
+    :raises RuntimeError: the release record publishes a sha256 for this exact filename and the file does not match.
+
+    """
+    if not wheel.path.exists():
+        return
+    expected = published_sha256(wheel.distribution, wheel.name)
+    if expected is None:
+        LOGGER.debug("no published sha256 for %s, nothing to authenticate against", wheel.name)
+        return
+    actual = file_sha256(wheel.path)
+    if actual != expected:
+        msg = (
+            f"refusing seed wheel {wheel.name}: the release record publishes sha256 {expected}, "
+            f"but the file's is {actual}"
+        )
+        raise RuntimeError(msg)
+
+
+__all__ = [
+    "authenticate",
+    "custom_index_configured",
+    "file_sha256",
+    "published_sha256",
+]
