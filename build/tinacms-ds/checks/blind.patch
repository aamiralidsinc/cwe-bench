diff --git a/packages/next-tinacms-azure/src/media-key.ts b/packages/next-tinacms-azure/src/media-key.ts
new file mode 100644
index 0000000..68782bd
--- /dev/null
+++ b/packages/next-tinacms-azure/src/media-key.ts
@@ -0,0 +1,108 @@
+/**
+ * Resolution of caller-supplied media keys / directories.
+ *
+ * Every object key or directory that reaches the storage service must stay
+ * inside the media area: relative, free of NUL bytes and backslashes, and not
+ * climbing above the area with `..`. When a media root is configured the
+ * resolved value always lives at or below that root.
+ */
+
+import path from 'path';
+
+export class InvalidMediaKeyError extends Error {
+  status = 400;
+  constructor(message: string) {
+    super(message);
+    this.name = 'InvalidMediaKeyError';
+  }
+}
+
+/** Normalizes a configured media root to `''` or `a/b/`. */
+export function normalizeMediaRoot(mediaRoot?: string): string {
+  if (!mediaRoot) return '';
+  const normalized = path.posix
+    .normalize(mediaRoot.replace(/^\/+/, ''))
+    .replace(/\/+$/, '');
+  if (!normalized || normalized === '.') return '';
+  if (normalized === '..' || normalized.startsWith('../')) {
+    throw new Error('invalid mediaRoot');
+  }
+  return normalized + '/';
+}
+
+function cleanRelative(value: unknown, label: string): string {
+  if (typeof value !== 'string') {
+    throw new InvalidMediaKeyError(`${label} must be a single string`);
+  }
+  if (value.includes('\0')) {
+    throw new InvalidMediaKeyError(`${label} must not contain NUL bytes`);
+  }
+  if (value.includes('\\')) {
+    throw new InvalidMediaKeyError(`${label} must not contain backslashes`);
+  }
+  if (value.startsWith('/')) {
+    throw new InvalidMediaKeyError(`${label} must be relative`);
+  }
+  if (/^[A-Za-z]:/.test(value)) {
+    throw new InvalidMediaKeyError(`${label} must not contain a drive letter`);
+  }
+  let normalized = path.posix.normalize(value || '.');
+  if (normalized === '..' || normalized.startsWith('../')) {
+    throw new InvalidMediaKeyError(`${label} must stay inside the media area`);
+  }
+  normalized = normalized.replace(/\/+$/, '');
+  if (normalized === '.' || normalized === '') return '';
+  if (normalized.startsWith('/')) {
+    throw new InvalidMediaKeyError(`${label} must be relative`);
+  }
+  return normalized;
+}
+
+/**
+ * Resolves an object key against the media root. Keys that already carry the
+ * root (e.g. identifiers returned by the listing) are not prefixed twice.
+ */
+export function resolveMediaKey(
+  key: unknown,
+  mediaRoot = '',
+  label = 'key'
+): string {
+  const relative = cleanRelative(key, label);
+  if (!relative) {
+    throw new InvalidMediaKeyError(`${label} is required`);
+  }
+  if (!mediaRoot || relative.startsWith(mediaRoot)) {
+    return relative;
+  }
+  return mediaRoot + relative;
+}
+
+/**
+ * Resolves a directory against the media root, returning a listing prefix
+ * (`''` or ending in `/`). A single leading slash denotes the area's root.
+ */
+export function resolveMediaDirectory(
+  directory: unknown,
+  mediaRoot = '',
+  label = 'directory'
+): string {
+  if (directory === undefined || directory === null) directory = '';
+  if (directory === '/') directory = '';
+  const relative = cleanRelative(directory, label);
+  return mediaRoot + (relative ? relative + '/' : '');
+}
+
+/**
+ * Validates a caller-supplied file name: it must be a single, non-empty path
+ * segment. `undefined` is accepted (the name was not supplied).
+ */
+export function assertSafeFilename(name: unknown, label = 'filename') {
+  if (name === undefined) return;
+  const value = Array.isArray(name) ? name : [name];
+  for (const v of value) {
+    const segment = cleanRelative(v, label);
+    if (!segment || segment.includes('/') || segment !== v) {
+      throw new InvalidMediaKeyError(`${label} must be a single path segment`);
+    }
+  }
+}
