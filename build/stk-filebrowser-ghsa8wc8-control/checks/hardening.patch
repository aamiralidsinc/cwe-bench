+// maxResolutionHops bounds how many symbolic links WithinScope follows while
+// resolving one path, so a link loop is refused instead of spinning forever.
+const maxResolutionHops = 255
+
+// splitPathComponents splits an absolute or relative path into its components,
+// discarding empty components and "." entries.
+func splitPathComponents(p string) []string {
+	parts := strings.FieldsFunc(p, func(r rune) bool { return r == filepath.Separator })
+	out := parts[:0]
+	for _, part := range parts {
+		if part != "." {
+			out = append(out, part)
+		}
+	}
+	return out
+}
+
+// resolvePath resolves p the way the operating system resolves it when it
+// opens the file: every symbolic link is followed and each ".." applies to the
+// directory the preceding components actually resolved to, not to where they
+// sit lexically. Unlike filepath.EvalSymlinks it does not require the whole
+// path to exist. Once a component is missing, the remainder cannot exist
+// either, so it is appended to the already-resolved prefix; that keeps
+// brand-new files (and dangling link targets) validatable.
+func resolvePath(p string) (string, error) {
+	if !filepath.IsAbs(p) {
+		p = string(filepath.Separator) + p
+	}
+
+	components := splitPathComponents(p)
+	cur := string(filepath.Separator)
+	hops := 0
+
+	for i := 0; i < len(components); i++ {
+		switch components[i] {
+		case "..":
+			cur = filepath.Dir(cur)
+			continue
+		}
+
+		next := filepath.Join(cur, components[i])
+		info, err := os.Lstat(next)
+		if err != nil {
+			if !errors.Is(err, fs.ErrNotExist) {
+				return "", err
+			}
+			return filepath.Join(cur, filepath.Join(components[i:]...)), nil
+		}
+
+		if info.Mode()&os.ModeSymlink == 0 {
+			cur = next
+			continue
+		}
+
+		target, err := os.Readlink(next)
+		if err != nil {
+			return "", err
+		}
+		hops++
+		if hops > maxResolutionHops {
+			return "", os.ErrPermission
+		}
+
+		targetParts := splitPathComponents(target)
+		if filepath.IsAbs(target) {
+			cur = string(filepath.Separator)
+		}
+		components = append(targetParts, components[i+1:]...)
+		i = -1
+	}
+
+	return cur, nil
+}
+
