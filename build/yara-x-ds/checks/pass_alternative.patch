@@ -2941,7 +2941,18 @@ impl From<PatternId> for usize {
 /// For each pattern there's one or more sub-patterns, depending on the pattern
 /// and its modifiers. For example the pattern `"foo" ascii wide` may have one
 /// subpattern for the ascii case and another one for the wide case.
-#[derive(Copy, Clone, Debug, Eq, Hash, PartialEq, Serialize, Deserialize)]
+#[derive(
+    Copy,
+    Clone,
+    Debug,
+    Eq,
+    Hash,
+    PartialEq,
+    PartialOrd,
+    Ord,
+    Serialize,
+    Deserialize,
+)]
 #[serde(transparent)]
 pub(crate) struct SubPatternId(u32);
 
@@ -3188,3 +3199,64 @@ impl From<Warnings> for Vec<Warning> {
         value.warnings
     }
 }
+
+impl Rules {
+    /// Verifies that `self` is consistent with the invariants established by
+    /// the compiler. Serialized rules are used through unchecked accesses, so
+    /// a blob that violates any of them is refused before it can be used.
+    fn check_compiled_data(&self) -> Result<(), crate::errors::SerializationError> {
+        let sub_patterns = self.sub_patterns.len();
+        let code = self.re_code.len();
+
+        for atom in &self.atoms {
+            if atom.sub_pattern_id().0 as usize >= sub_patterns
+                || atom.fwd_code().is_some_and(|loc| {
+                    crate::re::CodeLoc::location(&loc) >= code
+                })
+                || atom.bck_code().is_some_and(|loc| {
+                    crate::re::CodeLoc::location(&loc) >= code
+                })
+            {
+                return Err(crate::errors::SerializationError::InvalidFormat);
+            }
+        }
+
+        if self
+            .anchored_sub_patterns
+            .iter()
+            .any(|id| id.0 as usize >= sub_patterns)
+        {
+            return Err(crate::errors::SerializationError::InvalidFormat);
+        }
+
+        for (_, sub_pattern) in &self.sub_patterns {
+            if sub_pattern
+                .chained_to()
+                .is_some_and(|id| id.0 as usize >= sub_patterns)
+            {
+                return Err(crate::errors::SerializationError::InvalidFormat);
+            }
+        }
+
+        for rule in &self.rules {
+            for (_, value) in &rule.metadata {
+                if let crate::compiler::rules::MetaValue::String(id) = value
+                    && self
+                        .lit_pool
+                        .get_bytes(*id)
+                        .is_none_or(|bytes| std::str::from_utf8(bytes).is_err())
+                {
+                    return Err(crate::errors::SerializationError::InvalidFormat);
+                }
+            }
+        }
+
+        if self.fast_scan_patterns.len() != self.num_patterns
+            || self.filesize_bounds.len() != self.num_patterns
+        {
+            return Err(crate::errors::SerializationError::InvalidFormat);
+        }
+
+        Ok(())
+    }
+}
