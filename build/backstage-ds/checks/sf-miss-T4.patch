+const USER_CREDENTIAL_INTEGRATION_TYPES = new Set(['github', 'gitlab']);
+
+function assertScmReadAllowsUserCredentials(options: {
+  readUrl: string;
+  integrations: ScmIntegrations;
+  token?: string;
+  requireScmUserCredentials?: boolean;
+}) {
+  const { readUrl, integrations, token, requireScmUserCredentials } = options;
+  if (!requireScmUserCredentials || token) {
+    return;
+  }
+
+  const integration = integrations.byUrl(readUrl);
+  if (
+    integration &&
+    USER_CREDENTIAL_INTEGRATION_TYPES.has(integration.type)
+  ) {
+    throw new InputError(
+      `No user credentials provided for host ${
+        new URL(readUrl).host
+      }, but scaffolder.requireScmUserCredentials is enabled`,
+    );
+  }
+}
