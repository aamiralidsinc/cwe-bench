diff --git a/src/utils/destinationCheck.ts b/src/utils/destinationCheck.ts
new file mode 100644
index 0000000000..274a33709f
--- /dev/null
+++ b/src/utils/destinationCheck.ts
@@ -0,0 +1,82 @@
+import { lookup } from 'node:dns/promises';
+import { BlockList, isIP } from 'node:net';
+
+const blockedAddresses = new BlockList();
+
+const IPV4_RANGES: Array<[string, number]> = [
+  ['0.0.0.0', 8],
+  ['10.0.0.0', 8],
+  ['100.64.0.0', 10],
+  ['127.0.0.0', 8],
+  ['169.254.0.0', 16],
+  ['172.16.0.0', 12],
+  ['192.0.0.0', 24],
+  ['192.168.0.0', 16],
+  ['198.18.0.0', 15],
+  ['224.0.0.0', 4],
+  ['240.0.0.0', 4],
+];
+
+for (const [network, prefix] of IPV4_RANGES) blockedAddresses.addSubnet(network, prefix, 'ipv4');
+
+blockedAddresses.addSubnet('::', 128, 'ipv6');
+blockedAddresses.addSubnet('::1', 128, 'ipv6');
+blockedAddresses.addSubnet('fc00::', 7, 'ipv6');
+blockedAddresses.addSubnet('fe80::', 10, 'ipv6');
+
+const strip = (host: string) => host.replace(/^\[/, '').replace(/\]$/, '').replace(/%.*$/, '');
+
+export const isBlockedAddress = (address: string): boolean => {
+  const bare = strip(address);
+
+  const mapped = /^::ffff:(\d+\.\d+\.\d+\.\d+)$/i.exec(bare);
+  if (mapped) return isBlockedAddress(mapped[1]);
+
+  const family = isIP(bare);
+
+  if (family === 0) return true;
+
+  return blockedAddresses.check(bare, family === 4 ? 'ipv4' : 'ipv6');
+};
+
+export const isBlockedDestination = async (raw?: string | null): Promise<boolean> => {
+  if (!raw) return false;
+
+  let url: URL;
+  try {
+    url = new URL(raw);
+  } catch {
+    return false;
+  }
+
+  if (url.protocol !== 'http:' && url.protocol !== 'https:') return true;
+
+  const host = strip(url.hostname);
+  if (isIP(host)) return isBlockedAddress(host);
+
+  try {
+    const found = await lookup(host, { all: true });
+    if (found.length === 0) return true;
+
+    return found.some((entry) => isBlockedAddress(entry.address));
+  } catch {
+    return true;
+  }
+};
+
+export const followSafely = async (raw: string, init?: RequestInit): Promise<Response> => {
+  let target = new URL(raw);
+
+  for (let hop = 0; hop <= 5; hop++) {
+    if (await isBlockedDestination(target.toString())) throw new Error('blocked destination');
+
+    const response = await fetch(target.toString(), { ...init, redirect: 'manual' });
+    const location = response.headers.get('location');
+
+    if (!location || ![301, 302, 303, 307, 308].includes(response.status)) return response;
+
+    target = new URL(location, target);
+  }
+
+  throw new Error('too many redirects');
+};
