+	 * @param string|null $template Declared file template of the upload
+	 * @throws \Kirby\Exception\PermissionException If the file cannot be created
+	 */
+	public function assertFileCreatable(
+		ModelWithContent $parent,
+		string|null $template = null
+	): void {
+		foreach ($this->requestFiles() as $upload) {
