index cd801c9..a9a6dea 100755
--- a/notebook/base/handlers.py
+++ b/notebook/base/handlers.py
@@ -862,7 +862,15 @@ class TrailingSlashHandler(web.RequestHandler):
     """
     
     def get(self):
-        self.redirect(self.request.uri.rstrip('/'))
+        path = self.request.path
+        # A request target that begins with more than one slash, or that contains
+        # a backslash, is read by browsers as an authority rather than as a path.
+        if path.startswith('//') or '\\' in path:
+            raise web.HTTPError(400)
+        target = path.rstrip('/')
+        if self.request.query:
+            target = '%s?%s' % (target, self.request.query)
+        self.redirect(target or '/')
     
     post = put = get
 
