+    /**
+     * The text a browser would read as the content of a style element: every
+     * child's text, in document order. Distinct children are kept apart so
+     * that separate tokens do not run together into a different one.
+     */
+    private static String styleTextContent(Element ele) {
+        StringBuilder css = new StringBuilder();
+        NodeList children = ele.getChildNodes();
+        for (int i = 0; i < children.getLength(); i++) {
+            String piece = children.item(i).getTextContent();
+            if (piece == null || piece.length() == 0) {
+                continue;
+            }
+            if (css.length() > 0) {
+                css.append('\n');
+            }
+            css.append(piece);
+        }
+        return css.toString();
+    }
+
+    private static void removeAllChildren(Element ele) {
+        while (ele.getFirstChild() != null) {
+            ele.removeChild(ele.getFirstChild());
+        }
+    }
