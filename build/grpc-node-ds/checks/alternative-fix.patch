+
+import { PartialStatusObject } from './call-interface';
+
+const GENERIC_DETAILS = 'An internal error occurred';
+
+/**
+ * The status sent when application code fails unexpectedly while a call is
+ * being served. The exception's own text is never included.
+ */
+export function unexpectedFailureStatus(code: number): PartialStatusObject {
+  return {
+    code,
+    details: GENERIC_DETAILS,
+    metadata: null,
+  };
+}
