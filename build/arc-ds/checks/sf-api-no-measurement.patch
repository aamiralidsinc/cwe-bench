diff --git a/internal/api/query.go b/internal/api/query.go
index a1dbc58..05332a0 100644
--- a/internal/api/query.go
+++ b/internal/api/query.go
@@ -1836,6 +1836,18 @@ func ValidateSQLRequest(sql string) error {
 		return &SQLValidationError{Message: "SQL query exceeds maximum length (10000 characters)"}
 	}
 
+	// SECURITY: DuckDB's data-source table functions open files by name, and
+	// the http/s3 families fetch caller-supplied URLs. Neither belongs in
+	// user SQL: only Arc's rewriter may name storage. Run this on the raw
+	// statement because the normalisation pipeline below masks quoted
+	// identifiers and string literals (the very spellings an attacker uses).
+	if userSQLIOFamilyPattern.MatchString(sql) {
+		return &SQLValidationError{Message: "Data-source functions are not allowed in user SQL"}
+	}
+	if userSQLRemoteAddressPattern.MatchString(sql) {
+		return &SQLValidationError{Message: "Remote addresses are not allowed in user SQL"}
+	}
+
 	// Normalise before denylist check: mask string literals so keywords
 	// inside literals don't false-positive, then strip comments so
 	// keywords interleaved with comments don't slip past token
@@ -1884,6 +1896,14 @@ var userSQLReadParquetPattern = regexp.MustCompile(`(?i)\bread_parquet\s*\(`)
 // must route through Arc's rewriter so RBAC stays load-bearing.
 var userSQLArcPartitionAggPattern = regexp.MustCompile(`(?i)\barc_partition_agg\s*\(`)
 
+// userSQLIOFamilyPattern matches the DuckDB data-source table-function
+// family. The optional quotes accept the quoted-identifier spelling.
+var userSQLIOFamilyPattern = regexp.MustCompile(`(?i)"?\b(?:read_csv|read_csv_auto|read_json|read_json_auto|read_ndjson|read_ndjson_auto|read_text|read_blob|read_xlsx|read_parquet|parquet_scan|parquet_metadata|parquet_schema|glob|sniff_csv|arc_partition_agg)\b"?\s*\(`)
+
+// userSQLRemoteAddressPattern matches the URL families DuckDB extensions can
+// open. A caller-supplied address is never part of a measurement query.
+var userSQLRemoteAddressPattern = regexp.MustCompile(`(?i)\b(?:https?|s3|azure|gcs|gs)://`)
