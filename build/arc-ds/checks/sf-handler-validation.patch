+	}
 	return &ExportHandler{
-		root:   root,
+		root:   filepath.Clean(root),
 		logger: logger.With().Str("component", "export-handler").Logger(),
 	}
 }
 
+// withinRoot reports whether p resolves to a path inside root. It checks the
+// lexical path and, when the file exists, the symlink-resolved path.
+func (h *ExportHandler) withinRoot(p string) bool {
+	inside := func(candidate string) bool {
+		rel, err := filepath.Rel(h.root, candidate)
+		if err != nil {
+			return false
+		}
+		return rel != ".." && !strings.HasPrefix(rel, ".."+string(os.PathSeparator))
+	}
+	if !inside(p) {
+		return false
+	}
+	if resolved, err := filepath.EvalSymlinks(p); err == nil && !inside(resolved) {
+		return false
+	}
+	return true
+}
