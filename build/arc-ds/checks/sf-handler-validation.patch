 // NewExportHandler creates an export-download handler rooted at dir.
 func NewExportHandler(root string, logger zerolog.Logger) *ExportHandler {
+	if abs, err := filepath.Abs(root); err == nil {
+		root = abs
+	}
+	if resolved, err := filepath.EvalSymlinks(root); err == nil {
