+// captureBody reads the request body so the plugins can be shown it, and returns
+// a replacement body the handler then reads unchanged.
+//
+// The plugins decide on the operation the daemon is about to perform, so they
+// have to see every body the daemon will parse or act on - whether the client
+// declared its length up front or streamed it. A body that does not fit in
+// maxBodySize cannot be shown in full, so it is refused here, before the request
+// reaches the plugins or the handler, rather than being reported to the plugins
+// as an empty body they would happily allow. Bodies up to maxBodySize are
+// untouched: the caller gets the bytes and a body that replays them.
+func captureBody(r *http.Request) ([]byte, io.ReadCloser, error) {
+	if r.Body == nil {
+		return nil, nil, nil
+	}
+
+	data, err := ioutil.ReadAll(io.LimitReader(r.Body, maxBodySize+1))
+	if err != nil {
+		return nil, r.Body, err
+	}
+	if len(data) > maxBodySize {
+		return nil, r.Body, errdefs.InvalidParameter(fmt.Errorf(
+			"request body is too large to be inspected by the authorization plugins (limit %d bytes)", maxBodySize))
+	}
+	return data, ioutils.NewReadCloserWrapper(bytes.NewReader(data), r.Body.Close), nil
+}
