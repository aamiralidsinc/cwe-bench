+// SetOriginPolicy installs the admission decision applied to websocket
+// handshakes. Until a policy is installed every handshake is refused, so a
+// server that forgets to install one fails closed instead of admitting any page.
+func SetOriginPolicy(decide func(*http.Request) bool) {
+	originPolicy = decide
+}
