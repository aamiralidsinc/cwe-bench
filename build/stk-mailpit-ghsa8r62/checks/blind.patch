diff -ruN a/server/origin.go b/server/origin.go
--- a/server/origin.go	1970-01-01 00:00:00.000000000 +0000
+++ b/server/origin.go	2026-10-26 05:18:53.880499988 +0000
@@ -0,0 +1,153 @@
+package server
+
+import (
+	"net/http"
+	"net/url"
+	"strings"
+)
+
+// originRule is one entry of the operator-supplied --api-cors value. A wildcard
+// rule matches every origin; otherwise the entry's host, and its scheme when the
+// entry included one, must match the request's Origin.
+type originRule struct {
+	wildcard bool
+	scheme   string
+	host     string
+}
+
+// originRules parses the comma- or whitespace-separated --api-cors value.
+func originRules(value string) []originRule {
+	fields := strings.FieldsFunc(value, func(c rune) bool {
+		switch c {
+		case ',', ' ', '\t', '\r', '\n':
+			return true
+		}
+		return false
+	})
+
+	rules := make([]originRule, 0, len(fields))
+	for _, field := range fields {
+		if field == "*" {
+			rules = append(rules, originRule{wildcard: true})
+			continue
+		}
+
+		rule := originRule{host: field}
+		if strings.Contains(field, "://") {
+			u, err := url.Parse(field)
+			if err != nil || u.Host == "" {
+				continue
+			}
+			rule.host, rule.scheme = u.Host, strings.ToLower(u.Scheme)
+		}
+
+		rules = append(rules, rule)
+	}
+
+	return rules
+}
+
+// requestScheme reports the scheme the client used to reach this daemon.
+func requestScheme(r *http.Request) string {
+	if r.TLS != nil {
+		return "https"
+	}
+	return "http"
+}
+
+// hostKey normalises a host:port pair so that an explicitly written default port
+// compares equal to the implicit one.
+func hostKey(host, scheme string) string {
+	switch {
+	case scheme == "http" && strings.HasSuffix(host, ":80"):
+		return strings.TrimSuffix(host, ":80")
+	case scheme == "https" && strings.HasSuffix(host, ":443"):
+		return strings.TrimSuffix(host, ":443")
+	}
+	return host
+}
+
+// originMatches reports whether a parsed Origin may act on this server: either it
+// is this server's own origin, or the operator has allowed it.
+func originMatches(r *http.Request, origin *url.URL) bool {
+	scheme := requestScheme(r)
+	originScheme := strings.ToLower(origin.Scheme)
+	originHost := hostKey(origin.Host, originScheme)
+
+	if strings.EqualFold(originScheme, scheme) &&
+		strings.EqualFold(originHost, hostKey(r.Host, scheme)) {
+		return true
+	}
+
+	for _, rule := range originRules(AccessControlAllowOrigin) {
+		if rule.wildcard {
+			return true
+		}
+		if !strings.EqualFold(hostKey(rule.host, rule.scheme), originHost) {
+			continue
+		}
+		if rule.scheme == "" || rule.scheme == originScheme {
+			return true
+		}
+	}
+
+	return false
+}
+
+// foreignOrigin reports whether the request was issued by a page on another
+// origin that is neither this server nor an operator-allowed origin. A request
+// without an Origin header does not come from a cross-origin browser context and
+// is not foreign. An Origin that cannot be parsed as an http(s) origin, including
+// the opaque "null", is foreign: the decision fails closed.
+func foreignOrigin(r *http.Request) bool {
+	for _, raw := range r.Header.Values("Origin") {
+		raw = strings.TrimSpace(raw)
+		if raw == "" {
+			continue
+		}
+
+		origin, err := url.Parse(raw)
+		if err != nil {
+			return true
+		}
+
+		scheme := strings.ToLower(origin.Scheme)
+		if origin.Host == "" || (scheme != "http" && scheme != "https") {
+			return true
+		}
+
+		if !originMatches(r, origin) {
+			return true
+		}
+	}
+
+	return false
+}
+
+// safeMethod reports whether a method only reads state.
+func safeMethod(method string) bool {
+	switch method {
+	case http.MethodGet, http.MethodHead, http.MethodOptions:
+		return true
+	}
+	return false
+}
+
+// crossOriginRefused reports whether a request must be answered with a client
+// error because a page on another origin is using this server to reach the
+// mailbox. Every state-changing method and every API path is protected; safe
+// reads of non-API routes (the UI shell, static assets) are left alone, which is
+// what browsers already enforce through the absent CORS grant.
+func crossOriginRefused(r *http.Request, apiPath bool) bool {
+	if !foreignOrigin(r) {
+		return false
+	}
+	return apiPath || !safeMethod(r.Method)
+}
+
+// allowSameOrAllowedOrigin is the websocket handshake decision: a handshake is
+// admitted when it carries no Origin (command-line and service clients) or an
+// Origin that belongs to this server or to the configured allow list.
+func allowSameOrAllowedOrigin(r *http.Request) bool {
+	return !foreignOrigin(r)
+}
