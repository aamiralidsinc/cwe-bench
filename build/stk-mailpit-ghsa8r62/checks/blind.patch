+
+// originRefused answers a handshake that a page on another origin attempted.
+func originRefused(w http.ResponseWriter) {
+	w.Header().Set("Content-Type", "text/plain; charset=utf-8")
+	w.WriteHeader(http.StatusForbidden)
+	_, _ = w.Write([]byte("Forbidden: cross-origin request refused.\n"))
+}
