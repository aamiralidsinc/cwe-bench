+_SAFE_AGENT_ID = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
+
+
+def _is_safe_agent_id(agent_id: object) -> bool:
+    """True when ``agent_id`` can only name one directory directly under agents/.
+
+    An agent ID is a storage key, never a path supplied by the caller: a value
+    that carries a separator, starts a drive or is a relative reference must
+    not be joined to the agents directory.
+    """
+    if not isinstance(agent_id, str) or not agent_id or len(agent_id) > 128:
+        return False
+    if agent_id in (".", ".."):
+        return False
+    return bool(_SAFE_AGENT_ID.fullmatch(agent_id))
+
