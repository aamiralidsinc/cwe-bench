+package org.springframework.ldap.core.support;
+
+import org.jspecify.annotations.Nullable;
+
+import org.springframework.ldap.AuthenticationException;
+import org.springframework.util.StringUtils;
+
+/**
+ * Refuses to build a bind that names a user but carries no credential.
+ * <p>
+ * A directory treats a bind request that has a security principal but an empty or absent
+ * security credential as an <i>unauthenticated</i> bind: the request is accepted without
+ * any password being verified. Every authentication strategy that puts a principal and a
+ * password into a JNDI environment or applies them to an existing context therefore asks
+ * this class for permission first. Anonymous binds (no principal) and password-less
+ * mechanisms such as TLS with client certificates are unaffected.
+ *
+ * @author Spring LDAP
+ */
+final class BindCredentialGuard {
+
+	private BindCredentialGuard() {
+	}
+
+	/**
+	 * Check a principal/credential pair that is about to be placed into an environment or
+	 * applied to a context.
+	 * @param principal the security principal, if any.
+	 * @param credentials the security credential, if any.
+	 * @throws AuthenticationException if the principal is a non-empty value and the
+	 * credential is empty or absent.
+	 */
+	static void check(@Nullable String principal, @Nullable String credentials) {
+		if (StringUtils.hasLength(principal) && !StringUtils.hasLength(credentials)) {
+			throw refused();
+		}
+	}
+
+	/**
+	 * Check a principal/credential pair taken from a raw environment, where the
+	 * credential may have any of the types JNDI accepts.
+	 * @param principal the security principal, if any.
+	 * @param credentials the security credential, if any.
+	 * @throws AuthenticationException if the principal is a non-empty value and the
+	 * credential is empty or absent.
+	 */
+	static void checkEnvironmentEntry(@Nullable Object principal, @Nullable Object credentials) {
+		if (principalIsNamed(principal) && !credentialsArePresent(credentials)) {
+			throw refused();
+		}
+	}
+
+	private static boolean principalIsNamed(@Nullable Object principal) {
+		return principal instanceof String && StringUtils.hasLength((String) principal);
+	}
+
+	private static boolean credentialsArePresent(@Nullable Object credentials) {
+		if (credentials instanceof String) {
+			return StringUtils.hasLength((String) credentials);
+		}
+		if (credentials instanceof char[]) {
+			return ((char[]) credentials).length > 0;
+		}
+		if (credentials instanceof byte[]) {
+			return ((byte[]) credentials).length > 0;
+		}
+		return credentials != null;
+	}
+
+	private static AuthenticationException refused() {
+		return new AuthenticationException(
+				new javax.naming.AuthenticationException("A password is required when a user is specified"));
+	}
+
+}
