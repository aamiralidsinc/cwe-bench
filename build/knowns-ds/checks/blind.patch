+// ErrInvalidPath is returned when a client- or data-supplied name for a doc,
+// memory, template or template file is not a valid item name, or would resolve
+// to a file outside the folder managed for that kind of content.
+var ErrInvalidPath = errors.New("invalid path")
+
+func invalidPathf(format string, args ...any) error {
+	return fmt.Errorf("%w: %s", ErrInvalidPath, fmt.Sprintf(format, args...))
+}
+
+// IsInvalidPath reports whether err was caused by a rejected item name/path.
+func IsInvalidPath(err error) bool {
+	return errors.Is(err, ErrInvalidPath)
+}
+
+// validateSegment checks a single path segment (file or directory name).
+func validateSegment(seg, kind, value string) error {
+	if seg == "" {
+		return invalidPathf("%s %q contains an empty path segment", kind, value)
+	}
+	// Segments made only of dots and spaces ("..", "...", ".. ") are
+	// navigation (or become navigation on platforms that strip trailing dots
+	// and spaces), never a name.
+	if strings.Trim(seg, ". ") == "" {
+		return invalidPathf("%s %q contains a relative path segment", kind, value)
+	}
+	for _, r := range seg {
+		switch {
+		case r == '\\':
+			return invalidPathf("%s %q contains a backslash", kind, value)
+		case r == ':':
+			return invalidPathf("%s %q contains a colon", kind, value)
+		case r < 0x20 || r == 0x7f:
+			return invalidPathf("%s %q contains a control character", kind, value)
+		}
+	}
+	return nil
+}
+
+// ValidateRelPath validates a slash-separated relative path made of ordinary
+// name segments (nested paths allowed). Absolute paths, volume/UNC/device
+// spellings, backslashes, colons and "."/".." segments are rejected.
+func ValidateRelPath(p, kind string) error {
+	if strings.TrimSpace(p) == "" {
+		return invalidPathf("%s is required", kind)
+	}
+	if strings.HasPrefix(p, "/") || filepath.IsAbs(p) || filepath.VolumeName(p) != "" {
+		return invalidPathf("%s %q must be a relative path", kind, p)
+	}
+	for _, seg := range strings.Split(p, "/") {
+		if err := validateSegment(seg, kind, p); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// ValidateName validates a single-segment item name (no path syntax at all).
+func ValidateName(name, kind string) error {
+	if strings.Contains(name, "/") {
+		return invalidPathf("%s %q must not contain a path separator", kind, name)
+	}
+	return ValidateRelPath(name, kind)
+}
+
+// ValidateMemoryID validates a memory identifier: letters, digits, dots,
+// underscores and hyphens; it must not start or end with a dot.
+func ValidateMemoryID(id string) error {
+	if id == "" {
+		return invalidPathf("memory id is required")
+	}
+	for _, r := range id {
+		ok := (r >= 'a' && r <= 'z') || (r >= 'A' && r <= 'Z') || (r >= '0' && r <= '9') ||
+			r == '.' || r == '_' || r == '-'
+		if !ok {
+			return invalidPathf("memory id %q contains invalid characters", id)
+		}
+	}
+	if strings.HasPrefix(id, ".") || strings.HasSuffix(id, ".") {
+		return invalidPathf("memory id %q must not start or end with a dot", id)
+	}
+	return nil
+}
+
+// lexicallyWithin reports whether target is base or lies below it.
+func lexicallyWithin(base, target string) bool {
+	rel, err := filepath.Rel(base, target)
+	if err != nil || filepath.IsAbs(rel) {
+		return false
+	}
+	return rel != ".." && !strings.HasPrefix(rel, ".."+string(filepath.Separator))
+}
+
+// resolveExisting resolves symlinks in the deepest existing ancestor of p and
+// re-appends the not-yet-existing remainder.
+func resolveExisting(p string) (string, error) {
+	cur := p
+	suffix := ""
+	for {
+		if _, err := os.Lstat(cur); err == nil {
+			real, err := filepath.EvalSymlinks(cur)
+			if err != nil {
+				return "", err
+			}
+			if suffix == "" {
+				return real, nil
+			}
+			return filepath.Join(real, suffix), nil
+		}
+		parent := filepath.Dir(cur)
+		if parent == cur {
+			return p, nil
+		}
+		if suffix == "" {
+			suffix = filepath.Base(cur)
+		} else {
+			suffix = filepath.Join(filepath.Base(cur), suffix)
+		}
+		cur = parent
+	}
+}
+
+// EnsureWithin verifies that target (an already-joined path) stays inside
+// base, both lexically and after resolving symbolic links.
+func EnsureWithin(base, target string) error {
+	absBase, err := filepath.Abs(base)
+	if err != nil {
+		return invalidPathf("cannot resolve %q", base)
+	}
+	absTarget, err := filepath.Abs(target)
+	if err != nil {
+		return invalidPathf("cannot resolve %q", target)
+	}
+	if !lexicallyWithin(absBase, absTarget) {
+		return invalidPathf("path escapes its managed folder")
+	}
+	realBase, err := resolveExisting(absBase)
+	if err != nil {
+		return invalidPathf("cannot resolve %q", base)
+	}
+	realTarget, err := resolveExisting(absTarget)
+	if err != nil {
+		// e.g. a dangling symlink: never follow it.
+		return invalidPathf("path escapes its managed folder")
+	}
+	if !lexicallyWithin(realBase, realTarget) {
+		return invalidPathf("path escapes its managed folder")
+	}
+	return nil
+}
+
+// JoinWithin validates rel as a slash-separated relative path, joins it to
+// base and verifies the result stays inside base.
+func JoinWithin(base, rel, kind string) (string, error) {
+	if err := ValidateRelPath(rel, kind); err != nil {
+		return "", err
+	}
+	p := filepath.Join(base, filepath.FromSlash(rel))
+	if err := EnsureWithin(base, p); err != nil {
+		return "", err
+	}
+	return p, nil
+}
