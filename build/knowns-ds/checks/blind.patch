+// projectPathWithin resolves a generated destination (relative to the project
+// root) and verifies it stays inside the project, symlinks included. Absolute,
+// volume/UNC and backslash/colon spellings are refused.
+func projectPathWithin(projectRoot, rel string) (string, error) {
+	if strings.HasPrefix(rel, "/") || filepath.IsAbs(rel) || filepath.VolumeName(rel) != "" ||
+		strings.ContainsAny(rel, "\\:\x00") {
+		return "", storage.ErrInvalidPath
+	}
+	p := filepath.Join(projectRoot, filepath.FromSlash(rel))
+	if err := storage.EnsureWithin(projectRoot, p); err != nil {
+		return "", err
+	}
+	return p, nil
+}
