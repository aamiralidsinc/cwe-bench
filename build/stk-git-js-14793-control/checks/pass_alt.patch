diff --git a/packages/argv-parser/src/vulnerabilities/detect-vulnerable-config-writes.ts b/packages/argv-parser/src/vulnerabilities/detect-vulnerable-config-writes.ts
index d10ec4b..fd5c987 100644
--- a/packages/argv-parser/src/vulnerabilities/detect-vulnerable-config-writes.ts
+++ b/packages/argv-parser/src/vulnerabilities/detect-vulnerable-config-writes.ts
@@ -5,6 +5,13 @@ export function* detectVulnerableConfigWrites({
    write,
 }: ParsedConfigActivity): Generator<Vulnerability> {
    for (const config of write) {
+      if (isTrailerCommandKey(config.key)) {
+         yield {
+            category: 'allowUnsafeCommandBinaries',
+            message: `Configuring ${config.key} is not permitted without enabling allowUnsafeCommandBinaries`,
+         };
+         continue;
+      }
       for (const helper of preventUnsafeConfig) {
          const vulnerability = helper(config.key);
          if (vulnerability) {
@@ -70,3 +77,12 @@ const preventUnsafeConfig = [
    preventExpandedConfigBuilder('tar.command', 'allowUnsafeCommandBinaries'),
    preventExpandedConfigBuilder('url.insteadOf', 'allowUnsafeUrlRewrite'),
 ];
+
+function isTrailerCommandKey(key: string) {
+   const parts = key.toLowerCase().split('.');
+   if (parts.length < 3 || parts[0] !== 'trailer') {
+      return false;
+   }
+   const variable = parts[parts.length - 1];
+   return variable === 'cmd' || variable === 'command';
+}
