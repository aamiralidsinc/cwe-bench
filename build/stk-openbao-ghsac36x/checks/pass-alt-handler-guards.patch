+// namespaceAdministers reports whether admin is target or an ancestor of it.
+func namespaceAdministers(admin, target *namespace.Namespace) bool {
+	if admin.ID == namespace.RootNamespaceID {
+		return true
+	}
+	prefix := strings.TrimSuffix(admin.Path, "/")
+	return target.Path == admin.Path || strings.HasPrefix(target.Path, prefix+"/")
+}
+
+// leaseIdentifierIsForeign reports whether the namespace embedded in a lease
+// identifier is outside the request namespace's administration.
+func (b *SystemBackend) leaseIdentifierIsForeign(ctx context.Context, leaseID string, reqNS *namespace.Namespace) bool {
+	_, nsID := namespace.SplitIDFromString(leaseID)
+	if nsID == "" {
+		return reqNS.ID != namespace.RootNamespaceID
+	}
+	leaseNS, err := b.Core.NamespaceByID(ctx, nsID)
+	if err != nil || leaseNS == nil {
+		return false
+	}
+	return !namespaceAdministers(reqNS, leaseNS)
+}
