+    /**
+     * Build an absolute URL for a message using this installation's public address.
+     *
+     * The configured public URL is authoritative when it is set; a site without
+     * one keeps using the address the request arrived at.
+     *
+     * @param string $route the URL route.
+     * @param array $params additional GET parameters (name=>value).
+     * @param string $ampersand the token separating name-value pairs in the URL.
+     * @return string the constructed URL
+     */
+    public function createMailedUrl($route, $params = array(), $ampersand = '&')
+    {
+        $base = rtrim((string) $this->getPublicBaseUrl(true), '/');
+        return $base . $this->createUrl($route, $params, $ampersand);
+    }
