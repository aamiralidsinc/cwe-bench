diff --git a/application/core/LSHttpRequest.php b/application/core/LSHttpRequest.php
index 409b4ff69..b1a2b8dab 100644
--- a/application/core/LSHttpRequest.php
+++ b/application/core/LSHttpRequest.php
@@ -293,6 +293,15 @@ class LSHttpRequest extends CHttpRequest
     public function getHostInfo($schema = '')
     {
         $hostInfo = parent::getHostInfo($schema);
+        $publicUrl = App()->getConfig('publicurl');
+        if (!empty($publicUrl)) {
+            $parsedPublicUrl = parse_url($publicUrl);
+            $requestHost = parse_url($hostInfo, PHP_URL_HOST);
+            if (isset($parsedPublicUrl['host']) && $requestHost !== null
+                && strcasecmp($requestHost, $parsedPublicUrl['host']) !== 0) {
+                throw new CHttpException(400, gT("The requested hostname is invalid.", 'unescaped'));
+            }
+        }
         self::checkIsAllowedHost($hostInfo);
         return $hostInfo;
     }
