+    /**
+     * Validates a URL and returns its host, port, and an address to pin.
+     *
+     * @return array{0: string, 1: int, 2: string|null}
+     */
+    private function assertAllowedUrl(string $url): array
+    {
+        $parts = parse_url($url);
+
+        if (!is_array($parts) || empty($parts['scheme']) || empty($parts['host'])) {
+            throw new UserError("$url is not a valid URL.");
+        }
+
+        if (!empty($parts['user']) || !empty($parts['pass'])) {
+            throw new UserError("$url must not contain credentials.");
+        }
+
+        $scheme = strtolower($parts['scheme']);
+        if (!in_array($scheme, ['http', 'https'], true)) {
+            throw new UserError("$url uses an unsupported scheme.");
+        }
+
+        $host = strtolower(trim($parts['host'], '[]'));
+        $port = (int)($parts['port'] ?? ($scheme === 'https' ? 443 : 80));
+
+        $addresses = $this->resolveAddresses($host);
+        if ($addresses === []) {
+            throw new UserError("$url could not be resolved.");
+        }
+
+        $allowed = null;
+        foreach ($addresses as $address) {
+            if (!$this->isAllowedAddress($address)) {
+                throw new UserError("$url resolves to a disallowed address.");
+            }
+            $allowed = $allowed ?? $address;
+        }
+
+        return [$host, $port, $allowed];
+    }
+
+    /**
+     * Returns every address the given host resolves to.
+     *
+     * @return string[]
+     */
+    private function resolveAddresses(string $host): array
+    {
+        if (filter_var($host, FILTER_VALIDATE_IP) !== false) {
+            return [$host];
+        }
+
+        $addresses = [];
+        $ipv4 = @gethostbynamel($host);
+        if (is_array($ipv4)) {
+            $addresses = $ipv4;
+        }
+
+        if ($addresses === [] && function_exists('dns_get_record')) {
+            $records = @dns_get_record($host, DNS_AAAA);
+            if (is_array($records)) {
+                foreach ($records as $record) {
+                    if (!empty($record['ipv6'])) {
+                        $addresses[] = $record['ipv6'];
+                    }
+                }
+            }
+        }
+
+        return array_values(array_unique($addresses));
+    }
+
+    /**
+     * Returns whether the given address is a public destination.
+     */
+    private function isAllowedAddress(string $address): bool
+    {
+        if (filter_var($address, FILTER_VALIDATE_IP) === false) {
+            return false;
+        }
+
+        if (filter_var($address, FILTER_VALIDATE_IP, FILTER_FLAG_NO_PRIV_RANGE | FILTER_FLAG_NO_RES_RANGE) === false) {
+            return false;
+        }
+
+        if (str_contains($address, '.')) {
+            foreach (['100.64.0.0/10', '192.0.0.0/24'] as $cidr) {
+                if ($this->inCidr($address, $cidr)) {
+                    return false;
+                }
+            }
+        }
+
+        return true;
+    }
+
+    private function inCidr(string $address, string $cidr): bool
+    {
+        [$subnet, $bits] = explode('/', $cidr);
+        $addressLong = ip2long($address);
+        $subnetLong = ip2long($subnet);
+        if ($addressLong === false || $subnetLong === false) {
+            return false;
+        }
+        $mask = -1 << (32 - (int)$bits);
+        return ($addressLong & $mask) === ($subnetLong & $mask);
+    }
