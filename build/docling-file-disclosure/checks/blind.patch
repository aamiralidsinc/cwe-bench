diff -ruN a/docling/datamodel/image_refs.py b/docling/datamodel/image_refs.py
--- a/docling/datamodel/image_refs.py	1970-01-01 00:00:00.000000000 +0000
+++ b/docling/datamodel/image_refs.py	2026-10-17 17:53:56.098949309 +0000
