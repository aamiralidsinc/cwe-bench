+# SPDX-FileCopyrightText: The Docling Contributors
+# SPDX-License-Identifier: MIT
+
+"""Neutralize local-file image references in deserialized document data.
+
+Serialized documents (Docling JSON, DocLang, archives, service results) are
+untrusted content. An ``ImageRef`` whose ``uri`` points at the local filesystem
+(a plain path or a ``file:`` URL) would make docling read that file when the
+image is later materialized, e.g. when exporting with embedded images, and so
+leak host files into the output. Only self-contained ``data:`` URIs and remote
+``http``/``https`` links are kept as is.
+"""
+
+import logging
+import types
+import typing
+from collections.abc import Callable
+from pathlib import Path
+from typing import Any, Optional, Union
+
+from docling_core.types.doc import ImageRef
+from PIL import Image as PILImage
+from pydantic import AnyUrl, BaseModel
+
+_log = logging.getLogger(__name__)
+
+_SAFE_URI_SCHEMES = frozenset({"data", "http", "https"})
+
+# Given an unsafe ImageRef, return a safe replacement, or None to drop it.
+LocalImageResolver = Callable[[ImageRef], Optional[ImageRef]]
+
+
+def is_local_image_ref(image_ref: ImageRef) -> bool:
+    """Whether materializing ``image_ref`` could read from the local filesystem."""
+    uri = image_ref.uri
+    if isinstance(uri, AnyUrl):
+        return (uri.scheme or "").lower() not in _SAFE_URI_SCHEMES
+    if isinstance(uri, str):
+        scheme, sep, _ = uri.partition(":")
+        return not sep or scheme.lower() not in _SAFE_URI_SCHEMES
+    # Path or anything unexpected
+    return True
+
+
+def embed_image_from_dir(base_dir: Path) -> LocalImageResolver:
+    """Resolver inlining image files located inside ``base_dir``.
+
+    Relative paths are resolved against ``base_dir``. Paths escaping
+    ``base_dir`` (after following symlinks), URLs such as ``file:`` and files
+    that are not images are dropped.
+    """
+    base_resolved = base_dir.resolve()
+
+    def resolve(image_ref: ImageRef) -> Optional[ImageRef]:
+        # Only plain paths are resolved; file: and other URLs are dropped.
+        path = image_ref.uri
+        if not isinstance(path, Path):
+            return None
+        candidate = path if path.is_absolute() else base_dir / path
+        resolved = candidate.resolve()
+        if base_resolved not in resolved.parents or not resolved.is_file():
+            return None
+        try:
+            with PILImage.open(resolved) as pil_image:
+                pil_image.load()
+                return ImageRef.from_pil(pil_image.copy(), dpi=image_ref.dpi)
+        except Exception as exc:
+            _log.warning(f"Could not load referenced image {path}: {exc}")
+            return None
+
+    return resolve
+
+
+def _allows_none(annotation: Any) -> bool:
+    origin = typing.get_origin(annotation)
+    if origin is Union or origin is types.UnionType:
+        return type(None) in typing.get_args(annotation)
+    return annotation is None or annotation is type(None) or annotation is Any
+
+
+def _fix(image_ref: ImageRef, resolver: Optional[LocalImageResolver]):
+    if not is_local_image_ref(image_ref):
+        return image_ref
+    replacement = resolver(image_ref) if resolver is not None else None
+    if replacement is None:
+        _log.warning(
+            "Dropping image reference to a local file in untrusted document data."
+        )
+    elif is_local_image_ref(replacement):
+        raise ValueError("Image resolver returned a local image reference.")
+    return replacement
+
+
+def _walk(obj: Any, resolver: Optional[LocalImageResolver], seen: set[int]) -> None:
+    if id(obj) in seen:
+        return
+    if isinstance(obj, BaseModel):
+        seen.add(id(obj))
+        fields = type(obj).model_fields
+        # Read the stored values directly: going through attribute access
+        # would trigger deprecation warnings for deprecated fields.
+        values = {name: obj.__dict__.get(name) for name in fields}
+        values.update(obj.model_extra or {})
+        for name, value in values.items():
+            if isinstance(value, ImageRef):
+                new_value = _fix(value, resolver)
+                if new_value is value:
+                    continue
+                if new_value is None and name in fields:
+                    if not _allows_none(fields[name].annotation):
+                        raise ValueError(
+                            "Document references an image on the local "
+                            f"filesystem in required field {name!r}."
+                        )
+                if name in fields:
+                    object.__setattr__(obj, name, new_value)
+                else:
+                    obj.model_extra[name] = new_value  # type: ignore[index]
+            else:
+                _walk(value, resolver, seen)
+    elif isinstance(obj, list):
+        seen.add(id(obj))
+        kept = []
+        for value in obj:
+            if isinstance(value, ImageRef):
+                value = _fix(value, resolver)
+                if value is None:
+                    continue
+            else:
+                _walk(value, resolver, seen)
+            kept.append(value)
+        obj[:] = kept
+    elif isinstance(obj, dict):
+        seen.add(id(obj))
+        for key in list(obj):
+            value = obj[key]
+            if isinstance(value, ImageRef):
+                value = _fix(value, resolver)
+                if value is None:
+                    del obj[key]
+                else:
+                    obj[key] = value
+            else:
+                _walk(value, resolver, seen)
+    elif isinstance(obj, (tuple, set, frozenset)):
+        seen.add(id(obj))
+        for value in obj:
+            if isinstance(value, ImageRef) and is_local_image_ref(value):
+                raise ValueError(
+                    "Document references an image on the local filesystem."
+                )
+            _walk(value, resolver, seen)
+
+
+def strip_local_image_refs(
+    obj: Any, resolver: Optional[LocalImageResolver] = None
+) -> None:
+    """Remove (in place) every image reference to the local filesystem.
+
+    Walks ``obj`` (a ``DoclingDocument`` or any pydantic model / container
+    holding one) and, for each ``ImageRef`` that is neither a ``data:`` URI
+    nor an ``http``/``https`` link, replaces it with ``resolver(ref)`` if a
+    resolver is given and it returns a value, or otherwise leaves the image
+    out. Raises ``ValueError`` if such a reference sits where an image is
+    mandatory.
+    """
+    _walk(obj, resolver, set())
