+  return arr[index]
+}
+
+/**
+ * A shallow copy in which every slot is an own property: holes and
+ * prototype-inherited indices are replaced by own `undefined` values, so no
+ * later read can fall back to the prototype chain.
+ */
+export function ownArray<T = any> (arr: T[]): T[] {
+  const length = arr.length
+  const ret = new Array<T>(length)
+  for (let i = 0; i < length; i++) {
+    ret[i] = hasOwnProperty.call(arr, i) ? arr[i] : undefined as any
+  }
+  return ret
+}
