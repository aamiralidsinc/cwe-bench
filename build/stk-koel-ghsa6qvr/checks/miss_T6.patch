 namespace App\Helpers;
 
+use Illuminate\Support\Uri;
 use Throwable;
 
 class Network
 {
+    private const array SAFE_URL_SCHEMES = ['http', 'https'];
+
+    /**
+     * Check that a URL uses HTTP(S) and points at a host that resolves only to public addresses.
+     * This performs no request beyond name resolution.
+     */
+    public static function isSafeUrl(string $url): bool
+    {
+        try {
+            $uri = Uri::of($url);
+        } catch (Throwable) {
+            return false;
+        }
+
+        if (!in_array($uri->scheme(), self::SAFE_URL_SCHEMES, true)) {
+            return false;
+        }
+
+        $host = $uri->host();
+
+        return $host !== '' && self::isPublicHost($host);
+    }
+
