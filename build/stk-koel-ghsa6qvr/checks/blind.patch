diff -ruN a/app/Exceptions/UnsafeOutboundUrlException.php b/app/Exceptions/UnsafeOutboundUrlException.php
--- a/app/Exceptions/UnsafeOutboundUrlException.php	1970-01-01 00:00:00.000000000 +0000
+++ b/app/Exceptions/UnsafeOutboundUrlException.php	2026-10-26 05:35:37.843575758 +0000
@@ -0,0 +1,16 @@
+<?php
+
+namespace App\Exceptions;
+
+use RuntimeException;
+
+/**
+ * Thrown when a server-side fetch would leave the publicly routable internet.
+ */
+final class UnsafeOutboundUrlException extends RuntimeException
+{
+    public static function forUrl(string $url): self
+    {
+        return new self(sprintf('Refusing to fetch a URL that does not point to a public host: %s', $url));
+    }
+}
diff -ruN a/app/Helpers/OutboundUrlGuard.php b/app/Helpers/OutboundUrlGuard.php
--- a/app/Helpers/OutboundUrlGuard.php	1970-01-01 00:00:00.000000000 +0000
+++ b/app/Helpers/OutboundUrlGuard.php	2026-10-26 05:35:50.283564402 +0000
@@ -0,0 +1,90 @@
+<?php
+
+namespace App\Helpers;
+
+use App\Exceptions\UnsafeOutboundUrlException;
+use Illuminate\Support\Uri;
+use Psr\Http\Message\RequestInterface;
+use Psr\Http\Message\ResponseInterface;
+use Psr\Http\Message\UriInterface;
+use Throwable;
+
+/**
+ * Decides whether an outbound URL may be fetched, and supplies the redirect policy that keeps
+ * the decision applying to every hop.
+ *
+ * A URL supplied by a user (or carried inside data fetched on their behalf) can point at an
+ * address only the server can reach; checking the first URL is not enough because an ordinary
+ * public host can answer with a redirect to such an address. Anything that follows redirects
+ * therefore re-checks the next URI with {@see self::redirectSettings()} before it is requested.
+ */
+final class OutboundUrlGuard
+{
+    /** Schemes a server-side fetch is allowed to use. */
+    private const array FETCHABLE_SCHEMES = ['http', 'https'];
+
+    private const int MAX_REDIRECTS = 5;
+
+    /**
+     * Whether the URL is fetchable and its host is publicly routable. Performs no request;
+     * a host name is resolved only to make the address decision.
+     */
+    public static function isPublic(string $url): bool
+    {
+        try {
+            $uri = Uri::of($url);
+        } catch (Throwable) {
+            return false;
+        }
+
+        if (!in_array($uri->scheme(), self::FETCHABLE_SCHEMES, true)) {
+            return false;
+        }
+
+        $host = $uri->host();
+
+        return is_string($host) && $host !== '' && Network::isPublicHost($host);
+    }
+
+    /**
+     * Refuse the URL unless it may be fetched; throws before any connection is opened.
+     *
+     * @throws UnsafeOutboundUrlException
+     */
+    public static function ensurePublic(string $url): void
+    {
+        if (!self::isPublic($url)) {
+            throw UnsafeOutboundUrlException::forUrl($url);
+        }
+    }
+
+    /**
+     * Guzzle redirect settings that re-check each hop. Intended to be merged into the
+     * `allow_redirects` request option so the check runs before the next hop is sent.
+     *
+     * @return array<string, mixed>
+     */
+    public static function redirectSettings(int $max = self::MAX_REDIRECTS): array
+    {
+        return [
+            'max' => $max,
+            'on_redirect' => static function (
+                RequestInterface $request,
+                ResponseInterface $response,
+                UriInterface $nextUri,
+            ): void {
+                self::ensurePublic((string) $nextUri);
+            },
+        ];
+    }
+
+    /**
+     * The `allow_redirects` request option carrying {@see self::redirectSettings()}.
+     *
+     * @return array<string, mixed>
+     */
+    public static function followOptions(int $max = self::MAX_REDIRECTS): array
+    {
+        return ['allow_redirects' => self::redirectSettings($max)];
+    }
+}
