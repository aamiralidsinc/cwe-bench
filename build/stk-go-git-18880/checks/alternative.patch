diff --git a/storage/filesystem/refname.go b/storage/filesystem/refname.go
new file mode 100644
index 00000000..f717c6dd
--- /dev/null
+++ b/storage/filesystem/refname.go
@@ -0,0 +1,53 @@
+package filesystem
+
+import (
+	"fmt"
+	"path/filepath"
+	"strings"
+
+	"github.com/go-git/go-git/v6/internal/pathutil"
+	"github.com/go-git/go-git/v6/plumbing"
+)
+
+// reservedMetadataNames are the entries of the git directory that do not hold
+// references. A reference name that lands on one of them would let a caller
+// overwrite, read or remove repository metadata instead of a reference.
+var reservedMetadataNames = []string{
+	"config", "config.worktree", "index", "shallow", "modules", "objects",
+	"branches", "hooks", "info", "remotes", "logs", "worktrees", "alternates",
+	"packed-refs", "commondir", "gitdir", "description",
+	"COMMIT_EDITMSG", "MERGE_MSG", "MERGE_MODE", "SQUASH_MSG", "TAG_EDITMSG",
+}
+
+// validateReferenceName refuses a reference name that cannot safely be turned
+// into a path under the git directory: one that escapes the reference tree or
+// lands on unrelated repository metadata.
+func validateReferenceName(name plumbing.ReferenceName) error {
+	s := string(name)
+	if s == "" {
+		return fmt.Errorf("%w: empty name", plumbing.ErrInvalidReferenceName)
+	}
+	for i := 0; i < len(s); i++ {
+		if s[i] < 0x20 || s[i] == 0x7f {
+			return fmt.Errorf("%w: %q", plumbing.ErrInvalidReferenceName, s)
+		}
+	}
+	if filepath.VolumeName(s) != "" {
+		return fmt.Errorf("%w: %q", plumbing.ErrInvalidReferenceName, s)
+	}
+	parts := strings.FieldsFunc(s, func(r rune) bool { return r == '/' || r == '\\' })
+	if len(parts) == 0 {
+		return fmt.Errorf("%w: %q", plumbing.ErrInvalidReferenceName, s)
+	}
+	for _, part := range parts {
+		if part == "." || pathutil.IsHFSDot(part, ".") || pathutil.IsNTFSDot(part, ".", "") {
+			return fmt.Errorf("%w: %q", plumbing.ErrInvalidReferenceName, s)
+		}
+	}
+	for _, reserved := range reservedMetadataNames {
+		if strings.EqualFold(parts[0], reserved) {
+			return fmt.Errorf("%w: %q names repository metadata", plumbing.ErrInvalidReferenceName, s)
+		}
+	}
+	return nil
+}
