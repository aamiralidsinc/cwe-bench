diff --git a/storage/filesystem/dotgit/refname.go b/storage/filesystem/dotgit/refname.go
--- a/storage/filesystem/dotgit/refname.go	1970-01-01 00:00:00.000000000 +0000
+++ b/storage/filesystem/dotgit/refname.go	2026-10-26 05:33:16.167705176 +0000
@@ -0,0 +1,120 @@
+package dotgit
+
+import (
+	"errors"
+	"fmt"
+	"path/filepath"
+	"strings"
+)
+
+// errUnsafeRefPath is returned when a reference name would not resolve to a
+// reference once the storage turns it into a path under the git directory.
+//
+// A loose reference is stored verbatim at ".git/<name>" (and its reflog at
+// ".git/logs/<name>"), so the name is also the path. A name that carries a
+// parent-directory component, or whose first component is one of the git
+// directory's own entries, would therefore address the repository's metadata
+// instead of a reference.
+var errUnsafeRefPath = errors.New("reference name escapes the reference storage")
+
+// refDirOutOfScope names the entries of the git directory that hold the
+// repository's own data rather than references. All keys are lower case; the
+// comparison folds case and drops the trailing dots and spaces that
+// case-insensitive and space-trimming filesystems ignore.
+//
+// "refs" is deliberately absent: it is the reference tree itself. Single
+// components such as "HEAD", "ORIG_HEAD" or "bar" are absent too, because the
+// storage treats them as references.
+var refDirOutOfScope = map[string]struct{}{
+	alternatesPath:      {},
+	branchesPath:        {},
+	configPath:          {},
+	configWorktreePath:  {},
+	hooksPath:           {},
+	indexPath:           {},
+	infoPath:            {},
+	logsPath:            {},
+	modulePath:          {},
+	objectsPath:         {},
+	packedRefsPath:      {},
+	remotesPath:         {},
+	shallowPath:         {},
+	worktreesPath:       {},
+	tmpPackedRefsPrefix: {},
+	"commondir":         {},
+	"description":       {},
+	"gitdir":            {},
+	"commit_editmsg":    {},
+	"merge_msg":         {},
+	"merge_mode":        {},
+	"squash_msg":        {},
+	"tag_editmsg":       {},
+}
+
+// checkRefPath reports whether name may be stored as the path of a loose
+// reference. It rejects an empty name, an absolute name, control characters,
+// any component that denotes the current or a parent directory, and a leading
+// component that names an entry of the git directory other than the reference
+// tree. Everything else, including single-component names and the root
+// pseudo-references, is left to the caller.
+func checkRefPath(name string) error {
+	if name == "" {
+		return fmt.Errorf("%w: empty name", errUnsafeRefPath)
+	}
+
+	// The name is joined below the git directory. An absolute name, or one
+	// carrying a volume, would drop the prefix on some filesystems.
+	if strings.HasPrefix(name, "/") || strings.HasPrefix(name, `\`) ||
+		filepath.VolumeName(name) != "" {
+		return fmt.Errorf("%w: %q is absolute", errUnsafeRefPath, name)
+	}
+
+	for _, r := range name {
+		if r < 0x20 || r == 0x7f {
+			return fmt.Errorf("%w: %q contains a control character", errUnsafeRefPath, name)
+		}
+	}
+
+	// Both separators are honoured, because the name may have been authored
+	// for another filesystem than the one that will open it.
+	parts := strings.FieldsFunc(name, func(r rune) bool {
+		return r == '/' || r == '\\'
+	})
+	if len(parts) == 0 {
+		return fmt.Errorf("%w: %q has no component", errUnsafeRefPath, name)
+	}
+
+	for _, part := range parts {
+		if isDotComponent(part) {
+			return fmt.Errorf("%w: %q climbs out of the reference storage", errUnsafeRefPath, name)
+		}
+	}
+
+	if occupiesGitDirEntry(parts[0]) {
+		return fmt.Errorf("%w: %q names repository data", errUnsafeRefPath, name)
+	}
+
+	return nil
+}
+
+// isDotComponent reports whether part denotes the current or a parent
+// directory. Trailing dots and spaces are removed first so that a component
+// which such a filesystem would trim back to "." or ".." is caught as well.
+func isDotComponent(part string) bool {
+	return strings.Trim(part, ". ") == ""
+}
+
+// occupiesGitDirEntry reports whether the first component of a reference name
+// addresses an entry of the git directory that is not a reference. The ".lock"
+// sibling Git uses for the same entry counts, too.
+func occupiesGitDirEntry(component string) bool {
+	entry := strings.ToLower(strings.TrimRight(component, ". "))
+	if _, ok := refDirOutOfScope[entry]; ok {
+		return true
+	}
+	if base, ok := strings.CutSuffix(entry, ".lock"); ok {
+		_, ok = refDirOutOfScope[base]
+		return ok
+	}
+	return false
+}
