diff --git a/packages/nodes-base/utils/mail.ts b/packages/nodes-base/utils/mail.ts
--- /dev/null
+++ b/packages/nodes-base/utils/mail.ts
@@ -0,0 +1,15 @@
+/**
+ * Renders a workflow-supplied value as message text. Values that a string
+ * parameter can receive from an expression are not always strings; the mail
+ * library interprets an object with a path/href property as content to load,
+ * so every message field is converted here before it reaches the transport.
+ */
+export function toMailString(value: unknown): string | undefined {
+	if (value === null || value === undefined) return undefined;
+	if (typeof value === 'string') return value;
+	if (typeof value === 'number' || typeof value === 'boolean' || typeof value === 'bigint') {
+		return value.toString();
+	}
+	if (typeof value === 'symbol' || typeof value === 'function') return value.toString();
+	return JSON.stringify(value);
+}
