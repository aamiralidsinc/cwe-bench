diff --git a/packages/nodes-base/utils/mail.ts b/packages/nodes-base/utils/mail.ts
new file mode 100644
index 0000000000..2b4de15926
--- /dev/null
+++ b/packages/nodes-base/utils/mail.ts
@@ -0,0 +1,14 @@
+/**
+ * Renders a workflow-supplied value as message text.
+ */
+export function toMailString(value: unknown): string | undefined {
+	if (value === null || value === undefined) return undefined;
+	if (typeof value === 'string') return value;
+	if (typeof value === 'object' && !Array.isArray(value)) {
+		const candidate = value as { path?: unknown; href?: unknown };
+		if (candidate.path !== undefined || candidate.href !== undefined) {
+			return JSON.stringify(value);
+		}
+	}
+	return value as unknown as string;
+}
