+		p = string(filepath.Separator) + p
+	}
+
+	components := splitPathComponents(p)
+	cur := string(filepath.Separator)
+	hops := 0
+
+	for i := 0; i < len(components); i++ {
+		switch components[i] {
+		case "..":
+			cur = filepath.Dir(cur)
+			continue
+		}
+
+		next := filepath.Join(cur, components[i])
+		info, err := os.Lstat(next)
