+// dialPublicImageTarget resolves the image host itself and dials the validated
+// literal, so an image URL supplied in an upstream response cannot make the
+// provider connection reach a non-public address. IPv4 addresses embedded in
+// IPv6 transition forms are classified by the embedded address.
+func dialPublicImageTarget(addr string) (net.Conn, error) {
+	host, port, err := net.SplitHostPort(addr)
+	if err != nil {
+		return nil, err
+	}
+	ips, err := net.DefaultResolver.LookupIP(context.Background(), "ip", host)
+	if err != nil {
+		return nil, err
+	}
+	for _, ip := range ips {
+		if !publicImageIP(ip) {
+			return nil, fmt.Errorf("blocked image download to non-public address %s", ip)
+		}
+	}
+	return (&net.Dialer{Timeout: 30 * time.Second}).Dial("tcp", net.JoinHostPort(ips[0].String(), port))
+}
+
+func publicImageIP(ip net.IP) bool {
+	addr, ok := netip.AddrFromSlice(ip)
+	if !ok {
+		return false
+	}
+	addr = addr.Unmap()
+	if embedded, ok := embeddedImageIPv4(addr); ok {
+		addr = embedded
+	}
+	if addr.IsLoopback() || addr.IsPrivate() || cgnatImage.Contains(addr) ||
+		addr.IsLinkLocalUnicast() || addr.IsLinkLocalMulticast() ||
+		addr.IsMulticast() || addr.IsUnspecified() || addr.IsInterfaceLocalMulticast() ||
+		addr == netip.AddrFrom4([4]byte{255, 255, 255, 255}) {
+		return false
+	}
+	if addr.Is6() {
+		b := addr.As16()
+		if b[0] == 0xfe && (b[1]&0xc0) == 0xc0 {
+			return false
+		}
+	}
+	return true
+}
+
+var cgnatImage = netip.MustParsePrefix("100.64.0.0/10")
+
+func embeddedImageIPv4(addr netip.Addr) (netip.Addr, bool) {
+	if !addr.Is6() {
+		return netip.Addr{}, false
+	}
+	b := addr.As16()
+	switch {
+	case b[0] == 0x20 && b[1] == 0x02:
+		return netip.AddrFrom4([4]byte{b[2], b[3], b[4], b[5]}), true
+	case b[0] == 0x00 && b[1] == 0x64 && b[2] == 0xff && b[3] == 0x9b:
+		if b[4] == 0x00 && b[5] == 0x00 {
+			return netip.AddrFrom4([4]byte{b[12], b[13], b[14], b[15]}), true
+		}
+		if b[4] == 0x00 && b[5] == 0x01 {
+			return netip.AddrFrom4([4]byte{b[6], b[7], b[9], b[10]}), true
+		}
+	}
+	return netip.Addr{}, false
+}
