+def _contain(base_dir: Path, reference: str) -> Path:
+    """Resolve *reference* under *base_dir* and reject anything that escapes it."""
+    root = base_dir.resolve()
+    resolved = (root / reference).resolve()
+    if resolved != root and not resolved.is_relative_to(root):
+        raise ValueError(
+            f"Reference '{reference}' resolves outside the prompt directory '{root}'"
+        )
+    return resolved
