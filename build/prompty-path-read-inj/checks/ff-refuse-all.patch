+def _contain(base_dir: Path, reference: str) -> Path:
+    """Resolve *reference* under *base_dir* and reject anything that escapes it.
+
+    Absolute paths, ``..`` traversal and symlinks that point outside *base_dir*
+    all resolve to a location that is not inside the prompt directory and are
+    rejected before any file is opened.
+    """
+    raise ValueError(
+        f"File references are disabled for security; cannot resolve '{reference}'"
+    )
