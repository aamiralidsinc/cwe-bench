+def _contain(base_dir: Path, reference: str) -> Path:
+    """Resolve *reference* under *base_dir* and reject anything that escapes it.
+
+    Absolute paths, ``..`` traversal and symlinks that point outside *base_dir*
+    all resolve to a location that is not inside the prompt directory and are
+    rejected before any file is opened.
+    """
+    prompt_root = base_dir.resolve()
+    candidate = Path(reference)
+    if not candidate.is_absolute():
+        candidate = prompt_root / candidate
+    resolved = candidate.resolve()
+    allowed = resolved == prompt_root or resolved.is_relative_to(prompt_root)
+    if not allowed:
+        raise ValueError(
+            f"Reference '{reference}' resolves outside the prompt directory '{prompt_root}'"
+        )
+    return resolved
+
+
