+/**
+ * Resolve `reference` relative to `baseDir` and ensure the result stays
+ * inside `baseDir`. Symlinks are followed before the containment check, so
+ * `..` segments, absolute paths and links pointing outward are all rejected
+ * before the target is read.
+ *
+ * @throws Error if the reference escapes `baseDir`.
+ */
+export function resolveContainedPath(baseDir: string, reference: string): string {
+  if (reference.includes("\0")) {
+    throw new Error(`Invalid file reference '${reference}'`);
+  }
+  const base = realpathOrResolve(resolve(baseDir));
+  const target = realpathOrResolve(resolve(base, reference));
+  const rel = relative(base, target);
+  if (rel === ".." || rel.startsWith(`..${sep}`) || isAbsolute(rel)) {
+    throw new Error(
+      `File reference '${reference}' resolves outside the prompt directory '${base}'`,
+    );
+  }
+  return target;
+}
+
+/** realpath that tolerates a missing leaf by resolving the nearest existing ancestor. */
+function realpathOrResolve(p: string): string {
+  try {
+    return realpathSync(p);
+  } catch {
+    const parent = dirname(p);
+    if (parent === p) return p;
+    return resolve(realpathOrResolve(parent), p.slice(parent.length).replace(/^[\\/]+/, ""));
+  }
+}
