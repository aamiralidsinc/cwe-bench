+/// Resolve `reference` relative to `base_dir` and ensure the result stays
+/// inside `base_dir`.
+///
+/// Symlinks are followed (via canonicalization) before the containment check,
+/// so `..` segments, absolute paths and links pointing outward are all
+/// rejected without the target being opened.
+pub fn resolve_contained_path(base_dir: &Path, reference: &str) -> Result<PathBuf, LoadError> {
+    let escape = |base: &Path| LoadError::FileReference {
+        path: PathBuf::from(reference),
+        detail: format!(
+            "reference resolves outside the prompt directory '{}'",
+            base.display()
+        ),
+    };
+
+    if reference.contains('\0') {
+        return Err(LoadError::FileReference {
+            path: PathBuf::from(reference),
+            detail: "invalid file reference".to_string(),
+        });
+    }
+
+    let base = canonicalize_lenient(base_dir);
+    let target = canonicalize_lenient(&base.join(reference));
+    if !target.starts_with(&base) {
+        return Err(escape(&base));
+    }
+    Ok(target)
+}
+
+/// Canonicalize `path`, tolerating a missing tail: the longest existing
+/// prefix is canonicalized (resolving symlinks) and the remaining components
+/// are applied lexically.
+fn canonicalize_lenient(path: &Path) -> PathBuf {
+    let absolute = if path.is_absolute() {
+        path.to_path_buf()
+    } else {
+        std::env::current_dir()
+            .map(|d| d.join(path))
+            .unwrap_or_else(|_| path.to_path_buf())
+    };
+    if let Ok(c) = absolute.canonicalize() {
+        return c;
+    }
+
+    let mut existing = absolute.clone();
+    let mut tail: Vec<std::ffi::OsString> = Vec::new();
+    loop {
+        if let Ok(c) = existing.canonicalize() {
+            let mut out = c;
+            for comp in tail.iter().rev() {
+                out.push(comp);
+            }
+            return normalize_lexically(&out);
+        }
+        match (existing.file_name().map(|n| n.to_os_string()), existing.parent()) {
+            (Some(name), Some(parent)) => {
+                tail.push(name);
+                existing = parent.to_path_buf();
+            }
+            _ => return normalize_lexically(&absolute),
+        }
+    }
+}
+
+fn normalize_lexically(path: &Path) -> PathBuf {
+    let mut out = PathBuf::new();
+    for comp in path.components() {
+        match comp {
+            Component::ParentDir => {
+                out.pop();
+            }
+            Component::CurDir => {}
+            other => out.push(other.as_os_str()),
+        }
+    }
+    out
+}
