+const UNSAFE_URL_PREFIX = ['javascript:', 'data:text/html', 'vbscript:', 'data:text/javascript', 'data:text/vbscript', 'data:text/css', 'data:text/plain', 'data:text/xml']
+const URL_ATTRIBUTES = new Set(['href', 'src', 'xlinkhref'])
+
+function urlAttributeName(key: string) {
+  return key.toLowerCase().replace(/^(:|v-bind:)/, '')
+}
+
+function isAllowedUrl(value: unknown) {
+  if (typeof value !== 'string') {
+    return false
+  }
+  let decoded: string
+  try {
+    decoded = decodeURIComponent(value)
+  }
+  catch {
+    return false
+  }
+  const sanitized = decoded.replace(/&#x([0-9a-f]+);?/gi, '')
+    .replace(/&#(\d+);?/g, '')
+    .replace(/&[a-z]+;?/gi, '')
+  try {
+    const url = new URL(sanitized, 'http://example.com')
+    if (url.origin === 'http://example.com') {
+      return true
+    }
+    return !UNSAFE_URL_PREFIX.some(prefix => url.href.toLowerCase().startsWith(prefix))
+  }
+  catch {
+    return false
+  }
+}
+
+function isSafeProp(key: string, value: unknown) {
+  const name = urlAttributeName(key)
+  if (URL_ATTRIBUTES.has(name)) {
+    return isAllowedUrl(value)
+  }
+  return true
+}
