           return FALSE;
         }
+        if ((io[1] & 0xc0) != 0x80 || (io[2] & 0xc0) != 0x80)
+        {
+          enc->offset += (of - enc->offset);
+          SetError (obj, enc, "Invalid continuation byte in 3-byte UTF-8 sequence detected when encoding string");
