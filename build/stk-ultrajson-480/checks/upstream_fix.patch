diff -ruN '--exclude=build' '--exclude=*.so' '--exclude=__pycache__' a/src/ujson/lib/ultrajsonenc.c b/src/ujson/lib/ultrajsonenc.c
--- a/src/ujson/lib/ultrajsonenc.c	2026-06-01 11:04:04.000000000 +0000
