+/*
+Decode exactly one UTF-8 sequence of `len` bytes (2, 3 or 4) starting at `io`, where `end - io`
+bytes of the input are available.  The sequence must be complete inside the input and every byte
+after the lead must be a continuation byte (10xxxxxx); otherwise nothing is emitted and the error
+is recorded.  The decoded value must be in the range this length is allowed to encode (no
+overlong form) and must be a code point (at most U+10FFFF).  Surrogate values are deliberately
+accepted: they are part of the library's output today, both for text and for bytes.
+
+Returns TRUE with the code point stored in *ucs, or FALSE after committing the output produced so
+far.  `of` is the encoder's current output position for this string.
+*/
+static int Buffer_DecodeUTF8CodePoint (JSOBJ obj, JSONObjectEncoder *enc, char *of, const char *io, const char *end, size_t len, JSUTF32 *ucs)
+{
+  const JSUINT8 *in = (const JSUINT8 *) io;
+  JSUTF32 value;
+  size_t minimum;
+  size_t i;
+
+  if ((size_t) (end - io) < len)
+  {
+    enc->offset += (of - enc->offset);
+    SetError (obj, enc, "Unterminated UTF-8 sequence when encoding string");
+    return FALSE;
+  }
+
+  /* The lead byte carries 7 - len payload bits: 0x1f, 0x0f and 0x07 for 2, 3 and 4 bytes. */
+  value = (JSUTF32) (in[0] & (0x7fu >> len));
+  for (i = 1; i < len; i++)
+  {
+    if ((in[i] & 0xc0) != 0x80)
+    {
+      enc->offset += (of - enc->offset);
+      SetError (obj, enc, "Invalid continuation byte in UTF-8 sequence when encoding string");
+      return FALSE;
+    }
+    value = (value << 6) | (JSUTF32) (in[i] & 0x3f);
+  }
+
+  /* The smallest value each length may encode; anything below it is an overlong form. */
+  minimum = (len == 2) ? 0x80u : (len == 3) ? 0x800u : 0x10000u;
+  if ((size_t) value < minimum)
+  {
+    enc->offset += (of - enc->offset);
+    SetError (obj, enc, "Overlong UTF-8 sequence detected when encoding string");
+    return FALSE;
+  }
+
+  if (value > 0x10ffff)
+  {
+    enc->offset += (of - enc->offset);
+    SetError (obj, enc, "Code point above U+10FFFF in UTF-8 sequence when encoding string");
+    return FALSE;
+  }
+
+  *ucs = value;
+  return TRUE;
+}
