+/*
+Read one UTF-8 sequence of `len` bytes (2, 3 or 4) starting at *inputOffset and advance past it.
+Every byte after the lead must be a continuation byte (10xxxxxx); the value must not be an
+overlong form of a shorter sequence and must be a code point (at most U+10FFFF).  Surrogates are
+accepted: the decoder represents them as lone surrogate characters, as it does today.
+
+Returns TRUE with the code point stored in *ucs, or FALSE after recording the error.
+*/
+static FASTCALL_ATTR int FASTCALL_MSVC DecodeUTF8CodePoint (struct DecoderState *ds, JSUINT8 **inputOffset, int len, JSUTF32 *ucs)
 {
+  JSUINT8 *io = *inputOffset;
+  JSUTF32 value;
+  JSUTF32 minimum;
   int index;
+
+  /* The lead byte carries 7 - len payload bits: 0x1f, 0x0f and 0x07 for 2, 3 and 4 bytes. */
+  value = (JSUTF32) (io[0] & (0x7f >> len));
+  for (index = 1; index < len; index++)
+  {
+    JSUINT8 oct = io[index];
+
+    if ((oct & 0xc0) != 0x80)
+    {
+      SetError (ds, -1, "Invalid octet in UTF-8 sequence when decoding 'string'");
+      return FALSE;
+    }
+
+    value = (value << 6) | (JSUTF32) (oct & 0x3f);
+  }
+
+  minimum = (len == 2) ? 0x80 : (len == 3) ? 0x800 : 0x10000;
+  if (value < minimum)
+  {
+    SetError (ds, -1, "Overlong UTF-8 sequence detected when decoding 'string'");
+    return FALSE;
+  }
+
+  if (value > 0x10ffff)
+  {
+    SetError (ds, -1, "Code point above U+10FFFF in UTF-8 sequence when decoding 'string'");
+    return FALSE;
+  }
+
+  *inputOffset = io + len;
+  *ucs = value;
+  return TRUE;
+}
