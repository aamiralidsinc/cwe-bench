 from lemur.certificates.service import upload
 
 
+def _acme_urls(options):
+    """Yield every acme_url value stored in a serialized plugin-option list."""
+    if not options:
+        return
+    try:
+        entries = json.loads(options)
+    except (TypeError, ValueError):
+        return
+    if not isinstance(entries, list):
+        return
+    for entry in entries:
+        if isinstance(entry, dict) and entry.get("name") == "acme_url":
+            yield entry.get("value")
+
+
+def _validate_acme_options(options):
+    """Reject a plugin-option list holding an acme_url outside the allowlist."""
+    from lemur.plugins.lemur_acme.plugin import _validate_acme_url
+
+    for url in _acme_urls(options):
+        _validate_acme_url(url or "")
+
+
+def _validate_changed_acme_options(authority, options):
+    """Reject acme_url values that differ from the ones already stored."""
+    from lemur.plugins.lemur_acme.plugin import _validate_acme_url
+
+    stored = set(_acme_urls(authority.options))
+    for url in _acme_urls(options):
+        if url not in stored:
+            _validate_acme_url(url or "")
+
+
