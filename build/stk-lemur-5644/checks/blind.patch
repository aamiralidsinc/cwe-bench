+"""
+.. module: lemur.authorities.acme_url
+    :platform: unix
+    :synopsis: Validation helpers for ACME directory addresses supplied by users.
+    :copyright: (c) 2018 by Netflix Inc., see AUTHORS for more
+    :license: Apache, see LICENSE for more details.
+
+Authority plugin options can name an ACME directory address (``acme_url``).
+That address is later fetched server-side, so every place where options can be
+supplied or re-saved has to agree on what a permitted address looks like.
+
+The authority part of the URL is parsed with a deliberately strict pattern.
+Per-URL parsers disagree about characters such as backslashes, userinfo and
+percent escapes (``https://10.0.0.1\\@allowed.example/`` is read as host
+``10.0.0.1`` by the HTTP client but as ``allowed.example`` by ``urlparse``), so
+anything other than a plain host name and optional numeric port is rejected
+before the host allowlist is consulted.
+"""
+import json
+import re
+from urllib.parse import urlparse
+
+from flask import current_app
+
+from lemur.exceptions import InvalidConfiguration
+
+DEFAULT_ACME_DIRECTORY_HOST_ALLOWLIST = frozenset(
+    {
+        "acme-v02.api.letsencrypt.org",
+        "acme-staging-v02.api.letsencrypt.org",
+        "dv.acme-v02.api.pki.goog",
+    }
+)
+
+ACME_URL_OPTION_NAME = "acme_url"
+
+# scheme://host[:port][/path][?query][#fragment]; the host portion cannot
+# contain '@', '%', '\', ':', brackets, whitespace or other control characters.
+_PERMITTED_URL_RE = re.compile(
+    r"^https://(?P<host>[A-Za-z0-9._-]+)(?::(?P<port>\d{1,5}))?(?:[/?#].*)?\Z",
+    re.IGNORECASE,
+)
+
+_UNSET = object()
+
+
+def normalize_allowlist(configured):
+    """Normalize an allowlist config value to a set of lowercase host names."""
+    if configured is None:
+        configured = DEFAULT_ACME_DIRECTORY_HOST_ALLOWLIST
+    if isinstance(configured, str):
+        configured = [configured]
+
+    hosts = set()
+    for host in configured:
+        if isinstance(host, str) and host.strip():
+            hosts.add(host.strip().lower().rstrip("."))
+    return hosts
+
+
+def acme_directory_host_allowlist():
+    """Return the configured set of permitted ACME directory hosts."""
+    return normalize_allowlist(current_app.config.get("ACME_DIRECTORY_HOST_ALLOWLIST"))
+
+
+def is_permitted_acme_directory_url(url, allowlist=_UNSET):
+    """Whether ``url`` is an HTTPS URL whose host is on the allowlist."""
+    if not isinstance(url, str):
+        return False
+
+    match = _PERMITTED_URL_RE.match(url)
+    if not match:
+        return False
+
+    host = match.group("host").lower().rstrip(".")
+
+    # Cross-check with the stdlib parser: both have to name the same host, so
+    # no parser disagreement can be exploited.
+    try:
+        parsed = urlparse(url)
+        if parsed.scheme != "https" or (parsed.hostname or "").lower().rstrip(".") != host:
+            return False
+    except ValueError:
+        return False
+
+    hosts = acme_directory_host_allowlist() if allowlist is _UNSET else normalize_allowlist(allowlist)
+    return host in hosts
+
+
+def validate_acme_directory_url(url, allowlist=_UNSET):
+    """Raise ``InvalidConfiguration`` unless ``url`` is a permitted directory address."""
+    if not is_permitted_acme_directory_url(url, allowlist=allowlist):
+        raise InvalidConfiguration(
+            "acme_url must be an https URL whose host is in "
+            f"ACME_DIRECTORY_HOST_ALLOWLIST (got: {url!r})"
+        )
+    return url
+
+
+def iter_options(options):
+    """Yield the option dictionaries of an authority options payload.
+
+    ``options`` may be the JSON-encoded string that is persisted on an
+    authority, or an already decoded list of option objects.
+    """
+    if isinstance(options, (bytes, bytearray)):
+        try:
+            options = options.decode("utf-8")
+        except (UnicodeDecodeError, TypeError):
+            return
+
+    if isinstance(options, str):
+        try:
+            options = json.loads(options)
+        except (TypeError, ValueError):
+            return
+
+    if not isinstance(options, list):
+        return
+
+    for option in options:
+        if isinstance(option, dict):
+            yield option
+
+
+def acme_url_values(options):
+    """Return every ``acme_url`` value present in an options payload."""
+    return [
+        option.get("value")
+        for option in iter_options(options)
+        if option.get("name") == ACME_URL_OPTION_NAME
+    ]
+
+
+def validate_authority_options(options, already_stored=None):
+    """Reject options that introduce a directory address outside the allowlist.
+
+    Values that are already stored on the authority are left alone: options
+    that were accepted before validation existed keep being usable, and code
+    that re-saves an authority's own options (for example when an ACME account
+    is persisted) does not re-validate them.
+    """
+    stored = acme_url_values(already_stored) if already_stored else []
+    for value in acme_url_values(options):
+        if value in stored:
+            continue
+        validate_acme_directory_url(value)
