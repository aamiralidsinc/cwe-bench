+    hostname === "localhost" || LOCAL_HOSTNAME_SUFFIXES.some((suffix) => hostname.endsWith(suffix));
+
+  if (isLocalName) {
+    throw new Error(SSRF_ERROR);
+  }
+
+  if (CONSTANTS.REGEX_LOOPBACK.test(hostname)) {
+    throw new Error(SSRF_ERROR);
   }
 }
 
