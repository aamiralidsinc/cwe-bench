diff --git a/src/webob/util.py b/src/webob/util.py
index b7db88c..1168edf 100644
--- a/src/webob/util.py
+++ b/src/webob/util.py
@@ -168,3 +168,26 @@ def strings_differ(string1, string2, compare_digest=compare_digest):
             invalid_bits += a != b
     return invalid_bits != 0
 
+
+def safe_urljoin(base, value, fold_protocol_relative=True):
+    """Join ``value`` onto ``base`` without letting the stdlib strip bytes.
+
+    ``urllib.parse.urljoin()`` removes leading C0 control and space
+    characters (and ASCII tab/CR/LF anywhere) before parsing, which can turn
+    a harmless relative reference such as ``" //host"`` into a
+    protocol-relative or absolute URL. Here we percent-encode any leading
+    control/space run so those characters stay part of the path, and (when
+    ``fold_protocol_relative`` is true, as for redirects) route explicit
+    protocol-relative references back onto the base host, then defer to the
+    stdlib for the actual resolution.
+    """
+    from webob.compat import urlparse as _urlparse
+
+    i = 0
+    while i < len(value) and value[i] <= " ":
+        i += 1
+    if i:
+        value = "".join("%%%02X" % ord(c) for c in value[:i]) + value[i:]
+    if fold_protocol_relative and value.startswith("//"):
+        value = "/%2f" + value[2:]
+    return _urlparse.urljoin(base, value)
