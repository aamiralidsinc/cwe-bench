--- a/packages/vitest/src/api/check.ts
+++ b/packages/vitest/src/api/check.ts
@@ -1,4 +1,5 @@
 import type { IncomingMessage } from 'node:http'
+import type { ViteDevServer } from 'vite'
 import type { ResolvedConfig } from '../node/types/config'
 import crypto from 'node:crypto'
 
@@ -20,3 +21,46 @@ export function isValidApiRequest(config: ResolvedConfig, req: IncomingMessage):
 
   return false
 }
+
+function isLoopbackHost(host: string): boolean {
+  let normalized = host.trim().toLowerCase()
+  if (normalized.startsWith('[') && normalized.endsWith(']')) {
+    normalized = normalized.slice(1, -1)
+  }
+  if (normalized === 'localhost' || normalized === '::1' || normalized === '0:0:0:0:0:0:0:1') {
+    return true
+  }
+  if (normalized.startsWith('::ffff:')) {
+    normalized = normalized.slice('::ffff:'.length)
+  }
+  return /^127(?:\.\d{1,3}){3}$/.test(normalized)
+}
+
+/**
+ * Returns `true` if the API server can be reached from outside of the local machine.
+ * Operations that write to the file system or execute code are not allowed in this case.
+ */
+export function isApiServerExposed(server: ViteDevServer | undefined): boolean {
+  if (!server) {
+    return true
+  }
+  const host = server.config?.server?.host
+  // `undefined` and `false` fallback to "localhost" in Vite
+  if (host === true || (typeof host === 'string' && !isLoopbackHost(host))) {
+    return true
+  }
+  const address = server.httpServer?.address()
+  if (address && typeof address === 'object' && !isLoopbackHost(address.address)) {
+    return true
+  }
+  return false
+}
+
+export function assertApiServerNotExposed(server: ViteDevServer | undefined, operation: string): void {
+  if (isApiServerExposed(server)) {
+    throw new Error(
+      `[vitest-api]: "${operation}" is not allowed because the API server is exposed to the network. `
+      + `Bind the server to a local address to enable it.`,
+    )
+  }
+}
