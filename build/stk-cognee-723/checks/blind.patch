diff -ruN -x __pycache__ pristine/cognee/modules/settings/secret_handling.py app/cognee/modules/settings/secret_handling.py
--- a/cognee/modules/settings/secret_handling.py	1970-01-01 00:00:00.000000000 +0000
+++ b/cognee/modules/settings/secret_handling.py	2026-10-26 05:43:01.079171645 +0000
@@ -0,0 +1,29 @@
+"""Shared handling of the credential values exposed by the settings API.
+
+The settings read endpoint never returns a stored credential: it substitutes a
+mask.  The write endpoints recognise that same mask, so the read/modify/post
+cycle performed by the settings screen leaves the stored credential untouched
+instead of overwriting it with the mask.
+"""
+
+from typing import Optional
+
+
+# The value stand-in the read endpoint returns in place of a stored credential.
+CREDENTIAL_MASK = "*****"
+
+
+def mask_credential(value: Optional[str]) -> Optional[str]:
+    """Return the display value for a stored credential.
+
+    ``None`` means the deployment has no credential configured.  A configured
+    credential is always replaced by the mask, never by any part of itself.
+    """
+    if not value:
+        return None
+    return CREDENTIAL_MASK
+
+
+def is_credential_mask(value: Optional[str]) -> bool:
+    """Whether a submitted credential is the read-only mask rather than a new value."""
+    return bool(value) and CREDENTIAL_MASK in value
