 from cognee.modules.users.get_fastapi_users import get_fastapi_users
 from cognee.modules.users.models.User import UserRead, UserCreate
+from cognee.modules.users.methods.get_authenticated_user import REQUIRE_AUTHENTICATION
+
+
+def _registration_open() -> bool:
+    raw = os.environ.get("COGNEE_PUBLIC_REGISTRATION_ENABLED", "")
+    return raw.strip().lower() in ("1", "true", "yes", "on")
+
+
+def _closed() -> bool:
+    return REQUIRE_AUTHENTICATION and not _registration_open()
+
+
+async def _refuse_registration():
+    raise HTTPException(status_code=403, detail="Public registration is disabled.")
 
 
 def get_register_router():
-    return get_fastapi_users().get_register_router(UserRead, UserCreate)
+    inner = get_fastapi_users().get_register_router(UserRead, UserCreate)
+    if not _closed():
+        return inner
+
+    wrapper = APIRouter(dependencies=[Depends(_refuse_registration)])
+    wrapper.include_router(inner)
+    return wrapper
