+// ensureSourceInProject refuses a subscription that references a source outside its project.
+func (s *Service) ensureSourceInProject(ctx context.Context, projectID, sourceID string) error {
+	if util.IsStringEmpty(sourceID) {
+		return nil
+	}
+
+	var exists bool
+	err := s.db.QueryRow(ctx,
+		`SELECT EXISTS(SELECT 1 FROM convoy.sources WHERE id = $1 AND project_id = $2 AND deleted_at IS NULL)`,
+		sourceID, projectID).Scan(&exists)
+	if err != nil {
+		return &ServiceError{ErrMsg: "failed to validate source", Err: err}
+	}
+
+	if !exists {
+		return datastore.ErrSourceNotFound
+	}
+
+	return nil
+}
