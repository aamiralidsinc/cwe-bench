+// sourceBelongsToProject reports whether sourceID resolves inside projectID. An empty id
+// means "no source" and is accepted. An unknown or foreign id is refused as a client error,
+// so a source owned by another project is treated exactly like one that does not exist.
+func (h *Handler) sourceBelongsToProject(w http.ResponseWriter, r *http.Request, projectID, sourceID string) bool {
+	if util.IsStringEmpty(sourceID) {
+		return true
+	}
+
+	if _, err := sources.New(h.A.Logger, h.A.DB).FindSourceByID(r.Context(), projectID, sourceID); err != nil {
+		_ = render.Render(w, r, util.NewErrorResponse("source does not belong to project", http.StatusBadRequest))
+		return false
+	}
+
+	return true
+}
