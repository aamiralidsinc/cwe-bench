+"""Outbound address policy for gateway provider calls.
+
+A gateway endpoint calls a model provider at an address that is derived from its
+configuration.  Only publicly routable destinations are allowed by default; an
+operator can opt in to internal destinations with
+``MLFLOW_GATEWAY_ALLOW_PRIVATE_UPSTREAMS``.
+"""
+
+import ipaddress
+import os
+import re
+import socket
+from urllib.parse import urlsplit
+
+ALLOW_PRIVATE_UPSTREAMS_ENV_VAR = "MLFLOW_GATEWAY_ALLOW_PRIVATE_UPSTREAMS"
+
+_ALLOWED_SCHEMES = ("http", "https")
+_URL_FIELDS = ("api_base", "base_url")
+_HOST_TOKEN_FIELDS = ("aws_region_name", "vertex_location")
+_HOST_TOKEN_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9-]*$")
+_MAX_HOST_TOKEN_LENGTH = 63
+
+
+class UnsafeUpstreamError(ValueError):
+    """A configured or derived upstream address is not publicly routable."""
+
+
+def allow_private_upstreams() -> bool:
+    value = os.environ.get(ALLOW_PRIVATE_UPSTREAMS_ENV_VAR, "")
+    return value.strip().lower() in {"1", "true", "yes", "on"}
+
+
+def _ip_is_public(address: ipaddress._BaseAddress) -> bool:
+    if address.version == 6 and address.ipv4_mapped is not None:
+        address = address.ipv4_mapped
+    return address.is_global and not address.is_multicast
+
+
+def _host_is_public(host: str) -> bool:
+    """Whether ``host`` names only publicly routable addresses.
+
+    Unresolvable names are treated as public here: the address is not known to be
+    internal, and the connection itself reports the failure.
+    """
+    host = host.strip().strip("[]")
+    try:
+        return _ip_is_public(ipaddress.ip_address(host))
+    except ValueError:
+        pass
+    try:
+        infos = socket.getaddrinfo(host, None)
+    except (socket.gaierror, UnicodeError, OSError):
+        return True
+    if not infos:
+        return True
+    for info in infos:
+        addr = info[4][0]
+        try:
+            address = ipaddress.ip_address(str(addr).split("%", 1)[0])
+        except ValueError:
+            return False
+        if not _ip_is_public(address):
+            return False
+    return True
+
+
+def validate_upstream_url(value: str, *, field: str = "upstream address") -> None:
+    """Raise `UnsafeUpstreamError` unless ``value`` names a public http(s) host."""
+    if not isinstance(value, str) or not value.strip():
+        raise UnsafeUpstreamError(f"{field} must be a non-empty URL")
+    value = value.strip()
+    try:
+        parts = urlsplit(value)
+        host = parts.hostname
+        port = parts.port
+    except ValueError as e:
+        raise UnsafeUpstreamError(f"{field} is not a valid URL: {e}") from e
+    if parts.scheme.lower() not in _ALLOWED_SCHEMES:
+        raise UnsafeUpstreamError(f"{field} must use http or https")
+    if not host:
+        raise UnsafeUpstreamError(f"{field} must include a host")
+    if parts.username is not None or parts.password is not None:
+        raise UnsafeUpstreamError(f"{field} must not embed credentials")
+    if port is not None and not 0 < port < 65536:
+        raise UnsafeUpstreamError(f"{field} has an invalid port")
+    if allow_private_upstreams():
+        return
+    if not _host_is_public(host):
+        raise UnsafeUpstreamError(f"{field} must name a publicly routable host")
+
+
+def validate_host_token(value: str, *, field: str) -> None:
+    """Raise `UnsafeUpstreamError` unless ``value`` is a plain region/location name.
+
+    Region and location names are interpolated into provider host names, so a
+    value carrying URL syntax would change the destination host.
+    """
+    if (
+        not isinstance(value, str)
+        or len(value) > _MAX_HOST_TOKEN_LENGTH
+        or not _HOST_TOKEN_RE.match(value)
+    ):
+        raise UnsafeUpstreamError(f"{field} must be a valid region or location name")
+
+
+def validate_supplied_config(
+    auth_config: dict | None, secret_value: dict | None
+) -> None:
+    """Validate every supplied value that can determine the upstream address."""
+    for source in (auth_config or {}, secret_value or {}):
+        if not isinstance(source, dict):
+            continue
+        for field in _URL_FIELDS:
+            if field in source:
+                validate_upstream_url(source[field], field=field)
+        for field in _HOST_TOKEN_FIELDS:
+            if field in source:
+                validate_host_token(source[field], field=field)
+
+
+def validate_egress_url(url: str) -> None:
+    """Validate the final URL a provider request will be sent to."""
+    validate_upstream_url(url, field="upstream address")
