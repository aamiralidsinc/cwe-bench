+
+    /**
+     * Refuse an address a browser would resolve to a file on the local filesystem.
+     *
+     * A browser discards surrounding and embedded whitespace and control characters,
+     * accepts a backslash where a URL uses a slash, and lets a source-view prefix sit in
+     * front of another address. The address is reduced the same way before the scheme is
+     * read, so every spelling of a local-file address is caught at the point the caller
+     * hands it in. Addresses the library builds itself (a temporary document, a document
+     * read from a caller-given path) never pass through here.
+     */
+    protected function refuseLocalFileAddress(string $url): void
+    {
+        $address = (string) preg_replace('/[\x00-\x20\x7f]+/', '', $url);
+        $address = str_replace('\\', '/', $address);
+
+        $isSourceView = false;
+
+        while (stripos($address, 'view-source:') === 0) {
+            $isSourceView = true;
+            $address = (string) preg_replace(
+                '/[\x00-\x20\x7f]+/',
+                '',
+                substr($address, strlen('view-source:'))
+            );
+        }
+
+        if ($isSourceView) {
+            // Separators left over from turning backslashes into slashes are not part of
+            // the wrapped address's scheme; drop them before the scheme is read.
+            $address = ltrim($address, '/');
+        }
+
+        if (preg_match('/^([a-z][a-z0-9+.\-]*):/i', $address, $matches) === 1
+            && strtolower($matches[1]) === 'file') {
+            throw FileUrlNotAllowed::make();
+        }
+    }
