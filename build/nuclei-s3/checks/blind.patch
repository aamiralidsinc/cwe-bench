+// text comes from the template itself, so it may be rendered; the values it
+// resolves to are written as-is.
+func resolveName(name string, values map[string]string) string {
+	if !strings.Contains(name, marker.ParenthesisOpen) && !strings.Contains(name, marker.General) {
+		return name
+	}
+	var builder strings.Builder
+	builder.Grow(len(name))
+	replaceInto(&builder, name, values)
+	return builder.String()
+}
+
+// matchingBraceEnd returns the offset at which the close marker matching the
+// open marker at start begins.
+func matchingBraceEnd(template string, start int) (int, bool) {
+	depth := 0
+	for index := start; index < len(template); {
+		switch {
+		case strings.HasPrefix(template[index:], marker.ParenthesisOpen):
+			depth++
+			index += len(marker.ParenthesisOpen)
+		case strings.HasPrefix(template[index:], marker.ParenthesisClose):
+			depth--
+			index += len(marker.ParenthesisClose)
+			if depth == 0 {
+				return index - len(marker.ParenthesisClose), true
+			}
+		default:
+			index++
+		}
+	}
+	return 0, false
 }
