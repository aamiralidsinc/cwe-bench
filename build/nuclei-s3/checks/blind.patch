+// templateOwnedKeys returns the keys whose final value comes from template
+// text. A data map that also defines a key wins the merge, so such keys are
+// dropped: their values are data and must not be rendered again.
+func templateOwnedKeys(templateLayers, dataLayers []map[string]interface{}) map[string]struct{} {
+	owned := make(map[string]struct{})
+	for _, layer := range templateLayers {
+		for key := range layer {
