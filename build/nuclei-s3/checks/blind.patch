diff -ruN a/pkg/protocols/common/expressions/literals.go b/pkg/protocols/common/expressions/literals.go
--- a/pkg/protocols/common/expressions/literals.go
+++ b/pkg/protocols/common/expressions/literals.go
@@ -0,0 +1,147 @@
+package expressions
+
+import (
+	"fmt"
+	"strings"
+
+	"github.com/projectdiscovery/nuclei/v3/pkg/protocols/common/marker"
+	"github.com/projectdiscovery/nuclei/v3/pkg/types"
+)
+
+// literalForms lists the placeholder forms that may appear inside an
+// expression. Parenthesis markers come first, matching the rest of the engine.
+var literalForms = [2][2]string{
+	{marker.ParenthesisOpen, marker.ParenthesisClose},
+	{marker.General, marker.General},
+}
+
+// ResolveLiteralPlaceholders resolves the placeholders that appear inside the
+// string literals of a compiled DSL expression. Each resolved value is escaped
+// for the surrounding literal, so it can never terminate the literal or add
+// expression syntax.
+//
+// A placeholder outside a string literal has no safe textual replacement: the
+// value would become expression source. Such an expression is refused with an
+// error instead.
+func ResolveLiteralPlaceholders(expression string, data map[string]interface{}) (string, error) {
+	if len(data) == 0 || !containsMarker(expression) {
+		return expression, nil
+	}
+	return rewriteLiteralPlaceholders(expression, data, true)
+}
+
+// resolveLiteralPlaceholders is the permissive variant used while rendering
+// template text: placeholders outside a literal are left untouched for the DSL
+// compiler to reject.
+func resolveLiteralPlaceholders(expression string, data map[string]interface{}) string {
+	if len(data) == 0 || !containsMarker(expression) {
+		return expression
+	}
+	resolved, err := rewriteLiteralPlaceholders(expression, data, false)
+	if err != nil {
+		return expression
+	}
+	return resolved
+}
+
+func containsMarker(text string) bool {
+	return strings.Contains(text, marker.ParenthesisOpen) || strings.Contains(text, marker.General)
+}
+
+// rewriteLiteralPlaceholders walks the expression and replaces placeholders
+// only while inside a single- or double-quoted literal. rejectOutside controls
+// whether a resolvable placeholder outside a literal is an error or is left
+// for the compiler.
+func rewriteLiteralPlaceholders(expression string, data map[string]interface{}, rejectOutside bool) (string, error) {
+	var builder strings.Builder
+	builder.Grow(len(expression))
+
+	var quote byte
+	for index := 0; index < len(expression); {
+		char := expression[index]
+
+		if quote == 0 {
+			if char == '\'' || char == '"' {
+				quote = char
+				builder.WriteByte(char)
+				index++
+				continue
+			}
+			if _, next, ok := placeholderAt(expression, index, data); ok {
+				if rejectOutside {
+					return "", fmt.Errorf("unresolved placeholder %q is outside a string literal", expression[index:next])
+				}
+				builder.WriteString(expression[index:next])
+				index = next
+				continue
+			}
+			builder.WriteByte(char)
+			index++
+			continue
+		}
+
+		if char == '\\' && index+1 < len(expression) {
+			// Keep the escaped pair as authored; the DSL lexer unescapes it.
+			builder.WriteString(expression[index : index+2])
+			index += 2
+			continue
+		}
+		if char == quote {
+			quote = 0
+			builder.WriteByte(char)
+			index++
+			continue
+		}
+		if value, next, ok := placeholderAt(expression, index, data); ok {
+			builder.WriteString(escapeForLiteral(value, quote))
+			index = next
+			continue
+		}
+		builder.WriteByte(char)
+		index++
+	}
+
+	return builder.String(), nil
+}
+
+// placeholderAt returns the value and end offset of a placeholder beginning at
+// index, when the placeholder names a known value.
+func placeholderAt(text string, index int, data map[string]interface{}) (string, int, bool) {
+	for _, form := range literalForms {
+		open, close := form[0], form[1]
+		if !strings.HasPrefix(text[index:], open) {
+			continue
+		}
+		nameStart := index + len(open)
+		offset := strings.Index(text[nameStart:], close)
+		if offset < 0 {
+			continue
+		}
+		name := text[nameStart : nameStart+offset]
+		value, ok := data[name]
+		if !ok {
+			continue
+		}
+		return types.ToString(value), nameStart + offset + len(close), true
+	}
+	return "", 0, false
+}
+
+// escapeForLiteral escapes a value for insertion into a DSL string literal
+// delimited by quote. govaluate treats a backslash as escaping the next byte,
+// so backslashes and the delimiter itself are the only bytes that need one.
+func escapeForLiteral(value string, quote byte) string {
+	if !strings.ContainsAny(value, "\\"+string(quote)) {
+		return value
+	}
+	var builder strings.Builder
+	builder.Grow(len(value) + 2)
+	for i := 0; i < len(value); i++ {
+		char := value[i]
+		if char == '\\' || char == quote {
+			builder.WriteByte('\\')
+		}
+		builder.WriteByte(char)
+	}
+	return builder.String()
+}
