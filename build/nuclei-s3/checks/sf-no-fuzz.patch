diff -ruN -x .git inj/pkg/protocols/common/expressions/string_markers.go variants/sf-no-fuzz/pkg/protocols/common/expressions/string_markers.go
--- inj/pkg/protocols/common/expressions/string_markers.go	1970-01-01 00:00:00.000000000 +0000
+++ variants/sf-no-fuzz/pkg/protocols/common/expressions/string_markers.go	2026-10-25 23:13:44.820378536 +0000
@@ -0,0 +1,178 @@
+package expressions
+
+import (
+	"fmt"
+	"regexp"
+	"sort"
+	"strings"
+
+	"github.com/projectdiscovery/nuclei/v3/pkg/protocols/common/marker"
+)
+
+var dslStringMarkerRegex = regexp.MustCompile(`\{\{([^{}]+)\}\}`)
+
+// dslStringMarker represents a span of an unresolved DSL expression within a
+// string literal.
+type dslStringMarker struct {
+	start int
+	end   int
+	expr  string
+	quote byte
+}
+
+type textSpan struct {
+	start int
+	end   int
+}
+
+type stringLiteralSpan struct {
+	start int
+	end   int
+	quote byte
+}
+
+// ResolveStringMarkers resolves placeholders that already appear inside string
+// literals of a compiled DSL expression. Resolved values are escaped for the
+// surrounding literal, so a value can never change the expression's structure.
+// Placeholders outside a string literal are rejected.
+func ResolveStringMarkers(expression string, data map[string]interface{}) (string, error) {
+	stringSpans := findStringLiteralSpans(expression)
+	markers, err := findDSLStringMarkers(expression, data, stringSpans)
+	if err != nil {
+		return "", err
+	}
+
+	if len(markers) == 0 {
+		return expression, nil
+	}
+
+	sort.Slice(markers, func(i, j int) bool {
+		return markers[i].start > markers[j].start
+	})
+
+	resolved := expression
+	for _, item := range markers {
+		result, err := Evaluate(marker.ParenthesisOpen+item.expr+marker.ParenthesisClose, data)
+		if err != nil {
+			return "", err
+		}
+
+		replacement := EscapeStringValue(result, item.quote)
+		resolved = resolved[:item.start] + replacement + resolved[item.end:]
+	}
+
+	return resolved, nil
+}
+
+func findDSLStringMarkers(expression string, data map[string]interface{}, stringSpans []stringLiteralSpan) ([]dslStringMarker, error) {
+	var markers []dslStringMarker
+	var occupiedSpans []textSpan
+
+	seenComplex := make(map[string]struct{})
+
+	for _, expr := range FindExpressions(expression, marker.ParenthesisOpen, marker.ParenthesisClose, data) {
+		if _, ok := seenComplex[expr]; ok {
+			continue
+		}
+		seenComplex[expr] = struct{}{}
+
+		markerText := marker.ParenthesisOpen + expr + marker.ParenthesisClose
+		for start := 0; ; {
+			index := strings.Index(expression[start:], markerText)
+			if index < 0 {
+				break
+			}
+
+			index += start
+			end := index + len(markerText)
+
+			stringSpan, ok := stringLiteralForSpan(stringSpans, index, end)
+			if !ok {
+				return nil, fmt.Errorf("unresolved DSL placeholder %q is not inside a string literal", expr)
+			}
+
+			markers = append(markers, dslStringMarker{start: index, end: end, expr: expr, quote: stringSpan.quote})
+			occupiedSpans = append(occupiedSpans, textSpan{start: index, end: end})
+			start = end
+		}
+	}
+
+	for _, match := range dslStringMarkerRegex.FindAllStringSubmatchIndex(expression, -1) {
+		if len(match) < 4 || markerWithinSpans(match[0], match[1], occupiedSpans) {
+			continue
+		}
+
+		stringSpan, ok := stringLiteralForSpan(stringSpans, match[0], match[1])
+		if !ok {
+			return nil, fmt.Errorf("unresolved DSL placeholder %q is not inside a string literal", expression[match[2]:match[3]])
+		}
+
+		markers = append(markers, dslStringMarker{
+			start: match[0],
+			end:   match[1],
+			expr:  expression[match[2]:match[3]],
+			quote: stringSpan.quote,
+		})
+	}
+
+	return markers, nil
+}
+
+func markerWithinSpans(start, end int, spans []textSpan) bool {
+	for _, span := range spans {
+		if start >= span.start && end <= span.end {
+			return true
+		}
+	}
+
+	return false
+}
+
+func findStringLiteralSpans(expression string) []stringLiteralSpan {
+	var spans []stringLiteralSpan
+	var quote byte
+	start := 0
+	escaped := false
+
+	for i := 0; i < len(expression); i++ {
+		char := expression[i]
+		if escaped {
+			escaped = false
+			continue
+		}
+
+		if char == '\\' {
+			escaped = true
+			continue
+		}
+
+		if quote != 0 {
+			if char == quote {
+				spans = append(spans, stringLiteralSpan{start: start, end: i, quote: quote})
+				quote = 0
+			}
+			continue
+		}
+
+		if char == '\'' || char == '"' {
+			quote = char
+			start = i + 1
+		}
+	}
+
+	if quote != 0 {
+		spans = append(spans, stringLiteralSpan{start: start, end: len(expression), quote: quote})
+	}
+
+	return spans
+}
+
+func stringLiteralForSpan(spans []stringLiteralSpan, start, end int) (stringLiteralSpan, bool) {
+	for _, span := range spans {
+		if start >= span.start && end <= span.end {
+			return span, true
+		}
+	}
+
+	return stringLiteralSpan{}, false
+}
