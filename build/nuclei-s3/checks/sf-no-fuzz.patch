+// Replace replaces placeholders in template with values on the fly. Both marker
+// forms are resolved in one pass over the template text: a value inserted for
+// one placeholder is terminal and is never scanned for another placeholder.
+// Placeholders nested inside another placeholder's name are part of the
+// template text and are resolved before the name is looked up.
 func Replace(template string, values map[string]interface{}) string {
+	if len(values) == 0 || template == "" {
+		return template
+	}
 	valuesMap := make(map[string]interface{}, len(values))
 	for k, v := range values {
 		valuesMap[k] = types.ToString(v)
 	}
-	replaced := fasttemplate.ExecuteStringStd(template, marker.ParenthesisOpen, marker.ParenthesisClose, valuesMap)
-	final := fasttemplate.ExecuteStringStd(replaced, marker.General, marker.General, valuesMap)
-	return final
+
+	var builder strings.Builder
+	builder.Grow(len(template))
+	writeReplaced(&builder, template, valuesMap)
+	return builder.String()
+}
+
+func writeReplaced(builder *strings.Builder, template string, values map[string]interface{}) {
+	for index := 0; index < len(template); {
+		brace := strings.Index(template[index:], marker.ParenthesisOpen)
+		general := strings.Index(template[index:], marker.General)
+		if brace < 0 && general < 0 {
+			builder.WriteString(template[index:])
+			return
+		}
+
+		if general >= 0 && (brace < 0 || general < brace) {
+			start := index + general
+			builder.WriteString(template[index:start])
+			valueEnd := strings.Index(template[start+len(marker.General):], marker.General)
+			if valueEnd < 0 {
+				builder.WriteString(template[start:])
+				return
+			}
+			valueEnd += start + len(marker.General)
+			content := template[start+len(marker.General) : valueEnd]
+			var resolvedContent strings.Builder
+			writeReplaced(&resolvedContent, content, values)
+			key := resolvedContent.String()
+			if value, ok := values[key]; ok {
+				builder.WriteString(types.ToString(value))
+			} else {
+				builder.WriteString(marker.General)
+				builder.WriteString(key)
+				builder.WriteString(marker.General)
+			}
+			index = valueEnd + len(marker.General)
+			continue
+		}
+
+		start := index + brace
+		builder.WriteString(template[index:start])
+		valueEnd, ok := braceValueEnd(template, start)
+		if !ok {
+			builder.WriteString(template[start:])
+			return
+		}
+		content := template[start+len(marker.ParenthesisOpen) : valueEnd]
+		var resolvedContent strings.Builder
+		writeReplaced(&resolvedContent, content, values)
+		key := resolvedContent.String()
+		if value, ok := values[key]; ok {
+			builder.WriteString(types.ToString(value))
+		} else {
+			builder.WriteString(marker.ParenthesisOpen)
+			builder.WriteString(key)
+			builder.WriteString(marker.ParenthesisClose)
+		}
+		index = valueEnd + len(marker.ParenthesisClose)
+	}
+}
+
+// braceValueEnd returns the index at which the close marker matching the open
+// marker at start begins.
+func braceValueEnd(template string, start int) (int, bool) {
+	depth := 0
+	for index := start; index < len(template); {
+		if strings.HasPrefix(template[index:], marker.ParenthesisOpen) {
+			depth++
+			index += len(marker.ParenthesisOpen)
+			continue
+		}
+		if strings.HasPrefix(template[index:], marker.ParenthesisClose) {
+			depth--
+			index += len(marker.ParenthesisClose)
+			if depth == 0 {
+				return index - len(marker.ParenthesisClose), true
+			}
+			continue
+		}
+		index++
+	}
+	return 0, false
 }
 
