+class _UnsafeExtensionError(Exception):
+    """
+    Mitigation exception for uncommon/malicious file extensions.
+
+    This is caught in YoutubeDL.py alongside a warning; the compat option
+    ``allow-unsafe-ext`` disables the check for CLI users.
+    """
+    ALLOWED_EXTENSIONS = frozenset([
+        # internal
+        'description',
+        'json',
+        'meta',
+        'orig',
+        'part',
+        'temp',
+        'uncut',
+        'unknown_video',
+        'ytdl',
+
+        # video
+        *MEDIA_EXTENSIONS.video,
+        'avif',
+        'ismv',
+        'm2ts',
+        'm4s',
+        'mng',
+        'mpeg',
+        'qt',
+        'swf',
+        'ts',
+        'vp9',
+        'wvm',
+
+        # audio
+        *MEDIA_EXTENSIONS.audio,
+        'isma',
+        'mid',
+        'mpga',
+        'ra',
+
+        # image
+        *MEDIA_EXTENSIONS.thumbnails,
+        'bmp',
+        'gif',
+        'heic',
+        'ico',
+        'jng',
+        'jpeg',
+        'jxl',
+        'svg',
+        'tif',
+        'wbmp',
+
+        # subtitle
+        *MEDIA_EXTENSIONS.subtitles,
+        'dfxp',
+        'fs',
+        'ismt',
+        'sami',
+        'scc',
+        'ssa',
+        'tt',
+        'ttml',
+
+        # others
+        *MEDIA_EXTENSIONS.manifests,
+        *MEDIA_EXTENSIONS.storyboards,
+        'ism',
+        'm3u',
+        'sbv',
+        'xml',
+    ])
+
+    # Types that must never be the result of a download, even when the user's output
+    # template leaves the whole name to metadata
+    UNSAFE_EXTENSIONS = frozenset([
+        'apk', 'app', 'bat', 'cmd', 'com', 'cpl', 'desktop', 'dll', 'dylib', 'exe',
+        'hta', 'inf', 'jar', 'js', 'jse', 'lnk', 'msi', 'msp', 'pif', 'ps1', 'psm1',
+        'py', 'reg', 'scr', 'scf', 'sh', 'so', 'url', 'vbe', 'vbs', 'webloc', 'wsf',
+        'wsh',
+    ])
+
+    def __init__(self, extension, /):
+        super().__init__(f'unsafe file extension: {extension!r}')
+        self.extension = extension
+
+    @classmethod
+    def allowed_extensions(cls, _allowed_exts=()):
+        return _allowed_exts or cls.ALLOWED_EXTENSIONS
+
+    @classmethod
+    def sanitize_extension(cls, extension, /, *, prepend=False, _allowed_exts=()):
+        if extension is None:
+            return None
+
+        if '/' in extension or '\\' in extension:
+            raise cls(extension)
+
+        if not prepend:
+            _, _, last = extension.rpartition('.')
+            if last == 'bin':
+                extension = last = 'unknown_video'
+            if last.lower() not in cls.allowed_extensions(_allowed_exts):
+                raise cls(extension)
+
+        return extension
+
+    @classmethod
+    def is_allowed_extension(cls, extension, /, *, _allowed_exts=()):
+        if not extension:
+            return True
+        if '/' in extension or '\\' in extension:
+            return False
+        return extension.lower() in cls.allowed_extensions(_allowed_exts)
+
+
