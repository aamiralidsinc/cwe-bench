+# The only file types a download may take when the remote site proposes the extension. This
+# covers media, subtitles, thumbnails, manifests/storyboards and yt-dlp's own working files;
+# anything else (in particular anything executable) is refused before the file is opened.
+_SAFE_DOWNLOAD_EXTENSIONS = frozenset({
+    # yt-dlp's own working files and placeholders
+    'description', 'json', 'meta', 'orig', 'part', 'temp', 'uncut', 'unknown_video', 'ytdl',
+
+    # video
+    *MEDIA_EXTENSIONS.video,
+    'avif', 'ismv', 'm2ts', 'm4s', 'mng', 'mpeg', 'qt', 'swf', 'ts', 'vp9', 'wvm',
+
+    # audio
+    *MEDIA_EXTENSIONS.audio,
+    'isma', 'mid', 'mpga', 'ra',
+
+    # images
+    *MEDIA_EXTENSIONS.thumbnails,
+    'bmp', 'gif', 'heic', 'ico', 'jng', 'jpeg', 'jxl', 'svg', 'tif', 'wbmp',
+
+    # subtitles
+    *MEDIA_EXTENSIONS.subtitles,
+    'dfxp', 'fs', 'ismt', 'sami', 'scc', 'ssa', 'tt', 'ttml',
+
+    # manifests, storyboards and structured sidecars
+    *MEDIA_EXTENSIONS.manifests,
+    *MEDIA_EXTENSIONS.storyboards,
+    'ism', 'm3u', 'sbv', 'xml',
+})
+
+# Types that must never be the result of a download. This applies even when the whole name is
+# produced by remote metadata, where there is no template field boundary to judge an extension
+# against an allow-list.
+_DANGEROUS_EXTENSIONS = frozenset({
+    'apk', 'app', 'bat', 'cmd', 'com', 'cpl', 'desktop', 'dll', 'dylib', 'exe', 'hta', 'inf',
+    'ini', 'jar', 'js', 'jse', 'lnk', 'msi', 'msp', 'pif', 'plist', 'ps1', 'psm1', 'py', 'reg',
+    'scf', 'scr', 'service', 'sh', 'so', 'url', 'vbe', 'vbs', 'webloc', 'wsf', 'wsh',
+})
+
+
+class _UnsafeExtensionError(Exception):
+    """A remote-supplied extension would make yt-dlp create an unsafe file type."""
+
+    def __init__(self, extension):
+        super().__init__(f'unsafe file extension: {extension!r}')
+        self.extension = extension
+
