+# One output-template field, e.g. %(title)s, %(id)03d or %(title&replacement)s
+_OUTTMPL_FIELD_RE = re.compile(r'%\([^)]*\)(?:[#0\-+ ]*\d*(?:\.\d+)?[hlL]?[a-zA-Z])')
+
+
+def _extension_origin(outtmpl):
+    """Classify where the final path component's extension in an output template comes from.
+
+    ``'literal'``  - the dot and the extension are template text (``clip.txt``)
+    ``'field'``    - the extension is (at least partly) the value of a template field
+    ``'whole'``    - the last component is entirely field output
+    """
+    tail = outtmpl.rsplit('/', 1)[-1]
+    # '%%' is an escaped percent sign, not the opening of a field
+    masked = _OUTTMPL_FIELD_RE.sub('\x00', tail.replace('%%', '\x01'))
+    last_field, last_dot = masked.rfind('\x00'), masked.rfind('.')
+    if last_field < 0 or last_dot > last_field:
+        return 'literal'
+    return 'field' if last_dot >= 0 else 'whole'
+
