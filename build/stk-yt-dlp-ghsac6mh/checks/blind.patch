+def _checked_extension(ext, allowed=()):
+    """Validate an extension that will end up as a file type on disk.
+
+    The extension is refused unless its last dot-separated part is a known-safe type. A
+    shorter extension such as ``en.vtt`` is therefore judged by ``vtt``.
+    """
+    if ext is None:
+        return None
+
+    if not isinstance(ext, str):
+        ext = str(ext)
+    if '/' in ext or '\\' in ext:
+        raise _UnsafeExtensionError(ext)
+
+    head, _, leaf = ext.rpartition('.')
+    if leaf == 'bin':
+        # A generic container; the real type is unknown but certainly not an executable
+        return 'unknown_video'
+    if leaf.lower() not in _SAFE_DOWNLOAD_EXTENSIONS.union(allowed):
+        raise _UnsafeExtensionError(ext)
+    return ext
+
+
+def _checked_infix(ext):
+    """Validate a string that is only inserted into a name, not used as the file type."""
+    if ext is None:
+        return None
+    if not isinstance(ext, str):
+        ext = str(ext)
+    if '/' in ext or '\\' in ext:
+        raise _UnsafeExtensionError(ext)
+    return ext
