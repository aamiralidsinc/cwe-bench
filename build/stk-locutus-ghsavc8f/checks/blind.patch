+// Helpers for treating caller- or payload-supplied names as plain data.
+//
+// The built-ins are captured once, at load time, so the result does not depend on
+// whatever String/RegExp/Object methods the surrounding process may later replace.
+const _hasOwnProperty = Object.prototype.hasOwnProperty
+const _defineProperty = Object.defineProperty
+
+// True only when the property is stored on the object itself, never when it is
+// reached through the prototype chain.
+function hasOwnKey(obj, key) {
+  return _hasOwnProperty.call(obj, key)
+}
+
+// Store a supplied name as an ordinary own data property. An assignment would let a
+// name such as '__proto__' run an inherited setter and turn the value into a
+// prototype link; defining the property keeps the name as data and writes only to
+// the object the caller handed in. Ordinary names get the same descriptors an
+// assignment would produce.
+function setOwnKey(obj, key, value) {
+  _defineProperty(obj, key, {
+    value,
+    writable: true,
+    enumerable: true,
+    configurable: true,
+  })
+}
+
+module.exports = { hasOwnKey, setOwnKey }
