diff -ruN a/src/Utils/Text.php b/src/Utils/Text.php
--- a/src/Utils/Text.php
+++ b/src/Utils/Text.php
@@ -0,0 +1,54 @@
+<?php
+
+namespace Tiptap\Utils;
+
+/**
+ * Documents arrive from clients as plain data, so every value in them can have
+ * any type. Only scalars have a textual form; everything else (a list, a map)
+ * is treated as absent by the renderers instead of being handed to a string
+ * function. This helper is the single place that decides what a value's text
+ * is, so the HTML renderer, the attribute renderer and the plain-text renderer
+ * all behave the same way.
+ */
+class Text
+{
+    /**
+     * Whether a value can be represented as text at all.
+     */
+    public static function isRenderable($value): bool
+    {
+        return is_scalar($value);
+    }
+
+    /**
+     * The escaped text for a value, or NULL when the value has no textual form.
+     */
+    public static function escaped($value): ?string
+    {
+        $plain = self::plain($value);
+
+        return $plain === null ? null : htmlspecialchars($plain, ENT_QUOTES, 'UTF-8');
+    }
+
+    /**
+     * The unescaped text for a value, or NULL when the value has no textual form.
+     */
+    public static function plain($value): ?string
+    {
+        return self::isRenderable($value) ? (string) $value : null;
+    }
+
+    /**
+     * The renderable entries of a list value, in their original order.
+     *
+     * @return array<int, mixed>
+     */
+    public static function entries($value): array
+    {
+        if (! is_array($value)) {
+            return [];
+        }
+
+        return array_values(array_filter($value, fn ($entry) => self::isRenderable($entry)));
+    }
+}
