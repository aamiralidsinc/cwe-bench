 // GenerateActivateCode generates an activate code based on user information and
 // the given email.
 func GenerateActivateCode(userID int64, email, name, password, rands string) string {
-	code := tool.CreateTimeLimitCode(
-		fmt.Sprintf("%d%s%s%s%s", userID, email, strings.ToLower(name), password, rands),
-		conf.Auth.ActivateCodeLives,
-		nil,
-	)
+	return generateTimeLimitedUserCode(userCodeData(userID, email, name, password, rands), name, conf.Auth.ActivateCodeLives, "")
+}
+
+// GenerateResetPasswordCode generates a password-reset code based on user
+// information and the given email. The token's lifetime is bound to
+// [conf.AuthOpts.ResetPasswordCodeLives] and its purpose is recorded in the
+// token tail, so it cannot be used as an account-activation code.
+func GenerateResetPasswordCode(userID int64, email, name, password, rands string) string {
+	return generateTimeLimitedUserCode(userCodeData(userID, email, name, password, rands), name, conf.Auth.ResetPasswordCodeLives, "reset")
+}
+
+func userCodeData(userID int64, email, name, password, rands string) string {
+	return fmt.Sprintf("%d%s%s%s%s", userID, email, strings.ToLower(name), password, rands)
+}
+
+func generateTimeLimitedUserCode(data, name string, minutes int, purpose string) string {
+	code := tool.CreateTimeLimitCode(data, minutes, nil)
 
 	// Add tailing hex username
 	code += hex.EncodeToString([]byte(strings.ToLower(name)))
+	if purpose != "" {
+		code += hex.EncodeToString([]byte{0}) + hex.EncodeToString([]byte(purpose))
+	}
 	return code
 }
 
