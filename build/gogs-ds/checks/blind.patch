diff --git a/internal/userx/delete_account.go b/internal/userx/delete_account.go
new file mode 100644
index 0000000..46b731a
--- /dev/null
+++ b/internal/userx/delete_account.go
@@ -0,0 +1,24 @@
+package userx
+
+import (
+	"encoding/hex"
+	"strings"
+
+	"gogs.io/gogs/internal/conf"
+	"gogs.io/gogs/internal/tool"
+)
+
+// DeleteAccountCodeData returns the data signed into an account deletion code.
+// Its distinct realm keeps a code issued for account activation, or for any
+// other account action, from deleting the account.
+func DeleteAccountCodeData(userID int64, email, name, password, rands string) string {
+	return "delete-account:" + userCodeData(userID, email, name, password, rands)
+}
+
+// GenerateDeleteAccountCode generates an account deletion code based on user
+// information and the given email.
+func GenerateDeleteAccountCode(userID int64, email, name, password, rands string) string {
+	code := tool.CreateTimeLimitCode(DeleteAccountCodeData(userID, email, name, password, rands), conf.Auth.ActivateCodeLives, nil)
+	code += hex.EncodeToString([]byte(strings.ToLower(name)))
+	return code
+}
