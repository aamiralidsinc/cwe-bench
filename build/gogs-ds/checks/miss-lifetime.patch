+// GenerateEmailResetPasswordCode mints the password-reset code for the API
+// mail adapter. It is a distinct method from the account activation code so a
+// reset mail can never carry a code issued for another account action.
+func (u resetMailUser) GenerateEmailResetPasswordCode(email string) string {
+	return userx.GenerateResetPasswordCode(u.user.ID, email, u.user.Name, u.user.Password, u.user.Rands)
+}
