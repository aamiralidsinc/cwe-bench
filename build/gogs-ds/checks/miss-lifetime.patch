+// verifyResetPasswordCode returns the user a password-reset code belongs to. A
+// password-reset code is signed over the reset realm, so a code issued for
+// account activation does not verify here.
+func verifyResetPasswordCode(ctx stdctx.Context, code string) (user *database.User) {
+	if user = parseUserFromCode(ctx, code); user != nil {
+		prefix := code[:tool.TimeLimitCodeLength]
+		data := userx.ResetPasswordCodeData(user.ID, user.Email, user.LowerName, user.Password, user.Rands)
+		if tool.VerifyTimeLimitCode(data, conf.Auth.ResetPasswordCodeLives, prefix) {
+			return user
+		}
+	}
+	return nil
+}
