diff -ruN cur/packages/server/src/enterprise/utils/credentialScope.ts variants/alt_fix/packages/server/src/enterprise/utils/credentialScope.ts
--- a/packages/server/src/enterprise/utils/credentialScope.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/packages/server/src/enterprise/utils/credentialScope.ts	2026-10-18 19:16:11.918031995 +0000
@@ -0,0 +1,36 @@
+import { Request } from 'express'
+import { StatusCodes } from 'http-status-codes'
+import { Credential } from '../../database/entities/Credential'
+import { WorkspaceShared } from '../database/entities/EnterpriseEntities'
+import { InternalFlowiseError } from '../../errors/internalFlowiseError'
+import { getRunningExpressApp } from '../../utils/getRunningExpressApp'
+
+export function getActiveWorkspaceIdForRequest(req: Request): string {
+    const user = req.user as { activeWorkspaceId?: string; activeOrganizationId?: string } | undefined
+    if (!user?.activeWorkspaceId || !user?.activeOrganizationId) {
+        throw new InternalFlowiseError(StatusCodes.UNAUTHORIZED, 'Unauthorized')
+    }
+    return user.activeWorkspaceId
+}
+
+export async function resolveCredentialForWorkspace(credentialId: string, workspaceId: string): Promise<Credential> {
+    if (!workspaceId) {
+        throw new InternalFlowiseError(StatusCodes.BAD_REQUEST, 'Workspace ID is required')
+    }
+    const appServer = getRunningExpressApp()
+    const credentialRepository = appServer.AppDataSource.getRepository(Credential)
+    const owned = await credentialRepository.find({ where: [{ id: credentialId, workspaceId: workspaceId }] })
+    if (owned.length > 0) {
+        return owned[0]
+    }
+    const shares = await appServer.AppDataSource.getRepository(WorkspaceShared).find({
+        where: { workspaceId: workspaceId, itemType: 'credential' }
+    })
+    if (shares.some((share) => share.sharedItemId === credentialId)) {
+        const matches = await credentialRepository.find({ where: { id: credentialId } })
+        if (matches.length > 0) {
+            return matches[0]
+        }
+    }
+    throw new InternalFlowiseError(StatusCodes.NOT_FOUND, 'Credential not found')
+}
