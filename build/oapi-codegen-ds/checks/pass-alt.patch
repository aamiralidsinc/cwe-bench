+// stripNewLines removes newlines so untrusted specification text stays inside a
+// single generated `//` line comment instead of breaking out into real Go source.
+// sanitizeCommentText keeps specification text on a single comment line by
+// joining its lines with spaces.
+func sanitizeCommentText(s string) string {
+	lines := strings.FieldsFunc(s, func(r rune) bool { return r == '\n' || r == '\r' })
+	return strings.Join(lines, " ")
