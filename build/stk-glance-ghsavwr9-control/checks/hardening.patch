--- a/glance/db/sqlalchemy/api.py
+++ b/glance/db/sqlalchemy/api.py
@@ -211,6 +211,12 @@ def image_destroy(context, image_id):
     with session.begin():
         image_ref = image_get(context, image_id, session=session)
 
+        # A protected image may not be destroyed until it has been
+        # explicitly unprotected through the update path.
+        if image_ref.protected:
+            msg = _("Image %s is protected") % image_id
+            raise exception.Forbidden(msg)
+
         # Perform authorization check
         check_mutate_authorization(context, image_ref)
 
