+/**
+ * Escape a string for embedding inside a backtick-delimited JS template
+ * literal: backslashes, backticks and `${` sequences. The result round-trips
+ * to the original text when the surrounding template literal is evaluated.
+ *
+ * @param input String to escape
+ */
+export function jsTemplateLiteralEscape(input: string) {
+  return input.replaceAll(/\\|`|\$\{/g, (sequence) => {
+    switch (sequence) {
+      case '\\': {
+        return '\\\\';
+      }
+      case '`': {
+        return '\\`';
+      }
+      default: {
+        return '\\${';
+      }
+    }
+  });
+}
