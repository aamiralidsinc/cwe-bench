+ * expressions. Escape sequences in static text (e.g. `\``, `\${`, `\\`) are
+ * decoded, so `static` parts hold the exact runtime string value and an
+ * escaped `\${` is never mistaken for an interpolation.
+ */
+export function splitRouteTemplate(route: string): RouteTemplatePart[] {
+  const parts: RouteTemplatePart[] = [];
+  let current = '';
+  let raw = '';
+  const pushStatic = () => {
+    if (raw) {
+      parts.push({ type: 'static', value: current, raw });
+      current = '';
+      raw = '';
+    }
+  };
