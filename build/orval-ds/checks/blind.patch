+ * cannot break out of the key position: plain identifiers are kept as-is,
+ * everything else is emitted as an escaped single-quoted string. `__proto__`
+ * is emitted as a computed key so it creates a data property.
+ */
+export function toSafeObjectKey(key: string) {
+  if (key === '__proto__') {
+    return `['${jsStringLiteralEscape(key)}']`;
+  }
+  return keyword.isIdentifierNameES5(key)
+    ? key
