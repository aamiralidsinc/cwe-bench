+// resolve maps a caller-supplied relative playlist path onto the location the
+// store will operate on. It returns the absolute path and the same path in its
+// cleaned, store-relative form. Every operation takes both its filesystem
+// target and the playlist's stored metadata (user id, name) from this one
+// value, so "." and ".." segments can neither leave the store nor disguise the
+// user a playlist is filed under. Paths that stay outside the store, and the
+// store directory itself, are refused.
+func (s *Store) resolve(relPath string) (absPath, cleanRel string, err error) {
+	baseAbs, err := filepath.Abs(s.basePath)
+	if err != nil {
+		return "", "", fmt.Errorf("resolve playlist base: %w", err)
+	}
+	absPath, err = filepath.Abs(filepath.Join(baseAbs, relPath))
+	if err != nil {
+		return "", "", fmt.Errorf("resolve playlist path: %w", err)
+	}
+	cleanRel, err = filepath.Rel(baseAbs, absPath)
+	if err != nil {
+		return "", "", fmt.Errorf("resolve playlist path: %w", err)
+	}
+	if cleanRel == "." {
+		return "", "", fmt.Errorf("%w: empty path", ErrInvalidPathFormat)
+	}
+	if cleanRel == ".." || strings.HasPrefix(cleanRel, ".."+string(filepath.Separator)) {
+		return "", "", fmt.Errorf("%w: %q", ErrOutsideStore, relPath)
+	}
+	return absPath, cleanRel, nil
+}
+
+// AbsPath returns the absolute location relPath names inside the store, or an
+// error when it would leave the store. Callers outside the store that need to
+// look at a playlist's neighbourhood (its cover image, say) should use this
+// rather than joining BasePath themselves.
+func (s *Store) AbsPath(relPath string) (string, error) {
+	absPath, _, err := s.resolve(relPath)
+	if err != nil {
+		return "", err
+	}
+	return absPath, nil
+}
+
+// PathOwner reports the user id that the storage layout assigns to relPath,
+// using the same cleaning the store's own operations use. It errors when
+// relPath leaves the store.
+func (s *Store) PathOwner(relPath string) (int, error) {
+	_, cleanRel, err := s.resolve(relPath)
+	if err != nil {
+		return 0, err
+	}
+	return userIDFromPath(cleanRel)
+}
