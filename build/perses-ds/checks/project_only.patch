+
+// headerSecretReference matches a header value that references a stored secret by name.
+var headerSecretReference = regexp.MustCompile(`\{\{secret:([A-Za-z0-9._-]+)\}\}`)
+
+// ReferencedSecrets returns the name of every stored secret referenced by the given plugin spec.
+// A reference is either the secret of the proxy configuration or a secret named in one of its header
+// values. The returned names are de-duplicated and keep their order of appearance.
+func ReferencedSecrets(pluginSpec any) ([]string, error) {
+	cfg, kind, err := ValidateAndExtract(pluginSpec)
+	if err != nil {
+		return nil, err
+	}
+	seen := make(map[string]bool)
+	var names []string
+	add := func(name string) {
+		if len(name) == 0 || seen[name] {
+			return
+		}
+		seen[name] = true
+		names = append(names, name)
+	}
+	switch kind {
+	case http.ProxyKindName:
+		httpConfig := cfg.(*http.Config)
+		add(httpConfig.Secret)
+		for _, value := range httpConfig.Headers {
+			for _, match := range headerSecretReference.FindAllStringSubmatch(value, -1) {
+				add(match[1])
+			}
+		}
+	case sql.ProxyKindName:
+		add(cfg.(*sql.Config).Secret)
+	}
+	return names, nil
+}
