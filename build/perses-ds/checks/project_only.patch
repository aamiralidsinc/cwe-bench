+// checkSecretPermission ensures that the user that creates/updates a dashboard whose local datasources
+// reference stored secrets is allowed to read those secrets.
+func (s *service) checkSecretPermission(ctx echo.Context, dashboard *v1.Dashboard) error {
+	if !s.authz.IsEnabled() {
+		return nil
+	}
+	for dtsName, dtsSpec := range dashboard.Spec.Datasources {
+		if dtsSpec == nil {
+			continue
+		}
+		referencedSecrets, err := datasourceV1.ReferencedSecrets(dtsSpec.Plugin.Spec)
+		if err != nil {
+			logrus.WithError(err).WithFields(map[string]interface{}{
+				"dashboard":  dashboard.Metadata.Name,
+				"project":    dashboard.Metadata.Project,
+				"datasource": dtsName,
+			}).Error("unable to build or find the config in the datasource spec")
+			return echo.NewHTTPError(http.StatusBadGateway, "unable to build or find the config")
+		}
+		if len(referencedSecrets) == 0 {
+			continue
+		}
+		if ok := s.authz.HasPermission(ctx, role.ReadAction, dashboard.Metadata.Project, role.SecretScope); !ok {
+			return apiInterface.HandleForbiddenError(fmt.Sprintf("missing '%s' permission in '%s' project for '%s' kind", role.ReadAction, dashboard.Metadata.Project, role.SecretScope))
+		}
+	}
+	return nil
+}
