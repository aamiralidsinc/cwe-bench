+def is_global_host(value):
+    """
+    Check whether the provided host resolves only to globally routable addresses.
+
+    Parameters:
+    - value (str): The input host or IP address to check.
+
+    Returns:
+    - bool: True if the value is an IP address that is globally routable or a
+      host that resolves to at least one address and all of them are global,
+      False otherwise.
+    """
+    if not value:
+        return False
+
+    value = value.rstrip(".")
+
+    if is_ip_address(value):
+        return is_global_address(value)
+
+    ips = host_to_ip(value)
+    return bool(ips) and all(is_global_address(ip) for ip in ips)
+
