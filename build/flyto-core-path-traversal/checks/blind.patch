+def validate_write_path(path: str, follow_symlinks: bool = True) -> str:
+    """
+    Validate a location a module is about to create, overwrite, append to or
+    remove. The location must resolve (after expanding ``~``, ``..`` and any
+    symlinks, including a symlink in the final component) inside the operator
+    sandbox (FLYTO_SANDBOX_DIR, default: cwd).
+
+    Call this BEFORE creating any parent directories so that a refused run
+    leaves nothing behind outside the sandbox.
+
+    Args:
+        path: File or directory path to validate
+        follow_symlinks: When False, a symlink in the final component is
+            treated as the entry itself (used for removing/renaming an entry,
+            which acts on the link, not on its target)
+
+    Returns:
+        The canonical path (use it for the actual write)
+
+    Raises:
+        PathTraversalError: If the location is outside the sandbox
+    """
+    if path is None or (isinstance(path, str) and not path.strip()):
+        raise PathTraversalError("Output path cannot be empty")
+    path = os.fspath(path)
+    if '\x00' in path:
+        raise PathTraversalError(f"Invalid path: {path!r}")
+    try:
+        if not follow_symlinks:
+            expanded = os.path.expanduser(path)
+            parent, name = os.path.split(expanded.rstrip(os.sep) or expanded)
+            if name and name not in ('.', '..'):
+                if not get_safe_path_config()['allow_absolute'] and os.path.isabs(expanded):
+                    raise PathTraversalError(f"Absolute paths not allowed: {path}")
+                # The parent must resolve inside the sandbox; the entry itself
+                # is then a direct child of an in-sandbox directory.
+                safe_parent = validate_path_with_env_config(parent or os.curdir)
+                return os.path.join(safe_parent, name)
+        return validate_path_with_env_config(path)
+    except PathTraversalError:
+        raise
+    except ValueError as e:
+        raise PathTraversalError(str(e))
+
+
+def validate_write_path_within(path: str, root: str) -> str:
+    """
+    Like validate_write_path(), but additionally require the resolved
+    location to stay inside ``root`` (e.g. an archive extraction directory).
+    Symlinks already present under ``root`` are followed when resolving.
+    """
+    canonical = validate_write_path(path)
+    root_canonical = os.path.realpath(os.path.expanduser(root))
+    try:
+        inside = os.path.commonpath([canonical, root_canonical]) == root_canonical
+    except ValueError:
+        inside = False
+    if not inside:
+        raise PathTraversalError(
+            f"Path escapes target directory: {path} "
+            f"(resolves to {canonical}, outside {root_canonical})"
+        )
+    return canonical
+
+
+def is_path_in_sandbox(path: str) -> bool:
+    """Return True if ``path`` resolves inside the sandbox."""
+    try:
+        validate_write_path(path)
+        return True
+    except PathTraversalError:
+        return False
