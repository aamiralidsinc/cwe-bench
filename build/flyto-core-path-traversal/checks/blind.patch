+def _check_tar_member(member, safe_output: str, resolve: bool = False) -> None:
+    """Refuse entries (or link targets) that land outside the output dir."""
+    def _inside(candidate: str) -> bool:
+        if resolve:
+            try:
+                validate_write_path_within(candidate, safe_output)
+                return True
+            except PathTraversalError:
+                return False
+        norm = os.path.normpath(candidate)
+        root = os.path.normpath(safe_output)
+        return os.path.commonpath([norm, root]) == root
+
+    target_path = os.path.join(safe_output, member.name)
+    if os.path.isabs(member.name) or not _inside(target_path):
+        raise ModuleError(
+            "Tar entry attempts path traversal: {}".format(member.name),
+            code="PATH_TRAVERSAL",
+        )
+    if member.issym():
+        link_target = os.path.join(os.path.dirname(target_path), member.linkname)
+    elif member.islnk():
+        link_target = os.path.join(safe_output, member.linkname)
+    else:
+        return
+    if os.path.isabs(member.linkname) or not _inside(link_target):
+        raise ModuleError(
+            "Tar entry link escapes output directory: {} -> {}".format(
+                member.name, member.linkname),
+            code="PATH_TRAVERSAL",
+        )
+
