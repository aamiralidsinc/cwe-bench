+/**
+ * Returns whether `address`'s own bits reach `range`, comparing only the
+ * network bits that `range` names. Unlike {@link isInSubnet}, the prefix
+ * length written on `address` plays no part: a classification must describe
+ * the address the value actually reaches, not the suffix it was given.
+ */
+export function isAddressInRange(
+  address: Address4 | Address6,
+  range: Address4 | Address6,
+): boolean {
+  return address.mask(range.subnetMask) === range.mask();
+}
