diff --git a/server/events/within.go b/server/events/within.go
new file mode 100644
index 00000000..dc536a21
--- /dev/null
+++ b/server/events/within.go
@@ -0,0 +1,25 @@
+// Copyright 2025 The Atlantis Authors
+// SPDX-License-Identifier: Apache-2.0
+
+package events
+
+import (
+	"fmt"
+	"path/filepath"
+	"strings"
+)
+
+// within reports whether candidate resolves inside base (or is base itself).
+func within(base, candidate string) error {
+	rel, err := filepath.Rel(filepath.Clean(base), filepath.Clean(candidate))
+	if err != nil {
+		return err
+	}
+	if rel == "." {
+		return nil
+	}
+	if rel == ".." || strings.HasPrefix(rel, ".."+string(filepath.Separator)) || filepath.IsAbs(rel) {
+		return fmt.Errorf("%q is outside %q", candidate, base)
+	}
+	return nil
+}
