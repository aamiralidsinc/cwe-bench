+ */
+
+import { Context, Next } from '@nocobase/actions';
+
+import { validateLocalStorageConfig } from '../storages/local';
+
+const WRITE_ACTIONS = ['create', 'update', 'updateOrCreate', 'firstOrCreate'];
+
+export async function validateStorageMiddleware(ctx: Context, next: Next) {
+  const { actionName, params } = ctx.action;
+  if (!WRITE_ACTIONS.includes(actionName)) {
+    return next();
+  }
+
+  const values = params.values || {};
+  const submittedOptions = values.options && typeof values.options === 'object' ? values.options : {};
+  const hasSubmittedDocumentRoot = Object.prototype.hasOwnProperty.call(submittedOptions, 'documentRoot');
+
+  let storage: any = { ...values };
+
+  if (actionName !== 'create') {
+    const repository = ctx.db.getRepository('storages');
+    let existing: any;
+    if (params.filterByTk) {
+      existing = await repository.findById(params.filterByTk);
+      if (!existing) {
+        existing = await repository.findOne({
+          filter: {
+            name: params.filterByTk,
+          },
+        });
+      }
+    } else if (Array.isArray(params.filterKeys) && params.filterKeys.length) {
+      const filter = {};
+      for (const key of params.filterKeys) {
+        if (key in values) {
+          filter[key] = values[key];
+        }
+      }
+      if (Object.keys(filter).length) {
+        existing = await repository.findOne({ filter });
+      }
+    }
+    if (existing) {
+      const existingValues = existing.toJSON();
+      storage = {
+        ...existingValues,
+        ...values,
+        options: {
+          ...(existingValues.options || {}),
+          ...submittedOptions,
+        },
+      };
+    }
+  }
+
+  try {
+    validateLocalStorageConfig(storage, { validateDocumentRoot: hasSubmittedDocumentRoot });
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === 'PATH_TRAVERSAL') {
+      return ctx.throw(400, (error as Error).message);
+    }
+    throw error;
+  }
+
+  await next();
+}
