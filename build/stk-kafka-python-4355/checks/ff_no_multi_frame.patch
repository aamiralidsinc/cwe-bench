+            raise ValueError(
+                'Invalid value (too large) for Salt in server-first-message')
+        try:
+            iterations = int(params['i'])
+        except (TypeError, ValueError):
+            raise ValueError(
+                'Invalid value (not integer) for Iteration count in server-first-message')
+        if iterations < 1 or iterations > MAX_SCRAM_ITERATIONS:
+            raise ValueError(
+                'Invalid value (out of range) for Iteration count in server-first-message')
