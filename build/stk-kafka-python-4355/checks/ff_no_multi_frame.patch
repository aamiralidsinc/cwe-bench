diff --git a/kafka/codec.py b/kafka/codec.py
index e523f422..467a38ea 100644
--- a/kafka/codec.py
+++ b/kafka/codec.py
@@ -8,6 +8,21 @@ _XERIAL_V1_HEADER = (-126, b'S', b'N', b'A', b'P', b'P', b'Y', 0, 1, 1)
 _XERIAL_V1_FORMAT = 'bccccccBii'
 ZSTD_MAX_OUTPUT_SIZE = 1024 * 1024
 
+# Upper bound on the output of any single decompression call.  A broker's
+# response is bounded by the frame size, but compressed data can expand without
+# limit; a small payload must not be able to make the client allocate an
+# arbitrarily large buffer.  The bound is generous enough for the largest
+# batches a consumer legitimately asks for (fetch_max_bytes defaults to 50 MB).
+MAX_DECOMPRESSED_SIZE = 50 * 1024 * 1024
+
+
+def _check_decompressed_size(data):
+    if len(data) > MAX_DECOMPRESSED_SIZE:
+        raise ValueError(
+            'Decompressed payload exceeds the maximum allowed size '
+            '(%d > %d bytes)' % (len(data), MAX_DECOMPRESSED_SIZE))
+    return data
+
 try:
     import snappy
 except ImportError:
@@ -98,7 +113,10 @@ def gzip_decode(payload):
     # so old-fashioned way until we decide to not support 2.6
     gzipper = gzip.GzipFile(fileobj=buf, mode='r')
     try:
-        return gzipper.read()
+        # Read at most one byte past the bound, so a decompression bomb is
+        # refused before the whole expanded stream is materialized.
+        data = gzipper.read(MAX_DECOMPRESSED_SIZE + 1)
+        return _check_decompressed_size(data)
     finally:
         gzipper.close()
 
@@ -217,9 +235,9 @@ def snappy_decode(payload):
             cursor = end
 
         out.seek(0)
-        return out.read()
+        return _check_decompressed_size(out.read())
     else:
-        return snappy.decompress(payload)
+        return _check_decompressed_size(snappy.decompress(payload))
 
 
 if lz4:
@@ -243,11 +261,12 @@ def lz4f_decode(payload):
     # actually read if the decompression was only partial.
     if data['next'] != 0:
         raise RuntimeError('lz4f unable to decompress full payload')
-    return data['decomp']
+    return _check_decompressed_size(data['decomp'])
 
 
 if lz4:
-    lz4_decode = lz4.decompress # pylint: disable-msg=no-member
+    def lz4_decode(payload):
+        return _check_decompressed_size(lz4.decompress(payload))
 elif lz4f:
     lz4_decode = lz4f_decode
 elif lz4framed:
@@ -319,5 +338,6 @@ def zstd_encode(payload):
 def zstd_decode(payload):
     if not zstd:
         raise NotImplementedError("Zstd codec is not available")
-    with zstd.ZstdDecompressor().stream_reader(io.BytesIO(payload), read_across_frames=True) as reader:
-        return reader.read()
+    with zstd.ZstdDecompressor().stream_reader(io.BytesIO(payload), read_across_frames=False) as reader:
+        data = reader.read(MAX_DECOMPRESSED_SIZE + 1)
+    return _check_decompressed_size(data)
