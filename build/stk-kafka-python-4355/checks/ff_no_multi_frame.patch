+# Bounds on the work a broker-chosen SCRAM handshake may request.  Real
+# deployments use salts of 16-64 bytes and iteration counts in the thousands to
+# tens of thousands; anything beyond these bounds is a resource-exhaustion attempt.
+MAX_SCRAM_ITERATIONS = 1000000
+MAX_SCRAM_SALT_SIZE = 4096
+
 
 def xor_bytes(left, right):
     return bytes(lb ^ rb for lb, rb in zip(left, right))
@@ -99,7 +105,17 @@ class ScramClient:
