+def _path_within_fs(fs, path):
+    """Return the host path for *path* inside the image mounted at *fs*.
+
+    *path* is interpreted relative to the root of the image; any leading
+    slash is ignored, matching the historical behaviour.  The image is
+    controlled by the user who supplied it, so it may contain symbolic links
+    and ``..`` components designed to make a write land somewhere on the
+    compute host.  The requested path is therefore resolved exactly as the
+    host would resolve it while writing (following links stored in the
+    image) and is refused if the result is not underneath *fs*.
+    """
+    if not isinstance(path, basestring) or '\x00' in path:
+        msg = _('Invalid path supplied for injection: %r') % (path,)
+        raise exception.Invalid(msg)
+
     absolute_path = os.path.join(fs, path.lstrip('/'))
+    root = os.path.realpath(fs)
+    try:
+        resolved = os.path.realpath(absolute_path)
+    except OSError:
+        msg = _('Unable to resolve path for injection: %s') % path
+        raise exception.Invalid(msg)
+
+    if resolved != root and not resolved.startswith(root + os.sep):
+        msg = _('Path escapes the image and cannot be injected: %s') % path
+        raise exception.Invalid(msg)
+
+    return absolute_path
+
+
+def _inject_file_into_fs(fs, path, contents):
+    absolute_path = _path_within_fs(fs, path)
     parent_dir = os.path.dirname(absolute_path)
     utils.execute('mkdir', '-p', parent_dir, run_as_root=True)
     utils.execute('tee', absolute_path, process_input=contents,
