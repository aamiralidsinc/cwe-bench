+def _resolved_inside(directory: str, target: str) -> bool:
+    """Tell whether a resolved target stays at, or below, a resolved directory.
+
+    Both arguments are expected to be resolved first, so that symbolic links
+    and relative components cannot make a path look contained while pointing
+    somewhere else.
+    """
+    try:
+        return os.path.commonpath([directory, target]) == directory
+    except ValueError:  # e.g. one path is relative, or another drive
+        return False
