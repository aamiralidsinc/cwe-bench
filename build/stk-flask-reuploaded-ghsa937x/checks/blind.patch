+    def _refused_extensions(self) -> frozenset[str]:
+        """The file types this set refuses, in lowercase.
+
+        The configuration's deny list and the upload set's own exclusions both
+        refuse a type; a type the configuration explicitly allows is never
+        refused, since `extension_allowed` gives the allow list precedence.
+        """
+        allowed = {str(item).lower() for item in self.config.allow}
+        refused = {str(item).lower() for item in self.config.deny}
+        excluded = getattr(self.extensions, 'items', None)
+        if excluded is not None and not callable(excluded):
+            refused.update(str(item).lower() for item in excluded)
+        return frozenset(refused.difference(allowed))
+
