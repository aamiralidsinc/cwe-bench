+const fs = require('node:fs/promises');
+const os = require('node:os');
+const path = require('node:path');
+const zlib = require('node:zlib');
+const { promisify } = require('node:util');
+const logging = require('@tryghost/logging');
+
+const gunzip = promisify(zlib.gunzip);
+const gzip = promisify(zlib.gzip);
+
+// Image processing picks the decoder from the bytes, so the name a file arrives
+// under cannot decide whether it is an image. Extensions are grouped by format
+// because configuration and `file-type` spell the same format differently
+// (`.jpg`/`.jpeg`, `.tif`/`.tiff`, `.png`/`.apng`, `.heic`/`.heif`).
+const FORMATS = {
+  jpeg: ['.jpg', '.jpeg', '.jpe', '.jfif'],
+  png: ['.png', '.apng'],
+  gif: ['.gif'],
+  webp: ['.webp'],
+  svg: ['.svg', '.svgz'],
+  avif: ['.avif'],
+  heic: ['.heic', '.heif'],
+  tiff: ['.tif', '.tiff'],
+  ico: ['.ico'],
+};
+
+function formatFor(extension) {
+  const ext = String(extension || '').toLowerCase();
+  return Object.keys(FORMATS).find((format) => FORMATS[format].includes(ext));
+}
+
+function isSvgExtension(extension) {
+  return formatFor(extension) === 'svg';
+}
+
+function extensionAllowed(extension, extensions) {
+  const format = formatFor(extension);
+
+  if (!format) {
+    return extensions.some((allowed) => allowed.toLowerCase() === String(extension).toLowerCase());
+  }
+
+  return extensions.some((allowed) => formatFor(allowed) === format);
+}
+
+async function detect(input) {
+  const { fileTypeFromBuffer, fileTypeFromFile } = await import('file-type');
+  return typeof input === 'string' ? fileTypeFromFile(input) : fileTypeFromBuffer(input);
+}
+
+/**
+ * Whether the contents (or the file at the path) are one of the configured
+ * image formats. SVG is text, is never detected by the content sniffer and is
+ * handled by the sanitizer instead.
+ */
+async function contentsAllowed(input, extensions) {
+  if (typeof input !== 'string' && (!input || input.byteLength === 0)) {
+    return false;
+  }
+
+  let fileType;
+  try {
+    fileType = await detect(input);
+  } catch {
+    return false;
+  }
+
+  if (!fileType || !fileType.mime.startsWith('image/')) {
+    return false;
+  }
+
+  const detected = `.${fileType.ext}`;
+  return !isSvgExtension(detected) && extensionAllowed(detected, extensions);
+}
+
+function sanitizeSvgContent(content) {
+  if (/<!ENTITY/i.test(content)) {
+    return null;
+  }
+
+  const { JSDOM } = require('jsdom');
+  const createDOMPurify = require('dompurify');
+  const window = new JSDOM('').window;
+  const DOMPurify = createDOMPurify(window);
+  const sanitized = DOMPurify.sanitize(content, { USE_PROFILES: { svg: true, svgFilters: true } });
+
+  if (!sanitized || sanitized.trim() === '' || !/<svg[^>]*>\s*[\S]+[\S\s]*<\/svg>/.test(sanitized)) {
+    return null;
+  }
+
+  return sanitized;
+}
+
+async function sanitizeSvgBuffer(buffer, zipped = false) {
+  try {
+    const content = zipped ? (await gunzip(buffer)).toString('utf8') : buffer.toString('utf8');
+    const sanitized = sanitizeSvgContent(content);
+
+    if (!sanitized) {
+      return null;
+    }
+
+    return zipped ? await gzip(sanitized) : Buffer.from(sanitized);
+  } catch (error) {
+    logging.error('Error sanitizing SVG:', error);
+    return null;
+  }
+}
+
+async function sanitizeSvgFile(filepath, zipped = false) {
+  const resolved = path.resolve(filepath);
+
+  if (!resolved.startsWith(path.resolve(os.tmpdir()) + path.sep)) {
+    logging.error(`Refused to sanitize SVG outside the temp directory: ${filepath}`);
+    return false;
+  }
+
+  try {
+    const sanitized = await sanitizeSvgBuffer(await fs.readFile(resolved), zipped);
+
+    if (!sanitized) {
+      return false;
+    }
+
+    await fs.writeFile(resolved, sanitized);
+    return true;
+  } catch (error) {
+    logging.error('Error sanitizing SVG:', error);
+    return false;
+  }
+}
+
+/**
+ * Checks a {name, path} import entry against the configured image formats.
+ * SVG entries are sanitized in place rather than checked.
+ */
+async function importImageAllowed(file, extensions) {
+  const ext = path.extname(file.name).toLowerCase();
+
+  if (isSvgExtension(ext)) {
+    return sanitizeSvgFile(file.path, ext === '.svgz');
+  }
+
+  return contentsAllowed(file.path, extensions);
+}
+
+module.exports = {
+  contentsAllowed,
+  extensionAllowed,
+  importImageAllowed,
+  isSvgExtension,
+  sanitizeSvgBuffer,
+  sanitizeSvgFile,
+};
