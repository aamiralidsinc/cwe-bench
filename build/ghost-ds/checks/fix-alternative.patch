index 0000000..4fc7db1
--- /dev/null
+++ b/ghost/core/core/server/lib/image/image-guard.js
@@ -0,0 +1,136 @@
+// Image bytes reach image storage from several places: content archives,
+// remote fetches and direct uploads. Image decoding picks a format from the
+// contents, so every one of those places checks the bytes themselves against
+// the configured image extensions. SVG is text, is never detected by the
+// content sniffer, and is sanitized instead of being checked.
+const fs = require('node:fs/promises');
+const os = require('node:os');
+const path = require('node:path');
+const zlib = require('node:zlib');
+const { promisify } = require('node:util');
+
+const gunzip = promisify(zlib.gunzip);
+const gzip = promisify(zlib.gzip);
+
+const FORMATS = {
+  jpeg: ['.jpg', '.jpeg', '.jpe', '.jfif'],
+  png: ['.png', '.apng'],
+  gif: ['.gif'],
+  webp: ['.webp'],
+  svg: ['.svg', '.svgz'],
+  avif: ['.avif'],
+  heic: ['.heic', '.heif'],
+  tiff: ['.tif', '.tiff'],
+  ico: ['.ico'],
+};
+
+const formatOf = (extension) => {
+  const ext = String(extension || '').toLowerCase();
+  return Object.keys(FORMATS).find((format) => FORMATS[format].includes(ext));
+};
+
+const isSvgName = (name) => {
+  const ext = path.extname(name).toLowerCase();
+  return ext === '.svg' || ext === '.svgz';
+};
+
+const extensionAllowed = (extension, extensions) => {
+  const format = formatOf(extension);
+  if (!format) {
+    return extensions.some((allowed) => allowed.toLowerCase() === String(extension).toLowerCase());
+  }
+
+  return extensions.some((allowed) => formatOf(allowed) === format);
+};
+
+const detect = async (input) => {
+  const { fileTypeFromBuffer, fileTypeFromFile } = await import('file-type');
+  return typeof input === 'string' ? fileTypeFromFile(input) : fileTypeFromBuffer(input);
+};
+
+/**
+ * True when the bytes (or the file at the path) are an allowed image format.
+ */
+const contentAllowed = async (input, extensions) => {
+  if (typeof input !== 'string' && input.byteLength === 0) {
+    return false;
+  }
+
+  const fileType = await detect(input);
+  if (!fileType || !fileType.mime.startsWith('image/')) {
+    return false;
+  }
+
+  return !isSvgName(`file.${fileType.ext}`) && extensionAllowed(`.${fileType.ext}`, extensions);
+};
+
+const sanitizeSvgContent = (content) => {
+  if (/<!ENTITY/i.test(content)) {
+    return null;
+  }
+
+  const { JSDOM } = require('jsdom');
+  const createDOMPurify = require('dompurify');
+  const DOMPurify = createDOMPurify(new JSDOM('').window);
+  const sanitized = DOMPurify.sanitize(content, { USE_PROFILES: { svg: true, svgFilters: true } });
+
+  if (!sanitized || sanitized.trim() === '' || !/<svg[^>]*>\s*[\S]+[\s\S]*<\/svg>/.test(sanitized)) {
+    return null;
+  }
+
+  return sanitized;
+};
+
+/**
+ * Sanitizes an SVG or gzipped SVG buffer, returning null when it cannot be.
+ */
+const sanitizeSvgBuffer = async (buffer, zipped = false) => {
+  try {
+    const content = zipped ? (await gunzip(buffer)).toString() : buffer.toString('utf8');
+    const sanitized = sanitizeSvgContent(content);
+
+    if (!sanitized) {
+      return null;
+    }
+
+    return zipped ? await gzip(sanitized) : Buffer.from(sanitized);
+  } catch {
+    return null;
+  }
+};
+
+/**
+ * Checks a {name, path} import file. SVG files are sanitized in place.
+ */
+const validateFile = async (file, extensions) => {
+  const ext = path.extname(file.name).toLowerCase();
+
+  if (ext === '.svg' || ext === '.svgz') {
+    const resolvedPath = path.resolve(file.path);
+
+    if (!resolvedPath.startsWith(path.resolve(os.tmpdir()) + path.sep)) {
+      return false;
+    }
+
+    try {
+      const sanitized = await sanitizeSvgBuffer(await fs.readFile(resolvedPath), ext === '.svgz');
+      if (!sanitized) {
+        return false;
+      }
+      await fs.writeFile(resolvedPath, sanitized);
+      return true;
+    } catch {
+      return false;
+    }
+  }
+
+  return contentAllowed(file.path, extensions);
+};
+
+module.exports = {
+  contentAllowed,
+  extensionAllowed,
+  isSvgName,
+  sanitizeSvgBuffer,
+  validateFile,
+};
