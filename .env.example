# Copy to .env (never commit .env)
GITHUB_TOKEN=                 # stage 1/2: 5000 req/h instead of 60

# Stage 3 task generation. Default backend drives the logged-in `claude` CLI (Claude Code subscription).
TASK_GEN_BACKEND=cli          # cli | api
ANTHROPIC_MODEL=claude-opus-5-5
# CLAUDE_BIN=claude
# ANTHROPIC_API_KEY=          # only needed for TASK_GEN_BACKEND=api. NOTE: the cli backend strips it from the child
                              # environment so the subscription is used, not API billing.

# Stage 5 targets - direct vendor keys. No base URLs needed: Harbor has a built-in DeepSeek provider and a dedicated
# `mimo` agent (Xiaomi's CLI, runs inside the task container).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash   # exact vendor model id
MIMO_API_KEY=
MIMO_MODEL=                     # exact vendor model id for MiMo-V2.6-Pro
EVAL_ATTEMPTS=3
EVAL_AGENT=terminus-2           # agent for DeepSeek (host-side, runs with the container's network off)
# MIMO_AGENT=mimo               # default; set MIMO_BASE_URL to use terminus-2 + an OpenAI-compatible endpoint instead
# HARBOR_BIN=harbor
# CWE_DATA_DIR=/abs/path/to/data

# Recency filter against training-data memorisation (fix commit date). Both models were released by 2026-09-22.
PUBLISHED_AFTER=2026-09-23
# Concurrent task containers during stage 5 (Docker Desktop VM memory is the limit).
MAX_CONTAINERS=4
# TASK_CPUS=2
# TASK_MEMORY_MB=3072

# ONE timeout rule for every stage-5 verdict, the ledger and --reverdict:
#   exclude = a run that hit the agent time limit is NOT a model failure (agreed rule); if timeouts are the only
#             non-failures, the task is rejected
#   count   = a timed-out run is a model failure, only if its budget was >= FULL_BUDGET_SEC
TIMEOUT_POLICY=exclude
FULL_BUDGET_SEC=7000

# Optional: the target models' real context windows (tokens). Harbor otherwise assumes 1M for unknown models and would
# not summarise a long 2-hour run before the provider rejects it. Time is the only run limit (no turn cap).
# DEEPSEEK_CONTEXT_TOKENS=
# MIMO_CONTEXT_TOKENS=

# Task generation: model used for a candidate after the primary model's output is stopped by the safety filter.
GEN_FALLBACK_MODEL=claude-opus-4-8
