# Copy to .env and fill in the keys (never commit .env)

# --- Stage 1/2: mining and screening
GITHUB_TOKEN=                       # GitHub API token: 5000 req/h instead of 60
PUBLISHED_AFTER=2026-08-01          # only fixes committed after this date (the target models' training data predates it)
MAX_REPO_MB=400                     # skip repositories larger than this

# --- Stage 3: task generation (Claude Code CLI on a Claude subscription)
TASK_GEN_BACKEND=cli                # cli = the logged-in `claude` CLI | api = Anthropic API (needs ANTHROPIC_API_KEY)
ANTHROPIC_MODEL=claude-opus-5-5
GEN_FALLBACK_MODEL=claude-opus-4-8  # used for a candidate when the primary model declines (never after a safeguards flag)
# CLAUDE_CODE_OAUTH_TOKEN=          # optional: `claude setup-token`; otherwise the CLI's own login is used
# CLAUDE_BIN=claude
# ANTHROPIC_API_KEY=                # only for TASK_GEN_BACKEND=api (the cli backend strips it from its environment)

# --- Stage 5: the evaluated models (driven by Harbor's claude-code agent inside the task container)
EVAL_AGENT=claude-code
CLAUDE_CODE_VERSION=2.1.292         # Claude Code version baked into every task image
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_REASONING_EFFORT=max
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.6-pro
EVAL_ATTEMPTS=3
AGENT_TIMEOUT_SEC=7200              # 2 hours per attempt; time is the only limit (no token or turn cap)
MAX_CONTAINERS=10                   # concurrent task containers (Docker Desktop memory is the limit)
# TASK_CPUS=2
# TASK_MEMORY_MB=3072

# --- Verdict rules
# exclude = an attempt that hit the time limit is NOT a model failure (agreed rule); count = it is, if its budget was
# >= FULL_BUDGET_SEC
TIMEOUT_POLICY=exclude
FULL_BUDGET_SEC=7000
REQUIRE_EXISTING_TESTS=1            # task spec: functional tests include existing tests of the affected code

# Optional: the target models' real context windows (tokens), so Harbor summarises long runs in time
# DEEPSEEK_CONTEXT_TOKENS=
# MIMO_CONTEXT_TOKENS=
# HARBOR_BIN=harbor
# CWE_DATA_DIR=/abs/path/to/data
