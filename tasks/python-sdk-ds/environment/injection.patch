diff --git a/src/mcp/server/experimental/task_housekeeping.py b/src/mcp/server/experimental/task_housekeeping.py
new file mode 100644
index 0000000..3fef91f
--- /dev/null
+++ b/src/mcp/server/experimental/task_housekeeping.py
@@ -0,0 +1,67 @@
+"""
+Default handlers for task housekeeping.
+
+A finished task keeps occupying the store until its TTL runs out. ``tasks/delete``
+lets a client drop a task it no longer needs, together with its stored result and
+queued messages, as soon as it is done with it.
+
+WARNING: These APIs are experimental and may change without notice.
+"""
+
+from __future__ import annotations
+
+import logging
+from collections.abc import Awaitable, Callable
+from typing import TYPE_CHECKING
+
+from mcp.server.experimental.task_watch import registry as watch_registry
+from mcp.shared.exceptions import McpError
+from mcp.shared.experimental.tasks.store import TaskStore
+from mcp.types import (
+    INVALID_PARAMS,
+    DeleteTaskRequest,
+    DeleteTaskResult,
+    ErrorData,
+    ServerResult,
+)
+
+if TYPE_CHECKING:
+    from mcp.server.lowlevel.server import Server
+
+logger = logging.getLogger(__name__)
+
+
+def register_housekeeping_handlers(
+    server: Server,
+    request_handlers: dict[type, Callable[..., Awaitable[ServerResult]]],
+    store: TaskStore,
+) -> None:
+    """Register the default tasks/delete handler.
+
+    The application keeps control: a handler it registered itself is left alone.
+
+    Args:
+        server: The low-level server (for the current request context)
+        request_handlers: The server's request handler table
+        store: The task store to remove tasks from
+    """
+    if DeleteTaskRequest in request_handlers:
+        return
+
+    async def _default_delete_task(req: DeleteTaskRequest) -> ServerResult:
+        session = server.request_context.session
+        deleted = await store.delete_task(req.params.taskId)
+        if not deleted:
+            raise McpError(
+                ErrorData(
+                    code=INVALID_PARAMS,
+                    message=f"Task not found: {req.params.taskId}",
+                )
+            )
+        client_name = session.client_params.clientInfo.name if session.client_params else "uninitialized client"
+        logger.debug("Deleted task %s at the request of %s", req.params.taskId, client_name)
+        # A removed task has no more status changes to report.
+        watch_registry.forget(req.params.taskId)
+        return ServerResult(DeleteTaskResult(taskId=req.params.taskId))
+
+    request_handlers[DeleteTaskRequest] = _default_delete_task
diff --git a/src/mcp/server/experimental/task_watch.py b/src/mcp/server/experimental/task_watch.py
new file mode 100644
index 0000000..33d3d25
--- /dev/null
+++ b/src/mcp/server/experimental/task_watch.py
@@ -0,0 +1,109 @@
+"""
+Default handlers for task status subscriptions.
+
+A client that does not want to long-poll ``tasks/result`` can ask to be told
+when a task's status changes instead: ``tasks/watch`` subscribes the calling
+session to that task's status notifications, which are then delivered as
+``notifications/tasks/status`` messages until the task reaches a terminal state.
+
+WARNING: These APIs are experimental and may change without notice.
+"""
+
+from __future__ import annotations
+
+import logging
+from collections.abc import Awaitable, Callable
+from typing import TYPE_CHECKING
+
+from mcp.shared.exceptions import McpError
+from mcp.shared.experimental.tasks.store import TaskStore
+from mcp.types import (
+    INVALID_PARAMS,
+    ErrorData,
+    ServerNotification,
+    ServerResult,
+    WatchTaskRequest,
+    WatchTaskResult,
+)
+
+if TYPE_CHECKING:
+    from mcp.server.lowlevel.server import Server
+    from mcp.server.session import ServerSession
+
+logger = logging.getLogger(__name__)
+
+
+class TaskWatchRegistry:
+    """Sessions that asked to be told when a task's status changes."""
+
+    def __init__(self) -> None:
+        self._sessions: dict[str, list[ServerSession]] = {}
+
+    def add(self, task_id: str, session: ServerSession) -> None:
+        """Subscribe a session to a task's status notifications."""
+        sessions = self._sessions.setdefault(task_id, [])
+        if session not in sessions:
+            sessions.append(session)
+
+    def sessions_for(self, task_id: str) -> list[ServerSession]:
+        """Return the sessions subscribed to a task."""
+        return list(self._sessions.get(task_id, ()))
+
+    def forget(self, task_id: str) -> None:
+        """Drop every subscription for a task that no longer exists."""
+        self._sessions.pop(task_id, None)
+
+
+registry = TaskWatchRegistry()
+
+
+async def publish(
+    notification: ServerNotification,
+    task_id: str,
+    *,
+    sender: ServerSession,
+) -> None:
+    """Forward a task status notification to the task's subscribers.
+
+    The session that ran the task already receives the notification through its
+    own task context, so it is skipped here.
+    """
+    for session in registry.sessions_for(task_id):
+        if session is sender:
+            continue
+        try:
+            await session.send_notification(notification)
+        except Exception:  # pragma: no cover - a closed peer must not break the task
+            logger.debug("Dropping task notification for an unreachable session", exc_info=True)
+
+
+def register_watch_handlers(
+    server: Server,
+    request_handlers: dict[type, Callable[..., Awaitable[ServerResult]]],
+    store: TaskStore,
+) -> None:
+    """Register the default tasks/watch handler.
+
+    The application keeps control: a handler it registered itself is left alone.
+
+    Args:
+        server: The low-level server (for the current request context)
+        request_handlers: The server's request handler table
+        store: The task store the watched tasks live in
+    """
+    if WatchTaskRequest in request_handlers:
+        return
+
+    async def _default_watch_task(req: WatchTaskRequest) -> ServerResult:
+        task = await store.get_task(req.params.taskId)
+        if task is None:
+            raise McpError(
+                ErrorData(
+                    code=INVALID_PARAMS,
+                    message=f"Task not found: {req.params.taskId}",
+                )
+            )
+        registry.add(req.params.taskId, server.request_context.session)
+        return ServerResult(WatchTaskResult(taskId=req.params.taskId, watching=True))
+
+    request_handlers[WatchTaskRequest] = _default_watch_task
