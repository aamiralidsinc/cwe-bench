+class AuthorityOptions(AuthenticatedResource):
+    @validate_schema(authority_options_update_schema, authority_output_schema)
+    def put(self, authority_id, data=None):
+        """
+        .. http:put:: /authorities/1/options
+
+           Replaces the plugin options of an authority.
+
+           :reqheader Authorization: OAuth token to authenticate
+           :statuscode 200: no error
+           :statuscode 403: unauthenticated
+        """
+        authority = service.get(authority_id)
+
+        if not authority:
+            return dict(message="Not Found"), 404
+
+        roles = [x.name for x in authority.roles]
+        permission = AuthorityPermission(authority_id, roles)
+
+        if not permission.can() or not StrictRolePermission().can():
+            return dict(message="You are not authorized to update this authority."), 403
+
+        return service.update_options(authority_id, options=data["options"])
+
+
+class AuthorityAcmeDirectory(AuthenticatedResource):
+    @validate_schema(authority_acme_directory_schema, None)
+    def post(self, authority_id, data=None):
+        """
+        .. http:post:: /authorities/1/acme-directory
+
+           Checks that the ACME directory configured for an authority can be reached.
+           An optional acme_url tests an alternative directory before it is used.
+
+           :reqheader Authorization: OAuth token to authenticate
+           :statuscode 200: no error
+           :statuscode 403: unauthenticated
+        """
+        authority = service.get(authority_id)
+
+        if not authority:
+            return dict(message="Not Found"), 404
+
+        roles = [x.name for x in authority.roles]
+        permission = AuthorityPermission(authority_id, roles)
+
+        if not permission.can() or not StrictRolePermission().can():
+            return dict(message="You are not authorized to use this authority."), 403
+
+        from lemur.plugins.lemur_acme.acme_handlers import AcmeHandler
+
+        overrides = {}
+        if data.get("acme_url"):
+            overrides["acme_url"] = data["acme_url"]
+
+        handler = AcmeHandler()
+        handler.setup_acme_client(authority, overrides=overrides or None)
+        return dict(message="The ACME directory is reachable")
+
