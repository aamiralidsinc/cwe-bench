+// subscribeStreamRequestContext builds outgoing metadata for a subscribe stream
+// call. The subscribe stream proxy is constructed apart from the shared proxy
+// helpers, so it resolves its own header configuration here.
+func subscribeStreamRequestContext(ctx context.Context, p Config) context.Context {
+	md := metadata.MD{}
+
+	// Set static metadata first, so that dynamic metadata can override it.
+	for k, v := range p.GRPC.StaticMetadata {
+		md.Set(k, v)
+	}
+
+	allowedHeader := func(name string) bool {
+		for _, header := range p.HttpHeaders {
+			if strings.EqualFold(header, name) {
+				return true
+			}
+		}
+		return false
+	}
+
+	emulatedHeaders, _ := clientcontext.GetEmulatedHeadersFromContext(ctx)
+	for k, v := range emulatedHeaders {
+		if allowedHeader(k) {
+			md.Set(k, v)
+		}
+	}
+
+	httpHeaders, hasHTTPHeaders := middleware.GetHeadersFromContext(ctx)
+	for k, vv := range httpHeaders {
+		if allowedHeader(k) {
+			md.Set(k, vv...)
+		}
+	}
+
+	if !hasHTTPHeaders {
+		incomingMD, _ := metadata.FromIncomingContext(ctx)
+		for k, vv := range incomingMD {
+			if slices.Contains(p.GrpcMetadata, k) {
+				md[k] = vv
+			}
+		}
+	}
+
+	return metadata.NewOutgoingContext(ctx, md)
+}
