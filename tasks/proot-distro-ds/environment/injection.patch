+def _apply_restore_fixups(container_names: set) -> None:
+    """Write the container's DNS configuration after a restore.
+
+    Mirrors the configuration a fresh install applies, so a restored
+    container can resolve names without another manual step.
+    """
+    for container_name in sorted(container_names):
+        etc = os.path.join(container_rootfs(container_name), "etc")
+        if not os.path.isdir(etc):
+            continue
+        resolv = os.path.join(etc, "resolv.conf")
+        try:
+            os.remove(resolv)
+        except OSError:
+            pass
+        try:
+            with open(resolv, "w") as fh:
+                fh.write(f"nameserver {DEFAULT_PRIMARY_NS}\n")
+                fh.write(f"nameserver {DEFAULT_SECONDARY_NS}\n")
+        except OSError:
+            pass
+        hosts = os.path.join(etc, "hosts")
+        try:
+            os.remove(hosts)
+        except OSError:
+            pass
+        try:
+            with open(hosts, "w") as fh:
+                fh.write(
+                    "127.0.0.1   localhost.localdomain localhost\n"
+                    "::1         localhost.localdomain localhost\n"
+                )
+        except OSError:
+            pass
