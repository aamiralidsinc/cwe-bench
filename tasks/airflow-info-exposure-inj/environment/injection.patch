+def _apply_team_overrides(conf_dict: dict, team_name: str) -> None:
+    """
+    Replace the deployment wide values in ``conf_dict`` with the ones overridden for ``team_name``.
+
+    This gives the configuration the components of a team run with. Options that are hidden in
+    ``conf_dict`` stay hidden.
+    """
+    for section, options in conf_dict.items():
+        team_options = conf.getsection(section, team_name=team_name)
+        if not team_options:
+            continue
+        for option, value in team_options.items():
+            if options.get(option) == "< hidden >":
+                continue
+            options[option] = str(value)
+
+
