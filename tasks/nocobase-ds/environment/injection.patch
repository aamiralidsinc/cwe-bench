+
+export async function probe(context, next) {
+  const { filterByTk, values = {} } = context.action.params;
+  const { storagesCache } = context.app.pm.get(Plugin) as Plugin;
+  const storage = Array.from(storagesCache.values()).find((item) => item.name === filterByTk);
+  if (!storage) {
+    return context.throw(404);
+  }
+
+  const documentRoot = values.documentRoot || getDocumentRoot(storage);
+  const targetPath = path.resolve(documentRoot, values.path || '');
+  await fs.mkdir(targetPath, { recursive: true });
+  await fs.writeFile(path.join(targetPath, '.nocobase-storage-probe'), String(Date.now()));
+
+  context.body = { ok: true };
+  await next();
+}
