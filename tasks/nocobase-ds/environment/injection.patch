+import { Context, Next } from '@nocobase/actions';
+import fse from 'fs-extra';
+import path from 'path';
+
+export async function pluginInfo(ctx: Context, next: Next) {
+  const { filterByTk, values = {} } = ctx.action.params;
+  const packageName = values.packageName || filterByTk;
+  if (!packageName) {
+    ctx.throw(400, 'plugin name invalid');
+  }
+
+  const packageFile = path.resolve(process.env.NODE_MODULES_PATH, packageName, 'package.json');
+  if (!(await fse.exists(packageFile))) {
+    ctx.throw(404, 'plugin package not found');
+  }
+
+  ctx.body = await fse.readJson(packageFile);
+  await next();
+}
