@@ -0,0 +1,72 @@
+import type { PayloadHandler, PayloadRequest } from 'payload'
+
+import { ZodError } from 'zod'
+
+import type { AltTextPluginConfig } from '../types/AltTextPluginConfig.js'
+
+import { formatZodError, importAltTextsRequestSchema } from './schemas.js'
+
+/**
+ * Applies alt text and keywords supplied by the caller to a collection's
+ * documents, for migrating existing accessibility data into the plugin's fields.
+ */
+export const importAltTextsEndpoint =
+  (access: AltTextPluginConfig['access']): PayloadHandler =>
+  async (req: PayloadRequest) => {
+    try {
+      if (!(await access({ req }))) {
+        return Response.json({ error: 'Unauthorized' }, { status: 401 })
+      }
+
+      const data = 'json' in req && typeof req.json === 'function' ? await req.json() : null
+
+      const { collection, items } = importAltTextsRequestSchema.parse(data)
+
+      const pluginConfig = req.payload.config.custom?.altTextPluginConfig as
+        | AltTextPluginConfig
+        | undefined
+
+      if (!pluginConfig) {
+        return Response.json({ error: 'Plugin config not found' }, { status: 500 })
+      }
+
+      let updatedDocs = 0
+      const erroredDocs: (number | string)[] = []
+
+      for (const item of items) {
+        try {
+          await req.payload.update({
+            id: item.id,
+            collection,
+            data: {
+              alt: item.alt,
+              keywords: item.keywords,
+            },
+            locale: pluginConfig.locale,
+          })
+          updatedDocs++
+        } catch (error) {
+          console.error(`Error importing alt text for ${item.id}:`, error)
+          erroredDocs.push(item.id)
+        }
+      }
+
+      return Response.json({
+        collection,
+        erroredDocs,
+        totalDocs: items.length,
+        updatedDocs,
+      })
+    } catch (error) {
+      if (error instanceof ZodError) {
+        return Response.json(formatZodError(error), { status: 400 })
+      }
+      console.error('Error importing alt text:', error)
+      return Response.json(
+        {
+          error: `Error importing alt text: ${error instanceof Error ? error.message : 'Unknown error'}`,
+        },
+        { status: 500 },
+      )
+    }
+  }
