index 0000000..858c4bc
--- /dev/null
+++ b/alt-text/src/endpoints/backfillMissingAltTexts.ts
@@ -0,0 +1,124 @@
+import type { PayloadHandler, PayloadRequest } from 'payload'
+
+import { ZodError } from 'zod'
+
+import type { AltTextPluginConfig } from '../types/AltTextPluginConfig.js'
+
+import { buildMimeTypeWhere, matchesMimeType } from '../utilities/mimeTypes.js'
+import { backfillMissingAltTextsRequestSchema, formatZodError } from './schemas.js'
+
+/**
+ * Generates and saves alt text for every tracked document in a collection that
+ * does not have any yet. Intended for the "fix all" action on the health widget:
+ * it fills the gaps the widget reports for one collection in one pass.
+ */
+export const backfillMissingAltTextsEndpoint =
+  (access: AltTextPluginConfig['access']): PayloadHandler =>
+  async (req: PayloadRequest) => {
+    try {
+      if (!(await access({ req }))) {
+        return Response.json({ error: 'Unauthorized' }, { status: 401 })
+      }
+
+      const data = 'json' in req && typeof req.json === 'function' ? await req.json() : null
+
+      const { collection, locale } = backfillMissingAltTextsRequestSchema.parse(data)
+
+      const pluginConfig = req.payload.config.custom?.altTextPluginConfig as
+        | AltTextPluginConfig
+        | undefined
+
+      if (!pluginConfig) {
+        return Response.json({ error: 'Plugin config not found' }, { status: 500 })
+      }
+
+      if (!pluginConfig.resolver) {
+        return Response.json({ error: 'No alt text resolver configured' }, { status: 500 })
+      }
+
+      const targetLocale = locale ?? pluginConfig.locale
+      if (!targetLocale) {
+        return Response.json(
+          {
+            error:
+              'Could not determine target locale for alt text generation. Please check your plugin configuration.',
+          },
+          { status: 500 },
+        )
+      }
+
+      const collectionConfig = pluginConfig.collections.find((entry) => entry.slug === collection)
+      const missingWhere = { or: [{ alt: { equals: '' } }, { alt: { exists: false } }] }
+      const mimeWhere = collectionConfig ? buildMimeTypeWhere(collectionConfig.mimeTypes) : null
+      const where = mimeWhere ? { and: [mimeWhere, missingWhere] } : missingWhere
+
+      const found = await req.payload.find({
+        collection,
+        depth: 0,
+        limit: 100,
+        where,
+      })
+
+      let updatedDocs = 0
+      const erroredDocs: (number | string)[] = []
+
+      for (const doc of found.docs) {
+        try {
+          const mimeType =
+            'mimeType' in doc && typeof doc.mimeType === 'string' ? doc.mimeType : undefined
+
+          if (
+            mimeType &&
+            collectionConfig &&
+            !matchesMimeType(mimeType, collectionConfig.mimeTypes)
+          ) {
+            continue
+          }
+
+          const result = await pluginConfig.resolver.resolve({
+            filename:
+              'filename' in doc && typeof doc.filename === 'string' ? doc.filename : undefined,
+            imageThumbnailUrl: pluginConfig.getImageThumbnail(doc),
+            locale: targetLocale,
+            req,
+          })
+
+          if (!result.success) {
+            throw new Error(result.error || 'Failed to generate alt text')
+          }
+
+          await req.payload.update({
+            id: doc.id,
+            collection,
+            data: {
+              alt: result.result.altText,
+              keywords: result.result.keywords,
+            },
+            locale: targetLocale,
+          })
+          updatedDocs++
+        } catch (error) {
+          console.error(`Error backfilling alt text for ${doc.id}:`, error)
+          erroredDocs.push(doc.id)
+        }
+      }
+
+      return Response.json({
+        collection,
+        erroredDocs,
+        totalDocs: found.docs.length,
+        updatedDocs,
+      })
+    } catch (error) {
+      if (error instanceof ZodError) {
+        return Response.json(formatZodError(error), { status: 400 })
+      }
+      console.error('Error backfilling alt text:', error)
+      return Response.json(
+        {
+          error: `Error backfilling alt text: ${error instanceof Error ? error.message : 'Unknown error'}`,
+        },
+        { status: 500 },
+      )
+    }
+  }
diff --git a/alt-text/src/endpoints/exportAltTexts.ts b/alt-text/src/endpoints/exportAltTexts.ts
new file mode 100644
index 0000000..74cda3b
--- /dev/null
+++ b/alt-text/src/endpoints/exportAltTexts.ts
@@ -0,0 +1,57 @@
+import type { PayloadHandler, PayloadRequest } from 'payload'
+
+import { ZodError } from 'zod'
+
+import type { AltTextPluginConfig } from '../types/AltTextPluginConfig.js'
+
+import { exportAltTextsRequestSchema, formatZodError } from './schemas.js'
+
+/**
+ * Returns the alt text and keywords of a collection's documents so they can be
+ * reviewed or migrated in bulk (for example, a CSV export from the admin UI).
+ */
+export const exportAltTextsEndpoint =
+  (access: AltTextPluginConfig['access']): PayloadHandler =>
+  async (req: PayloadRequest) => {
+    try {
+      if (!(await access({ req }))) {
+        return Response.json({ error: 'Unauthorized' }, { status: 401 })
+      }
+
+      const data = 'json' in req && typeof req.json === 'function' ? await req.json() : null
+
+      const { collection, limit } = exportAltTextsRequestSchema.parse(data)
+
+      const result = await req.payload.find({
+        collection,
+        depth: 0,
+        limit: limit ?? 100,
+        select: {
+          alt: true,
+          filename: true,
+          keywords: true,
+        },
+      })
+
+      return Response.json({
+        collection,
+        docs: result.docs.map((doc) => ({
+          alt: 'alt' in doc ? doc.alt : undefined,
+          filename: 'filename' in doc ? doc.filename : undefined,
+          id: doc.id,
+          keywords: 'keywords' in doc ? doc.keywords : undefined,
+        })),
+      })
+    } catch (error) {
+      if (error instanceof ZodError) {
+        return Response.json(formatZodError(error), { status: 400 })
+      }
+      console.error('Error exporting alt text:', error)
+      return Response.json(
+        {
+          error: `Error exporting alt text: ${error instanceof Error ? error.message : 'Unknown error'}`,
+        },
+        { status: 500 },
+      )
+    }
+  }
