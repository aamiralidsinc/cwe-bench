+    /**
+     * Readable dump of a value for page output — the always-on counterpart to
+     * dump()/debug(), which only run in the debugger. Objects are flattened
+     * through toArray() when they offer it, otherwise cast to an array, so the
+     * result is printable text rather than an object id.
+     *
+     * @param  mixed $var
+     * @return string
+     */
+    public function inspectFunc(mixed $var)
+    {
+        if (is_object($var)) {
+            if (method_exists($var, 'toArray')) {
+                $var = $var->toArray();
+            } else {
+                $var = (array) $var;
+            }
+        }
+
+        return print_r($var, true);
+    }
