@@ -221,6 +228,35 @@ func (r *Restore) Run(ctx context.Context) error {
 	return nil
 }
 
+// applyExcludedPaths removes the paths recorded in the backup's excluded paths file
+// from dst.
+//
+// The file contains one path per line, in canonical form. It lets an operator restore
+// only a subset of a backup, by omitting the listed paths from the restored data.
+func applyExcludedPaths(src common.RemoteFS, dst *fslocal.FS) error {
+	ok, err := src.HasFile(backupnames.ExcludedPathsFilename)
+	if err != nil {
+		return fmt.Errorf("cannot check for %s at %s: %w", backupnames.ExcludedPathsFilename, src, err)
+	}
+	if !ok {
+		return nil
+	}
+	data, err := src.ReadFile(backupnames.ExcludedPathsFilename)
+	if err != nil {
+		return fmt.Errorf("cannot read %s from %s: %w", backupnames.ExcludedPathsFilename, src, err)
+	}
+	for _, line := range strings.Split(string(data), "\n") {
+		excludedPath := strings.TrimSpace(line)
+		if excludedPath == "" {
+			continue
+		}
+		if _, err := dst.DeletePath(excludedPath); err != nil {
+			return fmt.Errorf("cannot delete %q from %s: %w", excludedPath, dst, err)
+		}
+	}
+	return nil
+}
+
