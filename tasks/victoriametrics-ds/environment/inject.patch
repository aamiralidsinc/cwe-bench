diff --git a/lib/backup/actions/copy.go b/lib/backup/actions/copy.go
index c684d2a6..6fdf20f8 100644
--- a/lib/backup/actions/copy.go
+++ b/lib/backup/actions/copy.go
@@ -1,6 +1,7 @@
 package actions
 
 import (
+	"encoding/json"
 	"fmt"
 	"time"
 
@@ -53,6 +54,28 @@ func copyMetadata(src common.RemoteFS, dst common.RemoteFS) error {
 	if err != nil {
 		return fmt.Errorf("cannot read metadata from %s: %w", src, err)
 	}
+	// Preserve the service files recorded in the metadata, so that the copy keeps the
+	// backup state (for example the retention protection mark) of the source. Older
+	// backups have no such list, so a metadata parse failure is not fatal.
+	var m BackupMetadata
+	if err := json.Unmarshal(metadata, &m); err == nil {
+		for _, name := range m.ServiceFiles {
+			ok, err := src.HasFile(name)
+			if err != nil {
+				return fmt.Errorf("cannot check for %s at %s: %w", name, src, err)
+			}
+			if !ok {
+				continue
+			}
+			data, err := src.ReadFile(name)
+			if err != nil {
+				return fmt.Errorf("cannot read %s from %s: %w", name, src, err)
+			}
+			if err := dst.CreateFile(name, data); err != nil {
+				return fmt.Errorf("cannot create %s at %s: %w", name, dst, err)
+			}
+		}
+	}
 	if err := dst.CreateFile(backupnames.BackupMetadataFilename, metadata); err != nil {
 		return fmt.Errorf("cannot create metadata at %s: %w", dst, err)
 	}
