+func canManageTargetRole(myRole int, targetRole int) bool {
+	return myRole == common.RoleRootUser || myRole > targetRole
+}
+
+// redactUserSetting removes the notification credentials from a stored settings blob.
+func redactUserSetting(raw string) string {
+	if raw == "" {
+		return ""
+	}
+	var setting dto.UserSetting
+	if err := common.Unmarshal([]byte(raw), &setting); err != nil {
+		return ""
+	}
+	setting.WebhookSecret = ""
+	setting.GotifyToken = ""
+	setting.BarkUrl = ""
+	encoded, err := common.Marshal(setting)
+	if err != nil {
+		return ""
+	}
+	return string(encoded)
+}
+
+// redactUserForAdmin removes credentials from a user record shown to another account.
+func redactUserForAdmin(user *model.User) *model.User {
+	if user != nil {
+		user.Setting = redactUserSetting(user.Setting)
+	}
+	return user
+}
