+type adminOAuthBindingRequest struct {
+	ProviderId     int    `json:"provider_id"`
+	ProviderUserId string `json:"provider_user_id"`
+}
+
+// AdminCreateUserOAuthBinding links a sign-in identity to an account for the administrator.
+func AdminCreateUserOAuthBinding(c *gin.Context) {
+	userId, err := strconv.Atoi(c.Param("id"))
+	if err != nil {
+		common.ApiErrorMsg(c, "invalid user id")
+		return
+	}
+	var req adminOAuthBindingRequest
+	if err := c.ShouldBindJSON(&req); err != nil || req.ProviderId == 0 || req.ProviderUserId == "" {
+		common.ApiErrorMsg(c, "invalid request")
+		return
+	}
+	if _, err := model.GetCustomOAuthProviderById(req.ProviderId); err != nil {
+		common.ApiError(c, err)
+		return
+	}
+	binding := &model.UserOAuthBinding{
+		UserId:         userId,
+		ProviderId:     req.ProviderId,
+		ProviderUserId: req.ProviderUserId,
+	}
+	if err := model.CreateUserOAuthBinding(binding); err != nil {
+		common.ApiError(c, err)
+		return
+	}
+	c.JSON(http.StatusOK, gin.H{
+		"success": true,
+		"message": "success",
+	})
+}
