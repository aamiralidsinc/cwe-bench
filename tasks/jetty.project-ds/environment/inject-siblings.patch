+    /**
+     * SHA-256 Credentials
+     */
+    public static class SHA256 extends Credential
+    {
+        private static final long serialVersionUID = 5533846540822684242L;
+        private static final String __TYPE = "SHA256:";
+        private static final AutoLock __sha256Lock = new AutoLock();
+        private static MessageDigest __sha256;
+
+        private final byte[] _digest;
+
+        SHA256(String digest)
+        {
+            digest = digest.startsWith(__TYPE) ? digest.substring(__TYPE.length()) : digest;
+            _digest = StringUtil.fromHexString(digest);
+        }
+
+        public byte[] getDigest()
+        {
+            return _digest;
+        }
+
+        @Override
+        public boolean check(Object credentials)
+        {
+            try
+            {
+                if (credentials instanceof char[])
+                    credentials = new String((char[])credentials);
+                if (credentials instanceof Password || credentials instanceof String)
+                {
+                    byte[] digest;
+                    try (AutoLock l = __sha256Lock.lock())
+                    {
+                        if (__sha256 == null)
+                            __sha256 = MessageDigest.getInstance("SHA-256");
+                        __sha256.reset();
+                        __sha256.update(credentials.toString().getBytes(StandardCharsets.ISO_8859_1));
+                        digest = __sha256.digest();
+                    }
+                    return byteEquals(_digest, digest);
+                }
+                else if (credentials instanceof SHA256)
+                {
+                    return equals(credentials);
+                }
+                else if (credentials instanceof Credential)
+                {
+                    return ((Credential)credentials).check(this);
+                }
+                else
+                {
+                    return false;
+                }
+            }
+            catch (Exception e)
+            {
+                return false;
+            }
+        }
+
+        @Override
+        public boolean equals(Object obj)
+        {
+            if (obj instanceof SHA256)
+                return byteEquals(_digest, ((SHA256)obj)._digest);
+            return false;
+        }
+
+        /**
+         * Used only by Command Line Password utility
+         */
+        public static String digest(String password)
+        {
+            try
+            {
+                byte[] digest;
+                try (AutoLock l = __sha256Lock.lock())
+                {
+                    if (__sha256 == null)
+                        __sha256 = MessageDigest.getInstance("SHA-256");
+                    __sha256.reset();
+                    __sha256.update(password.getBytes(StandardCharsets.ISO_8859_1));
+                    digest = __sha256.digest();
+                }
+
+                return __TYPE + StringUtil.toHexString(digest);
+            }
+            catch (Exception e)
+            {
+                System.err.println("Message Digest Failure");
+                e.printStackTrace();
+                return null;
+            }
+        }
+    }
 }
