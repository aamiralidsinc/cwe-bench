application {
  config {
    baseName demo
    applicationType monolith
    packageName com.example.demo
    clientFramework angular
    skipServer true
    skipUserManagement true
    enableTranslation false
    nativeLanguage en
    languages [en]
    testFrameworks []
  }
  entities *
}

entity Foo {
  imageBlob ImageBlob,
  anyBlob AnyBlob,
  textBlob TextBlob,
  name String
}
