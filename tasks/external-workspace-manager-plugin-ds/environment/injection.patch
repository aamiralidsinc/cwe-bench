+    /**
+     * Appends the given sub path to the allocated default path on the disk.
+     *
+     * @param defaultPath the path computed from the disk configuration and the running job
+     * @param subPath     the sub path to be appended
+     * @return the computed path on the physical disk
+     * @throws IOException if the {@code subPath} argument is not a relative path
+     */
+    @Nonnull
+    private String computeSubPath(@Nonnull String defaultPath, @Nonnull String subPath) throws IOException {
+        if (!isRelativePath(subPath)) {
+            String message = format("The sub path: %s must be a relative path", subPath);
+            throw new AbortException(message);
+        }
+
+        return new FilePath(new File(defaultPath, subPath)).getRemote();
+    }
