+import { TRANSCRIPTION_TIMEOUT_MS } from "./constants.js";
+import { decodeXmlEntities, extractFeedItems } from "./rss-feed.js";
+
+type ChapterPayload = {
+  chapters?: Array<{ title?: unknown }>;
+};
+
+function extractPodcastChaptersUrlFromItem(itemXml: string): string | null {
+  const match = itemXml.match(/<podcast:chapters\b[^>]*\burl\s*=\s*(['"])([^'"]+)\1[^>]*>/i);
+  const url = match?.[2]?.trim();
+  return url ? decodeXmlEntities(url) : null;
+}
+
+async function loadChapterTitles(fetchImpl: typeof fetch, chaptersUrl: string): Promise<string[]> {
+  try {
+    const res = await fetchImpl(chaptersUrl, {
+      redirect: "follow",
+      signal: AbortSignal.timeout(TRANSCRIPTION_TIMEOUT_MS),
+      headers: { accept: "application/json,*/*;q=0.8" },
+    });
+    if (!res.ok) return [];
+    const payload = JSON.parse(await res.text()) as ChapterPayload;
+    if (!Array.isArray(payload.chapters)) return [];
+    return payload.chapters
+      .map((chapter) => chapter?.title)
+      .filter((title): title is string => typeof title === "string" && title.trim().length > 0);
+  } catch {
+    return [];
+  }
+}
+
+/**
+ * Collect Podcasting 2.0 chapter titles for the episodes in a feed. Chapter data is
+ * optional enrichment: feeds without it, or with an unreadable chapters document,
+ * simply contribute no titles.
+ */
+export async function tryFetchChapterTitles({
+  fetchImpl,
+  feedXml,
+  notes,
+}: {
+  fetchImpl: typeof fetch;
+  feedXml: string;
+  notes: string[];
+}): Promise<string[]> {
+  const titles: string[] = [];
+  for (const item of extractFeedItems(feedXml)) {
+    const chaptersUrl = extractPodcastChaptersUrlFromItem(item);
+    if (!chaptersUrl) continue;
+    titles.push(...(await loadChapterTitles(fetchImpl, chaptersUrl)));
+  }
+  if (titles.length > 0) {
+    notes.push(`Loaded ${titles.length} podcast chapter ${titles.length === 1 ? "title" : "titles"}`);
+  }
+  return titles;
+}
