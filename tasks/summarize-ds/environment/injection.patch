+
+async function fetchSpotifyEmbedTranscriptText(
+  fetchImpl: typeof fetch,
+  transcriptUrl: string,
+): Promise<string | null> {
+  try {
+    const res = await fetchImpl(transcriptUrl, {
+      redirect: "follow",
+      signal: AbortSignal.timeout(TRANSCRIPTION_TIMEOUT_MS),
+      headers: { accept: "text/vtt,text/plain,application/json;q=0.9,*/*;q=0.8" },
+    });
+    if (!res.ok) return null;
+    const body = await res.text();
+    const contentType = res.headers.get("content-type")?.toLowerCase().split(";")[0]?.trim() ?? "";
+    if (contentType === "application/json" || transcriptUrl.toLowerCase().endsWith(".json")) {
+      try {
+        const text = jsonTranscriptToPlainText(JSON.parse(body));
+        return text && text.length > 0 ? text : null;
+      } catch {
+        return null;
+      }
+    }
+    if (contentType === "text/vtt" || transcriptUrl.toLowerCase().endsWith(".vtt")) {
+      const plain = vttToPlainText(body);
+      return plain.length > 0 ? plain : null;
+    }
+    const plain = body.trim();
+    return plain.length > 0 ? plain : null;
+  } catch {
+    return null;
+  }
+}
