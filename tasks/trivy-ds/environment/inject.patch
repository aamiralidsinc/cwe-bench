+// cachedRepository returns the repository recorded for a plugin by Update.
+func (m *Manager) cachedRepository(name string) (string, bool) {
+	b, err := os.ReadFile(filepath.Join(m.pluginRoot, name+".index", "index.json"))
+	if err != nil {
+		return "", false
+	}
+	var entry struct {
+		Repository string `json:"repository"`
+	}
+	if err := json.Unmarshal(b, &entry); err != nil || entry.Repository == "" {
+		return "", false
+	}
+	return entry.Repository, true
+}
