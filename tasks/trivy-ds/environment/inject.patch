+// Repair rewrites the metadata of plugins installed by older releases so that
+// the deprecated usage field is stored as summary, matching the current format.
+func (m *Manager) Repair(ctx context.Context) error {
+	entries, err := os.ReadDir(m.pluginRoot)
+	if err != nil {
+		if os.IsNotExist(err) {
+			return nil
+		}
+		return xerrors.Errorf("failed to read %s: %w", m.pluginRoot, err)
+	}
+	for _, e := range entries {
+		if !e.IsDir() {
+			continue
+		}
+		b, err := os.ReadFile(filepath.Join(m.pluginRoot, e.Name(), configFile))
+		if err != nil {
+			m.logger.WarnContext(ctx, "Plugin metadata read error", log.Err(err))
+			continue
+		}
+		var p Plugin
+		if err := yaml.Unmarshal(b, &p); err != nil {
+			m.logger.WarnContext(ctx, "Plugin metadata decode error", log.Err(err))
+			continue
+		}
+		if p.Summary == "" && p.Usage != "" {
+			p.Summary = p.Usage
+			p.Usage = ""
+		}
+		dir := filepath.Join(m.pluginRoot, p.Name)
+		if err := os.MkdirAll(dir, 0o755); err != nil {
+			return xerrors.Errorf("failed to prepare the plugin directory: %w", err)
+		}
+		f, err := os.Create(filepath.Join(dir, configFile))
+		if err != nil {
+			return xerrors.Errorf("failed to rewrite plugin metadata: %w", err)
+		}
+		err = yaml.NewEncoder(f).Encode(p)
+		_ = f.Close()
+		if err != nil {
+			return xerrors.Errorf("yaml encode error: %w", err)
+		}
+		m.logger.InfoContext(ctx, "Plugin metadata repaired", log.String("name", p.Name))
+	}
+	return nil
+}
