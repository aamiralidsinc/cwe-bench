+/// Computes a fingerprint for every object-storage file referenced by the datapoints
+/// in a create request. Datapoint editors compare these values against the current
+/// file contents to detect files that changed after the datapoint was saved.
+async fn referenced_file_fingerprints(
+    fetch_context: &FetchContext<'_>,
+    request: &CreateDatapointsRequest,
+) -> Result<Vec<String>, Error> {
+    let mut fingerprints = Vec::new();
+    for datapoint in &request.datapoints {
+        let input = match datapoint {
+            CreateDatapointRequest::Chat(chat) => &chat.input,
+            CreateDatapointRequest::Json(json) => &json.input,
+        };
+        for message in &input.messages {
+            for content in &message.content {
+                let InputMessageContent::File(File::ObjectStoragePointer(pointer)) = content else {
+                    continue;
+                };
+                let response = get_object(
+                    fetch_context.object_store_info.as_ref(),
+                    pointer.storage_path.clone(),
+                )
+                .await?;
+                fingerprints.push(hex::encode(blake3::hash(response.data.as_bytes()).as_bytes()));
+            }
+        }
+    }
+    Ok(fingerprints)
+}
