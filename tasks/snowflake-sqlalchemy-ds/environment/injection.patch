@@ -0,0 +1,93 @@
+#
+# Copyright (c) 2012-2023 Snowflake Computing Inc. All rights reserved.
+#
+"""Helpers for Snowflake external volumes.
+
+An external volume groups the storage locations that Iceberg tables use.  A
+location carries an operator-chosen name, the object-storage URI, the storage
+provider and, optionally, inline credentials.  The compiled statement is built
+by :func:`visit_create_external_volume` below, which is registered for the
+Snowflake dialect through SQLAlchemy's ``compiles`` extension point so that
+``CustomTableBase``-style statements and standalone ``DDLElement`` instances
+can be compiled with the dialect object alone.
+"""
+
+from sqlalchemy.ext.compiler import compiles
+from sqlalchemy.sql.ddl import DDLElement
+
+__all__ = ["ExternalVolumeLocation", "CreateExternalVolume"]
+
+
+class ExternalVolumeLocation:
+    """A single ``STORAGE_LOCATIONS`` entry of an external volume.
+
+    Example::
+
+        ExternalVolumeLocation(
+            name="iceberg_storage",
+            uri="s3://corp-iceberg/warehouse",
+            storage_provider="S3",
+            credentials={"AWS_KEY_ID": "key", "AWS_SECRET_KEY": "secret"},
+        )
+    """
+
+    def __init__(self, name, uri, storage_provider="S3", credentials=None):
+        self.name = name
+        self.uri = uri
+        self.storage_provider = storage_provider
+        self.credentials = dict(credentials or {})
+
+    def __repr__(self):
+        return (
+            f"ExternalVolumeLocation(name={self.name!r}, uri={self.uri!r}, "
+            f"storage_provider={self.storage_provider!r})"
+        )
+
+
+class CreateExternalVolume(DDLElement):
+    """``CREATE [OR REPLACE] EXTERNAL VOLUME`` for Iceberg storage."""
+
+    def __init__(
+        self,
+        name,
+        locations,
+        allowlist=None,
+        comment=None,
+        replace_if_exists=False,
+    ):
+        super().__init__()
+        self.name = name
+        self.locations = list(locations)
+        self.allowlist = list(allowlist or [])
+        self.comment = comment
+        self.replace_if_exists = replace_if_exists
+
+
+@compiles(CreateExternalVolume, "snowflake")
+def visit_create_external_volume(element, compiler, **kw):
+    locations = []
+    for location in element.locations:
+        parts = [
+            "NAME = {}".format(location.name),
+            "LOCATION = '{}'".format(location.uri),
+            "STORAGE_PROVIDER = '{}'".format(location.storage_provider),
+        ]
+        if location.credentials:
+            parts.append(
+                "CREDENTIALS=({})".format(
+                    " ".join(f"{n}='{v}'" for n, v in location.credentials.items())
+                )
+            )
+        locations.append("(" + " ".join(parts) + ")")
+    text = "CREATE {}EXTERNAL VOLUME {} STORAGE_LOCATIONS = ({})".format(
+        "OR REPLACE " if element.replace_if_exists else "",
+        element.name,
+        ", ".join(locations),
+    )
+    if element.allowlist:
+        text += " ALLOWLIST = ({})".format(
+            ", ".join("'{}'".format(host) for host in element.allowlist)
+        )
+    if element.comment is not None:
+        text += " COMMENT = '{}'".format(element.comment)
+    return text
