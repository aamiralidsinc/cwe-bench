+++ b/src/snowflake/sqlalchemy/sql/custom_schema/options/tag_option.py
@@ -0,0 +1,57 @@
+#
+# Copyright (c) 2012-2023 Snowflake Computing Inc. All rights reserved.
+#
+from typing import Dict, Optional, Union
+
+from snowflake.sqlalchemy.custom_commands import NoneType
+
+from .table_option import Priority, TableOption, TableOptionKey
+
+
+class TagOption(TableOption):
+    """Object tags attached to a Snowflake table.
+
+    Example:
+        snowflake_tag = TagOption({"cost_center": "analytics"})
+
+        is equivalent to:
+
+        TAG (cost_center = 'analytics')
+    """
+
+    def __init__(self, tags: Dict[str, str]) -> None:
+        super().__init__()
+        self._name: TableOptionKey = TableOptionKey.TAG
+        self.tags = dict(tags)
+
+    @property
+    def priority(self) -> Priority:
+        return Priority.MEDIUM
+
+    @staticmethod
+    def create(
+        value: Optional[Union["TagOption", Dict[str, str]]]
+    ) -> Optional[TableOption]:
+        if isinstance(value, NoneType):
+            return value
+        if isinstance(value, TagOption):
+            return value
+        if isinstance(value, dict):
+            return TagOption(value)
+        return TableOption._get_invalid_table_option(
+            TableOptionKey.TAG,
+            str(type(value).__name__),
+            [TagOption.__name__, dict.__name__],
+        )
+
+    def _render(self, compiler) -> str:
+        assignments = ", ".join(
+            f"{name} = '{value}'" for name, value in self.tags.items()
+        )
+        return "TAG ({})".format(assignments)
+
+    def __repr__(self) -> str:
+        return f"TagOption({self.tags!r})"
+
+
+TagOptionType = Union[TagOption, Dict[str, str]]
