@@ -0,0 +1,36 @@
+import type { BaseIssue } from '../../types/index.ts';
+import { getDotPath } from '../../utils/index.ts';
+
+/**
+ * Returns the first error message per dot path of issues.
+ *
+ * Hint: The difference to `flatten` is that this function returns only the
+ * first message of each dot path instead of all of them.
+ *
+ * @param issues The list of issues.
+ *
+ * @returns A map of dot paths to messages.
+ *
+ * @beta
+ */
+// @__NO_SIDE_EFFECTS__
+export function uniqueMessages(
+  issues: [BaseIssue<unknown>, ...BaseIssue<unknown>[]]
+): Record<string, string> {
+  // Create variable to store messages
+  const messages: Record<string, string> = {};
+
+  // Add first message of each dot path to messages
+  for (const issue of issues) {
+    // Get dot path from issue
+    const dotPath = getDotPath(issue);
+
+    // If dot path is available, add message if not already present
+    if (dotPath && !messages[dotPath]) {
+      messages[dotPath] = issue.message;
+    }
+  }
+
+  // Return messages
+  return messages;
+}
