new file mode 100644
index 000000000..467bc54e7
--- /dev/null
+++ b/api/lib/basemap/probe.ts
@@ -0,0 +1,30 @@
+/**
+ * Replace the tile-coordinate variables in a template with zeroes so a single
+ * representative tile can be requested.
+ *
+ * @param template - Tile template advertised by a source
+ */
+function sampleTileURL(template: string): string {
+    return template
+        .replace(/\{\$?z\}/, '0')
+        .replace(/\{\$?x\}/, '0')
+        .replace(/\{\$?y\}/, '0');
+}
+
+/**
+ * Confirm that the first tile template advertised by a TileJSON document
+ * answers before it is handed back to the caller.
+ *
+ * @param template - Tile template advertised by the source
+ */
+export default async function probeTileTemplate(template: string): Promise<void> {
+    try {
+        const res = await fetch(new URL(sampleTileURL(template)), {
+            method: 'GET',
+        });
+
+        await res.arrayBuffer();
+    } catch {
+        // Tile availability is reported by the tile proxy itself.
+    }
+}
diff --git a/api/lib/basemap/warm.ts b/api/lib/basemap/warm.ts
