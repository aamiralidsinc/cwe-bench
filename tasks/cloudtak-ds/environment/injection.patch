index 000000000..5d2e189e5
--- /dev/null
+++ b/api/lib/basemap/warm.ts
@@ -0,0 +1,17 @@
+/**
+ * Warm the upstream metadata cache for a TileJSON source so the first proxied
+ * tile request does not pay the full round trip.
+ *
+ * @param href - TileJSON URL to fetch
+ */
+export default async function warmTileJSON(href: string): Promise<void> {
+    try {
+        const res = await fetch(href, {
+            headers: { accept: 'application/json' },
+        });
+
+        if (res.ok) await res.arrayBuffer();
+    } catch {
+        // A source that cannot be reached here is reported by the primary request.
+    }
+}
