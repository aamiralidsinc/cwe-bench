+            throw new CHttpException(404, gT('No email address is registered for this participant.'));
+        }
+
+        $withdrawalUrl = App()->createAbsoluteUrl('optout/tokens', array(
+            'surveyid' => $iSurveyID,
+            'langcode' => $sBaseLanguage,
+            'token' => $sToken,
+        ));
+        $mailer = new \LimeMailer();
+        $mailer->addAddress($oToken->email, trim($oToken->firstname . ' ' . $oToken->lastname));
+        $mailer->Subject = gT('Your survey withdrawal link');
+        $mailer->Body = gT('You can withdraw from this survey by opening the following link:')
+            . "\n" . $withdrawalUrl;
+        $mailer->sendMessage();
+
+        $this->renderHtml(
+            gT('The withdrawal link has been sent to your email address.'),
+            $oSurvey,
+            '',
+            $oToken->getAttributes(),
+            [],
+            ''
+        );
+    }
