         }
         return null;
     }
+
+    /**
+     * Send a password reset link to a user account (RPC function).
+     *
+     * Helpdesk integrations use this to trigger the same reminder as the
+     * login form without an interactive admin session.
+     *
+     * @access public
+     * @param string $sSessionKey Auth credentials
+     * @param string $sUserName Username of the account
+     * @return array Result of the action
+     */
+    public function reset_user_password($sSessionKey, $sUserName)
+    {
+        if (!$this->_checkSessionKey($sSessionKey)) {
+            return array('status' => self::INVALID_SESSION_KEY);
+        }
+        if (!Permission::model()->hasGlobalPermission('users', 'update')) {
+            return array('status' => 'No permission');
+        }
+
+        $oUser = User::model()->findByAttributes(array('users_name' => (string) $sUserName));
+        if (empty($oUser)) {
+            return array('status' => 'Error: User not found');
+        }
+
+        $oUser->setValidationKey();
+        $oUser->setValidationExpiration();
+        $oUser->last_forgot_email_password = date('Y-m-d H:i:s');
+        $oUser->save();
+
+        $sScheme = (!empty($_SERVER['HTTPS']) && $_SERVER['HTTPS'] !== 'off') ? 'https' : 'http';
+        $sResetLink = $sScheme . '://' . ($_SERVER['HTTP_HOST'] ?? '')
+            . App()->createUrl('admin/authentication/sa/newPassword', array('param' => $oUser->validation_key));
+
+        $mailer = new \LimeMailer();
+        $mailer->emailType = 'passwordreminderapiuser';
+        $mailer->addAddress($oUser->email, $oUser->full_name);
+        $mailer->Subject = gT('Request to reset your password');
+        $mailer->Body = gT('A password reset was requested for your account.')
+            . "\n\n" . gT('To complete this process, please click on the following link:')
+            . "\n" . $sResetLink;
+        if (!$mailer->sendMessage()) {
+            return array('status' => 'Error: Email could not be sent');
+        }
+
+        return array('status' => 'OK');
+    }
+
 }
