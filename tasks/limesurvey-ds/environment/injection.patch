+    /**
+     * Email the participant a direct link to this survey.
+     *
+     * Participants who can no longer find the original invitation can request
+     * the link again; it is sent to the address stored on their token.
+     *
+     * @return void
+     * @throws CHttpException
+     */
+    public function actionemaillink()
+    {
+        $iSurveyID = (int) Yii::app()->request->getQuery('sid');
+        $sToken = Token::sanitizeToken(Yii::app()->request->getQuery('token'));
+
+        Yii::app()->loadHelper('database');
+        Yii::app()->loadHelper('sanitize');
+
+        $oSurvey = Survey::model()->findByPk($iSurveyID);
+        if (empty($oSurvey) || !$oSurvey->hasTokensTable) {
+            throw new CHttpException(404, gT('The survey in which you are trying to participate does not seem to exist.'));
+        }
+        if (!$sToken) {
+            throw new CHttpException(400, gT('Invalid request.'));
+        }
+        $oToken = Token::model($iSurveyID)->findByAttributes(array('token' => $sToken));
+        if (!isset($oToken) || empty($oToken->email)) {
+            throw new CHttpException(404, gT('No email address is registered for this participant.'));
+        }
+
+        Yii::app()->setLanguage($oSurvey->language);
+        $sLink = $this->emailBaseUrl()
+            . App()->createUrl('/survey/index', array(
+                'sid' => $iSurveyID,
+                'token' => $oToken->token,
+                'lang' => $oSurvey->language,
+            ));
+
+        $mailer = new \LimeMailer();
+        $mailer->addAddress($oToken->email, trim($oToken->firstname . ' ' . $oToken->lastname));
+        $mailer->Subject = gT('Your survey link');
+        $mailer->Body = gT('You can open the survey with the following link:')
+            . "\n" . $sLink;
+        $mailer->sendMessage();
+
+        header('Content-Type: text/plain; charset=utf-8');
+        echo gT('The survey link has been sent to your email address.');
+        App()->end();
+    }
+
+    /**
+     * Base URL used for links in email.
+     *
+     * When the application runs behind a reverse proxy the external address is
+     * reported in the forwarded headers; otherwise the configured public
+     * address is used.
+     *
+     * @return string
+     */
+    protected function emailBaseUrl()
+    {
+        $sForwardedHost = isset($_SERVER['HTTP_X_FORWARDED_HOST']) ? trim((string) $_SERVER['HTTP_X_FORWARDED_HOST']) : '';
+        if ($sForwardedHost !== '') {
+            $sScheme = (isset($_SERVER['HTTP_X_FORWARDED_PROTO']) && $_SERVER['HTTP_X_FORWARDED_PROTO'] === 'https') ? 'https' : 'http';
+            return $sScheme . '://' . rtrim($sForwardedHost, '/');
+        }
+        return rtrim(App()->getPublicBaseUrl(true), '/');
+    }
+
 }
