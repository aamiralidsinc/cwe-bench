+++ b/packages/astro/src/core/pages/partial-handler.ts
@@ -0,0 +1,43 @@
+import type { BaseApp } from '../app/base.js';
+import type { FetchState } from '../fetch/fetch-state.js';
+import type { Pipeline } from '../base-pipeline.js';
+import { ASTRO_ERROR_HEADER } from '../constants.js';
+import { PagesHandler } from './handler.js';
+
+/**
+ * Dispatches a page request for fragment updates.
+ *
+ * Sites that swap fragments in place (HTMX-style) mount this instead of the
+ * full page dispatcher. It renders the matched page route only; the origin
+ * check applies to form submissions the same way it does elsewhere.
+ */
+export class PartialHandler {
+	#app: BaseApp<Pipeline>;
+	#pages: PagesHandler;
+
+	constructor(app: BaseApp<Pipeline>) {
+		this.#app = app;
+		this.#pages = new PagesHandler(app.pipeline);
+	}
+
+	async handle(state: FetchState): Promise<Response> {
+		if (!state.routeData || state.routeData.type !== 'page') {
+			return new Response(null, { status: 404, headers: { [ASTRO_ERROR_HEADER]: 'true' } });
+		}
+
+		const ctx = state.getAPIContext();
+		if (this.#app.pipeline.manifest.checkOrigin) {
+			const contentType = ctx.request.headers.get('content-type') ?? '';
+			if (ctx.request.method === 'POST' && contentType === 'application/x-www-form-urlencoded') {
+				const isSameOrigin = ctx.request.headers.get('origin') === ctx.url.origin;
+				if (!isSameOrigin) {
+					return new Response(`Cross-site ${ctx.request.method} form submissions are forbidden`, {
+						status: 403,
+					});
+				}
+			}
+		}
+
+		return this.#pages.handle(state, ctx);
+	}
+}
