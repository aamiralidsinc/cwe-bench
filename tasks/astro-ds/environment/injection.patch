+import type { APIContext } from '../types/public/context.js';
+import { PipelineFeatures } from '../core/base-pipeline.js';
+import type { FetchState } from '../core/fetch/fetch-state.js';
+import { getActionContext, serializeActionResult } from './runtime/server.js';
+
+/**
+ * Runs a form action for hosts that render pages themselves.
+ *
+ * RPC actions answer the request directly and are therefore left to the
+ * regular action dispatch. Form actions (`?_action=<name>` on a page route)
+ * store their result for the page that renders afterwards; this handler runs
+ * that action and leaves the response to the caller. Non-form requests are a
+ * no-op.
+ */
+export class FormActionHandler {
+	handle(apiContext: APIContext, state: FetchState): Promise<Response | undefined> | undefined {
+		state.pipeline.usedFeatures |= PipelineFeatures.actions;
+		if (apiContext.isPrerendered) {
+			return undefined;
+		}
+
+		const { action, setActionResult } = getActionContext(apiContext);
+		if (!action || action.calledFrom !== 'form') {
+			return undefined;
+		}
+
+		return this.#runFormAction(action, setActionResult);
+	}
+
+	async #runFormAction(
+		action: NonNullable<ReturnType<typeof getActionContext>['action']>,
+		setActionResult: ReturnType<typeof getActionContext>['setActionResult'],
+	): Promise<undefined> {
+		const actionResult = await action.handler();
+		setActionResult(action.name, serializeActionResult(actionResult));
+		return undefined;
+	}
+}
