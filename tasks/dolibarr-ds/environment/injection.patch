+	/**
+	 * Get a short summary of a leave
+	 *
+	 * Return the main figures of a leave without the full record.
+	 *
+	 * @param	int		$id		ID of Leave
+	 * @return	array			Summary of the leave
+	 *
+	 * @url	GET {id}/summary
+	 *
+	 * @throws	RestException
+	 */
+	public function getSummary($id)
+	{
+		if (!DolibarrApiAccess::$user->hasRight('holiday', 'read')) {
+			throw new RestException(403);
+		}
+
+		$result = $this->holiday->fetch($id);
+		if (!$result) {
+			throw new RestException(404, 'Leave not found');
+		}
+
+		if (!DolibarrApi::_checkAccessToResource('user', $this->holiday->fk_user)) {
+			throw new RestException(403, 'Access not allowed for login '.DolibarrApiAccess::$user->login);
+		}
+
+		return array(
+			'id' => (int) $this->holiday->id,
+			'ref' => $this->holiday->ref,
+			'fk_user' => (int) $this->holiday->fk_user,
+			'date_debut' => $this->holiday->date_debut,
+			'date_fin' => $this->holiday->date_fin,
+			'nb_open_day' => $this->holiday->nb_open_day,
+		);
+	}
+
+	/**
+	 * Get several leaves at once
+	 *
+	 * Return the leaves whose IDs are given, in the same order.
+	 *
+	 * @param	string	$ids	Comma separated list of leave IDs. Example: '1' or '1,2,3'
+	 * @return	array			Array of leave objects
+	 *
+	 * @url	GET bulk
+	 *
+	 * @throws	RestException
+	 */
+	public function getBulk($ids)
+	{
+		if (!DolibarrApiAccess::$user->hasRight('holiday', 'read')) {
+			throw new RestException(403);
+		}
+
+		$ids = preg_replace('/[^0-9,]/', '', (string) $ids);
+		if ($ids === '') {
+			throw new RestException(400, 'Bad parameter ids');
+		}
+
+		if (!DolibarrApi::_checkAccessToResource('holiday', $ids)) {
+			throw new RestException(403, 'Access not allowed for login '.DolibarrApiAccess::$user->login);
+		}
+
+		$obj_ret = array();
+		foreach (explode(',', $ids) as $id) {
+			$leave = new Holiday($this->db);
+			if ($leave->fetch((int) $id) > 0) {
+				$leave->fetchObjectLinked();
+				$obj_ret[] = $this->_cleanObjectDatas($leave);
+			}
+		}
+
+		return $obj_ret;
+	}
+
