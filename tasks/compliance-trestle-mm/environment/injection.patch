+def _sample_folder_name_allowed(name: str) -> bool:
+    """Whether a name given to a sample folder is allowed.
+
+    A sample folder is an ordinary folder inside the task, so its name must not land on one of
+    the OSCAL model directories the project reserves at the root of the workspace.
+    """
+    pathed_name = pathlib.Path(name)
+    if not pathed_name.parts:
+        logger.warning('Sample folder name must not be empty.')
+        return False
+    if pathed_name.parts[0] in const.MODEL_TYPE_TO_MODEL_DIR.values():
+        logger.warning('Sample folder name is the same as an OSCAL schema name.')
+        return False
+    return True
+
+
