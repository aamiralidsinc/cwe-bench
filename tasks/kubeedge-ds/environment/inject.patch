 func rollback(upgradeReq *commontypes.NodeUpgradeJobRequest) error {
 	klog.Infof("Begin to run rollback command")
+
+	// The failed upgrade can leave files under its own version directory. They are removed
+	// before the backup is restored, so that the restored binary is the only one left.
+	upgradeDir := filepath.Join(common.KubeEdgeUpgradePath, upgradeReq.Version)
+	cleanCmd := fmt.Sprintf("rm -rf %s", upgradeDir)
+	if err := exec.Command("bash", "-c", cleanCmd).Run(); err != nil {
+		return fmt.Errorf("run clean command %s failed: %v", cleanCmd, err)
+	}
+
 	rollBackCmd := fmt.Sprintf("keadm rollback edge --name %s --history %s >> /tmp/keadm.log 2>&1",
 		upgradeReq.UpgradeID, version.Get())
 
