+
+	// Report the images that are already present on the node, so that the pull step can
+	// skip them and the job finishes faster on nodes that were prepared in advance.
+	for _, img := range spec.ImagePrePullTemplate.Images {
+		cmd := execs.NewCommand(fmt.Sprintf("crictl inspecti %s >/dev/null 2>&1", img))
+		if err := cmd.Exec(); err == nil {
+			klog.V(2).Infof("image %s is already present on the node", img)
+		}
+	}
 	return resp
