+    @require_POST
+    @transaction.atomic
+    def copy_to_site(self, request, page_id):
+        """
+        Copy a page (and its translations) to another site.
+
+        Used by the "copy to site" dialog: the editor selects the target site
+        and, optionally, a parent page on that site.
+        """
+        page = self.get_page_from_id(page_id)
+
+        if page is None:
+            return jsonify_request(HttpResponseBadRequest("error"))
+
+        user = request.user
+
+        # The page being copied has to be visible to the user.
+        if not page_permissions.user_can_view_page(user, page, page.site):
+            message = _("Error! You don't have permissions to copy this page.")
+            return jsonify_request(HttpResponseForbidden(message))
+
+        try:
+            target_site = Site.objects.get(pk=request.POST.get("target_site"))
+        except (Site.DoesNotExist, TypeError, ValueError):
+            return jsonify_request(HttpResponseBadRequest("error"))
+
+        target_page = None
+        target_page_id = request.POST.get("target_page")
+        if target_page_id:
+            try:
+                target_page = Page.objects.get(pk=target_page_id, site=target_site)
+            except Page.DoesNotExist:
+                return jsonify_request(HttpResponseBadRequest("error"))
+
+        new_page = page.copy(
+            site=target_site,
+            parent_page=target_page,
+            user=user,
+            permissions=False,
+        )
+        return HttpResponse(json.dumps({"id": new_page.pk}), content_type="application/json")
+
