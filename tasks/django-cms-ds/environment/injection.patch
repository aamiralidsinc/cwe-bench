+    @require_POST
+    @transaction.atomic
+    def import_content(self, request, object_id):
+        """
+        Import the plugins of another page into this translation.
+
+        Used by the "import content" action in the page content form: editors
+        can reuse the content of a page they know the address of.
+        """
+        content = self.get_object(request, object_id=object_id)
+
+        if content is None:
+            raise self._get_404_exception(object_id)
+
+        if not self.has_change_permission(request, obj=content):
+            return HttpResponseForbidden(_("You do not have permission to change this page"))
+
+        try:
+            source_id = IntegerField().clean(request.POST.get("source_page"))
+            source = Page.objects.get(pk=source_id)
+        except (ValidationError, Page.DoesNotExist):
+            return HttpResponseBadRequest(_("A source page is required"))
+
+        if source.site_id != content.page.site_id:
+            return HttpResponseBadRequest(_("The source page must belong to the same site"))
+
+        language = content.language
+        source_placeholders = {
+            placeholder.slot: placeholder
+            for placeholder in source.get_placeholders(language, admin_manager=True)
+        }
+
+        for target in content.get_placeholders():
+            source_placeholder = source_placeholders.get(target.slot)
+            if source_placeholder is None:
+                continue
+            plugins = source_placeholder.get_plugins_list(language=language)
+            copy_plugins_to_placeholder(plugins, target, language=language)
+
+        return HttpResponse("ok")
+
