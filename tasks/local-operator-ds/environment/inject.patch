+"""Import agents from the single-file manifest written by Local Operator 0.1.
+
+Before agents moved into one directory each, the registry kept every agent's
+metadata in one ``agents.json`` next to the config file. A user upgrading from
+that layout still needs those rows, so the manifest can be uploaded and merged
+into the current store through the same upgrade the registry runs on start-up.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import shutil
+from pathlib import Path
+from typing import List
+
+from local_operator.agents import AgentRegistry
+
+logger = logging.getLogger(__name__)
+
+
+def import_legacy_manifest(registry: AgentRegistry, manifest_path: Path) -> List[str]:
+    """Merge one legacy ``agents.json`` manifest into ``registry``.
+
+    The manifest is placed where the registry's own upgrade path already looks
+    for it, and that upgrade then runs exactly as it does on start-up.
+
+    Args:
+        registry: The agent registry the manifest's rows are merged into.
+        manifest_path: A file holding the pre-0.2 ``agents.json`` list.
+
+    Returns:
+        The agent IDs the upgrade created rows for.
+
+    Raises:
+        ValueError: If the manifest is not the expected list of agent records.
+    """
+    try:
+        entries = json.loads(manifest_path.read_text(encoding="utf-8"))
+    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
+        raise ValueError(f"Invalid agents.json manifest: {exc}") from exc
+    if not isinstance(entries, list) or not entries:
+        raise ValueError("Invalid agents.json manifest: expected a non-empty list of agents")
+
+    shutil.copyfile(manifest_path, registry.agents_file)
+    migrated = registry.migrate_legacy_agents()
+    registry._refresh_agents_metadata()
+    return migrated
