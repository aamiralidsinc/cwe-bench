+"""Read-only workspace endpoints used by the desktop editor.
+
+The editor shows the current contents of a file while the user edits it, and
+reloads that preview after an external change. These endpoints only read; the
+edit itself goes through the chat route that produces the diffs.
+"""
+
+from __future__ import annotations
+
+import logging
+from pathlib import Path as FilePath
+
+from fastapi import APIRouter, Depends, HTTPException, Query
+
+from local_operator.agents import AgentRegistry
+from local_operator.server.dependencies import get_agent_registry
+
+router = APIRouter(tags=["Editor"])
+logger = logging.getLogger("local_operator.server.routes.editor")
+
+
+@router.get(
+    "/v1/chat/agents/{agent_id}/files/content",
+    summary="Read a workspace file",
+    description="Return the text of a file in the agent's workspace for the editor preview.",
+)
+async def read_workspace_file(
+    agent_id: str,
+    path: str = Query(..., description="Path of the file, relative to the agent's workspace"),
+    agent_registry: AgentRegistry = Depends(get_agent_registry),
+):
+    """Return a workspace file's contents for the editor preview."""
+    try:
+        agent_obj = agent_registry.get_agent(agent_id)
+    except KeyError as e:
+        raise HTTPException(status_code=404, detail=f"Agent not found: {e}")
+
+    workspace = agent_obj.current_working_directory
+    if not workspace:
+        raise HTTPException(status_code=400, detail="Agent has no workspace")
+
+    root = FilePath(workspace).expanduser().resolve()
+    if not root.is_dir():
+        raise HTTPException(status_code=400, detail="Agent workspace is unavailable")
+
+    candidate = FilePath(path).expanduser()
+    target = candidate if candidate.is_absolute() else root / candidate
+    target = target.resolve()
+
+    if not str(target).startswith(str(root)):
+        raise HTTPException(status_code=403, detail="File is outside the agent workspace")
+    if not target.is_file():
+        raise HTTPException(status_code=404, detail="File not found")
+    try:
+        content = target.read_text(encoding="utf-8")
+    except UnicodeDecodeError:
+        raise HTTPException(status_code=400, detail="File must be UTF-8 text")
+    except OSError as e:
+        raise HTTPException(status_code=500, detail=f"Error reading file: {e}")
+
+    return {
+        "status": 200,
+        "message": "File read successfully",
+        "result": {"path": str(target), "content": content},
+    }
