+"""Install a profile that was shared as a JSON document.
+
+The Radient hub, the desktop's "Share profile" action and the clipboard all
+carry a profile as one JSON document: the same payload as an ``agent.yml``,
+with the instruction body inline instead of a separate file. Installing the
+document writes an ordinary registry row, so a shared profile behaves exactly
+like one the operator wrote locally.
+"""
+
+from __future__ import annotations
+
+import logging
+import shutil
+import uuid
+from typing import List, Optional
+
+import yaml
+from pydantic import BaseModel, Field
+
+from local_operator.agents import AgentData, AgentRegistry
+from local_operator.paths import default_agent_cwd
+
+logger = logging.getLogger(__name__)
+
+
+class SharedProfile(BaseModel):
+    """One agent profile as it travels between installations."""
+
+    id: str = Field(..., description="Identity the profile has where it is shared.")
+    name: str = Field(..., description="Display name of the profile.")
+    created_date: str = Field(..., description="When the profile was created where it is shared.")
+    version: str = Field("", description="Product version that wrote the document.")
+    description: str = Field("", description="What the profile is for.")
+    security_prompt: str = Field("", description="Safety instructions for the profile.")
+    system_prompt: str = Field("", description="Instruction body installed as system_prompt.md.")
+    tags: List[str] = Field(default_factory=list, description="Tags carried by the profile.")
+    categories: List[str] = Field(
+        default_factory=list, description="Categories carried by the profile."
+    )
+    current_working_directory: Optional[str] = Field(
+        None, description="Workspace the profile was shared with, if any."
+    )
+
+
+def install_shared_profile(registry: AgentRegistry, shared: SharedProfile) -> AgentData:
+    """Install one shared profile document as a new local agent row.
+
+    The row is stored in a directory of its own so installing a profile can
+    never replace files that are already in the registry. The identity the
+    profile travels with is kept on the row, so a profile that is shared back
+    and re-installed keeps the same identity everywhere.
+    """
+    profile = AgentData.model_validate(
+        {
+            "id": shared.id,
+            "name": shared.name,
+            "created_date": shared.created_date,
+            "version": shared.version,
+            "description": shared.description,
+            "security_prompt": shared.security_prompt,
+            "tags": shared.tags,
+            "categories": shared.categories,
+            "current_working_directory": shared.current_working_directory or default_agent_cwd(),
+        }
+    )
+
+    row_id = str(uuid.uuid4())
+    destination = registry.agents_dir / row_id
+    destination.mkdir(mode=0o700)
+    try:
+        # The row keeps the document the profile was shared as, so it can be
+        # re-shared or inspected without rebuilding it from the local row.
+        with (destination / "agent.yml").open("w", encoding="utf-8") as handle:
+            yaml.safe_dump(shared.model_dump(exclude_none=True), handle, default_flow_style=False)
+        (destination / "system_prompt.md").write_text(shared.system_prompt, encoding="utf-8")
+        for filename in (
+            "conversation.jsonl",
+            "execution_history.jsonl",
+            "learnings.jsonl",
+            "schedules.jsonl",
+        ):
+            (destination / filename).touch()
+    except Exception:
+        shutil.rmtree(destination, ignore_errors=True)
+        raise
+
+    registry._refresh_agents_metadata()
+    return profile
