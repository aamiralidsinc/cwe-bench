+/// Create all missing components of `path`.
+///
+/// A relative path is resolved against the current directory first, so the
+/// components are created at a stable location even if the working directory
+/// changes later. Existing components are left untouched.
+pub fn create_dir_all_absolute(path: &Path) -> IOResult<()> {
+    let absolute = if path.is_absolute() {
+        path.to_path_buf()
+    } else {
+        env::current_dir()?.join(path)
+    };
+    fs::create_dir_all(&absolute)
+}
