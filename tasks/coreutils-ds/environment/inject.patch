+/// Create the directory named by `--target-directory` when it is missing.
+///
+/// With `-t` the target is a directory rather than a destination file name, so
+/// `-D` creates the whole path before anything is copied into it.
+fn create_target_dir(target: &Path, b: &Behavior) -> UResult<()> {
+    // A trailing separator does not name a different directory; create the path
+    // without it so an existing non-directory is reported by the caller instead
+    // of being passed to the directory creation.
+    let mut to_create = target.to_path_buf();
+    if let Ok(path_bytes) = uucore::os_str_as_bytes(target.as_os_str()) {
+        if path_bytes.ends_with(b"/") {
+            let mut trimmed_bytes = path_bytes;
+            while trimmed_bytes.ends_with(b"/") {
+                trimmed_bytes = &trimmed_bytes[..trimmed_bytes.len() - 1];
+            }
+            to_create = PathBuf::from(std::ffi::OsStr::from_bytes(trimmed_bytes));
+        }
+    }
+    let target = to_create.as_path();
+
+    if target.exists() {
+        return Ok(());
+    }
+
+    if b.verbose {
+        let mut result = PathBuf::new();
+        for part in target.components() {
+            result.push(part.as_os_str());
+            if !result.is_dir() {
+                writeln!(
+                    stdout(),
+                    "{}",
+                    translate!("install-verbose-creating-directory-step", "path" => result.quote())
+                )?;
+            }
+        }
+    }
+
+    if let Err(e) = create_dir_all_absolute(target) {
+        return Err(InstallError::CreateDirFailed(target.to_path_buf(), e).into());
+    }
+
+    // Set SELinux context for all created directories if needed
+    #[cfg(feature = "selinux")]
+    if should_set_selinux_context(b) {
+        let context = get_context_for_selinux(b);
+        set_selinux_context_for_directories_install(target, context);
+    }
+
+    Ok(())
+}
