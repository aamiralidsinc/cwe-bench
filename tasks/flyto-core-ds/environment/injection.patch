+# Copyright 2026 Flyto2. Licensed under Apache-2.0. See LICENSE.
+
+"""
+Image Thumbnail Module
+Create a scaled-down thumbnail for an image.
+"""
+import asyncio
+import logging
+import os
+from typing import Any, Dict
+
+from ...registry import register_module
+from ...schema import compose
+from ...schema.builders import field
+from ...schema.constants import FieldGroup
+from ...errors import ModuleError
+from ....utils import validate_path_with_env_config, PathTraversalError
+
+
+logger = logging.getLogger(__name__)
+
+
+def _thumbnail_stem(input_path: str, name) -> str:
+    if name:
+        return str(name)
+    return os.path.splitext(os.path.basename(input_path))[0] + '-thumb'
+
+
+def _render_thumbnail(input_path: str, target: str, size: int) -> None:
+    from PIL import Image
+
+    with Image.open(input_path) as img:
+        if img.mode not in ('RGB', 'RGBA'):
+            img = img.convert('RGBA')
+        img.thumbnail((size, size))
+        img.save(target, 'PNG')
+
+
+@register_module(
+    module_id='image.thumbnail',
+    version='1.0.0',
+    category='image',
+    subcategory='resize',
+    tags=['image', 'thumbnail', 'preview', 'resize', 'path_restricted'],
+    label='Create Thumbnail',
+    label_key='modules.image.thumbnail.label',
+    description='Create a scaled-down thumbnail image in an output directory',
+    description_key='modules.image.thumbnail.description',
+    icon='Image',
+    color='#0EA5E9',
+
+    input_types=['file_path'],
+    output_types=['file_path'],
+
+    can_connect_to=['image.*', 'file.*', 'flow.*'],
+    can_receive_from=['image.*', 'file.*', 'flow.*', 'start'],
+
+    timeout_ms=30000,
+    retryable=False,
+    concurrent_safe=True,
+
+    requires_credentials=False,
+    handles_sensitive_data=False,
+    required_permissions=['filesystem.read', 'filesystem.write'],
+
+    params_schema=compose(
+        field(
+            'input_path',
+            type='string',
+            label='Input Path',
+            label_key='modules.image.thumbnail.params.input_path.label',
+            description='Path to the source image',
+            description_key='modules.image.thumbnail.params.input_path.description',
+            required=True,
+            placeholder='/path/to/image.png',
+            group=FieldGroup.BASIC,
+            format='path',
+        ),
+        field(
+            'output_dir',
+            type='string',
+            label='Output Directory',
+            label_key='modules.image.thumbnail.params.output_dir.label',
+            description='Directory that receives the thumbnail',
+            description_key='modules.image.thumbnail.params.output_dir.description',
+            required=False,
+            default='/tmp',
+            placeholder='/path/to/thumbnails',
+            group=FieldGroup.BASIC,
+            format='path',
+        ),
+        field(
+            'name',
+            type='string',
+            label='Thumbnail Name',
+            label_key='modules.image.thumbnail.params.name.label',
+            description='Base name for the thumbnail (defaults to the input file name)',
+            description_key='modules.image.thumbnail.params.name.description',
+            required=False,
+            placeholder='preview',
+            group=FieldGroup.OPTIONS,
+        ),
+        field(
+            'size',
+            type='number',
+            label='Size',
+            label_key='modules.image.thumbnail.params.size.label',
+            description='Longest edge of the thumbnail in pixels',
+            description_key='modules.image.thumbnail.params.size.description',
+            required=False,
+            default=256,
+            group=FieldGroup.OPTIONS,
+        ),
+    ),
+    output_schema={
+        'path': {
+            'type': 'string',
+            'description': 'Path to the generated thumbnail',
+            'description_key': 'modules.image.thumbnail.output.path.description',
+        },
+        'width': {
+            'type': 'number',
+            'description': 'Thumbnail width in pixels',
+            'description_key': 'modules.image.thumbnail.output.width.description',
+        },
+        'height': {
+            'type': 'number',
+            'description': 'Thumbnail height in pixels',
+            'description_key': 'modules.image.thumbnail.output.height.description',
+        },
+    },
+    examples=[
+        {
+            'title': 'Thumbnail next to the source image',
+            'title_key': 'modules.image.thumbnail.examples.basic.title',
+            'params': {
+                'input_path': '/path/to/image.png',
+                'output_dir': '/path/to/thumbnails',
+            },
+        },
+        {
+            'title': 'Named thumbnail',
+            'title_key': 'modules.image.thumbnail.examples.named.title',
+            'params': {
+                'input_path': '/path/to/image.png',
+                'output_dir': '/path/to/thumbnails',
+                'name': 'cover',
+                'size': 128,
+            },
+        },
+    ],
+    author='Flyto Team',
+    license='MIT',
+)
+async def image_thumbnail(context: Dict[str, Any]) -> Dict[str, Any]:
+    """Create a thumbnail from an image."""
+    params = context['params']
+    input_path = params['input_path']
+    output_dir = params.get('output_dir', '/tmp')
+    name = params.get('name')
+    size = int(params.get('size', 256))
+
+    if not os.path.exists(input_path):
+        raise FileNotFoundError(f"Input file not found: {input_path}")
+    if size < 1:
+        raise ValueError("size must be positive")
+
+    try:
+        safe_dir = validate_path_with_env_config(output_dir)
+    except PathTraversalError as e:
+        raise ModuleError(str(e), code="PATH_TRAVERSAL")
+
+    os.makedirs(safe_dir, exist_ok=True)
+    stem = _thumbnail_stem(input_path, name)
+    target = os.path.join(safe_dir, f'{stem}.png')
+
+    await asyncio.to_thread(_render_thumbnail, input_path, target, size)
+
+    from PIL import Image
+    with Image.open(target) as thumb:
+        width, height = thumb.size
+
+    logger.info(f"Created thumbnail: {target}")
+    return {
+        'ok': True,
+        'path': target,
+        'width': width,
+        'height': height,
+    }
