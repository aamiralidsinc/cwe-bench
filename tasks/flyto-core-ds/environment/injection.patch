--- a/src/core/modules/atomic/document/pdf_metadata.py	1970-01-01 00:00:00.000000000 +0000
+++ b/src/core/modules/atomic/document/pdf_metadata.py	2026-10-18 19:14:13.922115708 +0000
@@ -0,0 +1,230 @@
+# Copyright 2026 Flyto2. Licensed under Apache-2.0. See LICENSE.
+
+"""
+PDF Metadata Module
+Write document metadata onto a PDF.
+"""
+import asyncio
+import logging
+import os
+import shutil
+from typing import Any, Dict
+
+from ...base import BaseModule
+from ...registry import register_module
+from ...schema import compose
+from ...schema.builders import field
+from ...schema.constants import FieldGroup
+from ...errors import ModuleError
+from ....utils import validate_path_with_env_config, PathTraversalError
+
+
+logger = logging.getLogger(__name__)
+
+
+def _resolve_metadata_output(input_path: str, output_path):
+    if output_path:
+        return output_path
+    base, ext = os.path.splitext(input_path)
+    return f"{base}_meta{ext or '.pdf'}"
+
+
+def _write_pdf_with_metadata(input_path: str, output_path: str, metadata: Dict[str, Any]) -> None:
+    from pypdf import PdfReader, PdfWriter
+
+    reader = PdfReader(input_path)
+    writer = PdfWriter()
+    for page in reader.pages:
+        writer.add_page(page)
+
+    entries = {}
+    for key, value in metadata.items():
+        name = str(key)
+        if not name.startswith('/'):
+            name = '/' + name
+        entries[name] = str(value)
+    if entries:
+        writer.add_metadata(entries)
+
+    with open(output_path, 'wb') as handle:
+        writer.write(handle)
+
+
+@register_module(
+    module_id='document.pdf_metadata',
+    version='1.0.0',
+    category='document',
+    subcategory='pdf',
+    tags=['pdf', 'metadata', 'document', 'path_restricted'],
+    label='Set PDF Metadata',
+    label_key='modules.document.pdf_metadata.label',
+    description='Write document metadata onto a PDF',
+    description_key='modules.document.pdf_metadata.description',
+    icon='FileText',
+    color='#DC2626',
+
+    input_types=['file_path'],
+    output_types=['file_path'],
+
+    can_connect_to=['document.*', 'file.*', 'flow.*'],
+    can_receive_from=['document.*', 'file.*', 'flow.*', 'start'],
+
+    timeout_ms=60000,
+    retryable=False,
+    concurrent_safe=True,
+
+    requires_credentials=False,
+    handles_sensitive_data=False,
+    required_permissions=['filesystem.read', 'filesystem.write'],
+
+    params_schema=compose(
+        field(
+            'input_path',
+            type='string',
+            label='Input PDF',
+            label_key='modules.document.pdf_metadata.params.input_path.label',
+            description='Path to the source PDF',
+            description_key='modules.document.pdf_metadata.params.input_path.description',
+            required=True,
+            placeholder='/path/to/document.pdf',
+            group=FieldGroup.BASIC,
+            format='path',
+        ),
+        field(
+            'output_path',
+            type='string',
+            label='Output Path',
+            label_key='modules.document.pdf_metadata.params.output_path.label',
+            description='Path for the updated PDF (defaults beside the input)',
+            description_key='modules.document.pdf_metadata.params.output_path.description',
+            required=False,
+            placeholder='/path/to/document_meta.pdf',
+            group=FieldGroup.BASIC,
+            format='path',
+        ),
+        field(
+            'metadata',
+            type='object',
+            label='Metadata',
+            label_key='modules.document.pdf_metadata.params.metadata.label',
+            description='Metadata entries to write (for example Title, Author)',
+            description_key='modules.document.pdf_metadata.params.metadata.description',
+            required=False,
+            default={},
+            group=FieldGroup.OPTIONS,
+        ),
+        field(
+            'keep_backup',
+            type='boolean',
+            label='Keep Backup',
+            label_key='modules.document.pdf_metadata.params.keep_backup.label',
+            description='Copy the original PDF to backup_path before writing the result',
+            description_key='modules.document.pdf_metadata.params.keep_backup.description',
+            required=False,
+            default=False,
+            group=FieldGroup.OPTIONS,
+        ),
+        field(
+            'backup_path',
+            type='string',
+            label='Backup Path',
+            label_key='modules.document.pdf_metadata.params.backup_path.label',
+            description='Destination for the original PDF when keep_backup is enabled',
+            description_key='modules.document.pdf_metadata.params.backup_path.description',
+            required=False,
+            placeholder='/path/to/document.original.pdf',
+            group=FieldGroup.OPTIONS,
+            format='path',
+        ),
+    ),
+    output_schema={
+        'path': {
+            'type': 'string',
+            'description': 'Path to the updated PDF',
+            'description_key': 'modules.document.pdf_metadata.output.path.description',
+        },
+        'backup_path': {
+            'type': 'string',
+            'description': 'Path to the saved original, when a backup was requested',
+            'description_key': 'modules.document.pdf_metadata.output.backup_path.description',
+        },
+        'written_keys': {
+            'type': 'number',
+            'description': 'Number of metadata entries written',
+            'description_key': 'modules.document.pdf_metadata.output.written_keys.description',
+        },
+    },
+    examples=[
+        {
+            'title': 'Set title metadata',
+            'title_key': 'modules.document.pdf_metadata.examples.basic.title',
+            'params': {
+                'input_path': '/path/to/document.pdf',
+                'output_path': '/path/to/labeled.pdf',
+                'metadata': {'Title': 'Quarterly report'},
+            },
+        },
+        {
+            'title': 'Keep the original beside the result',
+            'title_key': 'modules.document.pdf_metadata.examples.backup.title',
+            'params': {
+                'input_path': '/path/to/document.pdf',
+                'output_path': '/path/to/labeled.pdf',
+                'keep_backup': True,
+                'backup_path': '/path/to/document.original.pdf',
+            },
+        },
+    ],
+    author='Flyto Team',
+    license='MIT',
+)
+class PdfMetadataModule(BaseModule):
+    """Write document metadata onto a PDF."""
+
+    module_name = "Set PDF Metadata"
+    module_description = "Write document metadata onto a PDF"
+
+    def validate_params(self) -> None:
+        self.input_path = self.params.get('input_path')
+        self.output_path = self.params.get('output_path')
+        self.metadata = self.params.get('metadata') or {}
+        self.keep_backup = self.params.get('keep_backup', False)
+        self.backup_path = self.params.get('backup_path')
+
+        if not self.input_path:
+            raise ValueError("input_path is required")
+        if not isinstance(self.metadata, dict):
+            raise ValueError("metadata must be an object")
+        if self.keep_backup and not self.backup_path:
+            raise ValueError("backup_path is required when keep_backup is true")
+
+    async def execute(self) -> Dict[str, Any]:
+        if not os.path.exists(self.input_path):
+            raise FileNotFoundError(f"PDF file not found: {self.input_path}")
+
+        output_path = _resolve_metadata_output(self.input_path, self.output_path)
+        try:
+            output_path = validate_path_with_env_config(output_path)
+        except PathTraversalError as e:
+            raise ModuleError(str(e), code="PATH_TRAVERSAL")
+
+        if self.keep_backup:
+            backup_dir = os.path.dirname(self.backup_path)
+            if backup_dir and not os.path.exists(backup_dir):
+                os.makedirs(backup_dir, exist_ok=True)
+            shutil.copy2(self.input_path, self.backup_path)
+
+        output_dir = os.path.dirname(output_path)
+        if output_dir and not os.path.exists(output_dir):
+            os.makedirs(output_dir, exist_ok=True)
+
+        await asyncio.to_thread(
+            _write_pdf_with_metadata, self.input_path, output_path, self.metadata
+        )
+
+        return {
+            'ok': True,
+            'path': output_path,
+            'backup_path': self.backup_path if self.keep_backup else None,
+            'written_keys': len(self.metadata),
+        }
