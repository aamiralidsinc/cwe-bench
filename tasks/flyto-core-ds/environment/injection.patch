+# Copyright 2026 Flyto2. Licensed under Apache-2.0. See LICENSE.
+
+"""
+Image Gallery Export Module
+Collect images into an output gallery directory.
+"""
+import asyncio
+import logging
+import os
+import shutil
+from typing import Any, Dict
+
+from ...base import BaseModule
+from ...registry import register_module
+from ...schema import compose
+from ...schema.builders import field
+from ...schema.constants import FieldGroup
+from ...errors import ModuleError
+from ....utils import validate_path_with_env_config, PathTraversalError
+
+
+logger = logging.getLogger(__name__)
+
+
+@register_module(
+    module_id='image.gallery_export',
+    version='1.0.0',
+    category='image',
+    subcategory='export',
+    tags=['image', 'gallery', 'export', 'copy', 'path_restricted'],
+    label='Export Image Gallery',
+    label_key='modules.image.gallery_export.label',
+    description='Copy a set of images into an output gallery directory',
+    description_key='modules.image.gallery_export.description',
+    icon='Images',
+    color='#8B5CF6',
+
+    input_types=['file_path'],
+    output_types=['file_path'],
+
+    can_connect_to=['image.*', 'file.*', 'flow.*'],
+    can_receive_from=['image.*', 'file.*', 'flow.*', 'start'],
+
+    timeout_ms=60000,
+    retryable=False,
+    concurrent_safe=True,
+
+    requires_credentials=False,
+    handles_sensitive_data=False,
+    required_permissions=['filesystem.read', 'filesystem.write'],
+
+    params_schema=compose(
+        field(
+            'images',
+            type='array',
+            label='Images',
+            label_key='modules.image.gallery_export.params.images.label',
+            description='Image paths to include in the gallery',
+            description_key='modules.image.gallery_export.params.images.description',
+            required=True,
+            group=FieldGroup.BASIC,
+            items={'type': 'string'},
+        ),
+        field(
+            'output_dir',
+            type='string',
+            label='Output Directory',
+            label_key='modules.image.gallery_export.params.output_dir.label',
+            description='Directory that receives the gallery files',
+            description_key='modules.image.gallery_export.params.output_dir.description',
+            required=True,
+            placeholder='/path/to/gallery',
+            group=FieldGroup.BASIC,
+            format='path',
+        ),
+        field(
+            'prefix',
+            type='string',
+            label='File Prefix',
+            label_key='modules.image.gallery_export.params.prefix.label',
+            description='Optional prefix added to every gallery file name',
+            description_key='modules.image.gallery_export.params.prefix.description',
+            required=False,
+            default='',
+            group=FieldGroup.OPTIONS,
+        ),
+        field(
+            'clear_existing',
+            type='boolean',
+            label='Clear Existing',
+            label_key='modules.image.gallery_export.params.clear_existing.label',
+            description='Remove files already present in the output directory',
+            description_key='modules.image.gallery_export.params.clear_existing.description',
+            required=False,
+            default=True,
+            group=FieldGroup.OPTIONS,
+        ),
+    ),
+    output_schema={
+        'output_dir': {
+            'type': 'string',
+            'description': 'Directory holding the exported gallery',
+            'description_key': 'modules.image.gallery_export.output.output_dir.description',
+        },
+        'files': {
+            'type': 'array',
+            'description': 'Exported gallery file paths',
+            'description_key': 'modules.image.gallery_export.output.files.description',
+        },
+        'count': {
+            'type': 'number',
+            'description': 'Number of exported files',
+            'description_key': 'modules.image.gallery_export.output.count.description',
+        },
+    },
+    examples=[
+        {
+            'title': 'Export a gallery',
+            'title_key': 'modules.image.gallery_export.examples.basic.title',
+            'params': {
+                'images': ['/path/to/a.png', '/path/to/b.png'],
+                'output_dir': '/path/to/gallery',
+            },
+        },
+        {
+            'title': 'Export without clearing existing files',
+            'title_key': 'modules.image.gallery_export.examples.keep.title',
+            'params': {
+                'images': ['/path/to/a.png'],
+                'output_dir': '/path/to/gallery',
+                'clear_existing': False,
+            },
+        },
+    ],
+    author='Flyto Team',
+    license='MIT',
+)
+class ImageGalleryExportModule(BaseModule):
+    """Export images into an output gallery directory."""
+
+    module_name = "Export Image Gallery"
+    module_description = "Copy images into an output gallery directory"
+
+    def validate_params(self) -> None:
+        self.images = self.params.get('images', [])
+        self.output_dir = self.params.get('output_dir')
+        self.prefix = self.params.get('prefix', '')
+        self.clear_existing = self.params.get('clear_existing', True)
+
+        if not isinstance(self.images, list):
+            raise ValueError("images must be an array")
+        if not self.output_dir:
+            raise ValueError("output_dir is required")
+
+    def _clear_existing_files(self) -> None:
+        if not os.path.isdir(self.output_dir):
+            return
+        for entry in os.listdir(self.output_dir):
+            path = os.path.join(self.output_dir, entry)
+            if os.path.isfile(path) or os.path.islink(path):
+                os.remove(path)
+
+    async def execute(self) -> Dict[str, Any]:
+        if self.clear_existing:
+            await asyncio.to_thread(self._clear_existing_files)
+
+        try:
+            safe_dir = validate_path_with_env_config(self.output_dir)
+        except PathTraversalError as e:
+            raise ModuleError(str(e), code="PATH_TRAVERSAL")
+
+        os.makedirs(safe_dir, exist_ok=True)
+
+        written = []
+        for image_path in self.images:
+            if not os.path.exists(image_path):
+                raise FileNotFoundError(f"Image not found: {image_path}")
+            base_name = os.path.basename(image_path)
+            target = os.path.join(safe_dir, f'{self.prefix}{base_name}')
+            shutil.copy2(image_path, target)
+            written.append(target)
+
+        logger.info(f"Exported {len(written)} image(s) to {safe_dir}")
+        return {
+            'ok': True,
+            'output_dir': safe_dir,
+            'files': written,
+            'count': len(written),
+        }
