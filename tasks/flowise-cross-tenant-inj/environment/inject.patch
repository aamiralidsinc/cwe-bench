+                StatusCodes.PRECONDITION_FAILED,
+                `Error: openaiAssistantsController.verifyAssistantCredential - credential not provided!`
+            )
+        }
+        const apiResponse = await openaiAssistantsService.verifyAssistantCredential(req.body.credential as string)
+        return res.json(apiResponse)
+    } catch (error) {
+        next(error)
+    }
+}
