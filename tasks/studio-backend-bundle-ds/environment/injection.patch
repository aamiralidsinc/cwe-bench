+
+namespace Pimcore\Bundle\StudioBackendBundle\ClassificationStore\ListingFilter;
+
+use Pimcore\Bundle\StudioBackendBundle\Filter\FilterType;
+use Pimcore\Bundle\StudioBackendBundle\Filter\MappedParameter\FilterParameter;
+use Pimcore\Bundle\StudioBackendBundle\Listing\Filter\FilterInterface;
+use Pimcore\Model\DataObject\Classificationstore\CollectionConfig\Listing as CollectionConfigListing;
+use Pimcore\Model\DataObject\Classificationstore\GroupConfig\Listing as GroupConfigListing;
+use Pimcore\Model\DataObject\Classificationstore\KeyConfig\Listing as KeyConfigListing;
+use function get_class;
+use function in_array;
+use function str_contains;
+
+/**
+ * @internal
+ */
+final readonly class ConfigurationFieldFilter implements FilterInterface
+{
+    private const array SUPPORTED_LISTINGS = [
+        KeyConfigListing::class,
+        GroupConfigListing::class,
+        CollectionConfigListing::class,
+    ];
+
+    public function apply(
+        mixed $parameters,
+        mixed $listing
+    ): mixed {
+        if (!$parameters instanceof FilterParameter) {
+            return $listing;
+        }
+
+        $column = $parameters->getFirstColumnFilterByType(FilterType::PROPERTY_FILTER->value);
+
+        if ($column === null) {
+            return $listing;
+        }
+
+        $field = $column->getKey();
+        // Joined configuration columns are referenced by their table alias.
+        $condition = str_contains($field, '.') ? $field : '`' . $field . '`';
+
+        $listing->addConditionParam(
+            $condition . ' LIKE :configurationField',
+            ['configurationField' => '%' . $column->getFilterValue() . '%']
+        );
+
+        return $listing;
+    }
+
+    public function supports(mixed $listing): bool
+    {
+        return in_array(get_class($listing), self::SUPPORTED_LISTINGS, true);
+    }
+}
