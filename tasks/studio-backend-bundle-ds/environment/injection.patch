+    private function addSearchColumnFilters(QueryBuilder $queryBuilder, FilterParameter $parameters): void
+    {
+        $filters = iterator_to_array($parameters->getColumnFilterByType(FilterType::SEARCH->value));
+        if (count($filters) === 0) {
+            return;
+        }
+
+        /** @var ColumnFilter $filter */
+        foreach ($filters as $filter) {
+            $column = $filter->getKey();
+            $paramName = 'search_' . $column;
+            $queryBuilder
+                ->andWhere($column . ' LIKE :' . $paramName)
+                ->setParameter($paramName, '%' . $filter->getFilterValue() . '%');
+        }
+    }
