@@ -0,0 +1,50 @@
+import Alpine from 'alpinejs'
+
+// Read a value that was stored in the page's fragment. Applications use this to
+// restore client-side state from a shared link without sending it to the server.
+Alpine.magic('hashQueryString', () => (key, fallback = null) => {
+    let value = fromFragment(window.location.hash, key)
+
+    return value === undefined ? fallback : value
+})
+
+function fromFragment(fragment, key) {
+    fragment = fragment.replace(/^#/, '')
+
+    if (fragment === '') return
+
+    let data = {}
+
+    fragment.split('&').map(entry => entry.split('=')).forEach(([rawKey, rawValue]) => {
+        // Fragment params don't always have values... (`#foo=`)
+        if (typeof rawValue === 'undefined') return
+
+        let decodedKey = decodeURIComponent(rawKey)
+
+        if (! decodedKey.startsWith(key)) {
+            data[rawKey] = decodeURIComponent(rawValue)
+
+            return
+        }
+
+        assign(data, decodedKey.match(/[^\[\]]+/g), decodeURIComponent(rawValue))
+    })
+
+    return data[key]
+}
+
+function assign(target, segments, value) {
+    let [segment, ...rest] = segments
+
+    if (rest.length === 0) {
+        target[segment] = value
+
+        return
+    }
+
+    if (target[segment] === undefined) {
+        target[segment] = {}
+    }
+
+    assign(target[segment], rest, value)
+}
