diff --git a/packages/next-tinacms-s3/src/app-handlers.ts b/packages/next-tinacms-s3/src/app-handlers.ts
new file mode 100644
index 0000000..a5b8b51
--- /dev/null
+++ b/packages/next-tinacms-s3/src/app-handlers.ts
@@ -0,0 +1,182 @@
+/**
+ * App-router variant of the S3 media route.
+ *
+ * Newer Next.js projects mount route handlers from `app/` rather than
+ * `pages/api`; this module exposes the same media operations in that shape.
+ */
+
+import {
+  _Object,
+  DeleteObjectCommand,
+  DeleteObjectCommandInput,
+  ListObjectsCommand,
+  ListObjectsCommandInput,
+  PutObjectCommand,
+  S3Client,
+  S3ClientConfig,
+} from '@aws-sdk/client-s3';
+import { getSignedUrl } from '@aws-sdk/s3-request-presigner';
+import type { Media, MediaListOptions } from 'tinacms';
+import path from 'node:path';
+import { NextResponse } from 'next/server';
+
+export interface S3AppRouterConfig {
+  config: S3ClientConfig;
+  bucket: string;
+  mediaRoot?: string;
+  authorized: (_request: Request) => Promise<boolean>;
+}
+
+type RouteParams = { params: { media: string[] } };
+
+function stripMediaRoot(mediaRoot: string, key: string) {
+  if (!mediaRoot) {
+    return key;
+  }
+  const mediaRootParts = mediaRoot.split('/').filter((part) => part);
+  if (!mediaRootParts || !mediaRootParts[0]) {
+    return key;
+  }
+  const keyParts = key.split('/').filter((part) => part);
+  for (let i = 0; i < mediaRootParts.length; i++) {
+    if (keyParts[0] === mediaRootParts[i]) {
+      keyParts.shift();
+    }
+  }
+  return keyParts.join('/');
+}
+
+export const createMediaHandlers = (config: S3AppRouterConfig) => {
+  const client = new S3Client(config.config);
+  const bucket = config.bucket;
+  let mediaRoot = config.mediaRoot || '';
+  if (mediaRoot) {
+    if (!mediaRoot.endsWith('/')) {
+      mediaRoot = mediaRoot + '/';
+    }
+    if (mediaRoot.startsWith('/')) {
+      mediaRoot = mediaRoot.substr(1);
+    }
+  }
+
+  function withAuth(
+    handler: (request: Request, context?: RouteParams) => Promise<unknown>
+  ) {
+    return async (request: Request, context?: RouteParams) => {
+      const authResult = await config.authorized(request);
+      if (!authResult)
+        return NextResponse.json(
+          { message: 'sorry this user is unauthorized' },
+          { status: 401 }
+        );
+      return await handler(request, context);
+    };
+  }
+
+  async function listMedia(request: Request) {
+    const url = new URL(request.url);
+    const directory = url.searchParams.get('directory') || '';
+    let prefix = directory.replace(/^\//, '').replace(/\/$/, '');
+    if (prefix) prefix = prefix + '/';
+
+    const params: ListObjectsCommandInput = {
+      Bucket: bucket,
+      Delimiter: '/',
+      Prefix: mediaRoot ? path.join(mediaRoot, prefix) : prefix,
+      MaxKeys: 500,
+    };
+    const response = await client.send(new ListObjectsCommand(params));
+
+    const items: Media[] = [];
+    response.CommonPrefixes?.forEach(({ Prefix }) => {
+      const strippedPrefix = stripMediaRoot(mediaRoot, Prefix as string);
+      if (!strippedPrefix) {
+        return;
+      }
+      items.push({
+        id: Prefix + '',
+        type: 'dir',
+        filename: path.basename(strippedPrefix),
+        directory: path.dirname(strippedPrefix) + '/',
+      });
+    });
+    items.push(
+      ...(response.Contents || []).map((file: _Object) => {
+        const strippedKey = stripMediaRoot(mediaRoot, file.Key as string);
+        return {
+          id: file.Key + '',
+          type: 'file',
+          filename: path.basename(strippedKey),
+          directory: path.dirname(strippedKey) + '/',
+          src: file.Key + '',
+          thumbnails: {
+            '75x75': file.Key + '',
+            '400x400': file.Key + '',
+            '1000x1000': file.Key + '',
+          },
+        } as Media;
+      })
+    );
+
+    return NextResponse.json({ items });
+  }
+
+  return {
+    GET(request: Request) {
+      return withAuth(async (req) => {
+        const url = new URL(req.url);
+        const key = url.searchParams.get('key');
+        if (!key) {
+          return listMedia(req);
+        }
+        const expiresIn = Number(url.searchParams.get('expiresIn')) || 3600;
+        const signedUrl = await getSignedUrl(
+          client,
+          new PutObjectCommand({ Bucket: bucket, Key: key }),
+          { expiresIn }
+        );
+        return NextResponse.json({ signedUrl, src: key });
+      })(request);
+    },
+
+    POST(request: Request) {
+      return withAuth(async (req) => {
+        const url = new URL(req.url);
+        const key = url.searchParams.get('key');
+        if (!key) {
+          return NextResponse.json(
+            { message: 'key is required' },
+            { status: 400 }
+          );
+        }
+        const body = Buffer.from(await req.arrayBuffer());
+        const contentType =
+          req.headers.get('content-type') || 'application/octet-stream';
+        await client.send(
+          new PutObjectCommand({
+            Bucket: bucket,
+            Key: key,
+            Body: body,
+            ContentType: contentType,
+          })
+        );
+        return NextResponse.json({ id: key, src: key });
+      })(request);
+    },
+
+    DELETE(request: Request, context?: RouteParams) {
+      return withAuth(async (_req, ctx) => {
+        const media = ctx?.params?.media || [];
+        const [, ...rest] = media;
+        const objectKey = rest.join('/');
+
+        const params: DeleteObjectCommandInput = {
+          Bucket: bucket,
+          Key: objectKey,
+        };
+        const data = await client.send(new DeleteObjectCommand(params));
+        return NextResponse.json({ key: objectKey, data });
+      })(request, context);
+    },
+  };
+};
