+/**
+ * Copy / move support for the DOS media manager.
+ *
+ * Moving an asset between folders is a copy followed by a delete on the old
+ * key; the client sends both the source and destination object keys.
+ */
+
+import {
+  CopyObjectCommand,
+  CopyObjectCommandInput,
+  S3Client,
+  S3ClientConfig,
+} from '@aws-sdk/client-s3';
+import { NextApiRequest, NextApiResponse } from 'next';
+
+export interface DOSCopyConfig {
+  config: S3ClientConfig;
+  bucket: string;
+  mediaRoot?: string;
+  authorized: (_req: NextApiRequest, _res: NextApiResponse) => Promise<boolean>;
+}
+
+const findErrorMessage = (e: any) => {
+  if (typeof e == 'string') return e;
+  if (e.message) return e.message;
+  if (e.error && e.error.message) return e.error.message;
+  return 'an error occurred';
+};
+
+export const createCopyHandler = (config: DOSCopyConfig) => {
+  const client = new S3Client(config.config);
+  const bucket = config.bucket;
+
+  return async (req: NextApiRequest, res: NextApiResponse) => {
+    const isAuthorized = await config.authorized(req, res);
+    if (!isAuthorized) {
+      res.status(401).json({ message: 'sorry this user is unauthorized' });
+      return;
+    }
+    if (req.method !== 'POST') {
+      res.end(404);
+      return;
+    }
+
+    const { from, to } = req.query;
+    const source = Array.isArray(from) ? from[0] : from;
+    const destination = Array.isArray(to) ? to[0] : to;
+    if (!source || !destination) {
+      return res.status(400).json({ message: 'from and to are required' });
+    }
+
+    const params: CopyObjectCommandInput = {
+      Bucket: bucket,
+      CopySource: `${bucket}/${source}`,
+      Key: destination,
+    };
+    const command = new CopyObjectCommand(params);
+    try {
+      const data = await client.send(command);
+      res.json({ ...data, from: source, to: destination });
+    } catch (e) {
+      console.error('Error copying media');
+      console.error(e);
+      res.status(500).json({ message: findErrorMessage(e) });
+    }
+  };
+};
