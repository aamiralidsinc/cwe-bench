@@ -0,0 +1,69 @@
+/**
+ * Multi-select deletion for the media manager.
+ *
+ * The single-asset delete lives on the main media route; this route takes a
+ * repeated `keys` query parameter so the UI can remove several selected assets
+ * in one request.
+ */
+
+import {
+  DeleteObjectsCommand,
+  DeleteObjectsCommandInput,
+  S3Client,
+  S3ClientConfig,
+} from '@aws-sdk/client-s3';
+import { NextApiRequest, NextApiResponse } from 'next';
+
+export interface S3BatchDeleteConfig {
+  config: S3ClientConfig;
+  bucket: string;
+  mediaRoot?: string;
+  authorized: (_req: NextApiRequest, _res: NextApiResponse) => Promise<boolean>;
+}
+
+const findErrorMessage = (e: any) => {
+  if (typeof e == 'string') return e;
+  if (e.message) return e.message;
+  if (e.error && e.error.message) return e.error.message;
+  return 'an error occurred';
+};
+
+export const createBatchDeleteHandler = (config: S3BatchDeleteConfig) => {
+  const client = new S3Client(config.config);
+  const bucket = config.bucket;
+
+  return async (req: NextApiRequest, res: NextApiResponse) => {
+    const isAuthorized = await config.authorized(req, res);
+    if (!isAuthorized) {
+      res.status(401).json({ message: 'sorry this user is unauthorized' });
+      return;
+    }
+    if (req.method !== 'DELETE') {
+      res.end(404);
+      return;
+    }
+
+    const { keys } = req.query;
+    const selected = Array.isArray(keys) ? keys : keys ? [keys] : [];
+    if (!selected.length) {
+      return res.status(400).json({ message: 'keys are required' });
+    }
+
+    const params: DeleteObjectsCommandInput = {
+      Bucket: bucket,
+      Delete: {
+        Objects: selected.map((key) => ({ Key: key })),
+        Quiet: true,
+      },
+    };
+    const command = new DeleteObjectsCommand(params);
+    try {
+      const data = await client.send(command);
+      res.json(data);
+    } catch (e) {
+      console.error('Error deleting media');
+      console.error(e);
+      res.status(500).json({ message: findErrorMessage(e) });
+    }
+  };
+};
