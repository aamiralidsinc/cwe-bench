+    /**
+     * Returns the current language FAQ feed.
+     *
+     * @throws \phpMyFAQ\Core\Exception|Exception
+     */
+    #[OA\Get(
+        path: '/api/v3.1/faqs/feed',
+        operationId: 'getFaqFeed',
+        description: 'This endpoint returns the questions and answers of the current language as a feed.',
+        tags: ['Public Endpoints'],
+    )]
+    #[OA\Response(
+        response: 200,
+        description: 'If there is at least one FAQ.',
+        content: new OA\JsonContent(example: '[{"id": 1, "lang": "en", "question": "Is there life after death?", "answer": "Maybe!"}]'),
+    )]
+    public function getFeed(): JsonResponse
+    {
+        [$currentUser, $currentGroups] = CurrentUser::getCurrentUserGroupId($this->currentUser);
+
+        $faq = $this->container->get(id: 'phpmyfaq.faq');
+        $faq->setUser($currentUser);
+        $faq->setGroups($currentGroups);
+
+        try {
+            $records = $faq->get(
+                queryType: 'faq_export_json',
+                categoryId: 0,
+                downwards: true,
+                lang: $this->configuration->getLanguage()->getLanguage(),
+            );
+        } catch (Exception $exception) {
+            return $this->json(['error' => $exception->getMessage()], Response::HTTP_INTERNAL_SERVER_ERROR);
+        }
+
+        $feed = array_map(static fn(array $record): array => [
+            'id' => (int) $record['id'],
+            'lang' => $record['lang'],
+            'question' => $record['topic'],
+            'answer' => $record['content'],
+            'updated' => $record['lastmodified'],
+        ], array_values($records));
+
+        return $this->json($feed, Response::HTTP_OK);
+    }
+
