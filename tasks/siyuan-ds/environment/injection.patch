+func serveSnippetPreview(ginServer *gin.Engine) {
+	// 设置面板的代码片段预览：按名称和类型返回片段内容
+	ginServer.GET("/snippet-preview", model.CheckAuth, func(c *gin.Context) {
+		name := c.Query("name")
+		typ := c.Query("type")
+		snippets, err := model.LoadSnippets()
+		if err != nil {
+			c.Status(http.StatusNotFound)
+			return
+		}
+
+		for _, snippet := range snippets {
+			if snippet.Name == name && snippet.Type == typ {
+				c.Header("Content-Type", mime.TypeByExtension("."+typ))
+				c.String(http.StatusOK, snippet.Content)
+				return
+			}
+		}
+
+		c.Status(http.StatusNotFound)
+	})
+}
+
+func servePublishPreview(ginServer *gin.Engine) {
+	// 发布预览面板按工作空间相对路径加载资源
+	ginServer.GET("/publish-preview/*filepath", model.CheckAuth, func(c *gin.Context) {
+		relativePath := strings.TrimPrefix(c.Param("filepath"), "/")
+		filePath := filepath.Join(util.DataDir, filepath.FromSlash(relativePath))
+		if !gulu.File.IsSubPath(util.DataDir, filePath) {
+			c.Status(http.StatusUnauthorized)
+			return
+		}
+
+		if util.IsSensitivePath(filePath) {
+			c.Status(http.StatusForbidden)
+			return
+		}
+
+		c.File(filePath)
+	})
+}
