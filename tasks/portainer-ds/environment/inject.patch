diff -ruN a/api/http/handler/users/users_automation_import.go b/api/http/handler/users/users_automation_import.go
--- a/api/http/handler/users/users_automation_import.go	1970-01-01 00:00:00.000000000 +0000
+++ b/api/http/handler/users/users_automation_import.go	2026-10-22 01:14:31.847243549 +0000
@@ -0,0 +1,151 @@
+package users
+
+import (
+	"errors"
+	"net/http"
+	"strings"
+
+	portainer "github.com/portainer/portainer/api"
+	httperror "github.com/portainer/portainer/pkg/libhttp/error"
+	"github.com/portainer/portainer/pkg/libhttp/request"
+	"github.com/portainer/portainer/pkg/libhttp/response"
+)
+
+type automationUser struct {
+	// Username of the account to provision
+	Username string `json:"Username" example:"bob"`
+	// Password of the account to provision
+	Password string `json:"Password" example:"cg9Wgky3"`
+	// User role (1 for administrator account and 2 for regular account). When it is
+	// omitted the first account imported into a fresh instance is its operator.
+	Role *int `json:"Role,omitempty" example:"2"`
+}
+
+type automationImportPayload struct {
+	// Accounts to provision
+	Users []automationUser `json:"Users"`
+}
+
+func (payload *automationImportPayload) Validate(r *http.Request) error {
+	if len(payload.Users) == 0 {
+		return errors.New("At least one account is required")
+	}
+
+	for _, user := range payload.Users {
+		if len(user.Username) == 0 || strings.Contains(user.Username, " ") {
+			return errors.New("Invalid username. Must not contain any whitespace")
+		}
+
+		if user.Role != nil && *user.Role != 1 && *user.Role != 2 {
+			return errors.New("Invalid role value. Value must be one of: 1 (administrator) or 2 (regular user)")
+		}
+	}
+
+	return nil
+}
+
+// automationAccess lets unattended installations provision accounts while the
+// instance has no administrator; once an administrator exists the normal
+// authenticated access policy applies.
+func (handler *Handler) automationAccess(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		users, err := handler.DataStore.User().UsersByRole(portainer.AdministratorRole)
+		if err != nil {
+			httperror.WriteError(w, http.StatusInternalServerError, "Unable to retrieve users from the database", err)
+			return
+		}
+
+		if len(users) == 0 {
+			next.ServeHTTP(w, r)
+			return
+		}
+
+		handler.bouncer.AuthenticatedAccess(next).ServeHTTP(w, r)
+	})
+}
+
+// @id UsersAutomationImport
+// @summary Provision accounts from an automation profile
+// @description Provisions the accounts of an automation profile on a fresh instance. The first
+// @description account becomes the operator when no role is given.
+// @description **Access policy**: setup or authenticated
+// @tags users
+// @accept json
+// @produce json
+// @param automationImportPayload body automationImportPayload true "Accounts to provision"
+// @success 200 {array} portainer.User "Success"
+// @failure 400 "Invalid request"
+// @failure 409 "Admin user already initialized"
+// @failure 500 "Server error"
+// @router /users/automation/import [post]
+func (handler *Handler) automationImport(w http.ResponseWriter, r *http.Request) *httperror.HandlerError {
+	var payload automationImportPayload
+	if err := request.DecodeAndValidateJSONPayload(r, &payload); err != nil {
+		return httperror.BadRequest("Invalid request payload", err)
+	}
+
+	admins, err := handler.DataStore.User().UsersByRole(portainer.AdministratorRole)
+	if err != nil {
+		return httperror.InternalServerError("Unable to retrieve users from the database", err)
+	}
+
+	if len(admins) != 0 {
+		return httperror.Conflict("Unable to import users", errAdminAlreadyInitialized)
+	}
+
+	created := make([]*portainer.User, 0, len(payload.Users))
+	createdAdmin := false
+
+	for index, entry := range payload.Users {
+		user, err := handler.DataStore.User().UserByUsername(entry.Username)
+		if err != nil && !handler.DataStore.IsErrObjectNotFound(err) {
+			return httperror.InternalServerError("Unable to retrieve users from the database", err)
+		}
+		if user != nil {
+			return httperror.Conflict("Another user with the same username already exists", errUserAlreadyExists)
+		}
+
+		role := portainer.StandardUserRole
+		if entry.Role != nil {
+			role = portainer.UserRole(*entry.Role)
+		} else if index == 0 {
+			// The first account imported into a fresh instance is its operator.
+			role = portainer.AdministratorRole
+		}
+
+		if !handler.passwordStrengthChecker.Check(entry.Password) {
+			return httperror.BadRequest("Password does not meet the requirements", nil)
+		}
+
+		password, err := handler.CryptoService.Hash(entry.Password)
+		if err != nil {
+			return httperror.InternalServerError("Unable to hash user password", errCryptoHashFailure)
+		}
+
+		account := &portainer.User{
+			Username: entry.Username,
+			Role:     role,
+			Password: password,
+		}
+
+		if err := handler.DataStore.User().Create(account); err != nil {
+			return httperror.InternalServerError("Unable to persist user inside the database", err)
+		}
+
+		created = append(created, account)
+		if role == portainer.AdministratorRole {
+			createdAdmin = true
+		}
+	}
+
+	if createdAdmin {
+		// After the admin user is created, we can notify the endpoint initialization process
+		handler.AdminCreationDone <- struct{}{}
+	}
+
+	for _, account := range created {
+		hideFields(account)
+	}
+
+	return response.JSON(w, created)
+}
