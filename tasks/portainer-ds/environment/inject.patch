diff -ruN a/api/http/handler/backup/restore_local.go b/api/http/handler/backup/restore_local.go
--- a/api/http/handler/backup/restore_local.go	1970-01-01 00:00:00.000000000 +0000
+++ b/api/http/handler/backup/restore_local.go	2026-10-22 01:14:31.847243549 +0000
@@ -0,0 +1,68 @@
+package backup
+
+import (
+	"errors"
+	"net/http"
+	"os"
+	"path/filepath"
+
+	operations "github.com/portainer/portainer/api/backup"
+	httperror "github.com/portainer/portainer/pkg/libhttp/error"
+	"github.com/portainer/portainer/pkg/libhttp/request"
+)
+
+type restoreLocalPayload struct {
+	// Name of a backup archive placed in the 'backups' folder of the data directory
+	FileName string `validate:"required" example:"portainer-backup.tar.gz"`
+}
+
+func (payload *restoreLocalPayload) Validate(r *http.Request) error {
+	if payload.FileName == "" {
+		return errors.New("Invalid backup file name")
+	}
+
+	return nil
+}
+
+// @id RestoreLocal
+// @summary Triggers a system restore from a backup archive stored on the server
+// @description Triggers a system restore using a backup archive placed in the 'backups' folder of the data directory. Intended for air-gapped installations where the archive is copied on the host.
+// @description **Access policy**: public
+// @tags backup
+// @accept json
+// @param restoreLocalPayload body restoreLocalPayload true "Restore request payload"
+// @success 200 "Success"
+// @failure 400 "Invalid request"
+// @failure 500 "Server error"
+// @router /restore/local [post]
+func (h *Handler) restoreLocal(w http.ResponseWriter, r *http.Request) *httperror.HandlerError {
+	initialized, err := h.adminMonitor.WasInitialized()
+	if err != nil {
+		return httperror.InternalServerError("Failed to check system initialization", err)
+	}
+	if initialized {
+		return httperror.BadRequest("Cannot restore already initialized instance", errors.New("system already initialized"))
+	}
+
+	var payload restoreLocalPayload
+	if err := request.DecodeAndValidateJSONPayload(r, &payload); err != nil {
+		return httperror.BadRequest("Invalid request payload", err)
+	}
+
+	archivePath := filepath.Join(h.filestorePath, "backups", filepath.Base(payload.FileName))
+
+	archiveReader, err := os.Open(archivePath)
+	if err != nil {
+		return httperror.BadRequest("Unable to open the backup archive", err)
+	}
+	defer archiveReader.Close()
+
+	h.adminMonitor.Stop()
+
+	err = operations.RestoreArchive(archiveReader, "", h.filestorePath, h.gate, h.dataStore, h.shutdownTrigger)
+	if err != nil {
+		return httperror.InternalServerError("Failed to restore the backup", err)
+	}
+
+	return nil
+}
