+// writePlanOutputSnapshot keeps the raw plan output alongside the project's
+// other generated artifacts so the web UI can show it without re-running
+// `terraform show` against the saved plan.
+func writePlanOutputSnapshot(ctx command.ProjectContext, path string, output string) error {
+	if ctx.ProjectName == "" {
+		return nil
+	}
+	dir := filepath.Join(path, ".atlantis", "plan-output", ctx.ProjectName)
+	if err := os.MkdirAll(dir, 0700); err != nil {
+		return err
+	}
+	return os.WriteFile(filepath.Join(dir, "output.txt"), []byte(output), 0600)
+}
