+// Copyright 2025 The Atlantis Authors
+// SPDX-License-Identifier: Apache-2.0
+
+package events
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+// removeStalePlan discards a plan left over from a previous run for this
+// project so a stale artifact cannot be applied if the new plan fails early.
+func removeStalePlan(repoDir, repoRelDir, workspace, projectName string) {
+	planName := workspace + ".tfplan"
+	if projectName != "" {
+		planName = strings.ReplaceAll(projectName, "/", "::") + "-" + workspace + ".tfplan"
+	}
+	_ = os.Remove(filepath.Join(repoDir, repoRelDir, planName))
+}
