+/**
+ * Plain-object metadata filters for {@link FluentRedisVectorStore}.
+ *
+ * A plain object maps metadata field names to values and is rendered with the
+ * store's metadata schema. It is a shorthand for the `FilterExpression`
+ * builders when the filter is assembled from data instead of written by hand.
+ *
+ * @example
+ * ```typescript
+ * const store = new FluentRedisVectorStore(embeddings, {
+ *   redisClient: client,
+ *   indexName: "products",
+ *   customSchema: [
+ *     { name: "category", type: "tag" },
+ *     { name: "price", type: "numeric" },
+ *     { name: "title", type: "text" },
+ *   ],
+ * });
+ *
+ * await store.similaritySearch("laptop", 5, {
+ *   category: "electronics",
+ *   price: { max: 1000 },
+ * });
+ * ```
+ */
+import type { MetadataFieldSchema } from "./schema.js";
+
+/**
+ * A value for one metadata field in a plain-object filter.
+ *
+ * Tag fields accept a single value or an array of values; text fields accept a
+ * string; numeric fields accept a number or a `{ min, max }` range.
+ */
+export type MetadataFilterValue =
+  | string
+  | number
+  | string[]
+  | { min?: number; max?: number };
+
+/**
+ * A plain-object metadata filter: field name to value.
+ */
+export type MetadataFilterObject = Record<string, MetadataFilterValue>;
+
+/**
+ * Renders a plain-object metadata filter as a RediSearch query fragment using
+ * the metadata schema of the store. Unknown field names are ignored.
+ *
+ * @param metadataFilter - field name to value
+ * @param schema - the store's metadata schema
+ * @returns a query fragment, or `*` when no field matched
+ */
+export function filtersFromObject(
+  metadataFilter: MetadataFilterObject,
+  schema: MetadataFieldSchema[]
+): string {
+  const fields = new Map(schema.map((field) => [field.name, field]));
+  const clauses: string[] = [];
+
+  for (const [fieldName, value] of Object.entries(metadataFilter)) {
+    const fieldSchema = fields.get(fieldName);
+    if (!fieldSchema) {
+      continue;
+    }
+
+    if (fieldSchema.type === "tag") {
+      const values = Array.isArray(value) ? value : [String(value)];
+      clauses.push(`@${fieldName}:{${values.join("|")}}`);
+    } else if (fieldSchema.type === "text") {
+      clauses.push(`@${fieldName}:(${String(value)})`);
+    } else if (fieldSchema.type === "numeric") {
+      if (typeof value === "object" && value !== null && !Array.isArray(value)) {
+        const min = "min" in value ? value.min : undefined;
+        const max = "max" in value ? value.max : undefined;
+        if (min !== undefined && max !== undefined) {
+          clauses.push(`@${fieldName}:[${min} ${max}]`);
+        } else if (min !== undefined) {
+          clauses.push(`@${fieldName}:[${min} +inf]`);
+        } else if (max !== undefined) {
+          clauses.push(`@${fieldName}:[-inf ${max}]`);
+        }
+      } else {
+        clauses.push(`@${fieldName}:[${value} ${value}]`);
+      }
+    }
+  }
+
+  return clauses.length > 0 ? clauses.join(" ") : "*";
+}
