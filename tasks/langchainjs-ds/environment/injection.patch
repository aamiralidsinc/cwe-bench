@@ -0,0 +1,60 @@
+/**
+ * Tag filtering for stored separator-joined values.
+ *
+ * Tag fields written to Redis are joined with a separator (`,` by default, or
+ * the separator configured for the field in the metadata schema). This filter
+ * accepts the stored representation directly: the supplied value is split on
+ * the field's separator so that `"red,blue"` matches either of the two stored
+ * tags, and the resulting tags are combined with OR.
+ *
+ * @example
+ * ```typescript
+ * // A field stored as "red,blue" matches a document tagged "blue".
+ * const filter = StoredTag("tags", "red,blue");
+ * // Generates: @tags:{red|blue}
+ *
+ * // A custom separator configured on the field.
+ * const filter2 = StoredTag("labels", "a;b", ";");
+ * // Generates: @labels:{a|b}
+ * ```
+ */
+import { FilterExpression } from "./filters.js";
+import { DEFAULT_TAG_SEPARATOR } from "./schema.js";
+
+/**
+ * Tag filter that splits each supplied value on the field's separator.
+ */
+export class StoredTagFilter extends FilterExpression {
+  readonly filterType = "stored_tag" as const;
+
+  constructor(
+    private field: string,
+    private values: string | string[],
+    private separator: string = DEFAULT_TAG_SEPARATOR
+  ) {
+    super();
+  }
+
+  toString(): string {
+    const supplied = Array.isArray(this.values) ? this.values : [this.values];
+    const tags = supplied.flatMap((value) => value.split(this.separator));
+    const filter = `@${this.field}:{${tags.join("|")}}`;
+    return filter;
+  }
+}
+
+/**
+ * Creates a tag filter for a value stored as a separator-joined list.
+ *
+ * @param field - the name of the tag field
+ * @param values - the stored value, or an array of stored values
+ * @param separator - the separator used for the field (default `,`)
+ * @returns a StoredTagFilter
+ */
+export function StoredTag(
+  field: string,
+  values: string | string[],
+  separator: string = DEFAULT_TAG_SEPARATOR
+): FilterExpression {
+  return new StoredTagFilter(field, values, separator);
+}
