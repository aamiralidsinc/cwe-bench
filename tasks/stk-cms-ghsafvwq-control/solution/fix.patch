+    /**
+     * Returns whether a given value is safe to hand to the browser as a navigation destination.
+     *
+     * Markup and template-tag braces are removed before the scheme is inspected, because the
+     * application's own handling of a return address removes them before the browser sees it.
+     *
+     * @param string $url
+     * @return bool
+     * @since 4.15.3
+     */
+    public static function isSafeNavigationUrl(string $url): bool
+    {
+        $url = str_replace(['{', '}'], '', strip_tags($url));
+        $scheme = parse_url($url, PHP_URL_SCHEME);
+        if ($scheme !== null && $scheme !== false) {
+            return in_array(strtolower($scheme), ['http', 'https'], true);
+        }
+
+        return true;
+    }
