+# ----------------------------------------------------------------------
+# inspect_artifact
+# ----------------------------------------------------------------------
+
+def inspect_artifact(path: Any) -> dict:
+    """Read the version envelope of a saved detector.
+
+    Returns the envelope written by `save()` with the ``model`` field
+    removed, so a caller can look at the recorded dependency versions,
+    the save timestamp and the user metadata without handling the model
+    object itself. Artifacts that carry no envelope are rejected.
+
+    Parameters
+    ----------
+    path : str or pathlib.Path
+        Path to the artifact.
+
+    Returns
+    -------
+    envelope : dict
+        The stored envelope without the model payload.
+
+    Raises
+    ------
+    ValueError
+        When the artifact has no PyOD version envelope.
+    """
+    obj = joblib.load(path)
+    if not _is_envelope(obj):
+        raise ValueError(
+            "inspect_artifact(): artifact has no PyOD version envelope. "
+            "Use joblib.load if the file was written by raw joblib.dump.")
+    return {k: v for k, v in obj.items() if k != "model"}
+
+
