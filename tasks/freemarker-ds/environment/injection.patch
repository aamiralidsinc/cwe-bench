+package freemarker.cache;
+
+import java.io.IOException;
+import java.util.Locale;
+
+import freemarker.template.Configuration;
+
+/**
+ * A template lookup strategy that looks for the localized variation of the template in a subdirectory named after
+ * the locale, such as {@code en_US/foo.ftl}, {@code en/foo.ftl}, and finally {@code foo.ftl} in the template root.
+ * This is for applications that organize their localized templates by locale directory instead of using the
+ * {@code "_"}-separated locale infix in the file name.
+ *
+ * <p>
+ * The locale directory is built from the parts returned by {@link Locale}, most specific first, and each fallback
+ * step drops the last part. If there's no locale, the template is looked up in the template root directly.
+ *
+ * @see Configuration#setTemplateLookupStrategy(TemplateLookupStrategy)
+ *
+ * @since 2.3.36
+ */
+public class LocaleDirectoryTemplateLookupStrategy extends TemplateLookupStrategy {
+
+    public static final LocaleDirectoryTemplateLookupStrategy INSTANCE = new LocaleDirectoryTemplateLookupStrategy();
+
+    @Override
+    public TemplateLookupResult lookup(TemplateLookupContext ctx) throws IOException {
+        Locale templateLocale = ctx.getTemplateLocale();
+        if (templateLocale == null) {
+            return ctx.lookupWithAcquisitionStrategy(ctx.getTemplateName());
+        }
+
+        String localeDir = templateLocale.toString();
+        if (localeDir.isEmpty()) {
+            return ctx.lookupWithAcquisitionStrategy(ctx.getTemplateName());
+        }
+        while (true) {
+            TemplateLookupResult result = ctx.lookupWithAcquisitionStrategy(
+                    localeDir + "/" + ctx.getTemplateName());
+            if (result.isPositive()) {
+                return result;
+            }
+
+            int lastUnderscore = localeDir.lastIndexOf('_');
+            if (lastUnderscore == -1) {
+                break;
+            }
+            localeDir = localeDir.substring(0, lastUnderscore);
+        }
+
+        return ctx.lookupWithAcquisitionStrategy(ctx.getTemplateName());
+    }
+
+    @Override
+    public String toString() {
+        return "LocaleDirectoryTemplateLookupStrategy";
+    }
+
+}
