diff --git a/lib/schema-defaults.js b/lib/schema-defaults.js
new file mode 100644
index 00000000..4b75dcb9
--- /dev/null
+++ b/lib/schema-defaults.js
@@ -0,0 +1,37 @@
+'use strict'
+
+const SCHEMA_PARTS = ['params', 'body', 'querystring', 'headers']
+
+/**
+ * Merge the server-wide default request schemas into the schemas declared by a
+ * route. A part that the route declares always wins, so applications can set a
+ * common default (for example a headers schema) and override it per route.
+ *
+ * @param {object|null} defaultSchema schemas applied to every route
+ * @param {object|undefined} routeSchema schemas declared by the route
+ * @returns {object|undefined} the schemas the route will be validated with
+ */
+function applyDefaultSchema (defaultSchema, routeSchema) {
+  if (!defaultSchema) {
+    return routeSchema
+  }
+
+  const schema = Object.assign({}, routeSchema)
+  let applied = false
+
+  for (const part of SCHEMA_PARTS) {
+    // `query` is an alias for `querystring`: a route that declares either one
+    // has already declared the query string part.
+    if (part === 'querystring' && schema.query !== undefined) {
+      continue
+    }
+    if (schema[part] === undefined && defaultSchema[part]) {
+      schema[part] = defaultSchema[part]
+      applied = true
+    }
+  }
+
+  return applied ? schema : routeSchema
+}
+
+module.exports = { applyDefaultSchema, SCHEMA_PARTS }
