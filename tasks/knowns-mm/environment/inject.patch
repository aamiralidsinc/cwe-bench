diff --git a/internal/storage/doc_archive.go b/internal/storage/doc_archive.go
new file mode 100644
index 0000000..dd805a7
--- /dev/null
+++ b/internal/storage/doc_archive.go
@@ -0,0 +1,55 @@
+package storage
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+// archiveDir returns the directory holding archived documents.
+func (ds *DocStore) archiveDir() string { return filepath.Join(ds.root, "archive") }
+
+// Archive moves a document out of the live documentation set into the project's
+// archive area, mirroring the way tasks are archived. The document keeps its
+// path so it can be unarchived later.
+func (ds *DocStore) Archive(path string) error {
+	if strings.TrimSpace(path) == "" {
+		return fmt.Errorf("doc path is required")
+	}
+	path = strings.TrimSuffix(path, ".md")
+	src := filepath.Join(ds.docsDir(), filepath.FromSlash(path)+".md")
+	dst := filepath.Join(ds.archiveDir(), filepath.FromSlash(path)+".md")
+	data, err := os.ReadFile(src)
+	if err != nil {
+		return fmt.Errorf("archive doc %q: %w", path, err)
+	}
+	if err := atomicWrite(dst, data); err != nil {
+		return fmt.Errorf("archive doc %q: %w", path, err)
+	}
+	if err := os.Remove(src); err != nil && !os.IsNotExist(err) {
+		return fmt.Errorf("archive doc %q: %w", path, err)
+	}
+	return nil
+}
+
+// Unarchive moves an archived document back into the live documentation set.
+func (ds *DocStore) Unarchive(path string) error {
+	if strings.TrimSpace(path) == "" {
+		return fmt.Errorf("doc path is required")
+	}
+	path = strings.TrimSuffix(path, ".md")
+	src := filepath.Join(ds.archiveDir(), filepath.FromSlash(path)+".md")
+	dst := filepath.Join(ds.docsDir(), filepath.FromSlash(path)+".md")
+	data, err := os.ReadFile(src)
+	if err != nil {
+		return fmt.Errorf("unarchive doc %q: %w", path, err)
+	}
+	if err := atomicWrite(dst, data); err != nil {
+		return fmt.Errorf("unarchive doc %q: %w", path, err)
+	}
+	if err := os.Remove(src); err != nil && !os.IsNotExist(err) {
+		return fmt.Errorf("unarchive doc %q: %w", path, err)
+	}
+	return nil
+}
diff --git a/internal/storage/memory_history.go b/internal/storage/memory_history.go
new file mode 100644
index 0000000..0d7a2ac
--- /dev/null
+++ b/internal/storage/memory_history.go
@@ -0,0 +1,87 @@
+package storage
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"time"
+)
+
+// MemoryRevision is one recorded snapshot of a memory entry. Revisions are
+// identified by an incrementing integer wrapped in a "v" prefix, matching the
+// revision labels used for tasks and documents.
+type MemoryRevision struct {
+	ID        string         `json:"id"`
+	MemoryID  string         `json:"memoryId"`
+	Version   int            `json:"version"`
+	Timestamp time.Time      `json:"timestamp"`
+	Author    string         `json:"author,omitempty"`
+	Snapshot  map[string]any `json:"snapshot"`
+}
+
+// MemoryHistory is the revision log kept for one memory entry.
+type MemoryHistory struct {
+	MemoryID         string           `json:"memoryId"`
+	CurrentVersion   int              `json:"currentVersion"`
+	Versions         []MemoryRevision `json:"versions"`
+}
+
+func (ms *MemoryStore) memoryHistoryDir() string {
+	return filepath.Join(ms.root, "versions")
+}
+
+// memoryHistoryPath returns the history file recorded for a memory entry.
+func (ms *MemoryStore) memoryHistoryPath(id string) string {
+	return filepath.Join(ms.memoryHistoryDir(), "mem-"+id+".json")
+}
+
+// History returns the recorded revisions for a memory entry.
+func (ms *MemoryStore) History(id string) (*MemoryHistory, error) {
+	if id == "" {
+		return nil, fmt.Errorf("memory ID is required")
+	}
+	data, err := os.ReadFile(ms.memoryHistoryPath(id))
+	if err != nil {
+		if os.IsNotExist(err) {
+			return &MemoryHistory{MemoryID: id, Versions: []MemoryRevision{}}, nil
+		}
+		return nil, fmt.Errorf("read memory history: %w", err)
+	}
+	var history MemoryHistory
+	if err := json.Unmarshal(data, &history); err != nil {
+		return nil, fmt.Errorf("parse memory history: %w", err)
+	}
+	return &history, nil
+}
+
+// Checkpoint records the current state of a memory entry as a new revision.
+func (ms *MemoryStore) Checkpoint(id string, snapshot map[string]any, author string) (*MemoryRevision, error) {
+	if id == "" {
+		return nil, fmt.Errorf("memory ID is required")
+	}
+	history, err := ms.History(id)
+	if err != nil {
+		return nil, err
+	}
+	version := history.CurrentVersion + 1
+	revision := MemoryRevision{
+		ID:        fmt.Sprintf("v%d", version),
+		MemoryID:  id,
+		Version:   version,
+		Timestamp: time.Now().UTC(),
+		Author:    author,
+		Snapshot:  snapshot,
+	}
+	history.CurrentVersion = version
+	history.Versions = append(history.Versions, revision)
+
+	data, err := json.MarshalIndent(history, "", "  ")
+	if err != nil {
+		return nil, fmt.Errorf("encode memory history: %w", err)
+	}
+	if err := atomicWrite(ms.memoryHistoryPath(id), data); err != nil {
+		return nil, fmt.Errorf("write memory history: %w", err)
+	}
+	return &revision, nil
+}
