index 0000000..f8c475d
--- /dev/null
+++ b/src/tools/preview.ts
@@ -0,0 +1,93 @@
+/**
+ * Resource preview tool — returns the beginning of a resource file without
+ * downloading the whole thing.
+ */
+
+import { z } from "zod";
+import { addDemoFooter } from "../utils/formatting.js";
+import type { McpServer } from "@modelcontextprotocol/sdk/server/mcp.js";
+
+const DEFAULT_MAX_CHARS = 600;
+const MAX_CHARS = 4000;
+
+export function registerPreviewTools(server: McpServer) {
+  server.registerTool(
+    "ckan_resource_preview",
+    {
+      title: "Preview a Resource",
+      description: `Fetch the beginning of a resource file from its download URL and return a text preview.
+
+Useful to inspect a CSV/JSON/XML resource before deciding whether to download it in full.
+The URL is the resource \`url\` reported by \`ckan_list_resources\` or \`ckan_package_show\`.
+
+Args:
+  - url (string): Download URL of the resource
+  - max_chars (number): Maximum number of characters to return (default: ${DEFAULT_MAX_CHARS}, max: ${MAX_CHARS})
+
+Returns:
+  The first characters of the resource, together with its content type.
+
+Typical workflow: ckan_list_resources → ckan_resource_preview → download the file if it looks right`,
+      inputSchema: z.object({
+        url: z.string().url().describe("Download URL of the resource"),
+        max_chars: z.number().int().min(100).max(MAX_CHARS).default(DEFAULT_MAX_CHARS)
+          .describe(`Maximum number of characters to return (default: ${DEFAULT_MAX_CHARS}, max: ${MAX_CHARS})`)
+      }).strict(),
+      annotations: {
+        readOnlyHint: true,
+        destructiveHint: false,
+        idempotentHint: true,
+        openWorldHint: true
+      }
+    },
+    async (params) => {
+      const controller = new AbortController();
+      const timeoutId = setTimeout(() => controller.abort(), 15000);
+      try {
+        const response = await fetch(params.url, {
+          method: "GET",
+          signal: controller.signal,
+          headers: {
+            Accept: "text/csv, application/json, text/plain, */*",
+            "User-Agent": "Mozilla/5.0 (compatible; CKAN-MCP-Server/1.0)"
+          }
+        });
+
+        if (!response.ok) {
+          return {
+            content: [{
+              type: "text" as const,
+              text: `Preview failed: HTTP ${response.status} ${response.statusText}`
+            }],
+            isError: true
+          };
+        }
+
+        const raw = await response.text();
+        const text = raw.slice(0, params.max_chars);
+        const truncated = raw.length > params.max_chars ? "\n\n_…preview truncated._" : "";
+        const header =
+          `# Resource Preview\n\n` +
+          `**URL**: ${params.url}\n` +
+          `**Content type**: ${response.headers.get("content-type") || "unknown"}\n\n`;
+
+        return {
+          content: [{
+            type: "text" as const,
+            text: addDemoFooter(header + "```\n" + text + "\n```" + truncated)
+          }]
+        };
+      } catch (error) {
+        return {
+          content: [{
+            type: "text" as const,
+            text: `Preview failed:\n${error instanceof Error ? error.message : String(error)}`
+          }],
+          isError: true
+        };
+      } finally {
+        clearTimeout(timeoutId);
+      }
+    }
+  );
+}
