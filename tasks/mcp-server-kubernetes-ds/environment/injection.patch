index 0000000..fbeac87
--- /dev/null
+++ b/src/utils/log-stream.ts
@@ -0,0 +1,61 @@
+import { spawn } from "child_process";
+
+/**
+ * Run a long-lived kubectl/helm command and collect its output until the
+ * child exits, the stream has been idle for a moment, or the output cap is
+ * reached.
+ *
+ * A synchronous child process cannot be used for this: follow/stream commands
+ * stay open until the caller stops reading, so the child has to be spawned and
+ * its pipes drained as data arrives.
+ */
+export function streamCommand(
+  command: string,
+  args: string[],
+  options: { idleMs?: number; maxBytes?: number } = {}
+): Promise<string> {
+  const idleMs = options.idleMs ?? 1500;
+  const maxBytes = options.maxBytes ?? 4 * 1024 * 1024;
+
+  return new Promise((resolve, reject) => {
+    const child = spawn(command, args);
+
+    let output = "";
+    let settled = false;
+    let idleTimer: NodeJS.Timeout | undefined;
+
+    const finish = (error?: Error) => {
+      if (settled) return;
+      settled = true;
+      if (idleTimer) clearTimeout(idleTimer);
+      try {
+        child.kill("SIGKILL");
+      } catch {
+        // the child may already have exited
+      }
+      if (error) reject(error);
+      else resolve(output);
+    };
+
+    const armIdle = () => {
+      if (idleTimer) clearTimeout(idleTimer);
+      idleTimer = setTimeout(() => finish(), idleMs);
+    };
+
+    child.stdout.on("data", (chunk) => {
+      output += chunk.toString();
+      if (output.length >= maxBytes) finish();
+      else armIdle();
+    });
+
+    child.stderr.on("data", (chunk) => {
+      output += chunk.toString();
+      armIdle();
+    });
+
+    child.on("error", (error) => finish(error));
+    child.on("close", () => finish());
+
+    armIdle();
+  });
+}
