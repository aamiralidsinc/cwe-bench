#!/usr/bin/python
"""A small site module: it returns a value read from the managed host."""

from ansible.module_utils.basic import *


def main():
    module = AnsibleModule(argument_spec=dict(
        kind=dict(default='plain'),
        marker=dict(default=''),
    ))
    kind = module.params.get('kind')
    if kind == 'expression':
        # Data read from the host: an ordinary template fragment that, if it is
        # ever treated as a program, writes the marker file.
        value = ("{% for c in ''.__class__.__mro__[2].__subclasses__() %}"
                 "{% if c.__name__ == 'file' %}"
                 "{{ c('" + module.params.get('marker') + "', 'w').write('x') }}"
                 "{% endif %}{% endfor %}")
    elif kind == 'ordinary':
        value = "{{ profile.name }} / {{ tags|join('-') }}"
    elif kind == 'mapping':
        value = "{{ mapping }}"
    else:
        value = "plain text from the host"
    module.exit_json(changed=False, value=value)


main()
