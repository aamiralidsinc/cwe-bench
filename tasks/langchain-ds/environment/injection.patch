+    def _handle_copy(self, args: dict, tool_call_id: str | None) -> Command:
+        """Handle copy command."""
+        source = args["path"]
+        new_path = args["new_path"]
+
+        # Read the existing source file. Reuse the same traversal guard the
+        # other commands apply before touching the filesystem.
+        if not source.startswith("/"):
+            source = "/" + source
+        if ".." in source or "~" in source:
+            msg = "Path traversal not allowed"
+            raise ValueError(msg)
+        source_full = (self.root_path / source.lstrip("/")).resolve()
+        if not source_full.exists() or not source_full.is_file():
+            msg = f"File not found: {args['path']}"
+            raise FileNotFoundError(msg)
+        content = source_full.read_text()
+
+        # Validate and contain the destination before writing to it.
+        dest_full = self._validate_and_resolve_path(new_path)
+        dest_full.parent.mkdir(parents=True, exist_ok=True)
+        dest_full.write_text(content)
+
+        return Command(
+            update={
+                "messages": [
+                    ToolMessage(
+                        content=f"File copied: {args['path']} -> {new_path}",
+                        tool_call_id=tool_call_id,
+                        name=self.tool_name,
+                    )
+                ]
+            }
+        )
+
+    def _handle_list(self, args: dict, tool_call_id: str | None) -> Command:
+        """Handle list command: list the entries of a directory."""
+        path = args["path"]
+        if not path.startswith("/"):
+            path = "/" + path
+        if ".." in path or "~" in path:
+            msg = "Path traversal not allowed"
+            raise ValueError(msg)
+
+        directory = self.root_path / path.lstrip("/")
+
+        # Confirm the directory we are about to list sits inside the root.
+        try:
+            directory.relative_to(self.root_path)
+        except ValueError:
+            msg = f"Path outside root directory: {path}"
+            raise ValueError(msg) from None
+
+        if not directory.is_dir():
+            msg = f"Directory not found: {path}"
+            raise FileNotFoundError(msg)
+
+        entries = sorted(entry.name for entry in directory.iterdir())
+        content = "\n".join(entries) if entries else "No files found"
+
+        return Command(
+            update={
+                "messages": [
+                    ToolMessage(
+                        content=content,
+                        tool_call_id=tool_call_id,
+                        name=self.tool_name,
+                    )
+                ]
+            }
+        )
+
+    def _handle_append(self, args: dict, tool_call_id: str | None) -> Command:
+        """Handle append command."""
+        path = args["path"]
+        file_text = args["file_text"]
+
+        # Make sure the directory the text is added to is inside the root.
+        parent = os.path.dirname(path) or "/"
+        self._validate_and_resolve_path(parent)
+
+        full_path = self.root_path / path.lstrip("/")
+        full_path.parent.mkdir(parents=True, exist_ok=True)
+        with full_path.open("a", encoding="utf-8") as handle:
+            handle.write(file_text + "\n")
+
+        return Command(
+            update={
+                "messages": [
+                    ToolMessage(
+                        content=f"Text appended: {path}",
+                        tool_call_id=tool_call_id,
+                        name=self.tool_name,
+                    )
+                ]
+            }
+        )
+
+    def _handle_find(self, args: dict, tool_call_id: str | None) -> Command:
+        """Handle find command: list files whose name matches a pattern."""
+        path = args["path"]
+        pattern = args["pattern"]
+
+        directory = self._validate_and_resolve_path(path)
+
+        matches: list[str] = []
+        for walk_root, _dirs, files in os.walk(directory, followlinks=True):
+            for name in files:
+                if fnmatch.fnmatch(name, pattern):
+                    matches.append(
+                        "/" + str((Path(walk_root) / name).relative_to(self.root_path))
+                    )
+
+        matches.sort()
+        content = "\n".join(matches) if matches else "No files found"
+
+        return Command(
+            update={
+                "messages": [
+                    ToolMessage(
+                        content=content,
+                        tool_call_id=tool_call_id,
+                        name=self.tool_name,
+                    )
+                ]
+            }
+        )
+
 
