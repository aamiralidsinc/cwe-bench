+namespace TYPO3\CMS\Form\Command;
+
+use Symfony\Component\Console\Attribute\AsCommand;
+use Symfony\Component\Console\Command\Command;
+use Symfony\Component\Console\Input\InputArgument;
+use Symfony\Component\Console\Input\InputInterface;
+use Symfony\Component\Console\Input\InputOption;
+use Symfony\Component\Console\Output\OutputInterface;
+use Symfony\Component\Console\Style\SymfonyStyle;
+use TYPO3\CMS\Core\Core\Bootstrap;
+use TYPO3\CMS\Form\Service\FormTransferService;
+
+/**
+ * CLI command to import form definitions from a JSON export into database storage.
+ *
+ * Usage:
+ *   bin/typo3 form:definition:import export.json
+ *   bin/typo3 form:definition:import export.json --pid=42
+ */
+#[AsCommand('form:definition:import', 'Import form definitions from a JSON export into database storage')]
+class ImportFormDefinitionsCommand extends Command
+{
+    public function __construct(
+        private readonly FormTransferService $formTransferService,
+    ) {
+        parent::__construct();
+    }
+
+    protected function configure(): void
+    {
+        $this
+            ->setHelp(
+                'Imports form definitions that were exported from another instance into the database storage.'
+                . LF . 'The file must contain a JSON array of objects with "identifier", "label" and "configuration".'
+            )
+            ->addArgument(
+                'file',
+                InputArgument::REQUIRED,
+                'Path to the JSON export file.',
+            )
+            ->addOption(
+                'pid',
+                null,
+                InputOption::VALUE_REQUIRED,
+                'Page id to store the imported form definitions on.',
+                '0',
+            );
+    }
+
+    protected function execute(InputInterface $input, OutputInterface $output): int
+    {
+        Bootstrap::initializeBackendAuthentication();
+
+        $io = new SymfonyStyle($input, $output);
+        $file = (string)$input->getArgument('file');
+        if (!is_file($file)) {
+            $io->error(sprintf('File "%s" does not exist.', $file));
+            return Command::FAILURE;
+        }
+
+        try {
+            $records = json_decode((string)file_get_contents($file), true, 512, JSON_THROW_ON_ERROR);
+        } catch (\JsonException $e) {
+            $io->error(sprintf('The export file is not valid JSON: %s', $e->getMessage()));
+            return Command::FAILURE;
+        }
+
+        if (!is_array($records)) {
+            $io->error('The export file must contain a JSON array of form definitions.');
+            return Command::FAILURE;
+        }
+
+        $imported = $this->formTransferService->importFromExport($records, (int)$input->getOption('pid'));
+        $io->success(sprintf('Imported %d form definition(s).', $imported));
+        return Command::SUCCESS;
+    }
+}
