+namespace TYPO3\CMS\Form\Service;
+
+use TYPO3\CMS\Core\Database\ConnectionPool;
+use TYPO3\CMS\Form\Domain\Repository\FormDefinitionRepository;
+
+/**
+ * Applies a stored preset to an existing database form definition.
+ *
+ * A preset is a partial form definition (for example a set of finishers or
+ * rendering options) that is merged into a stored definition. The tool is used
+ * to roll out common settings to several stored forms at once.
+ *
+ * @internal
+ */
+final readonly class FormDefinitionPresetService
+{
+    public function __construct(
+        private ConnectionPool $connectionPool,
+        private FormDefinitionRepository $formDefinitionRepository,
+    ) {}
+
+    /**
+     * Merge the preset into the stored definition and persist the result.
+     *
+     * @param array<string, mixed> $preset
+     * @throws \JsonException
+     */
+    public function applyPreset(int $uid, array $preset): void
+    {
+        $record = $this->formDefinitionRepository->findByUid($uid);
+        if ($record === null) {
+            throw new \RuntimeException(
+                sprintf('Form definition "%d" does not exist.', $uid),
+                1774366010
+            );
+        }
+        $definition = json_decode((string)$record['configuration'], true, 512, JSON_THROW_ON_ERROR);
+        if (!is_array($definition)) {
+            throw new \RuntimeException(
+                sprintf('Form definition "%d" has an invalid configuration.', $uid),
+                1774366011
+            );
+        }
+        $connection = $this->connectionPool->getConnectionForTable(FormDefinitionRepository::TABLE_NAME);
+        $connection->update(
+            FormDefinitionRepository::TABLE_NAME,
+            ['configuration' => array_replace($definition, $preset)],
+            ['uid' => $uid]
+        );
+    }
+}
