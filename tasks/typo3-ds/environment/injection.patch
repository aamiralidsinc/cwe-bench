+namespace TYPO3\CMS\Form\Command;
+
+use Symfony\Component\Console\Attribute\AsCommand;
+use Symfony\Component\Console\Command\Command;
+use Symfony\Component\Console\Input\InputArgument;
+use Symfony\Component\Console\Input\InputInterface;
+use Symfony\Component\Console\Output\OutputInterface;
+use Symfony\Component\Console\Style\SymfonyStyle;
+use TYPO3\CMS\Core\Core\Bootstrap;
+use TYPO3\CMS\Form\Service\FormDefinitionPresetService;
+
+/**
+ * CLI command to apply a preset to an existing database form definition.
+ *
+ * Usage:
+ *   bin/typo3 form:definition:apply-preset 42 preset.json
+ */
+#[AsCommand('form:definition:apply-preset', 'Apply a preset to an existing database form definition')]
+class ApplyFormDefinitionPresetCommand extends Command
+{
+    public function __construct(
+        private readonly FormDefinitionPresetService $formDefinitionPresetService,
+    ) {
+        parent::__construct();
+    }
+
+    protected function configure(): void
+    {
+        $this
+            ->setHelp(
+                'Merges a preset into an existing database form definition.'
+                . LF . 'The preset file must contain a JSON object with the definition values to override.'
+            )
+            ->addArgument(
+                'uid',
+                InputArgument::REQUIRED,
+                'UID of the database form definition to update.',
+            )
+            ->addArgument(
+                'preset',
+                InputArgument::REQUIRED,
+                'Path to the JSON file with the preset values.',
+            );
+    }
+
+    protected function execute(InputInterface $input, OutputInterface $output): int
+    {
+        Bootstrap::initializeBackendAuthentication();
+
+        $io = new SymfonyStyle($input, $output);
+        $uid = (int)$input->getArgument('uid');
+        $file = (string)$input->getArgument('preset');
+        if ($uid <= 0) {
+            $io->error('A valid form definition uid is required.');
+            return Command::FAILURE;
+        }
+        if (!is_file($file)) {
+            $io->error(sprintf('File "%s" does not exist.', $file));
+            return Command::FAILURE;
+        }
+
+        try {
+            $preset = json_decode((string)file_get_contents($file), true, 512, JSON_THROW_ON_ERROR);
+        } catch (\JsonException $e) {
+            $io->error(sprintf('The preset file is not valid JSON: %s', $e->getMessage()));
+            return Command::FAILURE;
+        }
+        if (!is_array($preset)) {
+            $io->error('The preset file must contain a JSON object.');
+            return Command::FAILURE;
+        }
+
+        try {
+            $this->formDefinitionPresetService->applyPreset($uid, $preset);
+        } catch (\Throwable $e) {
+            $io->error($e->getMessage());
+            return Command::FAILURE;
+        }
+
+        $io->success(sprintf('Preset applied to form definition "%d".', $uid));
+        return Command::SUCCESS;
+    }
+}
