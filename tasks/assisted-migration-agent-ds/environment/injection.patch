diff --git a/internal/services/inspector_meta.go b/internal/services/inspector_meta.go
new file mode 100644
index 0000000..dc6854b
--- /dev/null
+++ b/internal/services/inspector_meta.go
@@ -0,0 +1,43 @@
+package services
+
+import (
+	"context"
+	"crypto/tls"
+	"fmt"
+	"net/http"
+	"net/url"
+	"time"
+)
+
+// vCenterVersion queries the vCenter REST API for the appliance version. The
+// inspector records it with the run so results can be correlated with the
+// vCenter build they were collected from.
+func vCenterVersion(ctx context.Context, vcenterURL string) (string, error) {
+	u, err := url.Parse(vcenterURL)
+	if err != nil {
+		return "", fmt.Errorf("failed to parse vCenter URL: %w", err)
+	}
+	if u.Host == "" {
+		return "", fmt.Errorf("vCenter URL has no host: %q", vcenterURL)
+	}
+
+	client := &http.Client{
+		Timeout: 5 * time.Second,
+		Transport: &http.Transport{
+			TLSClientConfig: &tls.Config{InsecureSkipVerify: true},
+		},
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, u.Scheme+"://"+u.Host+"/rest/appliance/system/version", nil)
+	if err != nil {
+		return "", err
+	}
+	resp, err := client.Do(req)
+	if err != nil {
+		return "", err
+	}
+	defer func() { _ = resp.Body.Close() }()
+	if resp.StatusCode != http.StatusOK {
+		return "", fmt.Errorf("vCenter REST version request returned %d", resp.StatusCode)
+	}
+	return resp.Header.Get("X-Vcenter-Version"), nil
+}
diff --git a/pkg/vmware/endpoint.go b/pkg/vmware/endpoint.go
new file mode 100644
index 0000000..01b8199
--- /dev/null
+++ b/pkg/vmware/endpoint.go
@@ -0,0 +1,33 @@
+package vmware
+
+import (
+	"context"
+	"crypto/tls"
+	"fmt"
+	"net"
+	"net/url"
+	"time"
+)
+
+// CheckEndpoint performs a quick TLS reachability check against the vCenter
+// endpoint before a long-running pipeline starts, so that an unreachable
+// endpoint fails fast instead of being retried by every stage.
+func CheckEndpoint(ctx context.Context, vcenterURL string) error {
+	u, err := url.Parse(vcenterURL)
+	if err != nil {
+		return fmt.Errorf("failed to parse vCenter URL: %w", err)
+	}
+	if u.Host == "" {
+		return fmt.Errorf("vCenter URL has no host: %q", vcenterURL)
+	}
+
+	dialer := &tls.Dialer{
+		NetDialer: &net.Dialer{Timeout: 5 * time.Second},
+		Config:    &tls.Config{InsecureSkipVerify: true},
+	}
+	conn, err := dialer.DialContext(ctx, "tcp", u.Host)
+	if err != nil {
+		return fmt.Errorf("vCenter endpoint unreachable: %w", err)
+	}
+	return conn.Close()
+}
