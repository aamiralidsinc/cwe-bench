+    public void doRefresh(HttpServletRequest req, HttpServletResponse rsp) throws IOException {
+        int refreshed = 0;
+        for (Cloud cloud : Jenkins.get().clouds) {
+            if (cloud instanceof EC2FleetCloud) {
+                try {
+                    ((EC2FleetCloud) cloud).update();
+                    refreshed++;
+                } catch (Exception e) {
+                    // ignore clouds that cannot be refreshed right now
+                }
+            }
+        }
+        rsp.setContentType("application/json");
+        rsp.getWriter().write("{\"refreshed\":" + refreshed + "}");
+    }
 }
