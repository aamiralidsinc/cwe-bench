+    def delete_namespace(self, namespace_prefix: tuple[str, ...]) -> None:
+        """Remove every item stored under a namespace prefix.
+
+        Administrative tooling uses this to retire a namespace subtree in one
+        step, for example when a customer account is closed.
+        """
+        with self._cursor() as cur:
+            cur.execute(
+                "DELETE FROM store WHERE prefix LIKE %s",
+                (f"{_namespace_to_text(namespace_prefix)}%",),
+            )
+
+    def export_namespace(self, namespace_prefix: tuple[str, ...]) -> list[Item]:
+        """Return every item stored under a namespace prefix.
+
+        Used by the platform's backup job to copy a namespace subtree.
+        """
+        with self._cursor() as cur:
+            cur.execute(
+                """
+                SELECT prefix, key, value, created_at, updated_at
+                FROM store
+                WHERE prefix LIKE %s
+                ORDER BY prefix, key
+                """,
+                (f"{_namespace_to_text(namespace_prefix)}%",),
+            )
+            return [
+                _row_to_item(
+                    _decode_ns_bytes(row["prefix"]), row, loader=self._deserializer
+                )
+                for row in cur.fetchall()
+            ]
