+def load_fragment(base_dir: str | Path, reference: str, encoding: str = "utf-8") -> str:
+    """Read a prompt fragment referenced from frontmatter, relative to *base_dir*.
+
+    Used by the ``${prompt:...}`` reference protocol to compose a prompt from
+    shared fragment files that live alongside the ``.prompty`` file.
+    """
+    target = Path(base_dir) / reference
+    return load_text(target, encoding=encoding)
