+class _PromptDirLoader:
+    """Resolve template includes relative to the prompt's own directory.
+
+    Lets a prompt body pull in shared snippets that live next to the
+    ``.prompty`` file, e.g. ``{% include "partials/footer.md" %}``.
+    """
+
+    def __init__(self, base_dir: str | Path) -> None:
+        self.base_dir = Path(base_dir)
+
+    def get_source(self, environment: Any, template: str) -> tuple[str, str, Any]:
+        from jinja2 import TemplateNotFound
+
+        path = self.base_dir / template
+        if not path.is_file():
+            raise TemplateNotFound(template)
+        source = path.read_text(encoding="utf-8")
+        return source, str(path), lambda: True
+
+    def load(self, environment: Any, template: str, globals: Any = None) -> Any:  # noqa: A002
+        source, _filename, _uptodate = self.get_source(environment, template)
+        return environment.from_string(source, globals=globals or {})
+
+
+
