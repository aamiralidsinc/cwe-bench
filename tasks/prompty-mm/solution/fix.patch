+
+/**
+ * Resolve `reference` against `baseDir`, rejecting anything that escapes it.
+ *
+ * Absolute paths, `..` traversal and symlinks that point outside `baseDir`
+ * all land outside the directory and are rejected before any file is opened.
+ */
+function containPath(baseDir: string, reference: string): string {
+  const root = realpathSync(baseDir);
+  const candidate = isAbsolute(reference) ? resolve(reference) : resolve(root, reference);
+  const resolved = existsSync(candidate) ? realpathSync(candidate) : resolve(candidate);
+  const rel = relative(root, resolved);
+  if (rel !== "" && (rel.startsWith("..") || isAbsolute(rel))) {
+    throw new Error(`Reference '${reference}' resolves outside the directory '${root}'`);
+  }
+  return resolved;
+}
