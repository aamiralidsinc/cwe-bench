+def contain_path(base_dir: str | Path, reference: str) -> Path:
+    """Resolve *reference* against *base_dir*, rejecting anything that escapes it.
+
+    Absolute paths, ``..`` traversal and symlinks that point outside *base_dir*
+    all land outside the directory and are rejected before any file is opened.
+    """
+    root = Path(base_dir).resolve()
+    candidate = Path(reference)
+    if not candidate.is_absolute():
+        candidate = root / candidate
+    resolved = candidate.resolve()
+    if resolved != root and not resolved.is_relative_to(root):
+        raise ValueError(f"Reference '{reference}' resolves outside the directory '{root}'")
+    return resolved
+
+
 def load_fragment(base_dir: str | Path, reference: str, encoding: str = "utf-8") -> str:
     """Read a prompt fragment referenced from frontmatter, relative to *base_dir*.
 
     Used by the ``${prompt:...}`` reference protocol to compose a prompt from
     shared fragment files that live alongside the ``.prompty`` file.
     """
-    target = Path(base_dir) / reference
+    target = contain_path(base_dir, reference)
     return load_text(target, encoding=encoding)
 
 
