+    /**
+     * Downloads an old revision of this job's configuration.
+     *
+     * @param req incoming request
+     * @param rsp outgoing response
+     * @throws IOException if the revision cannot be read or written.
+     */
+    public final void doDownload(StaplerRequest2 req, StaplerResponse2 rsp) throws IOException {
+        if (!hasConfigurePermission() && !hasReadExtensionPermission()) {
+            checkConfigurePermission();
+            return;
+        }
+        final String timestamp = req.getParameter("timestamp");
+        final XmlFile xmlFile = getOldConfigXml(timestamp);
+        rsp.setContentType("application/xml;charset=UTF-8");
+        rsp.getWriter().write(xmlFile.asString());
+    }
