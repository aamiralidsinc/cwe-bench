diff -ruN base/server/origin.go oracle/server/origin.go
--- base/server/origin.go	1970-01-01 00:00:00.000000000 +0000
+++ oracle/server/origin.go	2026-10-26 02:22:45.598040860 +0000
@@ -0,0 +1,80 @@
+package server
+
+import (
+	"net/http"
+	"net/url"
+	"strings"
+)
+
+// requestScheme returns the scheme the client used to reach this server.
+func requestScheme(r *http.Request) string {
+	if r.TLS != nil {
+		return "https"
+	}
+	return "http"
+}
+
+// configuredOrigins returns the origins the operator has allowed for cross-origin use.
+func configuredOrigins() []string {
+	return strings.FieldsFunc(AccessControlAllowOrigin, func(c rune) bool {
+		return c == ',' || c == ' ' || c == '\t' || c == '\n' || c == '\r'
+	})
+}
+
+// originAllowed reports whether a request may proceed based on its Origin header.
+// A request without an Origin header does not originate from a cross-origin browser
+// context and is allowed. A present Origin must be this server's own origin, or an
+// origin the operator has configured.
+func originAllowed(r *http.Request) bool {
+	values := r.Header.Values("Origin")
+	if len(values) == 0 {
+		return true
+	}
+	origin := strings.TrimSpace(values[0])
+	if origin == "" {
+		return true
+	}
+
+	u, err := url.Parse(origin)
+	if err != nil || u.Host == "" || (u.Scheme != "http" && u.Scheme != "https") {
+		return false
+	}
+
+	// Same origin as the request itself.
+	if strings.EqualFold(u.Scheme, requestScheme(r)) && strings.EqualFold(u.Host, r.Host) {
+		return true
+	}
+
+	// Operator-configured origins: a full origin (scheme://host[:port]), a bare
+	// host[:port], or the wildcard.
+	for _, entry := range configuredOrigins() {
+		if entry == "*" {
+			return true
+		}
+
+		host, scheme := entry, ""
+		if strings.Contains(entry, "://") {
+			a, err := url.Parse(entry)
+			if err != nil {
+				continue
+			}
+			host, scheme = a.Host, a.Scheme
+		}
+
+		if host != "" && strings.EqualFold(host, u.Host) &&
+			(scheme == "" || strings.EqualFold(scheme, u.Scheme)) {
+			return true
+		}
+	}
+
+	return false
+}
+
+// isStateChangingMethod reports whether a method is unsafe for cross-origin requests.
+func isStateChangingMethod(method string) bool {
+	switch method {
+	case http.MethodGet, http.MethodHead, http.MethodOptions:
+		return false
+	}
+	return true
+}
