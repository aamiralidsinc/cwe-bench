+def _reject_host_header(headers: Iterable[Header]) -> Generator[Header, None, None]:
+    """
+    Raises a ProtocolError if a request trailer block names the host, which the
+    request's opening block has already named.
+    """
+    for header in headers:
+        if header[0] == b"host":
+            msg = "Request trailer block must not contain a Host header."
+            raise ProtocolError(msg)
+
+        yield header
