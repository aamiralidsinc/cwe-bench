<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.3/phpunit.xsd"
    bootstrap="/workspace/framework/core/vendor/autoload.php"
    backupGlobals="false"
    backupStaticAttributes="false"
    colors="false"
    convertErrorsToExceptions="true"
    convertNoticesToExceptions="true"
    convertWarningsToExceptions="true"
    processIsolation="true"
    stopOnFailure="false"
>
    <testsuites>
        <testsuite name="project">
            <file>/workspace/framework/core/tests/integration/api/settings/SetTest.php</file>
            <file>/workspace/framework/core/tests/integration/extenders/SettingsTest.php</file>
            <file>/workspace/framework/core/tests/integration/extenders/ThemeTest.php</file>
        </testsuite>
    </testsuites>
</phpunit>
