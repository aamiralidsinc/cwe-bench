diff --git a/lib/service/recover.js b/lib/service/recover.js
new file mode 100644
index 000000000..df71ae21b
--- /dev/null
+++ b/lib/service/recover.js
@@ -0,0 +1,30 @@
+var fs = require('fs');
+var parseUrl = require('url').parse;
+
+var RECOVER_RE = /^\/cgi-bin\/composer\/recover(?:\?|$)/;
+
+function isRecoverUrl(url) {
+  return RECOVER_RE.test(url || '');
+}
+
+function sendJson(res, body) {
+  res.setHeader('Content-Type', 'application/json; charset=utf-8');
+  res.end(JSON.stringify(body));
+}
+
+function handle(req, res) {
+  var file = parseUrl(req.url, true).query.file;
+  if (!file || typeof file !== 'string') {
+    return sendJson(res, { ec: 400, em: 'Bad file' });
+  }
+  fs.readFile(file, function(err, data) {
+    if (err) {
+      return sendJson(res, { ec: 2, em: err.message });
+    }
+    res.setHeader('Content-Type', 'text/plain; charset=utf-8');
+    res.end(data);
+  });
+}
+
+exports.isRecoverUrl = isRecoverUrl;
+exports.handle = handle;
