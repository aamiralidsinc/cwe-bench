+++ b/handlebars/src/main/java/com/github/jknack/handlebars/io/ServletContextTemplateLoader.java
@@ -60,6 +60,11 @@ public class ServletContextTemplateLoader extends URLTemplateLoader {
 
   @Override
   protected URL getResource(final String location) throws IOException {
+    // Absolute context paths are already rooted at the web application root, so the
+    // container resolves them directly; pass them straight through.
+    if (location.startsWith("/")) {
+      return servletContext.getResource(location);
+    }
     return servletContext.getResource(classpathResource(location));
   }
 }
