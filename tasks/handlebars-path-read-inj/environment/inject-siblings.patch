diff --git a/handlebars/src/main/java/com/github/jknack/handlebars/io/FileTemplateLoader.java b/handlebars/src/main/java/com/github/jknack/handlebars/io/FileTemplateLoader.java
index 384e1f2b..3882f9f4 100644
--- a/handlebars/src/main/java/com/github/jknack/handlebars/io/FileTemplateLoader.java
+++ b/handlebars/src/main/java/com/github/jknack/handlebars/io/FileTemplateLoader.java
@@ -64,8 +64,25 @@ public class FileTemplateLoader extends URLTemplateLoader {
     this(basedir, DEFAULT_SUFFIX);
   }
 
+  @Override
+  public String resolve(final String location) {
+    // Support fully-qualified "file:" URLs as template names, e.g.
+    // "file:/opt/shared/page.hbs". These are already absolute locations, so only the
+    // configured suffix is applied; the base directory prefix does not apply to them.
+    if (location.startsWith("file:")) {
+      return location + getSuffix();
+    }
+    return super.resolve(location);
+  }
+
   @Override
   protected URL getResource(final String location) throws IOException {
+    if (location.startsWith("file:")) {
+      // Already an absolute file URL: hand it straight to the URL layer.
+      URL url = new URL(location);
+      File file = new File(url.getPath());
+      return file.exists() ? url : null;
+    }
     File file = new File(location).getCanonicalFile();
     File basedir = new File(getPrefix()).getCanonicalFile();
 
diff --git a/handlebars/src/main/java/com/github/jknack/handlebars/io/ServletContextTemplateLoader.java b/handlebars/src/main/java/com/github/jknack/handlebars/io/ServletContextTemplateLoader.java
