--- orig/src/client/async.rs	2026-10-18 19:18:29.000000000 +0000
+++ base/src/client/async.rs	2026-10-18 23:42:01.186736984 +0000
@@ -3326,6 +3326,74 @@
     ) -> Result<RestoreStageResponse, ApiError> {
         self.client.restore_status(restore_id, capability).await
     }
+
+    /// Stage a backup document and poll until the restore reaches a terminal state.
+    pub fn run(&self, document: &BackupDocument) -> RestoreRunOp {
+        RestoreRunOp::new(self.client.clone(), document.clone())
+    }
+}
+
+pub struct RestoreRunOp {
+    client: Client<Authenticated>,
+    document: BackupDocument,
+    poll_interval: std::time::Duration,
+    timeout: Option<std::time::Duration>,
+}
+
+impl RestoreRunOp {
+    fn new(client: Client<Authenticated>, document: BackupDocument) -> Self {
+        Self {
+            client,
+            document,
+            poll_interval: std::time::Duration::from_secs(1),
+            timeout: Some(std::time::Duration::from_secs(300)),
+        }
+    }
+
+    pub fn poll_interval(mut self, interval: std::time::Duration) -> Self {
+        self.poll_interval = interval;
+        self
+    }
+
+    pub fn timeout(mut self, timeout: Option<std::time::Duration>) -> Self {
+        self.timeout = timeout;
+        self
+    }
+
+    pub async fn send(self) -> Result<RestoreStageResponse, ApiError> {
+        let restores = Restores::new(self.client.clone());
+        let mut staged = restores.stage(&self.document).await?;
+        let capability = staged.restore_capability.clone().ok_or_else(|| {
+            ApiError::EmptyResult("Restore stage returned no capability".into())
+        })?;
+        let started = std::time::Instant::now();
+        loop {
+            if staged.status.is_terminal() {
+                if matches!(staged.status, crate::types::RestoreJobStatus::Failed) {
+                    return Err(ApiError::Api(format!(
+                        "Restore {} {:?}: {}",
+                        staged.id,
+                        staged.status,
+                        staged
+                            .error
+                            .clone()
+                            .unwrap_or_else(|| "no error detail".to_string())
+                    )));
+                }
+                return Ok(staged);
+            }
+            if let Some(timeout) = self.timeout
+                && started.elapsed() >= timeout
+            {
+                return Err(ApiError::Api(format!(
+                    "Restore {} did not finish in time",
+                    staged.id
+                )));
+            }
+            tokio::time::sleep(self.poll_interval).await;
+            staged = restores.status(staged.id, &capability).await?;
+        }
+    }
 }
 
