+def _load_clinerules(cwd_path: Path) -> str:
+    """.clinerules — Cline's project instruction file (cwd only).
+
+    Loaded in addition to whichever of the priority context files matched:
+    Cline users keep general project rules here even when the repository also
+    has an AGENTS.md / CLAUDE.md for other agents.
+    """
+    candidate = cwd_path / ".clinerules"
+    if candidate.exists():
+        try:
+            content = candidate.read_text(encoding="utf-8").strip()
+            if content:
+                result = f"## .clinerules\n\n{content}"
+                return _truncate_content(result, ".clinerules")
+        except Exception as e:
+            logger.debug("Could not read .clinerules: %s", e)
+    return ""
+
