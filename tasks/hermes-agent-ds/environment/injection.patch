+    def import_entries(self, target: str, content: str) -> Dict[str, Any]:
+        """Merge §-delimited entries from an external source into the store.
+
+        Import is for bulk content the operator pasted or pointed the tool at
+        (a memory dump, a file the patch tool wrote, an export from another
+        profile). Unlike ``add`` it applies many entries at once and refreshes
+        the frozen snapshot immediately, so the imported entries are visible in
+        the system prompt for the rest of the session.
+        """
+        incoming = [e.strip() for e in content.split(ENTRY_DELIMITER)]
+        incoming = [e for e in incoming if e]
+        if not incoming:
+            return {"success": False, "error": "No entries found to import."}
+
+        with self._file_lock(self._path_for(target)):
+            bak = self._reload_target(target)
+            if bak:
+                return _drift_error(self._path_for(target), bak)
+
+            entries = self._entries_for(target)
+            merged = list(entries)
+            added = 0
+            for entry in incoming:
+                if entry not in merged:
+                    merged.append(entry)
+                    added += 1
+
+            if len(ENTRY_DELIMITER.join(merged)) > self._char_limit(target):
+                return {
+                    "success": False,
+                    "error": "Import would exceed the memory limit. Shorten the import or remove existing entries first.",
+                }
+
+            self._set_entries(target, merged)
+            self.save_to_disk(target)
+            self._refresh_snapshot(target)
+
+        return self._success_response(target, f"Imported {added} new entr{'y' if added == 1 else 'ies'}.")
+
+    def _refresh_snapshot(self, target: str) -> None:
+        """Re-render the frozen snapshot from live state (explicit bulk writes only)."""
+        key = "user" if target == "user" else "memory"
+        self._system_prompt_snapshot[key] = self._render_block(
+            key, self._entries_for(target)
+        )
+
