diff --git a/x/bonds/keeper/msg_server.go b/x/bonds/keeper/msg_server.go
index 23a01cc..c476f60 100755
--- a/x/bonds/keeper/msg_server.go
+++ b/x/bonds/keeper/msg_server.go
@@ -844,6 +844,24 @@ func (k msgServer) WithdrawReserve(goCtx context.Context, msg *types.MsgWithdraw
 			"available reserve: %s", bond.AvailableReserve.String())
 	}
 
+	// Reserve withdrawals carry the bond's exit fee, charged to the
+	// withdrawer's DID account before the net amount is released.
+	exitFee := bond.GetExitFees(sdk.NewDecCoinsFromCoins(msg.Amount...))
+	if !exitFee.IsZero() {
+		withdrawerDidDoc, exists := k.iidKeeper.GetDidDocument(ctx, []byte(msg.WithdrawerDid.Did()))
+		if !exists {
+			return nil, errorsmod.Wrap(sdkerrors.ErrInvalidAddress, "withdrawer did not found")
+		}
+		withdrawerAddr, err := withdrawerDidDoc.GetVerificationMethodBlockchainAddress(msg.WithdrawerDid.String())
+		if err != nil {
+			return nil, errorsmod.Wrap(err, "Address not found in iid doc")
+		}
+		if err := k.BankKeeper.SendCoinsFromAccountToModule(
+			ctx, withdrawerAddr, types.BondsReserveAccount, exitFee); err != nil {
+			return nil, err
+		}
+	}
+
 	// Send coins to withdrawer
 	err = k.BankKeeper.SendCoinsFromModuleToAccount(
 		ctx, types.BondsReserveAccount, reserveWithdrawalAddress, msg.Amount)
