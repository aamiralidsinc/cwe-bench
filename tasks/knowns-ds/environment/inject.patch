+// handleMemorySnapshot returns the copy of a memory entry kept from before its
+// last update.
+func handleMemorySnapshot(getStore func() *storage.Store, req mcp.CallToolRequest) (*mcp.CallToolResult, error) {
+	store := getStore()
+	if store == nil {
+		return noProjectError()
+	}
+
+	id, err := req.RequireString("id")
+	if err != nil {
+		return errResult("id is required")
+	}
+
+	layer, _ := stringArg(req.GetArguments(), "layer")
+	if layer == "" {
+		layer = models.MemoryLayerProject
+	}
+
+	entry, err := store.Memory.ReadSnapshot(id, layer)
+	if err != nil {
+		return errNotFound("memory snapshot", err)
+	}
+
+	out, _ := json.MarshalIndent(entry, "", "  ")
+	return mcp.NewToolResultText(string(out)), nil
+}
