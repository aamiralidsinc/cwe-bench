+
+// snapshotDir returns the directory that keeps the copies of memory entries
+// taken before they are overwritten.
+func (ms *MemoryStore) snapshotDir(layer string) (string, error) {
+	dir, err := ms.dirForLayer(layer)
+	if err != nil {
+		return "", err
+	}
+	return filepath.Join(dir, ".snapshots"), nil
+}
+
+// writeSnapshot keeps a copy of an entry as it was before an update so a
+// mistaken edit can be inspected afterwards.
+func (ms *MemoryStore) writeSnapshot(entry *models.MemoryEntry) error {
+	if entry == nil || entry.ID == "" {
+		return nil
+	}
+	dir, err := ms.snapshotDir(entry.Layer)
+	if err != nil {
+		return err
+	}
+	if err := os.MkdirAll(dir, 0755); err != nil {
+		return fmt.Errorf("create memory snapshot dir: %w", err)
+	}
+	return atomicWrite(filepath.Join(dir, models.MemoryFileName(entry.ID)), []byte(renderMemory(entry)))
+}
+
+// ReadSnapshot returns the copy of a memory entry stored by the last update.
+func (ms *MemoryStore) ReadSnapshot(id, layer string) (*models.MemoryEntry, error) {
+	if !models.ValidMemoryLayer(layer) {
+		return nil, fmt.Errorf("invalid memory layer: %q", layer)
+	}
+	dir, err := ms.snapshotDir(layer)
+	if err != nil {
+		return nil, err
+	}
+	absPath := filepath.Join(dir, models.MemoryFileName(id))
+	if _, err := os.Stat(absPath); err != nil {
+		return nil, fmt.Errorf("memory snapshot %q not found in %s layer", id, layer)
+	}
+	return ms.parseFile(absPath, layer)
+}
