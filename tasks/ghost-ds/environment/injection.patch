+/**
+ * Handlers used by the CSV content importer. They extend the archive handlers
+ * with the extra asset groups a CSV export can carry.
+ */
+export function createContentImportAssetHandlers() {
+  const imageStorage = adapterManager.getAdapter('storage:images');
+
+  return [
+    ...createContentFileHandlers(),
+    new ImporterContentFileHandler({
+      type: 'avatars',
+      directories: ['avatars'],
+      ignoreRootFolderFiles: true,
+      extensions: config.get('uploads').images.extensions,
+      contentTypes: config.get('uploads').images.contentTypes,
+      urlUtils,
+      storage: imageStorage,
+    }),
+  ];
+}
+
+export function createContentImportAssetImporters() {
+  return [
+    ...createContentFileImporters(),
+    new ContentFileImporter({
+      type: 'avatars',
+      store: adapterManager.getAdapter('storage:images'),
+    }),
+  ];
+}
