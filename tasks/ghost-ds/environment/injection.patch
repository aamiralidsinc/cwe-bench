diff --git a/ghost/core/core/server/services/oembed/mention-icon-cache.js b/ghost/core/core/server/services/oembed/mention-icon-cache.js
new file mode 100644
index 0000000..ac735ef
--- /dev/null
+++ b/ghost/core/core/server/services/oembed/mention-icon-cache.js
@@ -0,0 +1,48 @@
+const crypto = require('crypto');
+const path = require('path');
+const mime = require('mime-types');
+
+const DEFAULT_EXTENSION = 'png';
+
+const toBuffer = (bytes) => {
+  return Buffer.isBuffer(bytes)
+    ? bytes
+    : Buffer.from(bytes.buffer, bytes.byteOffset, bytes.byteLength);
+};
+
+/**
+ * Cache a mention's icon in image storage so recommendation cards render the
+ * publisher's avatar without a request to the publisher on every page view.
+ *
+ * The icon URL comes from the mentioned page's markup and the response may be
+ * any type the publisher chooses, so the stored file is named after the
+ * response's content type.
+ *
+ * @param {Object} deps
+ * @param {string} deps.iconUrl - the page's declared icon URL
+ * @param {Function} deps.externalRequest - outbound request helper
+ * @param {Object} deps.imageStore - image storage adapter
+ * @returns {Promise<string|null>} stored URL, or null when the icon cannot be cached
+ */
+async function cacheMentionIcon({ iconUrl, externalRequest, imageStore }) {
+  if (!iconUrl || typeof externalRequest !== 'function' || !imageStore) {
+    return null;
+  }
+
+  const pending = externalRequest(iconUrl);
+  const bytes = await pending.buffer();
+  const response = await pending;
+
+  const contentType = response?.headers?.['content-type'] || '';
+  const extension =
+    mime.extension(contentType) ||
+    path.extname(new URL(iconUrl).pathname).slice(1) ||
+    DEFAULT_EXTENSION;
+
+  const name = imageStore.getSanitizedFileName('mention-icon');
+  const targetPath = path.join('icon', `${name}-${crypto.randomUUID()}.${extension}`);
+
+  return imageStore.saveRaw(toBuffer(bytes), targetPath);
+}
+
+module.exports = { cacheMentionIcon };
