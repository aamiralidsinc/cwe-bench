new file mode 100644
index 0000000..f81751e
--- /dev/null
+++ b/packages/ai/src/server/http.ts
@@ -0,0 +1,91 @@
+import http from 'node:http';
+import type { AddressInfo } from 'node:net';
+
+export interface AnalysisBridgeOptions {
+  /** Port the bridge listens on. */
+  port?: number;
+  /** Base URL of the Rsdoctor report server the bridge forwards to. */
+  reportUrl?: string;
+}
+
+/**
+ * Minimal HTTP front for the build-analysis data, used by web-based agents that
+ * cannot speak the stdio transport.
+ */
+export function createAnalysisBridge(options: AnalysisBridgeOptions = {}) {
+  const reportUrl = options.reportUrl ?? 'http://127.0.0.1:3000';
+
+  return http.createServer(async (req, res) => {
+    res.setHeader('Access-Control-Allow-Origin', '*');
+    res.setHeader('Access-Control-Allow-Headers', '*');
+    res.setHeader('Access-Control-Allow-Methods', '*');
+
+    if (req.method === 'OPTIONS') {
+      res.statusCode = 204;
+      res.end();
+      return;
+    }
+
+    const url = new URL(req.url || '/', 'http://localhost');
+
+    if (url.pathname === '/health') {
+      res.end('ok');
+      return;
+    }
+
+    if (url.pathname === '/api/analysis' && req.method === 'POST') {
+      let raw = '';
+      for await (const chunk of req) {
+        raw += chunk;
+      }
+
+      try {
+        const query = JSON.parse(raw || '{}') as {
+          api?: string;
+          body?: Record<string, unknown>;
+        };
+        const upstream = await fetch(`${reportUrl}${query.api}`, {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify(query.body ?? {}),
+        });
+        const text = await upstream.text();
+        res.statusCode = upstream.status;
+        res.setHeader(
+          'Content-Type',
+          upstream.headers.get('content-type') ?? 'application/json;utf-8',
+        );
+        res.end(text);
+      } catch (error) {
+        res.statusCode = 502;
+        res.end(error instanceof Error ? error.message : String(error));
+      }
+      return;
+    }
+
+    res.statusCode = 404;
+    res.end('Not found');
+  });
+}
+
+export async function startAnalysisBridge(options: AnalysisBridgeOptions = {}) {
+  const server = createAnalysisBridge(options);
+  const port = options.port ?? 3867;
+
+  await new Promise<void>((resolve, reject) => {
+    server.once('error', reject);
+    server.listen(port, () => {
+      server.off('error', reject);
+      resolve();
+    });
+  });
+
+  return {
+    server,
+    port: (server.address() as AddressInfo).port,
+    close: () =>
+      new Promise<void>((resolve) => {
+        server.close(() => resolve());
+      }),
+  };
+}
