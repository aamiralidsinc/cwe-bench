+    /**
+     * Downloads a remote file to the given path, refusing destinations that
+     * resolve to addresses the site should not be able to reach.
+     */
+    private function fetchToPath(string $url, string $tempPath): void
+    {
+        $client = $this->createGuzzleClient();
+        $currentUrl = $url;
+
+        for ($hops = 0; $hops <= 5; $hops++) {
+            [$host, $port, $ip] = $this->assertAllowedUrl($currentUrl);
+
+            $options = [
+                RequestOptions::ALLOW_REDIRECTS => false,
+                RequestOptions::SINK => $tempPath,
+            ];
+
+            if ($ip !== null) {
+                $resolveIp = str_contains($ip, ':') ? "[$ip]" : $ip;
+                $options['curl'] = [
+                    CURLOPT_RESOLVE => ["$host:$port:$resolveIp"],
+                ];
+            }
+
+            $response = $client->request('GET', $currentUrl, $options);
+            $status = $response->getStatusCode();
+
+            if ($status >= 300 && $status < 400) {
+                $location = $response->getHeaderLine('Location');
+                if ($location === '') {
+                    throw new UserError("$currentUrl redirected without a location.");
+                }
+                $currentUrl = (string)UriResolver::resolve(new Uri($currentUrl), new Uri($location));
+                continue;
+            }
+
+            if ($status >= 400) {
+                throw new UserError("$currentUrl returned an error.");
+            }
+
+            return;
+        }
+
+        throw new UserError('Too many redirects.');
+    }
