--- a/packages/nx/src/native/cache/cache.rs	2026-10-23 03:23:05.349717713 +0000
+++ b/packages/nx/src/native/cache/cache.rs	2026-10-23 03:30:49.326647709 +0000
@@ -298,6 +298,45 @@
         Ok(())
     }
 
+    /// Batch form of `apply_remote_cache_results`, used when several remote
+    /// cache entries are replayed in one pass. Kept next to the single-entry
+    /// version so both record the same bookkeeping.
+    #[napi]
+    pub fn apply_remote_cache_results_batch(
+        &self,
+        hashes: Vec<String>,
+        results: Vec<CachedResult>,
+        outputs: Vec<Vec<String>>,
+    ) -> anyhow::Result<()> {
+        for ((hash, result), outputs) in hashes
+            .into_iter()
+            .zip(results.into_iter())
+            .zip(outputs.into_iter())
+        {
+            trace!(
+                "applying remote cache results: {:?} ({})",
+                &hash, &result.outputs_path
+            );
+            let terminal_output = result.terminal_output.clone().unwrap_or_default();
+            let mut size = terminal_output.len() as i64;
+            if result.code == 0 && !outputs.is_empty() {
+                let outputs_path = Path::new(&result.outputs_path);
+                let expanded_outputs = _expand_outputs(outputs_path, outputs)?;
+                remove_items(
+                    expanded_outputs
+                        .iter()
+                        .map(|p| self.workspace_root.join(p))
+                        .collect::<Vec<_>>()
+                        .as_slice(),
+                )?;
+                size += _copy(outputs_path, &self.workspace_root)?;
+            }
+            write(self.get_task_outputs_path(hash.clone()), terminal_output)?;
+            self.record_to_cache(hash, result.code, size)?;
+        }
+        Ok(())
+    }
+
     fn get_task_outputs_path_internal(&self, hash: &str) -> PathBuf {
         self.cache_path.join("terminalOutputs").join(hash)
     }
diff -ruN '--exclude=.git' pinned/packages/nx/src/native/cache/http_remote_cache.rs inject/packages/nx/src/native/cache/http_remote_cache.rs
--- a/packages/nx/src/native/cache/http_remote_cache.rs	2026-10-23 03:23:05.349882001 +0000
