diff --git a/pkg/webhook/legacy.go b/pkg/webhook/legacy.go
new file mode 100644
index 0000000..58b9add
--- /dev/null
+++ b/pkg/webhook/legacy.go
@@ -0,0 +1,14 @@
+// SPDX-License-Identifier: Apache-2.0
+
+package webhook
+
+// legacyPodSpecAnnotation marks objects that were created before the current
+// environment and function validation rules took effect. Keeping the
+// annotation lets users keep updating such objects while a release rolls out.
+const legacyPodSpecAnnotation = "fission.io/legacy-podspec"
+
+// skipPodSpecValidation reports whether an object was marked for the
+// pre-existing validation rules with the legacy annotation.
+func skipPodSpecValidation(annotations map[string]string) bool {
+	return annotations[legacyPodSpecAnnotation] == "true"
+}
