diff --git a/pkg/executor/util/pod_overrides.go b/pkg/executor/util/pod_overrides.go
new file mode 100644
index 0000000..1250990
--- /dev/null
+++ b/pkg/executor/util/pod_overrides.go
@@ -0,0 +1,70 @@
+// SPDX-License-Identifier: Apache-2.0
+
+package util
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"strings"
+
+	apiv1 "k8s.io/api/core/v1"
+	apierrors "k8s.io/apimachinery/pkg/api/errors"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/util/strategicpatch"
+	"k8s.io/client-go/kubernetes"
+	"sigs.k8s.io/yaml"
+)
+
+// NamespacePodOverridesConfigMap is the ConfigMap a namespace uses to supply
+// pod settings that apply to the platform pods created for it. The "podspec"
+// key holds a YAML or JSON pod-spec fragment that is merged into the pod after
+// the typed pod spec, in the same way as the runtime pod spec patch.
+const NamespacePodOverridesConfigMap = "fission-pod-overrides"
+
+// NamespacePodOverridesKey is the data key that holds the pod-spec fragment.
+const NamespacePodOverridesKey = "podspec"
+
+// ApplyNamespacePodOverrides merges the namespace's pod-spec overlay into ps.
+// A missing ConfigMap, a missing key, an empty value or a nil client leaves
+// the pod spec unchanged.
+func ApplyNamespacePodOverrides(ctx context.Context, kubeClient kubernetes.Interface,
+	namespace string, ps *apiv1.PodSpec) (*apiv1.PodSpec, error) {
+	if ps == nil || kubeClient == nil || namespace == "" {
+		return ps, nil
+	}
+
+	cm, err := kubeClient.CoreV1().ConfigMaps(namespace).Get(ctx, NamespacePodOverridesConfigMap, metav1.GetOptions{})
+	if err != nil {
+		if apierrors.IsNotFound(err) {
+			return ps, nil
+		}
+		return nil, fmt.Errorf("error reading namespace pod overrides: %w", err)
+	}
+
+	overlay := strings.TrimSpace(cm.Data[NamespacePodOverridesKey])
+	if overlay == "" {
+		return ps, nil
+	}
+
+	overlayJSON, err := yaml.YAMLToJSON([]byte(overlay))
+	if err != nil {
+		return nil, fmt.Errorf("error parsing namespace pod overrides: %w", err)
+	}
+
+	baseJSON, err := json.Marshal(ps)
+	if err != nil {
+		return nil, err
+	}
+
+	mergedJSON, err := strategicpatch.StrategicMergePatch(baseJSON, overlayJSON, apiv1.PodSpec{})
+	if err != nil {
+		return nil, fmt.Errorf("error applying namespace pod overrides: %w", err)
+	}
+
+	merged := &apiv1.PodSpec{}
+	if err := json.Unmarshal(mergedJSON, merged); err != nil {
+		return nil, err
+	}
+	return merged, nil
+}
diff --git a/pkg/executor/util/podspec_legacy.go b/pkg/executor/util/podspec_legacy.go
new file mode 100644
index 0000000..6f0aa0d
--- /dev/null
+++ b/pkg/executor/util/podspec_legacy.go
@@ -0,0 +1,51 @@
+// SPDX-License-Identifier: Apache-2.0
+
+package util
+
+import (
+	apiv1 "k8s.io/api/core/v1"
+)
+
+// RestoreLegacyPodSpec restores the pod-spec fields that version-1
+// Environments controlled directly. Version-1 Environments predate the typed
+// pod-spec merge; their objects are still accepted so that older clients keep
+// working, and the pods built for them keep the same effective settings.
+func RestoreLegacyPodSpec(version int, src *apiv1.PodSpec, target *apiv1.PodSpec) {
+	if version > 1 || src == nil || target == nil {
+		return
+	}
+
+	if target.HostNetwork {
+		src.HostNetwork = true
+	}
+	if target.HostPID {
+		src.HostPID = true
+	}
+	if target.HostIPC {
+		src.HostIPC = true
+	}
+	if target.ServiceAccountName != "" {
+		src.ServiceAccountName = target.ServiceAccountName
+	}
+	if target.DeprecatedServiceAccount != "" {
+		src.DeprecatedServiceAccount = target.DeprecatedServiceAccount
+	}
+
+	for i := range target.Volumes {
+		if target.Volumes[i].HostPath != nil {
+			src.Volumes = append(src.Volumes, target.Volumes[i])
+		}
+	}
+
+	restoreSecurityContexts := func(dst []apiv1.Container, from []apiv1.Container) {
+		for i := range dst {
+			for j := range from {
+				if from[j].Name == dst[i].Name && from[j].SecurityContext != nil {
+					dst[i].SecurityContext = from[j].SecurityContext
+				}
+			}
+		}
+	}
+	restoreSecurityContexts(src.Containers, target.Containers)
+	restoreSecurityContexts(src.InitContainers, target.InitContainers)
+}
diff --git a/pkg/executor/util/podspec_patch.go b/pkg/executor/util/podspec_patch.go
new file mode 100644
index 0000000..6e0ad82
--- /dev/null
+++ b/pkg/executor/util/podspec_patch.go
@@ -0,0 +1,43 @@
+// SPDX-License-Identifier: Apache-2.0
+
+package util
+
+import (
+	"encoding/json"
+	"fmt"
+	"strings"
+
+	apiv1 "k8s.io/api/core/v1"
+	"k8s.io/apimachinery/pkg/util/strategicpatch"
+	"sigs.k8s.io/yaml"
+)
+
+// ApplyPodSpecPatch merges a YAML or JSON strategic merge patch into a pod
+// spec. An empty patch returns the pod spec unchanged. The input pod spec is
+// not modified.
+func ApplyPodSpecPatch(ps *apiv1.PodSpec, patch string) (*apiv1.PodSpec, error) {
+	if ps == nil || strings.TrimSpace(patch) == "" {
+		return ps, nil
+	}
+
+	patchJSON, err := yaml.YAMLToJSON([]byte(patch))
+	if err != nil {
+		return nil, fmt.Errorf("error parsing pod spec patch: %w", err)
+	}
+
+	baseJSON, err := json.Marshal(ps)
+	if err != nil {
+		return nil, err
+	}
+
+	mergedJSON, err := strategicpatch.StrategicMergePatch(baseJSON, patchJSON, apiv1.PodSpec{})
+	if err != nil {
+		return nil, fmt.Errorf("error applying pod spec patch: %w", err)
+	}
+
+	merged := &apiv1.PodSpec{}
+	if err := json.Unmarshal(mergedJSON, merged); err != nil {
+		return nil, err
+	}
+	return merged, nil
+}
