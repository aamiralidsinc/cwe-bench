+
+// expandExtractedValues resolves template references in the values produced by
+// extractors, so that reported extractions contain the final value.
+func expandExtractedValues(result *operators.Result, data output.InternalEvent) {
+	for name, values := range result.Extracts {
+		for i, value := range values {
+			if !strings.Contains(value, "{{") && !strings.Contains(value, "\u00a7") {
+				continue
+			}
+			if expanded, err := expressions.Evaluate(value, data); err == nil {
+				values[i] = expanded
+			}
+		}
+		result.Extracts[name] = values
+	}
+
+	for i, value := range result.OutputExtracts {
+		if !strings.Contains(value, "{{") && !strings.Contains(value, "\u00a7") {
+			continue
+		}
+		if expanded, err := expressions.Evaluate(value, data); err == nil {
+			result.OutputExtracts[i] = expanded
+		}
+	}
+}
