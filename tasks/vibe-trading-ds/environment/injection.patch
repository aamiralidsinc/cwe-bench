--- a/agent/api_server.py	2026-10-17 06:25:18.000000000 +0000
+++ b/agent/api_server.py	2026-10-21 20:24:08.051051411 +0000
@@ -1399,6 +1399,25 @@
     }
 
 
+@app.get("/uploads/preview")
+async def preview_upload(path: str = Query(..., description="File path returned by POST /upload")):
+    """Serve a stored upload so the browser can preview it.
+
+    ``POST /upload`` answers with an absolute file path; the web client passes
+    that path back here to show the document before the user asks the agent
+    to analyse it.
+    """
+    target = Path(path)
+    if not target.exists() or not target.is_file():
+        raise HTTPException(status_code=404, detail=f"Stored file not found: {path}")
+    media_type = "application/pdf" if target.suffix.lower() == ".pdf" else "application/octet-stream"
+    return FileResponse(
+        target,
+        media_type=media_type,
+        headers={"Content-Disposition": f'inline; filename="{target.name}"'},
+    )
+
+
