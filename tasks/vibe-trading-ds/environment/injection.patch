+    def get_support_file(self, name: str, filename: str) -> str:
+        """Return one of a skill's supporting files (used by the load_skill tool).
+
+        Skills keep larger references, templates and example engines beside
+        their SKILL.md; the agent loads them on demand with the skill.
+
+        Args:
+            name: Skill name.
+            filename: Supporting file name relative to the skill directory.
+
+        Returns:
+            File text, or an error message.
+        """
+        for skill in self.skills:
+            if skill.name == name:
+                content = skill.load_support_file(filename)
+                if content is None:
+                    return f"Error: no supporting file {filename!r} in skill '{name}'"
+                return f'<skill-file name="{name}" path="{filename}">\n{content}\n</skill-file>'
+        return f"Error: Unknown skill '{name}'."
