+import { InputError } from '@backstage/errors';
+import {
+  createTemplateAction,
+  parseRepoUrl,
+} from '@backstage/plugin-scaffolder-node';
+import {
+  DefaultGithubCredentialsProvider,
+  GithubCredentialsProvider,
+  ScmIntegrationRegistry,
+} from '@backstage/integration';
+import { Octokit } from 'octokit';
+
+/**
+ * Creates a `github:release:create` Scaffolder action that creates a GitHub
+ * release for an existing tag.
+ *
+ * @public
+ */
+export function createGithubReleaseAction(options: {
+  integrations: ScmIntegrationRegistry;
+  githubCredentialsProvider?: GithubCredentialsProvider;
+}) {
+  const { integrations, githubCredentialsProvider } = options;
+
+  return createTemplateAction({
+    id: 'github:release:create',
+    description: 'Creates a release for an existing tag in a GitHub repository',
+    schema: {
+      input: {
+        repoUrl: z =>
+          z.string({
+            description:
+              'Accepts the format `github.com?repo=reponame&owner=owner` where `reponame` is the repository name and `owner` is an organization or username',
+          }),
+        tagName: z =>
+          z.string({
+            description: 'The name of the tag to create the release from',
+          }),
+        title: z =>
+          z
+            .string({
+              description: 'The title of the release',
+            })
+            .optional(),
+        body: z =>
+          z
+            .string({
+              description: 'The description of the release',
+            })
+            .optional(),
+        draft: z =>
+          z
+            .boolean({
+              description: 'Whether the release should be a draft',
+            })
+            .optional(),
+        token: z =>
+          z
+            .string({
+              description: 'The token to use for authorization to GitHub',
+            })
+            .optional(),
+      },
+      output: {
+        releaseId: z =>
+          z.number({
+            description: 'The ID of the created release',
+          }),
+        releaseUrl: z =>
+          z.string({
+            description: 'The URL of the created release',
+          }),
+      },
+    },
+    async handler(ctx) {
+      const {
+        repoUrl,
+        tagName,
+        title,
+        body,
+        draft = false,
+        token: providedToken,
+      } = ctx.input;
+
+      const { host, owner, repo } = parseRepoUrl(repoUrl, integrations);
+
+      if (!owner) {
+        throw new InputError(`No owner provided for repo ${repoUrl}`);
+      }
+
+      const integrationConfig = integrations.github.byHost(host);
+
+      if (!integrationConfig) {
+        throw new InputError(`No integration for host ${host}`);
+      }
+
+      let auth = providedToken;
+
+      if (!auth) {
+        const credentialsProvider =
+          githubCredentialsProvider ??
+          DefaultGithubCredentialsProvider.fromIntegrations(integrations);
+        const credentials = await credentialsProvider.getCredentials({
+          url: `https://${host}/${encodeURIComponent(
+            owner,
+          )}/${encodeURIComponent(repo)}`,
+        });
+        auth = credentials.token;
+      }
+
+      if (!auth) {
+        throw new InputError(`No token available for host ${host}`);
+      }
+
+      const client = new Octokit({
+        auth,
+        baseUrl: integrationConfig.config.apiBaseUrl,
+        previews: ['nebula-preview'],
+        log: ctx.logger,
+      });
+
+      const release = await ctx.checkpoint({
+        key: `create.release.${owner}.${repo}.${tagName}`,
+        fn: async () =>
+          client.rest.repos.createRelease({
+            owner,
+            repo,
+            tag_name: tagName,
+            name: title,
+            body,
+            draft,
+          }),
+      });
+
+      ctx.output('releaseId', release.data.id);
+      ctx.output('releaseUrl', release.data.html_url);
+    },
+  });
+}
