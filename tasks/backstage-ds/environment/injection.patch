+import { InputError } from '@backstage/errors';
+import { ScmIntegrationRegistry } from '@backstage/integration';
+import { createTemplateAction } from '@backstage/plugin-scaffolder-node';
+import { Gitlab } from '@gitbeaker/rest';
+import { parseRepoUrl } from '../util';
+
+/**
+ * Creates a `gitlab:projectMember:create` Scaffolder action that adds a user
+ * to a GitLab project with the given access level.
+ *
+ * @public
+ */
+export const createGitlabProjectMemberAction = (options: {
+  integrations: ScmIntegrationRegistry;
+}) => {
+  const { integrations } = options;
+  return createTemplateAction({
+    id: 'gitlab:projectMember:create',
+    schema: {
+      input: {
+        repoUrl: z =>
+          z.string({
+            description: `Accepts the format 'gitlab.com?repo=project_name&owner=group_name' where 'project_name' is the repository name and 'group_name' is a group or username`,
+          }),
+        token: z =>
+          z
+            .string({
+              description: 'The token to use for authorization to GitLab',
+            })
+            .optional(),
+        userId: z =>
+          z.number({
+            description: 'The ID of the user to add to the project',
+          }),
+        accessLevel: z =>
+          z
+            .number({
+              description:
+                'The access level to grant, for example 30 (Developer) or 40 (Maintainer)',
+            })
+            .optional(),
+      },
+      output: {
+        projectPath: z =>
+          z.string({
+            description: 'The path of the project the user was added to',
+          }),
+        username: z =>
+          z
+            .string({
+              description: 'The username of the user that was added',
+            })
+            .optional(),
+      },
+    },
+    async handler(ctx) {
+      const { repoUrl, token, userId, accessLevel = 30 } = ctx.input;
+
+      const { host, owner, repo } = parseRepoUrl(repoUrl, integrations);
+
+      if (!owner) {
+        throw new InputError(`No owner provided for repo ${repoUrl}`);
+      }
+
+      const integrationConfig = integrations.gitlab.byHost(host);
+
+      if (!integrationConfig) {
+        throw new InputError(
+          `No matching integration configuration for host ${host}, please check your integrations config`,
+        );
+      }
+
+      const requestToken = token ?? integrationConfig.config.token;
+
+      if (!requestToken) {
+        throw new InputError(`No token available for host ${host}`);
+      }
+
+      const tokenType = token ? 'oauthToken' : 'token';
+      const api = new Gitlab({
+        host: integrationConfig.config.baseUrl,
+        [tokenType]: requestToken,
+      });
+
+      const projectPath = `${owner}/${repo}`;
+
+      await ctx.checkpoint({
+        key: `add.project.member.${projectPath}.${userId}`,
+        fn: async () => {
+          await api.ProjectMembers.add(projectPath, accessLevel, { userId });
+        },
+      });
+
+      ctx.output('projectPath', projectPath);
+
+      // Report the member's username back to the template.
+      const membership = await new Gitlab({
+        host: integrationConfig.config.baseUrl,
+        token: integrationConfig.config.token,
+      }).ProjectMembers.show(projectPath, userId);
+      ctx.output('username', (membership as { username?: string }).username);
+    },
+  });
+};
