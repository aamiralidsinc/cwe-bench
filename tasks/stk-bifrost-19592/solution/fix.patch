+// newEndpointHTTPClient builds the client used to download configured endpoint
+// data. The dialer resolves the destination itself and refuses addresses that
+// the save-time URL validation cannot see: an IPv4 smuggled inside an IPv6
+// transition form, the deprecated site-local range, link-local and unspecified
+// addresses. Locally hosted endpoints (loopback and RFC 1918) keep working, as
+// they do for the save-time validation.
+func newEndpointHTTPClient(timeout time.Duration) *http.Client {
+	dialer := &net.Dialer{Timeout: timeout}
+	return &http.Client{
+		Timeout: timeout,
+		Transport: &http.Transport{
+			DialContext: func(ctx context.Context, network, addr string) (net.Conn, error) {
+				return dialEndpoint(ctx, dialer, network, addr)
+			},
+		},
+	}
+}
+
+func dialEndpoint(ctx context.Context, dialer *net.Dialer, network, addr string) (net.Conn, error) {
+	host, port, err := net.SplitHostPort(addr)
+	if err != nil {
+		return nil, err
+	}
+	ips, err := net.DefaultResolver.LookupIP(ctx, "ip", host)
+	if err != nil {
+		return nil, err
+	}
+	for _, ip := range ips {
+		if blockedEndpointIP(ip) {
+			return nil, fmt.Errorf("blocked connection to non-public address %s", ip)
+		}
+	}
+	return dialer.DialContext(ctx, network, net.JoinHostPort(ips[0].String(), port))
+}
+
+func blockedEndpointIP(ip net.IP) bool {
+	addr, ok := netip.AddrFromSlice(ip)
+	if !ok {
+		return true
+	}
+	addr = addr.Unmap()
+	if embedded, ok := embeddedEndpointIPv4(addr); ok {
+		return !publicEndpointIPv4(embedded)
+	}
+	if addr.IsLoopback() || addr.IsPrivate() {
+		return false
+	}
+	b := addr.As16()
+	return cgnatEndpoint.Contains(addr) || addr.IsLinkLocalUnicast() || addr.IsLinkLocalMulticast() ||
+		addr.IsMulticast() || addr.IsUnspecified() ||
+		(addr.Is6() && b[0] == 0xfe && (b[1]&0xc0) == 0xc0) ||
+		addr == netip.AddrFrom4([4]byte{255, 255, 255, 255})
+}
+
+var cgnatEndpoint = netip.MustParsePrefix("100.64.0.0/10")
+
+func publicEndpointIPv4(addr netip.Addr) bool {
+	return addr.Is4() && !(addr.IsLoopback() || addr.IsPrivate() || cgnatEndpoint.Contains(addr) ||
+		addr.IsLinkLocalUnicast() || addr.IsLinkLocalMulticast() ||
+		addr.IsMulticast() || addr.IsUnspecified() ||
+		addr == netip.AddrFrom4([4]byte{255, 255, 255, 255}))
+}
+
+func embeddedEndpointIPv4(addr netip.Addr) (netip.Addr, bool) {
+	if !addr.Is6() {
+		return netip.Addr{}, false
+	}
+	b := addr.As16()
+	switch {
+	case b[0] == 0x20 && b[1] == 0x02:
+		return netip.AddrFrom4([4]byte{b[2], b[3], b[4], b[5]}), true
+	case b[0] == 0x00 && b[1] == 0x64 && b[2] == 0xff && b[3] == 0x9b:
+		if b[4] == 0x00 && b[5] == 0x00 {
+			return netip.AddrFrom4([4]byte{b[12], b[13], b[14], b[15]}), true
+		}
+		if b[4] == 0x00 && b[5] == 0x01 {
+			return netip.AddrFrom4([4]byte{b[6], b[7], b[9], b[10]}), true
+		}
+	}
+	return netip.Addr{}, false
+}
