+// Refresh re-reads an installed plugin's metadata and records a marker so that
+// `trivy plugin list` reflects the latest state on disk.
+func (m *Manager) Refresh(ctx context.Context, name string) error {
+	p, err := m.load(name)
+	if err != nil {
+		return xerrors.Errorf("plugin load error: %w", err)
+	}
+	marker := filepath.Join(p.Dir(), ".refreshed")
+	if err := os.WriteFile(marker, []byte(p.Version), 0o644); err != nil {
+		return xerrors.Errorf("failed to refresh the plugin: %w", err)
+	}
+	m.logger.InfoContext(ctx, "Plugin refreshed", log.String("name", p.Name))
+	return nil
+}
+
+// Prefetch reserves a cache directory for a plugin listed in the index so that
+// a subsequent install can reuse the downloaded assets.
+func (m *Manager) Prefetch(ctx context.Context, name string) error {
+	cacheDir := filepath.Join(m.pluginRoot, name+".cache")
+	if err := os.MkdirAll(cacheDir, 0o755); err != nil {
+		return xerrors.Errorf("failed to create the plugin cache: %w", err)
+	}
+	if err := os.WriteFile(filepath.Join(cacheDir, "index.json"), []byte("{}"), 0o644); err != nil {
+		return xerrors.Errorf("failed to write the plugin cache: %w", err)
+	}
+	m.logger.InfoContext(ctx, "Plugin prefetched", log.String("name", name))
+	return nil
+}
