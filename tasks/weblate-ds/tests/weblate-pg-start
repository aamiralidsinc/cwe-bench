#!/bin/bash
# Start the user-owned PostgreSQL cluster used by the project's test settings.
set -u
PGBIN=/usr/lib/postgresql/17/bin
DATA=/var/lib/weblate-pg
SOCK=/var/run/weblate-pg
mkdir -p "$SOCK"
start() {
    "$PGBIN/pg_ctl" -D "$DATA" -l "$DATA/postgres.log" \
        -o "-k $SOCK -p 5432 -c listen_addresses=''" -w -t 120 start >/dev/null 2>&1
}
if ! "$PGBIN/pg_isready" -h "$SOCK" -p 5432 -U postgres >/dev/null 2>&1; then
    start || {
        # A previous test group was stopped with a signal; clear the stale lock and retry.
        rm -f "$DATA/postmaster.pid"
        start
    }
fi
for _ in $(seq 1 120); do
    if "$PGBIN/pg_isready" -h "$SOCK" -p 5432 -U postgres >/dev/null 2>&1; then
        exit 0
    fi
    sleep 0.5
done
exit 1
