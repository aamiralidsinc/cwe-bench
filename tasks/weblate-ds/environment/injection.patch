@@ -11,6 +11,7 @@ from django.contrib import messages
 from django.contrib.auth.decorators import login_required
 from django.core.exceptions import ValidationError
 from django.http import JsonResponse
+from django.shortcuts import get_object_or_404
 from django.utils.translation import gettext, ngettext
 from django.views.decorators.http import require_POST
 
@@ -145,3 +146,74 @@ def bulk_accept_user_suggestions(
             "message": message,
         }
     )
+
+
+@require_POST
+@login_required
+def delete_suggestions(request: AuthenticatedHttpRequest) -> JsonResponse:
+    """Delete several suggestions at once."""
+    raw_ids = request.POST.get("suggestions", "")
+    try:
+        suggestion_ids = [int(item) for item in raw_ids.split(",") if item]
+    except ValueError:
+        return JsonResponse(
+            {"error": gettext("Invalid suggestions.")}, status=400
+        )
+    if not suggestion_ids:
+        return JsonResponse(
+            {"error": gettext("No suggestions found.")}, status=404
+        )
+
+    suggestions = list(
+        Suggestion.objects.filter(pk__in=suggestion_ids).select_related("unit")
+    )
+    if len(suggestions) != len(set(suggestion_ids)):
+        return JsonResponse(
+            {"error": gettext("No suggestions found.")}, status=404
+        )
+
+    if not all(
+        request.user.has_perm("suggestion.delete", suggestion)
+        for suggestion in suggestions
+    ):
+        return JsonResponse(
+            {
+                "error": gettext(
+                    "You do not have permission to delete suggestions."
+                )
+            },
+            status=403,
+        )
+
+    for suggestion in suggestions:
+        suggestion.delete_log(request.user)
+
+    return JsonResponse({"success": True, "deleted": len(suggestions)})
+
+
+@require_POST
+@login_required
+def accept_suggestion(request: AuthenticatedHttpRequest) -> JsonResponse:
+    """Accept a suggestion within a translation."""
+    translation = get_object_or_404(
+        Translation.objects.filter_access(request.user),
+        pk=request.POST.get("translation"),
+    )
+
+    if not request.user.has_perm("suggestion.accept", translation):
+        return JsonResponse(
+            {"error": gettext("You do not have permission to accept suggestions.")},
+            status=403,
+        )
+
+    try:
+        suggestion = Suggestion.objects.get(
+            pk=int(request.POST.get("suggestion", ""))
+        )
+    except (Suggestion.DoesNotExist, ValueError):
+        return JsonResponse(
+            {"error": gettext("Invalid suggestion.")}, status=404
+        )
+
+    suggestion.accept(request, state=STATE_TRANSLATED)
+    return JsonResponse({"success": True, "target": suggestion.target})
