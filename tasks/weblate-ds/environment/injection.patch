+@login_required
+def check_summary(request: AuthenticatedHttpRequest, check_id):
+    """Return a summary of a check for the AJAX popup."""
+    obj = get_object_or_404(
+        Check.objects.filter(
+            unit__translation__component__project__in=request.user.allowed_projects
+        ),
+        pk=check_id,
+    )
+    if not request.user.has_perm("unit.check", obj):
+        raise PermissionDenied
+    return JsonResponse(
+        {
+            "name": obj.name,
+            "unit": obj.unit_id,
+            "dismissed": obj.dismissed,
+        }
+    )
