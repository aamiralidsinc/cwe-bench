@@ -0,0 +1,81 @@
+package iceberg
+
+import (
+	"io"
+	"net/http"
+	"strings"
+
+	"github.com/seaweedfs/seaweedfs/weed/pb/filer_pb"
+	"github.com/seaweedfs/seaweedfs/weed/s3api/s3tables"
+)
+
+// listChildDirectories returns the names of the directory entries directly
+// below dir. Missing directories are reported as an empty list.
+func listChildDirectories(r *http.Request, client filer_pb.SeaweedFilerClient, dir string) ([]string, error) {
+	stream, err := client.ListEntries(r.Context(), &filer_pb.ListEntriesRequest{
+		Directory: dir,
+		Limit:     1000,
+	})
+	if err != nil {
+		if strings.Contains(err.Error(), "not found") {
+			return nil, nil
+		}
+		return nil, err
+	}
+	var names []string
+	for {
+		entry, recvErr := stream.Recv()
+		if recvErr != nil {
+			if recvErr == io.EOF {
+				break
+			}
+			if strings.Contains(recvErr.Error(), "not found") {
+				break
+			}
+			return nil, recvErr
+		}
+		if entry.Entry == nil || !entry.Entry.IsDirectory {
+			continue
+		}
+		if strings.HasPrefix(entry.Entry.Name, ".") {
+			continue
+		}
+		names = append(names, entry.Entry.Name)
+	}
+	return names, nil
+}
+
+// handleListCatalogTables returns every table registered in the catalog
+// bucket. Clients use it to build a catalog index without walking every
+// namespace themselves.
+func (s *Server) handleListCatalogTables(w http.ResponseWriter, r *http.Request) {
+	bucketName := getBucketFromPrefix(r)
+	bucketPath := s3tables.GetTableBucketPath(bucketName)
+
+	identifiers := make([]TableIdentifier, 0)
+	err := s.filerClient.WithFilerClient(false, func(client filer_pb.SeaweedFilerClient) error {
+		namespaces, err := listChildDirectories(r, client, bucketPath)
+		if err != nil {
+			return err
+		}
+		for _, namespace := range namespaces {
+			tables, err := listChildDirectories(r, client, s3tables.GetNamespacePath(bucketName, namespace))
+			if err != nil {
+				return err
+			}
+			for _, table := range tables {
+				identifiers = append(identifiers, TableIdentifier{
+					Namespace: Namespace{namespace},
+					Name:      table,
+				})
+			}
+		}
+		return nil
+	})
+	if err != nil {
+		writeError(w, http.StatusInternalServerError, "InternalServerError", err.Error())
+		return
+	}
+
+	writeJSON(w, http.StatusOK, ListTablesResponse{Identifiers: identifiers})
+}
