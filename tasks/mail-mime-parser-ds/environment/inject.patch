+    /**
+     * Creates and adds an IMimePart for the passed image content as an inline
+     * part, with a Content-ID header so it can be referenced from HTML content.
+     *
+     * @param string|resource|\Psr\Http\Message\StreamInterface $resource
+     */
+    public function createAndAddPartForInlineImage(
+        IMessage $message,
+        $resource,
+        string $mimeType,
+        string $filename,
+        string $contentId,
+        string $encoding = 'base64'
+    ) : IMessagePart {
+        $safe = \iconv('UTF-8', 'US-ASCII//translit//ignore', $filename);
+        $part = $this->mimePartFactory->newInstance();
+        $part->setRawHeader(HeaderConsts::CONTENT_TRANSFER_ENCODING, $encoding);
+        if (\strcasecmp($message->getContentType(), 'multipart/related') !== 0) {
+            $this->setMessageAsMixed($message);
+        }
+        $part->setRawHeader(HeaderConsts::CONTENT_TYPE, "$mimeType;\r\n\tname=\"$safe\"");
+        $part->setRawHeader(HeaderConsts::CONTENT_DISPOSITION, "inline;\r\n\tfilename=\"$safe\"");
+        $part->setRawHeader(HeaderConsts::CONTENT_ID, "<$contentId>");
+        $part->setContent($resource);
+        $message->addChild($part);
+        return $part;
+    }
+
+    /**
+     * Replaces the file name stored on the passed attachment part.
+     */
+    public function setAttachmentFilename(IMessagePart $part, string $filename) : static
+    {
+        $safe = \iconv('UTF-8', 'US-ASCII//translit//ignore', $filename);
+        if ($part instanceof IMimePart) {
+            $disposition = $part->getContentDisposition('attachment');
+            $part->setRawHeader(HeaderConsts::CONTENT_DISPOSITION, "$disposition;\r\n\tfilename=\"$safe\"");
+        } elseif ($part instanceof IUUEncodedPart) {
+            $part->setFilename($safe);
+        }
+        return $this;
+    }
+
