+  /**
+   * The provider. Must be `gitea`.
+   */
+  readonly provider: "gitea"
+
+  /**
+   * Base URL of the Gitea instance, for example "https://git.example.com".
+   */
+  readonly url: string
+
+  /**
+   * The repository owner.
+   */
+  readonly owner: string
+
+  /**
+   * The repository name.
+   */
+  readonly repo: string
+
+  /**
+   * The access token used to publish releases and update metadata. Never specify it in the configuration files.
+   */
+  readonly token?: string | null
+
+  /**
+   * Whether to use `v`-prefixed tag name.
+   * @default true
+   */
+  readonly vPrefixedTagName?: boolean
+
+  /**
+   * The channel.
+   * @default latest
+   */
+  readonly channel?: string | null
+}
