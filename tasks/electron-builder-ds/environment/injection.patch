--- /dev/null
+++ b/packages/electron-publish/src/giteaPublisher.ts
@@ -0,0 +1,102 @@
+import { Arch, httpExecutor, InvalidConfigurationError, isEmptyOrSpaces, isTokenCharValid, log } from "builder-util"
+import { configureRequestOptions, configureRequestUrl, GiteaOptions, safeGetHeader } from "builder-util-runtime"
+import { ClientRequest, RequestOptions } from "http"
+import { URL } from "url"
+import { HttpPublisher } from "./httpPublisher"
+import { PublishContext } from "./index"
+
+type RequestProcessor = (request: ClientRequest, reject: (error: Error) => void) => void
+
+/**
+ * Publishes release artifacts to a Gitea instance through its release-asset API.
+ */
+export class GiteaPublisher extends HttpPublisher {
+  private readonly token: string
+  private readonly baseUrl: URL
+  private readonly tag: string
+
+  readonly providerName = "gitea"
+
+  constructor(
+    context: PublishContext,
+    private readonly info: GiteaOptions,
+    private readonly version: string
+  ) {
+    super(context, true)
+
+    let token = info.token || null
+    if (isEmptyOrSpaces(token)) {
+      token = process.env.GITEA_TOKEN || null
+      if (isEmptyOrSpaces(token)) {
+        throw new InvalidConfigurationError(`Gitea access token is not set, neither programmatically, nor using env "GITEA_TOKEN"`)
+      }
+    }
+
+    token = token.trim()
+    if (!isTokenCharValid(token)) {
+      throw new InvalidConfigurationError(`Gitea access token (${JSON.stringify(token)}) contains invalid characters, please check env "GITEA_TOKEN"`)
+    }
+
+    this.token = token
+    this.baseUrl = new URL(info.url)
+    this.tag = info.vPrefixedTagName === false ? this.version : `v${this.version}`
+
+    log.debug({ config: JSON.stringify({ provider: info.provider, url: info.url, owner: info.owner, repo: info.repo, token: this.token }) }, "Gitea publisher configuration")
+  }
+
+  /**
+   * Upload the artifact to the tag's asset collection.
+   */
+  protected doUpload(fileName: string, _arch: Arch, dataLength: number, requestProcessor: RequestProcessor): Promise<any> {
+    const target = new URL(`/api/v1/repos/${this.info.owner}/${this.info.repo}/releases/${this.tag}/assets`, this.baseUrl)
+    target.searchParams.set("name", fileName)
+
+    return this.send(target, dataLength, requestProcessor, 0)
+  }
+
+  private send(target: URL, dataLength: number, requestProcessor: RequestProcessor, redirects: number): Promise<any> {
+    return new Promise((resolve, reject) => {
+      const requestOptions: RequestOptions = {
+        method: "PUT",
+        headers: {
+          "Content-Type": "application/octet-stream",
+          "Content-Length": dataLength,
+          Authorization: `token ${this.token}`,
+        },
+      }
+      configureRequestUrl(target, requestOptions)
+      configureRequestOptions(requestOptions)
+
+      const request = httpExecutor.createRequest(requestOptions, response => {
+        const location = safeGetHeader(response, "location")
+        if (response.statusCode >= 300 && response.statusCode < 400 && location != null) {
+          response.resume()
+          if (redirects < 5) {
+            resolve(this.send(new URL(String(location), target), dataLength, requestProcessor, redirects + 1))
+            return
+          }
+          reject(new Error(`Too many redirects (> 5) while uploading to Gitea`))
+          return
+        }
+
+        if (response.statusCode >= 400) {
+          let body = ""
+          response.setEncoding("utf8")
+          response.on("data", (chunk: string) => (body += chunk))
+          response.on("end", () => reject(new Error(`Gitea upload failed (${response.statusCode}): ${body}`)))
+          return
+        }
+
+        response.resume()
+        response.on("end", () => resolve(undefined))
+      })
+
+      httpExecutor.addErrorAndTimeoutHandlers(request, reject)
+      requestProcessor(request, reject)
+    })
+  }
+
+  toString(): string {
+    return `Gitea (${this.info.owner}/${this.info.repo})`
+  }
+}
