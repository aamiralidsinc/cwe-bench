+  /**
+   * Import multiple environment variables at once
+   *
+   * @param req
+   * @param res
+   */
+  const importEnvVarsHandler = (req, res) => {
+    try {
+      const { variables } = req.body;
+
+      if (
+        variables === null ||
+        typeof variables !== 'object' ||
+        Array.isArray(variables)
+      ) {
+        throw new Error('Variables missing from request');
+      }
+
+      const keys = Object.keys(variables);
+
+      keys.forEach((key) => {
+        process.env[key] = String(variables[key]);
+      });
+
+      res.send({
+        message: `Imported ${keys.length} environment variables`
+      });
+    } catch (_error) {
+      res.status(400).send({ message: 'Invalid request' });
+    }
+  };
