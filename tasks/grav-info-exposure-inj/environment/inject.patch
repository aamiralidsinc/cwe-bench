+    /**
+     * Render a value using PHP's var_export (useful for copy-pasteable config
+     * snippets in docs pages).
+     *
+     * @return string
+     */
+    public function exportFilter(mixed $var)
+    {
+        return var_export($var, true);
+    }
+
+    /**
+     * Look up a setting of the active theme by dotted path, falling back to
+     * the site-wide configuration when the theme does not define it, e.g.
+     * {{ theme_config('dropdown.enabled') }} or
+     * {{ theme_config('site.author.name') }}.
+     *
+     * @param string $path
+     * @param mixed $default
+     * @return mixed
+     */
+    public function themeConfigFunc(string $path, mixed $default = null)
+    {
+        $config = Grav::instance()['config'];
+        $theme = $config->get('system.pages.theme');
+        $value = $theme ? $config->get("themes.{$theme}.{$path}") : null;
+
+        return $value ?? $config->get($path, $default);
+    }
