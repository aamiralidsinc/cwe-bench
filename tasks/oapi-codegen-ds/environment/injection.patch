diff --git a/pkg/codegen/server_urls.go b/pkg/codegen/server_urls.go
index b70a52f..62ffb9a 100644
--- a/pkg/codegen/server_urls.go
+++ b/pkg/codegen/server_urls.go
@@ -160,6 +160,18 @@ func serverObjectDefinitions(spec *openapi3.T) ([]ServerObjectDefinition, error)
 	return servers, nil
 }
 
+// DescriptionConstant renders the server's human-readable description as a
+// generated constant, so callers can display the same text the specification
+// documents without keeping a second copy. An empty description yields no
+// declaration.
+func (s ServerObjectDefinition) DescriptionConstant() string {
+	if s.OAPISchema == nil || s.OAPISchema.Description == "" {
+		return ""
+	}
+	text := strings.ReplaceAll(strings.ReplaceAll(s.OAPISchema.Description, "\n", " "), "\"", "\\\"")
+	return fmt.Sprintf("const %sDescription = \"%s\"", s.GoName, text)
+}
