+"""Markdown body partials — ``@include "path"`` expansion.
+
+Prompt bodies often share a common preamble (house style, safety rules,
+output conventions). A line of its own in the body of the form::
+
+    @include "partials/preamble.md"
+
+is replaced with the text of the referenced file, read relative to the
+directory that contains the ``.prompty`` document.
+"""
+
+from __future__ import annotations
+
+import re
+from pathlib import Path
+
+from .utils import load_text
+
+__all__ = ["expand_partials"]
+
+_INCLUDE_RE = re.compile(r'^[ \t]*@include[ \t]+"([^"\n]+)"[ \t]*$', re.M)
+
+
+def expand_partials(instructions: str, base_dir: str | Path) -> str:
+    """Inline every ``@include "path"`` line in *instructions*.
+
+    Parameters
+    ----------
+    instructions:
+        The markdown body of a prompt document.
+    base_dir:
+        Directory of the prompt document; references are resolved from here.
+    """
+    root = Path(base_dir)
+
+    def _read(match: re.Match[str]) -> str:
+        return load_text(root / match.group(1))
+
+    return _INCLUDE_RE.sub(_read, instructions)
