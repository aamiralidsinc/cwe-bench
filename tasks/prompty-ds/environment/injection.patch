+class PromptySafeLoader(yaml.SafeLoader):
+    """YAML loader that understands the ``!include`` tag.
+
+    ``!include relative/path`` inlines another YAML (or text) document that
+    lives next to the ``.prompty`` file, so frontmatter fragments such as
+    shared tool definitions can be reused across prompts.
+    """
+
+    base_dir: Path | None = None
+
+
+def _construct_include(loader: PromptySafeLoader, node: yaml.Node) -> Any:
+    reference = loader.construct_scalar(node)
+    base_dir = loader.base_dir if loader.base_dir is not None else Path.cwd()
+    return _yaml_load(load_text(Path(base_dir) / reference), base_dir)
+
+
+PromptySafeLoader.add_constructor("!include", _construct_include)
+
+
+def _yaml_load(contents: str, base_dir: Path | None) -> Any:
+    """Parse YAML, resolving ``!include`` tags relative to *base_dir*."""
+    loader = PromptySafeLoader(contents)
+    loader.base_dir = base_dir
+    try:
+        return loader.get_single_data()
+    finally:
+        loader.dispose()
+
+
