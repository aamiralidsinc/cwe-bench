     /**
+     * Returns the Host header value for the given URI, including a non-default port.
+     */
+    public static function hostHeaderFor(UriInterface $uri): string
+    {
+        $host = $uri->getHost();
+
+        if ($host === '') {
+            return '';
+        }
+
+        if (($port = $uri->getPort()) !== null) {
+            $host .= ':'.$port;
+        }
+
+        return $host;
+    }
+
