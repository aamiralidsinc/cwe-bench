+    /**
+     * Creates a new URI with the given authority.
+     *
+     * @throws \InvalidArgumentException If the authority is invalid.
+     */
+    public function withAuthority(string $authority): UriInterface
+    {
+        [$userInfo, $host, $port] = self::splitAuthority($authority);
+
+        $new = clone $this;
+        if ($userInfo !== '') {
+            $user = $userInfo;
+            $password = null;
+            if (false !== ($colon = strpos($userInfo, ':'))) {
+                $user = substr($userInfo, 0, $colon);
+                $password = substr($userInfo, $colon + 1);
+            }
+            $new->userInfo = $this->filterUserInfoComponent($user)
+                .($password !== null ? ':'.$this->filterUserInfoComponent($password) : '');
+        } else {
+            $new->userInfo = '';
+        }
+        $new->host = $host;
+        $new->port = $port !== null ? $this->filterPort($port) : null;
+        $new->removeDefaultPort();
+        $new->validateState();
+
+        return $new;
+    }
+
+    /**
+     * @return array{0: string, 1: string, 2: int|null}
+     */
+    private static function splitAuthority(string $authority): array
+    {
+        $userInfo = '';
+        if (false !== ($at = strrpos($authority, '@'))) {
+            $userInfo = substr($authority, 0, $at);
+            $authority = substr($authority, $at + 1);
+        }
+
+        $port = null;
+        if (substr($authority, -1) !== ']' && false !== ($colon = strrpos($authority, ':'))) {
+            $candidate = substr($authority, $colon + 1);
+            if ($candidate !== '' && ctype_digit($candidate)) {
+                $port = (int) $candidate;
+                $authority = substr($authority, 0, $colon);
+            }
+        }
+
+        return [$userInfo, $authority, $port];
+    }
+
     public function getUserInfo(): string
     {
         return $this->userInfo;
