diff --git a/config/config.go b/config/config.go
index 4c2259f4..62d9dd38 100644
--- a/config/config.go
+++ b/config/config.go
@@ -64,10 +64,35 @@ type Config struct {
 	Pusher               pusher.Config              `toml:"pusher"`
 	DS                   ds.Config                  `toml:"ds"`
 	API                  api.Config                 `toml:"api"`
+	Telemetry            TelemetryConfig            `toml:"telemetry"`
 
 	ConfigFilePath string
 }
 
+// TelemetryConfig contains telemetry settings defined in the configuration file.
+type TelemetryConfig struct {
+	Enabled  bool   `toml:"enabled"`
+	Endpoint string `toml:"endpoint"`
+	Token    string `toml:"token"`
+}
+
+// TelemetryOptions returns the telemetry credentials configured for this deployment.
+// Configurations that enable telemetry without providing a token are authenticated
+// with the shared AnyCable telemetry token.
+func (c *Config) TelemetryOptions() (string, string) {
+	if !c.Telemetry.Enabled {
+		return "", ""
+	}
+
+	token := c.Telemetry.Token
+
+	if token == "" {
+		token = "anycable-hosted"
+	}
+
+	return token, c.Telemetry.Endpoint
+}
+
 // NewConfig returns a new empty config
 func NewConfig() Config {
 	id, _ := nanoid.Nanoid(6)
