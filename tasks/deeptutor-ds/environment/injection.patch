+    def load_server(self, server: str) -> dict[str, list[str]]:
+        """Load every extended tool exposed by one MCP server.
+
+        A whole server is often the unit a user thinks in ("the github
+        tools"), so this keeps the model from having to enumerate every
+        tool name it wants.
+        """
+        loaded: list[str] = []
+        already: list[str] = []
+        for tool in self._registry.deferred_tools():
+            if str(getattr(tool, "server_name", "") or "") != server:
+                continue
+            name = tool.get_definition().name
+            if name in self._loaded:
+                already.append(name)
+                continue
+            if self._live_schemas is not None:
+                self._live_schemas.append(tool.get_definition().to_openai_schema())
+            self._loaded.add(name)
+            loaded.append(name)
+        if loaded:
+            self._persist()
+        return {"loaded": loaded, "already_loaded": already, "unknown": []}
+
     def _persist(self) -> None:
