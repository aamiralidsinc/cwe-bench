@@ -151,4 +175,25 @@
             logger.warning("failed to persist deferred-tool state", exc_info=True)
 
 
-__all__ = ["DeferredToolLoader", "render_deferred_tools_manifest"]
+def persisted_tool_schemas(
+    session_id: str,
+    registry: ToolRegistry,
+) -> list[dict[str, Any]]:
+    """Schemas for the extended tools this conversation already loaded.
+
+    ``load_tools`` records the tool names per session. A turn that resumes
+    the conversation starts with those schemas so the model does not have to
+    load them again; tools that disappeared from the registry are skipped.
+    """
+    from deeptutor.services.mcp.session_state import load_loaded_tools
+
+    schemas: list[dict[str, Any]] = []
+    for name in sorted(load_loaded_tools(session_id)):
+        tool = registry.get(name)
+        if tool is None or not getattr(tool, "deferred", False):
+            continue
+        schemas.append(tool.get_definition().to_openai_schema())
+    return schemas
+
+
+__all__ = ["DeferredToolLoader", "persisted_tool_schemas", "render_deferred_tools_manifest"]
