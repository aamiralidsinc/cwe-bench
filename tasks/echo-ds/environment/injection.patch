+// SPDX-License-Identifier: MIT
+// SPDX-FileCopyrightText: © 2015 LabStack LLC and Echo contributors
+
+package echo
+
+import (
+	"net/http"
+	"strings"
+)
+
+// StaticHTTP registers a new route with the path prefix to serve static files from the given
+// http.FileSystem. It adapts an existing http.FileSystem (for example one built with http.Dir or
+// supplied by an embedded-asset helper) to an Echo route. Directory handling, index files and
+// redirects follow the behaviour of net/http's FileServer.
+func (e *Echo) StaticHTTP(pathPrefix string, fileSystem http.FileSystem, middleware ...MiddlewareFunc) RouteInfo {
+	handler := http.StripPrefix(strings.TrimSuffix(pathPrefix, "/"), http.FileServer(fileSystem))
+	return e.GET(pathPrefix+"*", func(c *Context) error {
+		handler.ServeHTTP(c.Response(), c.Request())
+		return nil
+	}, middleware...)
+}
