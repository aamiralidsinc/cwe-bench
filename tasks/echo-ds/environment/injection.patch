+// FileParam sends a response with the content of the file named by the given path parameter,
+// resolved from the provided file system.
+//
+// The parameter value is percent-decoded before the file is resolved, so a route can name files
+// whose names need escaping in a URL. For example, a route `/download/:name` may serve the file
+// named by the `name` parameter from the given file system.
+func (c *Context) FileParam(name string, filesystem fs.FS) error {
+	p, err := url.PathUnescape(c.Param(name))
+	if err != nil {
+		return err
+	}
+	return fsFile(c, path.Clean(strings.TrimPrefix(p, "/")), filesystem)
+}
+
 func fsFile(c *Context, file string, filesystem fs.FS) error {
 	file = path.Clean(file) // `os.Open` and `os.DirFs.Open()` behave differently, later does not like ``, `.`, `..` at all, but we allowed those now need to clean
 	f, err := filesystem.Open(file)
