diff --git a/guard/pacioli_guard/act.py b/guard/pacioli_guard/act.py
index 1494d5e..c402250 100644
--- a/guard/pacioli_guard/act.py
+++ b/guard/pacioli_guard/act.py
@@ -66,0 +67,4 @@ CANCEL = "cancel"
+# Erasing a document. Added 0.9.6: a delete takes a document off the site, and for a document that
+# moved stock or postings it is as consequential as a reversal. It is its own act because consent to
+# reverse a posting is not consent to erase the record of it.
+DELETE = "delete"
@@ -280,0 +285,6 @@ def _may_ride(doc, action):
+
+    **DELETE follows the same shape.** ``Document.delete`` has no insert frame either — a document
+    being erased necessarily exists — so the flag cannot discriminate there for the same structural
+    reason, and an erasure the framework performs while it is undoing something is part of that
+    undo. The delete gate added in 0.9.6 therefore rides the enclosing act exactly as the cancel
+    gate does.
@@ -282 +292 @@ def _may_ride(doc, action):
-    if action == CANCEL:
+    if action in (CANCEL, DELETE):
@@ -425,0 +436,15 @@ def before_cancel(doc, method=None):
+
+
+def on_trash(doc, method=None):
+    """``doc_events`` handler for the erasing act. Added 0.9.6.
+
+    Why this is gated at all, when ``delete_doc`` already refuses a document whose ``docstatus``
+    says it was posted: erasure is a distinct act on a document that a governed seat may be entitled
+    to perform, and an operator scoping that seat to "may not erase a document of this kind" had
+    nothing to say it with. The document's own name is all the gate needs; ``delete_doc`` runs
+    ``on_trash`` through ``Document.hook`` like every other lifecycle event, so a REST v1/v2 DELETE,
+    ``frappe.client.delete``, the desk's bulk delete, a background job and the console all pass here.
+
+    The marker binds to the document and to this act exactly as the other two do, so a marker minted
+    to submit or cancel a document does not erase it."""
+    _require_consent(doc, DELETE)
diff --git a/guard/pacioli_guard/enforce.py b/guard/pacioli_guard/enforce.py
index ffbb62d..39a13f0 100644
--- a/guard/pacioli_guard/enforce.py
+++ b/guard/pacioli_guard/enforce.py
@@ -428,0 +429,9 @@ def _consent_record(doctype, docname):
+
+    AN AMENDMENT CONTINUES THE DOCUMENT IT WAS MADE FROM (0.9.3). ERPNext's correction flow cancels
+    a document and re-creates it as an amended copy under a new name, and the operator who authorised
+    the correction is looking at the same business document, not a different one. Making them find
+    and mint a second marker for the copy, in the middle of a correction they have already approved,
+    is how an operator learns to mint markers carelessly. So when this exact document has no marker,
+    the document it was amended from is asked, and its marker is presented to the pure core as the
+    marker for this document. One step only: an amendment of an amendment is a different document
+    again, and the chain is not followed further.
@@ -435,0 +445,11 @@ def _consent_record(doctype, docname):
+        if not row:
+            origin = frappe.db.get_value(doctype, docname, "amended_from")
+            if origin:
+                row = frappe.db.get_value(
+                    CONSENT_DOCTYPE, {"ref_doctype": doctype, "ref_docname": origin},
+                    ["name", "token_hash", "ref_doctype", "ref_docname", "ref_action",
+                     "expires_at", "burned", "minted_by"],
+                    as_dict=True)
+                if row:
+                    # The marker now stands for the copy, which is the document this act is about.
+                    row = dict(row, ref_docname=docname)
