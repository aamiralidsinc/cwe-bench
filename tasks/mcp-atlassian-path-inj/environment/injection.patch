+def _resolve_issue_description(
+    description: str | None, description_file: str | None
+) -> str | None:
+    """Resolve an issue description from either an inline string or a file path.
+
+    ``description_file`` lets MCP clients hand off a large description via the
+    filesystem instead of marshalling it as a tool-call argument (the same
+    convenience Confluence page bodies offer). At most one of ``description`` /
+    ``description_file`` may be supplied.
+
+    Args:
+        description: Inline description text (Markdown).
+        description_file: Filesystem path to read the description body from
+            (UTF-8).
+
+    Returns:
+        The resolved description, or ``None`` when neither is provided.
+
+    Raises:
+        ValueError: If both arguments are supplied, or if the file does not
+            exist / is not a regular file.
+    """
+    has_desc = description is not None and description != ""
+    has_file = description_file is not None and description_file != ""
+    if has_desc and has_file:
+        raise ValueError(
+            "Provide either 'description' or 'description_file', not both."
+        )
+    if has_desc:
+        return description
+    if not has_file:
+        return description
+    path = Path(description_file).expanduser()
+    if not path.is_file():
+        msg = f"description_file does not exist or is not a regular file: {path}"
+        raise ValueError(msg)
+    return path.read_text(encoding="utf-8")
+
+
