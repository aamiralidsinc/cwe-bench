+# Copyright 2026 Flyto2. Licensed under Apache-2.0. See LICENSE.
+
+"""
+Export Records Module
+Write each record of an array to its own file
+"""
+import json
+import logging
+import os
+from typing import Any, Dict, List
+
+from ...registry import register_module
+from ...schema import compose, presets
+from ...schema.builders import field
+from ...schema.constants import FieldGroup
+from ...errors import ValidationError, ModuleError
+from ....utils import validate_path_with_env_config, PathTraversalError
+
+
+logger = logging.getLogger(__name__)
+
+
+@register_module(
+    module_id='data.export_records',
+    version='1.0.0',
+    category='data',
+    subcategory='export',
+    tags=['data', 'export', 'records', 'split', 'json', 'path_restricted'],
+    label='Export Records',
+    label_key='modules.data.export_records.label',
+    description='Write each record of an array to its own file',
+    description_key='modules.data.export_records.description',
+    icon='FileSpreadsheet',
+    color='#059669',
+
+    input_types=['array', 'object'],
+    output_types=['file_path', 'json'],
+    can_connect_to=['*'],
+    can_receive_from=['*'],
+
+    timeout_ms=120000,
+    retryable=True,
+    concurrent_safe=True,
+
+    requires_credentials=False,
+    handles_sensitive_data=False,
+    required_permissions=['filesystem.write'],
+
+    params_schema=compose(
+        presets.INPUT_DATA(key='records', required=True),
+        presets.OUTPUT_DIRECTORY(key='output_dir', required=True),
+        field(
+            'name_key',
+            type='string',
+            label='Name Field',
+            label_key='modules.data.export_records.params.name_key.label',
+            description='Field of each record holding the file name to write it under',
+            description_key='modules.data.export_records.params.name_key.description',
+            required=False,
+            default='name',
+            group=FieldGroup.BASIC,
+        ),
+    ),
+    output_schema={
+        'written': {
+            'type': 'array',
+            'description': 'Paths of the files that were written'
+        ,
+                'description_key': 'modules.data.export_records.output.written.description'},
+        'count': {
+            'type': 'number',
+            'description': 'Number of files written'
+        ,
+                'description_key': 'modules.data.export_records.output.count.description'}
+    },
+    examples=[
+        {
+            'title': 'Split a dataset into one file per record',
+            'title_key': 'modules.data.export_records.examples.split.title',
+            'params': {
+                'records': [{'name': 'alpha', 'value': 1}],
+                'output_dir': '/tmp/records',
+                'name_key': 'name'
+            }
+        }
+    ],
+    author='Flyto Team',
+    license='MIT'
+)
+async def data_export_records(context: Dict[str, Any]) -> Dict[str, Any]:
+    """Write each record of an array to its own file."""
+    params = context['params']
+    records = params.get('records')
+    output_dir = params.get('output_dir')
+    name_key = params.get('name_key') or 'name'
+
+    if not output_dir:
+        raise ValidationError("Missing required parameter: output_dir", field="output_dir")
+    if records is None:
+        raise ValidationError("Missing required parameter: records", field="records")
+    if not isinstance(records, list):
+        raise ValidationError("records must be an array", field="records")
+
+    try:
+        safe_dir = validate_path_with_env_config(output_dir)
+    except PathTraversalError as e:
+        raise ModuleError(str(e), code="PATH_TRAVERSAL")
+
+    os.makedirs(safe_dir, exist_ok=True)
+
+    written: List[str] = []
+    for index, record in enumerate(records):
+        if not isinstance(record, dict):
+            raise ValidationError(
+                "records[{}] must be an object".format(index), field="records"
+            )
+        name = record.get(name_key)
+        name = str(name) if name not in (None, '') else 'record-{}'.format(index)
+        if not name.endswith('.json'):
+            name = '{}.json'.format(name)
+        target = os.path.join(safe_dir, name)
+        target_dir = os.path.dirname(target)
+        if target_dir and not os.path.exists(target_dir):
+            os.makedirs(target_dir, exist_ok=True)
+        with open(target, 'w', encoding='utf-8') as f:
+            json.dump(record, f, ensure_ascii=False, indent=2)
+        written.append(target)
+
+    logger.info(f"Exported {len(written)} record files to {safe_dir}")
+
+    return {
+        'ok': True,
+        'data': {
+            'written': written,
+            'count': len(written),
+        }
+    }
