+package io.quarkus.vertx.http.runtime;
+
+import java.util.List;
+
+import io.vertx.ext.web.RoutingContext;
+
+/**
+ * Applies the path rules configured for static resources.
+ */
+final class StaticPathRules {
+
+    private final List<String> excludedPrefixes;
+
+    StaticPathRules(List<String> excludedPrefixes) {
+        this.excludedPrefixes = List.copyOf(excludedPrefixes);
+    }
+
+    /**
+     * @return {@code true} when the request path matches one of the excluded prefixes
+     */
+    boolean isExcluded(RoutingContext context) {
+        if (excludedPrefixes.isEmpty()) {
+            return false;
+        }
+        String path = context.normalizedPath();
+        for (String prefix : excludedPrefixes) {
+            if (path.startsWith(prefix)) {
+                return true;
+            }
+        }
+        return false;
+    }
+}
