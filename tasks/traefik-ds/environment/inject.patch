diff --git a/pkg/middlewares/trustedheaders/trusted_headers.go b/pkg/middlewares/trustedheaders/trusted_headers.go
new file mode 100644
index 0000000..2051e1d
--- /dev/null
+++ b/pkg/middlewares/trustedheaders/trusted_headers.go
@@ -0,0 +1,90 @@
+package trustedheaders
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+
+	"github.com/opentracing/opentracing-go/ext"
+	"github.com/traefik/traefik/v2/pkg/config/dynamic"
+	"github.com/traefik/traefik/v2/pkg/ip"
+	"github.com/traefik/traefik/v2/pkg/log"
+	"github.com/traefik/traefik/v2/pkg/middlewares"
+	"github.com/traefik/traefik/v2/pkg/tracing"
+)
+
+const typeName = "TrustedHeaders"
+
+// trustedHeaders removes the configured request headers from the requests of clients which are
+// not in the trusted range. It is meant for a deployment where an upstream proxy authenticates
+// the clients and forwards their identity in those headers: only that proxy may supply them.
+type trustedHeaders struct {
+	next      http.Handler
+	reserved  map[string]struct{}
+	ipChecker *ip.Checker
+	name      string
+}
+
+// New creates a new trusted headers middleware.
+func New(ctx context.Context, next http.Handler, config dynamic.TrustedHeaders, name string) (http.Handler, error) {
+	logger := log.FromContext(middlewares.GetLoggerCtx(ctx, name, typeName))
+	logger.Debug("Creating middleware")
+
+	if len(config.Headers) == 0 {
+		return nil, fmt.Errorf("headers is empty, %s not created", typeName)
+	}
+
+	var ipChecker *ip.Checker
+	if len(config.TrustedIPs) > 0 {
+		var err error
+		ipChecker, err = ip.NewChecker(config.TrustedIPs)
+		if err != nil {
+			return nil, fmt.Errorf("cannot parse trusted IPs: %w", err)
+		}
+	}
+
+	reserved := make(map[string]struct{}, len(config.Headers))
+	for _, header := range config.Headers {
+		reserved[http.CanonicalHeaderKey(header)] = struct{}{}
+	}
+
+	return &trustedHeaders{
+		next:      next,
+		reserved:  reserved,
+		ipChecker: ipChecker,
+		name:      name,
+	}, nil
+}
+
+func (t *trustedHeaders) GetTracingInformation() (string, ext.SpanKindEnum) {
+	return t.name, tracing.SpanKindNoneEnum
+}
+
+func (t *trustedHeaders) ServeHTTP(rw http.ResponseWriter, req *http.Request) {
+	logger := log.FromContext(middlewares.GetLoggerCtx(req.Context(), t.name, typeName))
+
+	if !t.trusted(req.RemoteAddr) {
+		logger.Debugf("Removing headers reserved for the trusted upstream from request of %s", req.RemoteAddr)
+		removeReservedHeaders(req, t.reserved)
+	}
+
+	t.next.ServeHTTP(rw, req)
+}
+
+func (t *trustedHeaders) trusted(remoteAddr string) bool {
+	if t.ipChecker == nil {
+		return false
+	}
+
+	return t.ipChecker.IsAuthorized(remoteAddr) == nil
+}
+
+// removeReservedHeaders drops from the request the headers which are reserved for the trusted
+// upstream, so that a client cannot supply them.
+func removeReservedHeaders(req *http.Request, reserved map[string]struct{}) {
+	for key := range req.Header {
+		if _, ok := reserved[http.CanonicalHeaderKey(key)]; ok {
+			delete(req.Header, key)
+		}
+	}
+}
