#!/bin/sh
# Deterministic FFmpeg stand-in for the offline verifier. It reports a version for the
# `-version` probe and appends each invocation's argument vector to the file named by
# AVI_FFMPEG_LOG, separated by a line holding three dashes.
if [ "$1" = "-version" ]; then
    echo "ffmpeg version 6.1-static"
    exit 0
fi
log="${AVI_FFMPEG_LOG:-/tmp/avi-ffmpeg-args.log}"
{
    echo "---"
    for arg in "$@"; do
        printf '%s\n' "$arg"
    done
} >> "$log"
exit 0
