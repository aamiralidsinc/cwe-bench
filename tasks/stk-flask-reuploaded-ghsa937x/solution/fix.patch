+    def _refused_type(self, ext: str) -> bool:
+        """Whether the configuration explicitly refuses this file type.
+
+        `UPLOADED_X_ALLOW` is checked first because an explicitly allowed
+        extension wins over the upload set's presets and the deny setting.
+        """
+        ext = ext.lower()
+        allow = {str(item).lower() for item in self.config.allow}
+        if ext in allow:
+            return False
+        deny = {str(item).lower() for item in self.config.deny}
+        if ext in deny:
+            return True
+        excluded = getattr(self.extensions, 'items', None)
+        if excluded is not None:
+            return ext in {str(item).lower() for item in excluded}
+        return False
+
+    def _check_basename(
