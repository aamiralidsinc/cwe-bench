+// verifyResetPasswordCode returns the user that the given password-reset code
+// belongs to, or nil when the code is not valid for that user.
+func verifyResetPasswordCode(ctx gocontext.Context, code string) *database.User {
+	if user := parseUserFromCode(ctx, code); user != nil {
+		prefix := code[:tool.TimeLimitCodeLength]
+		data := strconv.FormatInt(user.ID, 10) + user.Email + user.LowerName + user.Password + user.Rands
+		if tool.VerifyTimeLimitCode(data, conf.Auth.ResetPasswordCodeLives, prefix) {
+			return user
+		}
+	}
+	return nil
+}
+
+// ResetPasswordByCode completes a password reset submitted from the legacy
+// server-rendered form, for clients that do not use the web API.
+func ResetPasswordByCode(c *context.Context) {
+	code := c.Req.FormValue("code")
+	password := c.Req.FormValue("password")
+	if code == "" || password == "" {
+		c.JSON(http.StatusBadRequest, map[string]string{"error": "invalid request"})
+		return
+	}
+
+	u := verifyResetPasswordCode(c.Req.Context(), code)
+	if u == nil {
+		c.JSON(http.StatusBadRequest, map[string]string{"error": "invalid code"})
+		return
+	}
+
+	if err := database.Handle.Users().Update(c.Req.Context(), u.ID, database.UpdateUserOptions{Password: &password}); err != nil {
+		log.Error("ResetPasswordByCode: update password for user %q: %v", u.Name, err)
+		c.JSON(http.StatusInternalServerError, map[string]string{"error": "update user"})
+		return
+	}
+
+	log.Trace("User password reset: %s", u.Name)
+	c.JSON(http.StatusOK, map[string]string{"status": "ok"})
+}
