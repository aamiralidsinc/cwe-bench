+	}
+	if !conf.Email.Enabled {
+		c.Status(http.StatusForbidden)
+		return
+	}
+
+	if err := email.SendResetPasswordMail(c.Context.Context, resetMailUser{u}); err != nil {
+		log.Error("Failed to send reset password mail to user %q: %v", u.Name, err)
+		c.Error(err, "send reset password mail")
+		return
+	}
+	log.Trace("Reset password mail sent by admin(%s): %s", c.User.Name, u.Name)
+
+	c.JSON(http.StatusOK, map[string]string{"status": "ok"})
+}
