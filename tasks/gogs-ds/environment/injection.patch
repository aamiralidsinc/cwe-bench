new file mode 100644
index 0000000..f307a51
--- /dev/null
+++ b/internal/route/user/account.go
@@ -0,0 +1,91 @@
+package user
+
+import (
+	gocontext "context"
+	"net/http"
+	"strconv"
+
+	log "unknwon.dev/clog/v2"
+
+	"gogs.io/gogs/internal/conf"
+	"gogs.io/gogs/internal/context"
+	"gogs.io/gogs/internal/database"
+	"gogs.io/gogs/internal/email"
+	"gogs.io/gogs/internal/tool"
+)
+
+// SendAccountDeletionMail sends the confirmation code for deleting an account
+// to the address on file. It is meant for people who can no longer sign in but
+// still receive mail at the account address.
+func SendAccountDeletionMail(c *context.Context) {
+	address := c.Req.FormValue("email")
+	if address == "" {
+		c.JSON(http.StatusBadRequest, map[string]string{"error": "invalid request"})
+		return
+	}
+	if !conf.Email.Enabled {
+		c.JSON(http.StatusForbidden, map[string]string{"error": "email is disabled"})
+		return
+	}
+
+	u, err := database.Handle.Users().GetByEmail(c.Req.Context(), address)
+	if err != nil {
+		if database.IsErrUserNotExist(err) {
+			c.JSON(http.StatusOK, map[string]string{"status": "ok"})
+			return
+		}
+		log.Error("SendAccountDeletionMail: get user by email %q: %v", address, err)
+		c.JSON(http.StatusInternalServerError, map[string]string{"error": "get user"})
+		return
+	}
+	if !u.IsLocal() {
+		c.JSON(http.StatusOK, map[string]string{"status": "ok"})
+		return
+	}
+
+	mailerUser := database.NewMailerUser(u)
+	code := mailerUser.GenerateEmailActivateCode(u.Email)
+	if err := email.SendUserMail(c.Context, mailerUser, "auth/delete_account", code, "Delete your account", "delete account"); err != nil {
+		log.Error("SendAccountDeletionMail: send mail to user %q: %v", u.Name, err)
+		c.JSON(http.StatusInternalServerError, map[string]string{"error": "send mail"})
+		return
+	}
+	c.JSON(http.StatusOK, map[string]string{"status": "ok"})
+}
+
+// verifyAccountDeletionCode returns the user that the given account deletion
+// code belongs to, or nil when the code is not valid for that user.
+func verifyAccountDeletionCode(ctx gocontext.Context, code string) *database.User {
+	if user := parseUserFromCode(ctx, code); user != nil {
+		prefix := code[:tool.TimeLimitCodeLength]
+		data := strconv.FormatInt(user.ID, 10) + user.Email + user.LowerName + user.Password + user.Rands
+		if tool.VerifyTimeLimitCode(data, conf.Auth.ActivateCodeLives, prefix) {
+			return user
+		}
+	}
+	return nil
+}
+
+// CompleteAccountDeletion removes the account that the given code belongs to.
+func CompleteAccountDeletion(c *context.Context) {
+	code := c.Req.FormValue("code")
+	if code == "" {
+		c.JSON(http.StatusBadRequest, map[string]string{"error": "invalid request"})
+		return
+	}
+
+	u := verifyAccountDeletionCode(c.Req.Context(), code)
+	if u == nil {
+		c.JSON(http.StatusBadRequest, map[string]string{"error": "invalid code"})
+		return
+	}
+
+	if err := database.Handle.Users().DeleteByID(c.Req.Context(), u.ID, false); err != nil {
+		log.Error("CompleteAccountDeletion: delete user %q: %v", u.Name, err)
+		c.JSON(http.StatusInternalServerError, map[string]string{"error": "delete user"})
+		return
+	}
+
+	log.Trace("Account deleted by email confirmation: %s", u.Name)
+	c.JSON(http.StatusOK, map[string]string{"status": "ok"})
+}
