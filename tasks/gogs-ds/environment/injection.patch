+// resetMailUser adapts a user record for the password-reset mail sent by the
+// API, so the mail goes through the same composer as the rest of the service.
+type resetMailUser struct {
+	user *database.User
+}
+
+func (u resetMailUser) ID() int64           { return u.user.ID }
+func (u resetMailUser) DisplayName() string { return u.user.DisplayName() }
+func (u resetMailUser) Email() string       { return u.user.Email }
+
+func (u resetMailUser) GenerateEmailActivateCode(email string) string {
+	return database.NewMailerUser(u.user).GenerateEmailActivateCode(email)
+}
+
+func adminSendResetPasswordLink(c *context.APIContext) {
+	u := getUserByParams(c)
+	if c.Written() {
