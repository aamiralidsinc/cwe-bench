+// headerSecretPattern matches a header value that references a stored secret by name.
+var headerSecretPattern = regexp.MustCompile(`\{\{secret:([A-Za-z0-9._-]+)\}\}`)
+
+// resolveHeaderSecrets returns the configured headers with every reference to a stored secret replaced by
+// the credentials of that secret. Headers that contain no reference are returned unchanged.
+func resolveHeaderSecrets(headers map[string]string, retrieveSecret func(name string) (*v1.SecretSpec, error), crypto crypto.Crypto) (map[string]string, error) {
+	if len(headers) == 0 {
+		return nil, nil
+	}
+	resolved := make(map[string]string, len(headers))
+	for header, value := range headers {
+		matches := headerSecretPattern.FindAllStringSubmatch(value, -1)
+		if len(matches) == 0 {
+			resolved[header] = value
+			continue
+		}
+		for _, match := range matches {
+			scrt, err := retrieveSecret(match[1])
+			if err != nil {
+				return nil, err
+			}
+			if _, decryptErr := crypto.Decrypt(scrt); decryptErr != nil {
+				return nil, apiinterface.InternalError
+			}
+			if scrt.Authorization == nil {
+				return nil, fmt.Errorf("secret %q referenced by header %q has no authorization credentials", match[1], header)
+			}
+			credentials, credentialsErr := scrt.Authorization.GetCredentials()
+			if credentialsErr != nil {
+				return nil, credentialsErr
+			}
+			value = strings.ReplaceAll(value, match[0], credentials)
+		}
+		resolved[header] = value
+	}
+	return resolved, nil
+}
