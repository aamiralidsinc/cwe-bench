+package com.hazelcast.internal.serialization.impl;
+
+/**
+ * Counters collected by a serialization service for the diagnostics subsystem.
+ * <p>
+ * The counters are reported periodically by the serialization diagnostics
+ * plugin and are not part of the serialized form of any user object.
+ */
+public class SerializationServiceStatistics {
+
+    private String serviceName;
+    private long totalBytesWritten;
+    private long totalBytesRead;
+    private long totalObjectsWritten;
+    private long totalObjectsRead;
+
+    public SerializationServiceStatistics() {
+    }
+
+    public SerializationServiceStatistics(String serviceName) {
+        this.serviceName = serviceName;
+    }
+
+    public String getServiceName() {
+        return serviceName;
+    }
+
+    public long getTotalBytesWritten() {
+        return totalBytesWritten;
+    }
+
+    public long getTotalBytesRead() {
+        return totalBytesRead;
+    }
+
+    public long getTotalObjectsWritten() {
+        return totalObjectsWritten;
+    }
+
+    public long getTotalObjectsRead() {
+        return totalObjectsRead;
+    }
+
+    public void recordWrite(int bytes) {
+        totalBytesWritten += bytes;
+        totalObjectsWritten++;
+    }
+
+    public void recordRead(int bytes) {
+        totalBytesRead += bytes;
+        totalObjectsRead++;
+    }
+
+    @Override
+    public String toString() {
+        return "SerializationServiceStatistics{serviceName='" + serviceName + '\''
+                + ", totalBytesWritten=" + totalBytesWritten
+                + ", totalBytesRead=" + totalBytesRead + '}';
+    }
+}
