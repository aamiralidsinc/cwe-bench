@@ -0,0 +1,20 @@
+import type { BrowserCommand } from 'vitest/node'
+import fs, { promises as fsp } from 'node:fs'
+import { dirname, resolve } from 'node:path'
+import { assertFileAccess } from './fs'
+
+/**
+ * Writes a test artifact (a recorded payload, a generated report fragment, …)
+ * to disk so the UI can show it next to the run that produced it.
+ */
+export const exportArtifact: BrowserCommand<
+  [path: string, data: string]
+> = async ({ project }, path, data) => {
+  const filepath = resolve(project.config.root, path)
+  assertFileAccess(filepath, project)
+  const dir = dirname(filepath)
+  if (!fs.existsSync(dir)) {
+    await fsp.mkdir(dir, { recursive: true })
+  }
+  await fsp.writeFile(filepath, data, 'utf-8')
+}
