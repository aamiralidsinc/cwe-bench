+    /**
+     * SHA-1 Credentials
+     */
+    public static class SHA1 extends Credential
+    {
+        private static final long serialVersionUID = 5533846540822684241L;
+        private static final String __TYPE = "SHA1:";
+        private static final AutoLock __sha1Lock = new AutoLock();
+        private static MessageDigest __sha1;
+
+        private final byte[] _digest;
+
+        SHA1(String digest)
+        {
+            digest = digest.startsWith(__TYPE) ? digest.substring(__TYPE.length()) : digest;
+            _digest = StringUtil.fromHexString(digest);
+        }
+
+        public byte[] getDigest()
+        {
+            return _digest;
+        }
+
+        @Override
+        public boolean check(Object credentials)
+        {
+            try
+            {
+                if (credentials instanceof char[])
+                    credentials = new String((char[])credentials);
+                if (credentials instanceof Password || credentials instanceof String)
+                {
+                    byte[] digest;
+                    try (AutoLock l = __sha1Lock.lock())
+                    {
+                        if (__sha1 == null)
+                            __sha1 = MessageDigest.getInstance("SHA-1");
+                        __sha1.reset();
+                        __sha1.update(credentials.toString().getBytes(StandardCharsets.ISO_8859_1));
+                        digest = __sha1.digest();
+                    }
+                    return byteEquals(_digest, digest);
+                }
+                else if (credentials instanceof SHA1)
+                {
+                    return equals(credentials);
+                }
+                else if (credentials instanceof Credential)
+                {
+                    return ((Credential)credentials).check(this);
+                }
+                else
+                {
+                    return false;
+                }
+            }
+            catch (Exception e)
