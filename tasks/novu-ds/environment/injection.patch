+++ b/apps/api/src/app/inbox/usecases/get-notification-preview/get-notification-preview.usecase.ts
@@ -0,0 +1,80 @@
+import { Injectable, NotFoundException } from '@nestjs/common';
+import { MessageEntity, MessageRepository } from '@novu/dal';
+import { ButtonTypeEnum } from '@novu/shared';
+
+import { GetNotificationPreviewCommand } from './get-notification-preview.command';
+
+export type NotificationPreviewRedirect = {
+  url: string;
+  target?: string;
+};
+
+export type NotificationPreviewAction = {
+  label: string;
+  redirect?: NotificationPreviewRedirect;
+};
+
+/**
+ * Small payload used by the inbox hover card: it renders the subject and the destinations the
+ * user can act on without loading the whole notification body.
+ */
+export type NotificationPreviewDto = {
+  id: string;
+  subject?: string;
+  redirect?: NotificationPreviewRedirect;
+  primaryAction?: NotificationPreviewAction;
+  secondaryAction?: NotificationPreviewAction;
+};
+
+@Injectable()
+export class GetNotificationPreview {
+  constructor(private messageRepository: MessageRepository) {}
+
+  async execute(command: GetNotificationPreviewCommand): Promise<NotificationPreviewDto> {
+    const message = await this.messageRepository.findOneForInbox({
+      _environmentId: command.environmentId,
+      _subscriberId: command.subscriberId,
+      _id: command.notificationId,
+      contextKeys: command.contextKeys,
+    });
+
+    if (!message) {
+      throw new NotFoundException(`Notification with id: ${command.notificationId} is not found.`);
+    }
+
+    return mapMessageToPreview(message);
+  }
+}
+
+function mapAction(message: MessageEntity, type: ButtonTypeEnum): NotificationPreviewAction | undefined {
+  const button = message.cta?.action?.buttons?.find((item) => item.type === type);
+
+  if (!button) {
+    return undefined;
+  }
+
+  return {
+    label: button.content as string,
+    redirect: button.url
+      ? {
+          url: button.url,
+          target: button.target,
+        }
+      : undefined,
+  };
+}
+
+function mapMessageToPreview(message: MessageEntity): NotificationPreviewDto {
+  return {
+    id: message._id,
+    subject: message.subject,
+    redirect: message.cta?.data?.url
+      ? {
+          url: message.cta.data.url,
+          target: message.cta.data.target,
+        }
+      : undefined,
+    primaryAction: mapAction(message, ButtonTypeEnum.PRIMARY),
+    secondaryAction: mapAction(message, ButtonTypeEnum.SECONDARY),
+  };
+}
