+import { NotificationPreviewDto, Redirect } from '../types';
+
+/**
+ * Compact representation of a notification used by the inbox hover card. Every entry the card
+ * renders keeps the destination it would follow when the subscriber clicks it.
+ */
+export class NotificationPreview implements NotificationPreviewDto {
+  readonly id: string;
+  readonly subject?: string;
+  readonly redirect?: Redirect;
+  readonly primaryAction?: NotificationPreviewDto['primaryAction'];
+  readonly secondaryAction?: NotificationPreviewDto['secondaryAction'];
+
+  constructor(preview: NotificationPreviewDto) {
+    this.id = preview.id;
+    this.subject = preview.subject;
+    this.redirect = preview.redirect;
+    this.primaryAction = preview.primaryAction;
+    this.secondaryAction = preview.secondaryAction;
+  }
+}
