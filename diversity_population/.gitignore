# Large / rebuildable data — kept out of git (regenerate with the scripts here).
# 200+ MB copy of the reserve candidate index (prepare_index.py rebuilds it):
out/index/
# scratch intermediate from build_source_pool.py --per-pattern 250:
out/source_pool_250.sqlite
# the live queue DB (divq reconcile rebuilds it from out/results/):
out/divq.db
out/divq.db-wal
out/divq.db-shm
# decrypted run artifacts land here at run time:
out/results/
# per-run screener metadata (the screener records *.json are kept):
out/screener/*.run.json
# logs and caches:
*.nohup
out/steps.log
out/steps_topup.log
out/steps_status.txt
out/selection_run.log
out/topup_replace.log
__pycache__/
.pytest_cache/
*.pyc
