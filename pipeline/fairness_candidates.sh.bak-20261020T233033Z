#!/bin/bash
# Launch DeepSeek self-fairness on the DS-generated breaker candidates (both-fail + single-side -ds)
# that have no fairness verdict yet. Single-model rule: a -ds task is DeepSeek-generated -> DeepSeek
# checks fairness. Fairness is no-Docker (Read/Grep/Glob/Write) so parallel is cheap. Detached-safe.
cd "$HOME/cwe-bench" || exit 1
LOG=build/pipeline/fairness_candidates.log
{
echo "=== fairness_candidates START $(date -u +%FT%TZ) ==="
# both-fail (-ds): litellm-ds protobuf.js-ds ; single-side (-ds): airflow backstage electron-builder hazelcast hermes-agent siyuan
CANDS="litellm-ds protobuf.js-ds airflow-ds backstage-ds electron-builder-ds hazelcast-ds hermes-agent-ds siyuan-ds"
launched=0
for s in $CANDS; do
  if [ -f "build/$s/FAIRNESS.md" ]; then
    v=$(grep -qi 'not ready' "build/$s/FAIRNESS.md" && echo NOT-READY || echo READY)
    ff=$([ -f "build/$s/fairfix-exit.txt" ] && echo " +fairfixed" || echo "")
    echo "  SKIP $s (already fairness=$v$ff)"
  else
    echo "  LAUNCH deepseek fairness: $s"
    setsid bash -c "cd '$HOME/cwe-bench'; ./drive.sh deepseek bash run_fairness.sh '$s' >> 'build/$s/fairness.nohup' 2>&1" >/dev/null 2>&1 < /dev/null &
    launched=$((launched+1))
    sleep 1
  fi
done
echo "=== fairness launched this run: $launched ==="
echo "=== DONE $(date -u +%FT%TZ) ==="
} >> "$LOG" 2>&1
