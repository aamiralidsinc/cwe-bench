#!/bin/bash
. "$HOME/cwe-bench/pipeline/docker-tuning.env" 2>/dev/null || true
# run_pipeline.sh <deepseek|mimo> <slug>
# One candidate, end to end, model-driven generation + both-target trial:
#   build (driver) -> gate (nop/oracle/patches) -> if sound, trial BOTH targets -> ledger.
# Fairness/blind-fix are deferred to tasks that come back both-fail (validated separately).
set -uo pipefail
D=${1:?driver}; S=${2:?slug}
R="$HOME/cwe-bench"; cd "$R" || exit 1
LED="build/pipeline/ledger_$D.tsv"
LOG="build/$S/pipeline.log"
mkdir -p "build/$S"
# Atomic claim: only one pipeline instance ever processes a slug, so extra run_lane
# workers / a re-launch at higher concurrency can share the same list without collision.
if ! mkdir "build/$S/.lockdir" 2>/dev/null; then exit 0; fi
# Already started by another (possibly pre-lock) instance? Leave it strictly alone.
if [ -f "build/$S/pipeline.log" ]; then exit 0; fi
# Each slug is built exactly once per lane: start the task tree clean.
rm -rf "tasks/$S"
[ -f "$LED" ] || echo -e "utc\tslug\tstage\toutcome\tdeepseek\tmimo" > "$LED"
log(){ printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$(date -u +%FT%TZ)" "$S" "$1" "$2" "${3:-}" "${4:-}" >> "$LED"; }

echo "=== $(date -u +%FT%TZ) build $S (driver=$D) ===" >> "$LOG"
./drive.sh "$D" bash run_build.sh "$S" >> "$LOG" 2>&1
tf=$(find "tasks/$S" -type f 2>/dev/null | wc -l | tr -d ' ')
bx=$(cat "build/$S/build-exit.txt" 2>/dev/null || echo '-')
if [ "$tf" -lt 5 ]; then log build "stopped/failed tf=$tf exit=$bx"; exit 0; fi

sound=1
for st in nop oracle patches; do
  ok=None
  # A stage can return None = it did not record a result (e.g. "Docker compose command
  # failed" under concurrency) rather than a real pass/fail. Retry None up to 3x; stop
  # immediately on a real True/False. Only a real False (or persistent None) is unsound.
  for attempt in 1 2 3; do
    python3 -I builder/gate.py "$S" --only "$st" >> "$LOG" 2>&1 || true
    ok=$(python3 -c "import json;print(json.load(open('build/$S/gate_report.partial.json'))['stages'].get('$st',{}).get('ok'))" 2>/dev/null || echo None)
    echo "gate $st attempt=$attempt ok=$ok" >> "$LOG"
    [ "$ok" = "True" ] && break
    [ "$ok" = "False" ] && break
    sleep 20   # infra hiccup (compose/docker under load); let it clear, then retry
  done
  [ "$ok" = "True" ] || sound=0
done
if [ "$sound" != 1 ]; then touch "build/$S/.unsound"; log gate "UNSOUND (nop/oracle/patches not all ok)"; exit 0; fi
# Build+gate only. Trials are run per-stage by trial_set.sh (see pipeline/QUEUE.md).
rm -f "build/$S/.unsound"; touch "build/$S/.sound"
log gate "sound"
echo "=== $S BUILT + SOUND (ready to trial) $(date -u +%FT%TZ) ===" >> "$LOG"
