#!/bin/bash
# Iteratively validate a breaker candidate on a single model (DeepSeek), no Opus:
#   round: fairfix (apply current FAIRNESS.md) -> fairness re-check
#   when fairness READY: re-trial BOTH target models -> declare verdict
#   if still NOT READY after MAX rounds: cannot cleanly validate (likely not a fair task)
# Detached (setsid). Writes build/pipeline/validate_<slug>.log
cd "$HOME/cwe-bench" || exit 1
S=$1; MAX=${2:-3}
LOG=build/pipeline/validate_$S.log
echo "=== validate_loop $S start $(date -u +%FT%TZ) ===" >> "$LOG"
for r in $(seq 1 "$MAX"); do
  echo "[r$r] fairfix $(date -u +%T)" >> "$LOG"
  ./drive.sh deepseek bash run_fairfix.sh "$S" >> "build/$S/validate.nohup" 2>&1
  echo "[r$r] fairfix exit=$(cat build/$S/fairfix-exit.txt 2>/dev/null)" >> "$LOG"
  mv "build/$S/FAIRNESS.md" "build/$S/FAIRNESS.md.r$r" 2>/dev/null
  echo "[r$r] fairness $(date -u +%T)" >> "$LOG"
  ./drive.sh deepseek bash run_fairness.sh "$S" >> "build/$S/validate.nohup" 2>&1
  v=$(python3 -c "t=open('build/$S/FAIRNESS.md').read().lower();print('NOTREADY' if 'not ready' in t else 'READY')" 2>/dev/null || echo ERR)
  echo "[r$r] fairness verdict: $v" >> "$LOG"
  if [ "$v" = "READY" ]; then
    echo "[r$r] READY -> re-trial both models $(date -u +%T)" >> "$LOG"
    ts=$(date -u +%Y%m%dT%H%M%SZ)
    for f in runs_deepseek.log runs_mimo.log trial_detail_deepseek.json trial_detail_mimo.json; do
      [ -f "build/$S/$f" ] && mv "build/$S/$f" "build/$S/$f.r$r-$ts"
    done
    rm -f "build/$S/.unsound"; touch "build/$S/.sound"
    python3 build/trial.py "$S" --models deepseek --no-verdict >> "build/$S/trial_deepseek.out" 2>&1 &
    p1=$!
    python3 build/trial.py "$S" --models mimo --no-verdict >> "build/$S/trial_mimo.out" 2>&1 &
    p2=$!
    wait $p1 $p2
    D=$(grep -oE "reward=[0-9.]+" "build/$S/runs_deepseek.log" 2>/dev/null | sed s/reward=// | paste -sd, -)
    M=$(grep -oE "reward=[0-9.]+" "build/$S/runs_mimo.log" 2>/dev/null | sed s/reward=// | paste -sd, -)
    ds=$(echo "$D" | grep -q "1.0" && echo solve || echo fail)
    mm=$(echo "$M" | grep -q "1.0" && echo solve || echo fail)
    if [ "$ds" = fail ] && [ "$mm" = fail ]; then R="** CONFIRMED BOTH-MODELS BREAKER (fair) **"
    elif [ "$ds" = solve ] && [ "$mm" = solve ]; then R="both solve -> was unfair, NOT a breaker"
    else R="one-sided fail ($( [ $ds = fail ] && echo DeepSeek || echo MiMo )-only)"; fi
    echo "[r$r] FINAL: DeepSeek[$D] MiMo[$M] => $R" >> "$LOG"
    echo "$R" > "build/$S/VALIDATE_RESULT.txt"
    exit 0
  fi
done
echo "=== $S stayed NOT READY after $MAX rounds -> CANNOT CLEANLY VALIDATE (likely not a fair task) $(date -u +%T) ===" >> "$LOG"
echo "CANNOT-VALIDATE (NOT READY after $MAX fairfix rounds)" > "build/$S/VALIDATE_RESULT.txt"
